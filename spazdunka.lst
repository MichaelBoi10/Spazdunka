0001DB1C E081                       		asr.l	#8,d1			; find the new X speed
0001DB1E D240                       		add.w	d0,d1			; combine the two speeds
0001DB20 0C41 0400                  		cmpi.w	#$400,d1		; compare the combined speed with the jump release speed
0001DB24 6F00                       		ble.s	locret_1BBB4		; if it's less, branch to return
0001DB26 1038 F780                  		move.b	($FFFFF780).w,d0
0001DB2A 0200 00FC                  		andi.b	#$FC,d0
0001DB2E 4400                       		neg.b	d0
0001DB30 0400 0040                  		subi.b	#$40,d0
