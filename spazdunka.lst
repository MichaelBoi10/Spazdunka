0001CE92                            HurtSonic:
0001CE92 4A38 FE2C                  		tst.b	($FFFFFE2C).w	; does Sonic have a shield?
0001CE96 6600                       		bne.s	Hurt_Shield	; if yes, branch
0001CE98 4A78 FE20                  		tst.w	($FFFFFE20).w	; does Sonic have any rings?
0001CE9C 6700 0000                  		beq.w	Hurt_NoRings	; if not, branch
0001CEA0 4EB9 0000 E9F2             		jsr	SingleObjLoad
0001CEA6 6600                       		bne.s	Hurt_Shield
0001CEA8 12BC 0037                  		move.b	#$37,0(a1)	; load bouncing	multi rings object
0001CEAC 3368 0008 0008             		move.w	8(a0),8(a1)
0001CEB2 3368 000C 000C             		move.w	$C(a0),$C(a1)
0001CEB8                            
0001CEB8                            Hurt_Shield:
0001CEB8 11FC 0000 FE2C             		move.b	#0,($FFFFFE2C).w ; remove shield
0001CEBE 117C 0004 0024             		move.b	#4,$24(a0)
0001CEC4 6100 81A4                  		bsr.w	Sonic_ResetOnFloor
0001CEC8 08E8 0001 0022             		bset	#1,$22(a0)
0001CECE 317C FC00 0012             		move.w	#-$400,$12(a0)	; make Sonic bounce away from the object
0001CED4 317C FE00 0010             		move.w	#-$200,$10(a0)
0001CEDA 0828 0006 0022             		btst	#6,$22(a0)
0001CEE0 6700                       		beq.s	Hurt_Reverse
0001CEE2 317C FE00 0012             		move.w	#-$200,$12(a0)
0001CEE8 317C FF00 0010             		move.w	#-$100,$10(a0)
0001CEEE                            
