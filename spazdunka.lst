0001CBE0 B06A 0008                  		cmp.w	8(a2),d0
0001CBE4 6500                       		bcs.s	Hurt_ChkSpikes	; if Sonic is left of the object, branch
0001CBE6 4468 0010                  		neg.w	$10(a0)		; if Sonic is right of the object, reverse
0001CBEA                            
