001B1DC8                               include   "SampleDebugger.asm"
001B1DC8                            SampleDebugger:
001B1DC8                            	Console.WriteLine "%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
001B1DC8 40E7                     M 	move.w	sr,-(sp)
001B1DCA                          M 	_console.writeline	<"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>">,<>
001B1DCA                          M 	__fstring_generateargumentscode	"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
001B1DCA =00000001                M 	__pos:	= instr("%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'%<')
001B1DCA =00000000                M 	__stack:=	0
001B1DCA =00000000                M 	__sp:	= 0
001B1DCA                          M 	pusho
001B1DCA                          M 	opt	ae-
001B1DCA                          M 	while	(__pos)
001B1DCA =00000007                M 	__endpos:	= instr(__pos+1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'>')
001B1DCA =0000000E                M 	__midpos:	= instr(__pos+5,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",' ')
001B1DCA =00000007                M 	__midpos:	= __endpos
001B1DCA                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
