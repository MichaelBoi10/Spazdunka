00015110 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015114 1228 0022                  		move.b	$22(a0),d1
00015118 0201 0001                  		andi.b	#1,d1
0001511C 0228 00FC 0001             		andi.b	#$FC,1(a0)
