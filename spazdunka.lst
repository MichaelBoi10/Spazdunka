0007FD62                            ; Exported symbols
0007FD62                            ; ------------------------------------------------------------------------------
0007FD62                            
0007FD62 =0007DC4A                  MegaPCM_LoadDriver:	equ	MegaPCMLibraryBlob+$0
0007FD62 =0007DCB4                  MegaPCM_LoadSampleTable:	equ	MegaPCMLibraryBlob+$6A
0007FD62 =0007DEFA                  MegaPCM:	equ	MegaPCMLibraryBlob+$2B0
0007FD62 =0007FD61                  MegaPCM_End:	equ	MegaPCMLibraryBlob+$2117
