00015008                            Sonic_Animate:				; XREF: Obj01_Control; et al
00015008 43F9 0000 0000             		lea	(SonicAniData).l,a1
0001500E 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015012 6700                       		beq.s	SAnim_NotSuper
00015014 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
0001501A                            
0001501A                            SAnim_NotSuper:		
0001501A 7000                       		moveq	#0,d0
0001501C 1028 001C                  		move.b	$1C(a0),d0
00015020 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00015024 6700                       		beq.s	SAnim_Do	; if not, branch
00015026 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
0001502A 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00015030 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00015036                            
00015036                            SAnim_Do:
00015036 D040                       		add.w	d0,d0
00015038 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0001503C 1011                       		move.b	(a1),d0
0001503E 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00015040 1228 0022                  		move.b	$22(a0),d1
00015044 0201 0001                  		andi.b	#1,d1
00015048 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001504E 8328 0001                  		or.b	d1,1(a0)
00015052 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015056 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00015058 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
0001505C                            
0001505C                            SAnim_Do2:
0001505C 7200                       		moveq	#0,d1
0001505E 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
00015062 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00015066 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
0001506A 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
0001506C                            
0001506C                            SAnim_Next:
0001506C 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00015070 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00015074                            
00015074                            SAnim_Delay:
00015074 4E75                       		rts	
00015076                            ; ===========================================================================
00015076                            
00015076                            SAnim_End_FF:
00015076 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00015078 6600                       		bne.s	SAnim_End_FE	; if not, branch
0001507A 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015080 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015084 60E6                       		bra.s	SAnim_Next
00015086                            ; ===========================================================================
00015086                            
00015086                            SAnim_End_FE:
00015086 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00015088 6600                       		bne.s	SAnim_End_FD	; if not, branch
0001508A 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0001508E 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015092 9200                       		sub.b	d0,d1
00015094 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015098 60D2                       		bra.s	SAnim_Next
0001509A                            ; ===========================================================================
0001509A                            
0001509A                            SAnim_End_FD:
0001509A 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0001509C 6600                       		bne.s	SAnim_End	; if not, branch
0001509E 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
000150A4                            
000150A4                            SAnim_End:
000150A4 4E75                       		rts	
000150A6                            ; ===========================================================================
000150A6                            
000150A6                            SAnim_WalkRun:				; XREF: SAnim_Do
000150A6 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150AA 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
000150AC 5200                       		addq.b	#1,d0		; is animation walking/running?
000150AE 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
000150B2 7200                       		moveq	#0,d1
000150B4 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
000150B8 1428 0022                  		move.b	$22(a0),d2
000150BC 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
000150C0 6600                       		bne.s	loc_13A70	; if yes, branch
000150C2 4600                       		not.b	d0		; reverse angle
000150C4                            
000150C4                            loc_13A70:
000150C4 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
000150C8 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
000150CA 7203                       		moveq	#3,d1
000150CC                            
000150CC                            loc_13A78:
000150CC 0228 00FC 0001             		andi.b	#$FC,1(a0)
000150D2 B302                       		eor.b	d1,d2
000150D4 8528 0001                  		or.b	d2,1(a0)
000150D8 0828 0005 0022             		btst	#5,$22(a0)
000150DE 6600 0000                  		bne.w	SAnim_Push
000150E2 E808                       		lsr.b	#4,d0		; divide angle by $10
000150E4 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
000150E8 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000150EC 6A00                       		bpl.s	loc_13A9C
000150EE 4442                       		neg.w	d2
000150F0                            
000150F0                            loc_13A9C:
000150F0 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
000150F4 6700                       		beq.s	Loc_NotSuper
000150F6 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
000150FC 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015100 6400                       		bhs.s	SuperRun	; if yes, branch
00015102 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
00015108 6000                       		bra.s	SuperWalk
0001510A                            
0001510A                            Loc_NotSuper:
0001510A 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00015110 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015114 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015116 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
0001511C 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00015120 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015122 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00015128                            
00015128                            SuperWalk:
00015128 1200                       		move.b	d0,d1
0001512A E209                       		lsr.b	#1,d1
0001512C D001                       		add.b	d1,d0
0001512E                            
0001512E                            loc_13AB4:
0001512E D000                       		add.b	d0,d0
00015130                            
00015130                            SuperRun:
00015130 1600                       		move.b	d0,d3
00015132 4442                       		neg.w	d2
00015134 0642 0800                  		addi.w	#$800,d2
00015138 6A00                       		bpl.s	loc_13AC2
0001513A 7400                       		moveq	#0,d2
0001513C                            
0001513C                            loc_13AC2:
0001513C E04A                       		lsr.w	#8,d2
0001513E 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015142 6100 FF18                  		bsr.w	SAnim_Do2
00015146 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
0001514A 4E75                       		rts	
0001514C                            ; ===========================================================================
0001514C                            
0001514C                            SAnim_RollJump:				; XREF: SAnim_WalkRun
0001514C 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
0001514E 6600                       		bne.s	SAnim_Push	; if not, branch
00015150 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015154 6A00                       		bpl.s	loc_13ADE
00015156 4442                       		neg.w	d2
00015158                            
00015158                            loc_13ADE:
00015158 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
0001515E 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00015162 6400                       		bcc.s	loc_13AF0	; if yes, branch
00015164 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
0001516A                            
0001516A                            loc_13AF0:
0001516A 4442                       		neg.w	d2
0001516C 0642 0400                  		addi.w	#$400,d2
00015170 6A00                       		bpl.s	loc_13AFA
00015172 7400                       		moveq	#0,d2
00015174                            
00015174                            loc_13AFA:
00015174 E04A                       		lsr.w	#8,d2
00015176 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001517A 1228 0022                  		move.b	$22(a0),d1
0001517E 0201 0001                  		andi.b	#1,d1
00015182 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015188 8328 0001                  		or.b	d1,1(a0)
0001518C 6000 FECE                  		bra.w	SAnim_Do2
00015190                            ; ===========================================================================
00015190                            
00015190                            SAnim_Push:				; XREF: SAnim_RollJump
00015190 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015194 6B00                       		bmi.s	loc_13B1E
00015196 4442                       		neg.w	d2
00015198                            
00015198                            loc_13B1E:
00015198 0642 0800                  		addi.w	#$800,d2
0001519C 6A00                       		bpl.s	loc_13B26
0001519E 7400                       		moveq	#0,d2
000151A0                            
000151A0                            loc_13B26:
000151A0 EC4A                       		lsr.w	#6,d2
000151A2 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151A6 43F9 0000 0000             		lea	(SonAni_Push).l,a1
000151AC 1228 0022                  		move.b	$22(a0),d1
000151B0 0201 0001                  		andi.b	#1,d1
000151B4 0228 00FC 0001             		andi.b	#$FC,1(a0)
000151BA 8328 0001                  		or.b	d1,1(a0)
000151BE 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
000151C2 6700                       		beq.s	Loc_NotSuper2
000151C4 43F9 0000 0000             		lea	(SupSonAni_Push).l,a1 ; use	running	animation
000151CA                            
000151CA                            Loc_NotSuper2:
000151CA 6000 FE90                  		bra.w	SAnim_Do2
000151CE                            ; End of function Sonic_Animate
