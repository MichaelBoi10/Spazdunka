0000DD04 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DD06 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DD0A 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
