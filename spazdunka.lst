0001DAF2 0828 0007 0022             		btst	#7,$22(a0)		; did Sonic jump or is he just falling or hit by a bumper?
0001DAF8 6700                       		beq.s	locret_1BBB4		; if not, branch to return
0001DAFA 1038 F780                  		move.b	($FFFFF780).w,d0	; get SS angle
0001DAFE 0200 00FC                  		andi.b	#$FC,d0
0001DB02 4400                       		neg.b	d0
0001DB04 0400 0040                  		subi.b	#$40,d0
0001DB08 4EB9 0000 2A66             		jsr	(CalcSine).l			
0001DB0E 3428 0012                  		move.w	$12(a0),d2		; get Y speed
0001DB12 C1C2                       		muls.w	d2,d0			; multiply Y speed by sin
0001DB14 E080                       		asr.l	#8,d0			; find the new Y speed
0001DB16 3428 0010                  		move.w	$10(a0),d2		; get X speed
