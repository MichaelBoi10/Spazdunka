0000106C                            ; ---------------------------------------------------------------------------
0000106C                            ; Subroutine to load VDP commands into the DMA transfer queue
0000106C                            ;
0000106C                            ; In case you wish to use this queue system outside of the spin dash, this is the
0000106C                            ; registers in which it expects data in:
0000106C                            ; d1.l: Address to data (In 68k address space)
0000106C                            ; d2.w: Destination in VRAM
0000106C                            ; d3.w: Length of data
0000106C                            ;
0000106C                            ; Don't use this one, replace the code with the much better Ultra DMA Queue by Flamewing
0000106C                            ; ---------------------------------------------------------------------------
0000106C                            
0000106C                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000106C                            
0000106C                            
0000106C                            DMA_68KtoVRAM:
0000106C 2278 C8FC                  		movea.l	($FFFFC8FC).w,a1
00001070 B2FC C8FC                  		cmpa.w	#$C8FC,a1	; is the DMA queue full?
00001074 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
00001076                            
00001076                            		; piece together some VDP commands and store them for later...
00001076 303C 9300                  		move.w	#$9300,d0	; command to specify DMA transfer length & $00FF
0000107A 1003                       		move.b	d3,d0
0000107C 32C0                       		move.w	d0,(a1)+	; store command
0000107E                            
0000107E 303C 9400                  		move.w	#$9400,d0	; command to specify DMA transfer length & $FF00
00001082 E04B                       		lsr.w	#8,d3
00001084 1003                       		move.b	d3,d0
00001086 32C0                       		move.w	d0,(a1)+	; store command
00001088                            
00001088 303C 9500                  		move.w	#$9500,d0	; command to specify source address & $0001FE
0000108C E289                       		lsr.l	#1,d1
0000108E 1001                       		move.b	d1,d0
00001090 32C0                       		move.w	d0,(a1)+	; store command
00001092                            
00001092 303C 9600                  		move.w	#$9600,d0	; command to specify source address & $01FE00
00001096 E089                       		lsr.l	#8,d1
00001098 1001                       		move.b	d1,d0
0000109A 32C0                       		move.w	d0,(a1)+	; store command
0000109C                            
0000109C 303C 9700                  		move.w	#$9700,d0	; command to specify source address & $FE0000
000010A0 E089                       		lsr.l	#8,d1
000010A2 1001                       		move.b	d1,d0
000010A4 32C0                       		move.w	d0,(a1)+	; store command
000010A6                            
000010A6 0282 0000 FFFF             		andi.l	#$FFFF,d2	; command to specify destination address and begin DMA
000010AC E58A                       		lsl.l	#2,d2
000010AE E44A                       		lsr.w	#2,d2
000010B0 4842                       		swap	d2
000010B2 0082 4000 0080             		ori.l	#$40000080,d2 ; set bits to specify VRAM transfer
000010B8 22C2                       		move.l	d2,(a1)+	; store command
000010BA                            
000010BA 21C9 C8FC                  		move.l	a1,($FFFFC8FC).w ; set the next free slot address
000010BE B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
000010C2 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
000010C4 32BC 0000                  		move.w	#0,(a1) ; put a stop token at the end of the used part of the buffer
000010C8                            
000010C8                            DMA_68KtoVRAM_Done:			; XREF: DMA_68KtoVRAM
000010C8 4E75                       		rts
000010CA                            ; End of function DMA_68KtoVRAM
000010CA                            
000010CA                            ; ---------------------------------------------------------------------------
000010CA                            ; Process all VDP commands and then reset the DMA queue when it's done
000010CA                            ; ---------------------------------------------------------------------------
000010CA                            
000010CA                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000010CA                            
000010CA                            
000010CA                            Process_DMA:
000010CA 4BF9 00C0 0004             		lea	($C00004).l,a5
000010D0 43F8 C800                  		lea	($FFFFC800).w,a1
000010D4                            
000010D4                            Process_DMA_Loop:			; XREF: Process_DMA
000010D4 3019                       		move.w	(a1)+,d0	; has a stop token been encountered?
000010D6 6700                       		beq.s	Process_DMA_Done ; branch if we reached a stop token
000010D8                            
000010D8                            		; issue a set of VDP commands...
000010D8 3A80                       		move.w	d0,(a5)		; transfer length
000010DA 3A99                       		move.w	(a1)+,(a5)	; transfer length
000010DC 3A99                       		move.w	(a1)+,(a5)	; source address
000010DE 3A99                       		move.w	(a1)+,(a5)	; source address
000010E0 3A99                       		move.w	(a1)+,(a5)	; source address
000010E2 3A99                       		move.w	(a1)+,(a5)	; destination
000010E4 3A99                       		move.w	(a1)+,(a5)	; destination
000010E6 B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
000010EA 66E8                       		bne.s	Process_DMA_Loop ; loop if we haven't reached the end of the buffer
000010EC                            
000010EC                            Process_DMA_Done:			; XREF: Process_DMA
000010EC 31FC 0000 C800             		move.w	#0,($FFFFC800).w
000010F2 21FC FFFF C800 C8FC        		move.l	#$FFFFC800,($FFFFC8FC).w
000010FA 4E75                       		rts
000010FC                            ; End of function Process_DMA
