0001CBC8 0828 0006 0022             		btst	#6,$22(a0)
0001CBCE 6700                       		beq.s	Hurt_Reverse
0001CBD0 317C FE00 0012             		move.w	#-$200,$12(a0)
0001CBD6 317C FF00 0010             		move.w	#-$100,$10(a0)
