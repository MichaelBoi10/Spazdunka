00014100 6C00                       		bge.s	Obj01_OutWater	; if yes, branch
00014102 08E8 0006 0022             		bset	#6,status(a0)
00014108 66EC                       		bne.s	locret_12D80
0001410A 6100 0000                  		bsr.w	ResumeMusic
0001410E 11FC 000A D340             		move.b	#$A,($FFFFD340).w ; load bubbles object	from Sonic's mouth
00014114 11FC 0081 D368             		move.b	#$81,($FFFFD368).w
0001411A 31FC 0300 F760             		move.w	#$300,($FFFFF760).w ; change Sonic's top speed
00014120 31FC 0006 F762             		move.w	#6,($FFFFF762).w ; change Sonic's acceleration
00014126 31FC 0040 F764             		move.w	#$40,($FFFFF764).w ; change Sonic's deceleration
0001412C 4A38 FE19                  		tst.b	(Super_Sonic_flag).w	; Is Sonic Super?
00014130 6700                       		beq.s	@Skip			; If not branch
00014132 31FC 0500 F760             		move.w	#$500,(Sonic_top_speed).w
00014138 31FC 0018 F762             		move.w	#$18,(Sonic_acceleration).w
0001413E 31FC 0080 F764             		move.w	#$80,(Sonic_deceleration).w
