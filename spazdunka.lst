00001004 6700                       		beq.s	Pause_ChkStart	; if not, branch
00001006 0838 0006 F605             		btst	#6,($FFFFF605).w ; is button A pressed?
0000100C 6700                       		beq.s	Pause_ChkBC	; if not, branch
