00015316 4442                       		neg.w	d2
00015318                            
00015318                            loc_13B1E:
00015318 0642 0800                  		addi.w	#$800,d2
0001531C 6A00                       		bpl.s	loc_13B26
0001531E 7400                       		moveq	#0,d2
00015320                            
00015320                            loc_13B26:
