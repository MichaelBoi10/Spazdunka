00005C6E                            Cred_WaitLoop:
00005C6E 11FC 0004 F62A             		move.b	#4,($FFFFF62A).w
00005C74 6100 CDBE                  		bsr.w	DelayProgram
00005C78 6100 B62E                  		bsr.w	RunPLC_RAM
00005C7C 4A78 F614                  		tst.w	($FFFFF614).w	; have 2 seconds elapsed?
00005C80 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005C82 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005C86 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005C88 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
00005C8E 6700 0000                  		beq.w	TryAgainEnd	; if yes, branch
00005C92 4E75                       		rts	
