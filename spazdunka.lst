000150CC 4442                       		neg.w	d2
000150CE 0642 0800                  		addi.w	#$800,d2
000150D2 6A00                       		bpl.s	loc_13AC2
000150D4 7400                       		moveq	#0,d2
000150D6                            
000150D6                            loc_13AC2:
