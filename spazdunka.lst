00014868                            ; ---------------------------------------------------------------------------
00014868                            ; Subroutine called at the peak of a jump that transforms Sonic into Super Sonic
00014868                            ; if he has enough rings and emeralds
00014868                            ; ---------------------------------------------------------------------------
00014868                            
00014868                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00014868                            
00014868                            ; loc_1AB38: test_set_SS:
00014868                            Sonic_CheckGoSuper:
00014868 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
0001486C 6600 0000                  	bne.w	return_1ABA4		; if yes, branch
00014870 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
00014876 6600                       	bne.s	return_1ABA4		; if not, branch
00014878 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
0001487E 6500                       	bcs.s	return_1ABA4		; if not, branch
00014880 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
00014884 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
00014888 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
0001488E 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
00014894 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
0001489A 11FC 0001 F7C8             	move.b	#1,($FFFFF7C8).w ; lock	controls
000148A0 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
000148A6 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
000148AC 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
000148B2 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
000148B8 317C 0000 0032             	move.w	#0,invincibility_time(a0)
000148BE 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
000148C4 303C 00D4                  	move.w	#$D4,d0         ; 
000148C8 4EB9 0000 0FC8             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
000148CE 303C 0087                  	move.w	#$87,d0
000148D2 4EF9 0000 0FC2             	jmp	(PlaySound).l	; Play the super theme
000148D8                            ; ---------------------------------------------------------------------------
000148D8                            return_1ABA4:
000148D8 4E75                       	rts
000148DA                            ; End of subroutine Sonic_CheckGoSuper
000148DA                            
