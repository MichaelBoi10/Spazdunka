0001F0B2 0000 0000                  	dc.l Kos_MZ+$8000000
0001F0B6 0000 0000                  	dc.l Blk16_MZ+$9000000
0001F0BA 0000 0000                  	dc.l Blk256_MZ
0001F0BE 0083 0606                  	dc.b 0,	$83, 6,	6
0001F0C2 0000 0000                  	dc.l Kos_SLZ+$A000000
0001F0C6 0000 0000                  	dc.l Blk16_SLZ+$B000000
0001F0CA 0000 0000                  	dc.l Blk256_SLZ
0001F0CE 0084 0707                  	dc.b 0,	$84, 7,	7
0001F0D2 0000 0000                  	dc.l Kos_SYZ+$C000000
0001F0D6 0000 0000                  	dc.l Blk16_SYZ+$D000000
0001F0DA 0000 0000                  	dc.l Blk256_SYZ
0001F0DE 0085 0808                  	dc.b 0,	$85, 8,	8
0001F0E2 0000 0000                  	dc.l Kos_SBZ+$E000000
0001F0E6 0000 0000                  	dc.l Blk16_SBZ+$F000000
0001F0EA 0000 0000                  	dc.l Blk256_SBZ
0001F0EE 0086 0909                  	dc.b 0,	$86, 9,	9
