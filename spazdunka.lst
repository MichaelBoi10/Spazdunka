00014926 11FC 0002 F65F             	move.b	#2,(Super_Sonic_palette).w	; Remove rotating palette
0001492C 31FC 0028 F65C             	move.w	#$28,($FFFFF65C).w	; Unknown
00014932 11FC 0000 FE19             	move.b	#0,(Super_Sonic_flag).w
00014938 117C 0001 001D             	move.b	#1,next_anim(a0)	; Change animation back to normal ?
0001493E 317C 0001 0032             	move.w	#1,invincibility_time(a0)	; Remove invincibility
00014944 31FC 0630 F760             	move.w	#$630,(Sonic_top_speed).w
0001494A 31FC 000C F762             	move.w	#$C,(Sonic_acceleration).w
00014950 31FC 0080 F764             	move.w	#$80,(Sonic_deceleration).w
00014956 0828 0006 0022             	btst	#6,status(a0)	; Check if underwater, return if not
0001495C 6700                       	beq.s	return_1AC3C
