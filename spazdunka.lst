00001148 5147                       		subq.w	#8,d7
0000114A 3205                       		move.w	d5,d1
0000114C EE69                       		lsr.w	d7,d1
0000114E 0C01 00FC                  		cmpi.b	#-4,d1
00001152 6400                       		bcc.s	loc_14D6
00001154 0241 00FF                  		andi.w	#$FF,d1
00001158 D241                       		add.w	d1,d1
0000115A 1031 1000                  		move.b	(a1,d1.w),d0
0000115E 4880                       		ext.w	d0
