00001E00 0202 000E                  		andi.b	#$0E,d2					; MJ: get only red
00001E04 3610                       		move.w	(a0),d3					; MJ: load current colour in buffer
00001E06 B805                       		cmp.b	d5,d4					; MJ: is it time for blue to fade?
00001E08 6300                       		bls.s	FWI_NoBlue				; MJ: if not, branch
00001E0A 0443 0200                  		subi.w	#$0200,d3				; MJ: decrease blue
00001E0E                            
00001E0E                            FWI_NoBlue:
