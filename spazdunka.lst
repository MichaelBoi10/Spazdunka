0001503A                            GameOver:				; XREF: Obj01_Death
0001503A 3038 F704                  		move.w	($FFFFF704).w,d0
0001503E 0640 0100                  		addi.w	#$100,d0
00015042 B068 000C                  		cmp.w	$C(a0),d0
00015046 6C00 0000                  		bge.w	locret_13900
0001504A 317C FFC8 0012             		move.w	#-$38,y_vel(a0)
00015050 5428 0024                  		addq.b	#2,routine(a0)
00015054 4238 FE1E                  		clr.b	($FFFFFE1E).w	; stop time counter
00015058 5238 FE1C                  		addq.b	#1,($FFFFFE1C).w ; update lives	counter
0001505C 5338 FE12                  		subq.b	#1,($FFFFFE12).w ; subtract 1 from number of lives
00015060 6600                       		bne.s	loc_138D4
00015062 317C 0000 003A             		move.w	#0,$3A(a0)
00015068 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load GAME object
0001506E 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
00015074 11FC 0001 D0DA             		move.b	#1,($FFFFD0DA).w ; set OVER object to correct frame
0001507A 4238 FE1A                  		clr.b	($FFFFFE1A).w
0001507E                            
0001507E                            loc_138C2:
0001507E 11FC 0014 F600             		move.b	#$14,($FFFFF600).w ; set mode to $14 (continue screen)
00015084 7003                       		moveq	#3,d0
00015086 4EF9 0000 123C             		jmp	(LoadPLC).l	; load game over patterns
0001508C                            ; ===========================================================================
0001508C                            
0001508C                            loc_138D4:
0001508C 317C 003C 003A             		move.w	#60,$3A(a0)	; set time delay to 1 second
00015092 4A38 FE1A                  		tst.b	($FFFFFE1A).w	; is TIME OVER tag set?
00015096 6700                       		beq.s	locret_13900	; if not, branch
00015098 317C 0000 003A             		move.w	#0,$3A(a0)
0001509E 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load TIME object
000150A4 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
000150AA 11FC 0002 D09A             		move.b	#2,($FFFFD09A).w
000150B0 11FC 0003 D0DA             		move.b	#3,($FFFFD0DA).w
000150B6 60C6                       		bra.s	loc_138C2
000150B8                            ; ===========================================================================
000150B8                            
000150B8                            locret_13900:
000150B8 4E75                       		rts	
000150BA                            ; End of function GameOver
