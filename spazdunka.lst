000153E4 E808                       		lsr.b	#4,d0		; divide angle by $10
000153E6 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
000153EA 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000153EE 6A00                       		bpl.s	loc_13A9C
000153F0 4442                       		neg.w	d2
