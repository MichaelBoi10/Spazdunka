0001501A                            Sonic_Animate:				; XREF: Obj01_Control; et al
0001501A 43F9 0000 0000             		lea	(SonicAniData).l,a1
00015020 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015024 6700                       		beq.s	SAnim_NotSuper
00015026 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
0001502C                            
0001502C                            SAnim_NotSuper:		
0001502C 7000                       		moveq	#0,d0
0001502E 1028 001C                  		move.b	$1C(a0),d0
00015032 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00015036 6700                       		beq.s	SAnim_Do	; if not, branch
00015038 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
0001503C 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00015042 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00015048                            
00015048                            SAnim_Do:
00015048 D040                       		add.w	d0,d0
0001504A D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0001504E 1011                       		move.b	(a1),d0
00015050 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00015052 1228 0022                  		move.b	$22(a0),d1
00015056 0201 0001                  		andi.b	#1,d1
0001505A 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015060 8328 0001                  		or.b	d1,1(a0)
00015064 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015068 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
0001506A 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
0001506E                            
0001506E                            SAnim_Do2:
0001506E 7200                       		moveq	#0,d1
