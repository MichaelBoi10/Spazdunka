00001100 47F9 0000 0000             		lea	(loc_1502).l,a3
00001106 49F9 00C0 0000             		lea	($C00000).l,a4
0000110C 6000                       		bra.s	loc_145C
0000110E                            ; ===========================================================================
0000110E 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
00001112 47F9 0000 0000             		lea	(loc_1518).l,a3
00001118                            
00001118                            loc_145C:				; XREF: NemDec
