0000B270                            ; ---------------------------------------------------------------------------
0000B270                            ; Subroutine to	animate	a sprite using an animation script
0000B270                            ; ---------------------------------------------------------------------------
0000B270                            
0000B270                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B270                            
0000B270                            
0000B270                            AnimateSprite:
0000B270 7000                       		moveq	#0,d0
0000B272 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B276 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B27A 6700                       		beq.s	Anim_Run	; if not, branch
0000B27C 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B280 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B286 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B28C                            
0000B28C                            Anim_Run:
0000B28C 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B290 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B292 D040                       		add.w	d0,d0
0000B294 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B298 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B29C 7200                       		moveq	#0,d1
0000B29E 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B2A2 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B2A6 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B2A8                            
0000B2A8                            Anim_Next:
0000B2A8 1200                       		move.b	d0,d1
0000B2AA 0200 001F                  		andi.b	#$1F,d0
0000B2AE 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B2B2 1028 0022                  		move.b	$22(a0),d0
0000B2B6 E719                       		rol.b	#3,d1
0000B2B8 B101                       		eor.b	d0,d1
0000B2BA 0201 0003                  		andi.b	#3,d1
0000B2BE 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B2C4 8328 0001                  		or.b	d1,render_flags(a0)
0000B2C8 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B2CC                            
0000B2CC                            Anim_Wait:
0000B2CC 4E75                       		rts	
0000B2CE                            ; ===========================================================================
0000B2CE                            
0000B2CE                            Anim_End_FF:
0000B2CE 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B2D0 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B2D2 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B2D8 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B2DC 60CA                       		bra.s	Anim_Next
0000B2DE                            ; ===========================================================================
0000B2DE                            
0000B2DE                            Anim_End_FE:
0000B2DE 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B2E0 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B2E2 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B2E6 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B2EA 9200                       		sub.b	d0,d1
0000B2EC 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B2F0 60B6                       		bra.s	Anim_Next
0000B2F2                            ; ===========================================================================
0000B2F2                            
0000B2F2                            Anim_End_FD:
0000B2F2 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B2F4 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B2F6 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B2FC                            
0000B2FC                            Anim_End_FC:
0000B2FC 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B2FE 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B300 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B304                            
0000B304                            Anim_End_FB:
0000B304 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B306 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B308 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B30E 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B312                            
0000B312                            Anim_End_FA:
0000B312 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B314 6600                       		bne.s	Anim_End	; if not, branch
0000B316 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B31A                            
0000B31A                            Anim_End:
0000B31A 4E75                       		rts	
0000B31C                            ; End of function AnimateSprite
