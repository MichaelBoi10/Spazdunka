0000386C                            LevSelControls:				; XREF: LevelSelect
0000386C 1238 F605                  		move.b	($FFFFF605).w,d1
00003870 0201 0003                  		andi.b	#3,d1		; is up/down pressed and held?
00003874 6600                       		bne.s	LevSel_UpDown	; if yes, branch
00003876 5378 FF80                  		subq.w	#1,($FFFFFF80).w ; subtract 1 from time	to next	move
0000387A 6A00                       		bpl.s	LevSel_SndTest	; if time remains, branch
0000387C                            
0000387C                            LevSel_UpDown:
0000387C 31FC 000B FF80             		move.w	#$B,($FFFFFF80).w ; reset time delay
00003882 1238 F604                  		move.b	($FFFFF604).w,d1
00003886 0201 0003                  		andi.b	#3,d1		; is up/down pressed?
0000388A 6700                       		beq.s	LevSel_SndTest	; if not, branch
0000388C 3038 FF82                  		move.w	($FFFFFF82).w,d0
00003890 0801 0000                  		btst	#0,d1		; is up	pressed?
00003894 6700                       		beq.s	LevSel_Down	; if not, branch
00003896 5340                       		subq.w	#1,d0		; move up 1 selection
00003898 6400                       		bcc.s	LevSel_Down
0000389A 7014                       		moveq	#$14,d0		; if selection moves below 0, jump to selection	$14
0000389C                            
0000389C                            LevSel_Down:
0000389C 0801 0001                  		btst	#1,d1		; is down pressed?
000038A0 6700                       		beq.s	LevSel_Refresh	; if not, branch
000038A2 5240                       		addq.w	#1,d0		; move down 1 selection
000038A4 0C40 0015                  		cmpi.w	#$15,d0
000038A8 6500                       		bcs.s	LevSel_Refresh
000038AA 7000                       		moveq	#0,d0		; if selection moves above $14,	jump to	selection 0
000038AC                            
000038AC                            LevSel_Refresh:
000038AC 31C0 FF82                  		move.w	d0,($FFFFFF82).w ; set new selection
000038B0 6100 0000                  		bsr.w	LevSelTextLoad	; refresh text
000038B4 4E75                       		rts	
