0000DCB2                            
0000DCB2                            Obj36_Solid:				; XREF: Obj36_Index
0000DCB2 6100 0000                  		bsr.w	Obj36_Type0x	; make the object move
0000DCB6 343C 0004                  		move.w	#4,d2
0000DCBA 0C28 0005 001A             		cmpi.b	#5,mapping_frame(a0)	; is object type $5x ?
0000DCC0 6700                       		beq.s	Obj36_SideWays	; if yes, branch
0000DCC2 0C28 0001 001A             		cmpi.b	#1,mapping_frame(a0)	; is object type $1x ?
0000DCC8 6600                       		bne.s	Obj36_Upright	; if not, branch
0000DCCA 343C 0014                  		move.w	#$14,d2
0000DCCE                            
0000DCCE                            ; Spikes types $1x and $5x face	sideways
0000DCCE                            
0000DCCE                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DCCE 323C 001B                  		move.w	#$1B,d1
0000DCD2 3602                       		move.w	d2,d3
0000DCD4 5243                       		addq.w	#1,d3
0000DCD6 3828 0008                  		move.w	8(a0),d4
0000DCDA 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DCDE 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DCE2 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DCE6 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DCEA 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DCF0 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DCF2 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DCF4 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DCF6 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DCF8 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DCFA                            ; ===========================================================================
0000DCFA                            
0000DCFA                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DCFA                            
0000DCFA                            Obj36_Upright:				; XREF: Obj36_Solid
0000DCFA 7200                       		moveq	#0,d1
0000DCFC 1228 0019                  		move.b	$19(a0),d1
0000DD00 0641 000B                  		addi.w	#$B,d1
0000DD04 343C 0010                  		move.w	#$10,d2
0000DD08 363C 0011                  		move.w	#$11,d3
0000DD0C 3828 0008                  		move.w	8(a0),d4
0000DD10 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DD14 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DD1A 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DD1C 4A44                       		tst.w	d4			; check response value from SolidObject
0000DD1E 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DD20 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DD24 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DD28 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DD2E 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DD30 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DD32 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DD34 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DD36                            		; otherwise, fall through to Spik_Hurt
0000DD36                            
0000DD36                            Obj36_Hurt:				; XREF: Obj36_SideWays; Obj36_Upright
0000DD36 4A38 FE2D                  		tst.b	($FFFFFE2D).w	; is Sonic invincible?
0000DD3A 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DD3C 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DD40 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
0000DD42 2F08                       		move.l	a0,-(sp)
0000DD44 2448                       		movea.l	a0,a2
0000DD46 41F8 D000                  		lea	($FFFFD000).w,a0
0000DD4A 0C28 0004 0024             		cmpi.b	#4,routine(a0)
0000DD50 6400                       		bcc.s	loc_CF20
0000DD52 2628 000C                  		move.l	$C(a0),d3
0000DD56 3028 0012                  		move.w	$12(a0),d0
0000DD5A 48C0                       		ext.l	d0
0000DD5C E180                       		asl.l	#8,d0
0000DD5E 9680                       		sub.l	d0,d3
0000DD60 2143 000C                  		move.l	d3,y_pos(a0)
0000DD64 4EB9 0000 0000             		jsr	HurtSonic
