000039A8                            ; ---------------------------------------------------------------------------
000039A8                            ; Level	select menu text
000039A8                            ; ---------------------------------------------------------------------------
000039A8                            lstxt macro textline
000039A8                            	i:   = 1
000039A8                            	len: = strlen(\textline)
000039A8                            	if len<>24
000039A8                            		inform 2, "line length must be exactly 24 characters"
000039A8                            	endif
000039A8                            
000039A8                            	while (i<=len)
000039A8                            		char:	substr i,i,\textline
000039A8                            		i: = i+1
000039A8                            
000039A8                            		if     "\char"=' '
000039A8                            			dc.b	$FF
000039A8                            		elseif ("\char">='0')&("\char"<='9')
000039A8                            			dc.b	$00+"\char"-'0'
000039A8                            		elseif "\char"='$'
000039A8                            			dc.b	$0A
000039A8                            		elseif "\char"='-'
000039A8                            			dc.b	$0B
000039A8                            		elseif "\char"='='
000039A8                            			dc.b	$0C
000039A8                            		elseif "\char"=">"
000039A8                            			dc.b	$0D
000039A8                            		;elseif "\char"=">"
000039A8                            		;	dc.b	$0E
000039A8                            		elseif "\char"='Y'
000039A8                            			dc.b	$0F
000039A8                            		elseif "\char"='Z'
000039A8                            			dc.b	$10
000039A8                            		elseif ("\char">='A')&("\char"<='X')
000039A8                            			dc.b	$11+"\char"-'A'
000039A8                            		else
000039A8                            			inform 2, "illegal char \char"
000039A8                            		endif
000039A8                            	endw
000039A8                            	endm
000039A8                            
