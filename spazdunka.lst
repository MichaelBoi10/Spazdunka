0001516E 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
00015174 11FC 0001 D0DA             		move.b	#1,($FFFFD0DA).w ; set OVER object to correct frame
0001517A 4238 FE1A                  		clr.b	($FFFFFE1A).w
0001517E                            
0001517E                            loc_138C2:
0001517E 11FC 0014 F600             		move.b	#$14,($FFFFF600).w ; set mode to $14 (continue screen)
00015184 7003                       		moveq	#3,d0
00015186 4EF9 0000 123C             		jmp	(LoadPLC).l	; load game over patterns
0001518C                            ; ===========================================================================
0001518C                            
0001518C                            loc_138D4:
0001518C 317C 003C 003A             		move.w	#60,$3A(a0)	; set time delay to 1 second
00015192 4A38 FE1A                  		tst.b	($FFFFFE1A).w	; is TIME OVER tag set?
00015196 6700                       		beq.s	locret_13900	; if not, branch
00015198 317C 0000 003A             		move.w	#0,$3A(a0)
0001519E 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load TIME object
000151A4 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
000151AA 11FC 0002 D09A             		move.b	#2,($FFFFD09A).w
000151B0 11FC 0003 D0DA             		move.b	#3,($FFFFD0DA).w
000151B6 60C6                       		bra.s	loc_138C2
000151B8                            ; ===========================================================================
000151B8                            
000151B8                            locret_13900:
000151B8 4E75                       		rts	
000151BA                            ; End of function GameOver
