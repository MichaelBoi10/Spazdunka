00001E18 6300                       		bls.s	FWI_NoRed				; MJ: if not, branch
00001E1A 5503                       		subq.b	#$02,d3					; MJ: decrease red
00001E1C                            
00001E1C                            FWI_NoRed:
00001E1C 30C3                       		move.w	d3,(a0)+				; MJ: save colour
00001E1E 4E75                       		rts						; MJ: return
00001E20                            ; End of function Pal_DecColor2
