000153B4 7200                       		moveq	#0,d1
000153B6 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
000153BA 1428 0022                  		move.b	$22(a0),d2
000153BE 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
000153C2 6600                       		bne.s	loc_13A70	; if yes, branch
000153C4 4600                       		not.b	d0		; reverse angle
000153C6                            
000153C6                            loc_13A70:
000153C6 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
