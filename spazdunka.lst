00014C34                            Sonic_SpinDash:
00014C34 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
00014C38 6600                       		bne.s	loc2_1AC8E		; if set, branch
00014C3A 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
00014C40 6600                       		bne.s	locret2_1AC8C		; if not, return
00014C42 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014C46 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
00014C4A 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
00014C4E 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
00014C54 303C 00D2                  		move.w	#$D2,d0			; spin sound ($E0 in s2)
00014C58 4EB9 0000 0FC8             		jsr	(PlaySound_Special).l	; play spin sound
00014C5E 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014C60 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
00014C66 317C 0000 003A             		move.w	#0,$3A(a0)		; set charge count to 0
00014C6C 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
00014C72 6500                       		bcs.s	loc2_1AC84		; ??? branch if carry
