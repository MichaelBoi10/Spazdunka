0001CC0A 6600                       		bne.s	Hurt_Sound	; if not, branch
0001CC0C 0C12 0016                  		cmpi.b	#$16,(a2)	; was damage caused by LZ harpoon?
0001CC10 6600                       		bne.s	Hurt_Sound	; if not, branch
