00014732                            ; loc_1AB38: test_set_SS:
00014732                            Sonic_CheckGoSuper:
00014732 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014736 6600 0000                  	bne.w	return_1ABA4		; if yes, branch
0001473A 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
00014740 6600                       	bne.s	return_1ABA4		; if not, branch
00014742 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014748 6500                       	bcs.s	return_1ABA4		; if not, branch
0001474A 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
0001474E 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
00014752 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014758 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
0001475E 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
00014764 11FC 0001 F7C8             	move.b	#1,($FFFFF7C8).w ; lock	controls
0001476A 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
00014770 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
00014776 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
0001477C 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
00014782 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014788 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
0001478E 303C 00D4                  	move.w	#$D4,d0         ; 
00014792 4EB9 0000 0FF4             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
00014798 303C 0087                  	move.w	#$87,d0
0001479C 4EF9 0000 0FEE             	jmp	(PlaySound).l	; Play the super theme
000147A2                            ; ---------------------------------------------------------------------------
000147A2                            return_1ABA4:
000147A2 4E75                       	rts
000147A4                            ; End of subroutine Sonic_CheckGoSuper
