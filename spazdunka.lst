0007FD62                            ; ------------------------------------------------------------------------------
0007FD62                            ; Mega PCM API Routines
0007FD62                            ; ------------------------------------------------------------------------------
0007FD62                            
0007FD62                            
0007FD62                            ; ------------------------------------------------------------------------------
0007FD62                            ; Plays a given sample
0007FD62                            ; ------------------------------------------------------------------------------
0007FD62                            ; INPUT:
0007FD62                            ;		d0	.b		sample id (>$81)
0007FD62                            ;
0007FD62                            ; EXAMPLES:
0007FD62                            ;		move.b	#$81, d0
0007FD62                            ;		jsr		MegaPCM_PlaySample
0007FD62                            ;
0007FD62                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
0007FD62                            ;		jsr		MegaPCM_PlaySample
0007FD62                            ; ------------------------------------------------------------------------------
0007FD62                            
0007FD62                            MegaPCM_PlaySample:
0007FD62                            	MPCM_play	d0
0007FD62                          M 	mpcm_stopz80
0007FD62                          M 	pusho
0007FD62                          M 	opt	l-
0007FD62 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FD6A                          M 	@wait_17:
0007FD6A 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FD72 66F6                     M 	bne.s	@wait_17
0007FD74                          M 	popo
0007FD74 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0007FD7A                          M 	mpcm_startz80
0007FD7A 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FD82 4E75                       	rts
0007FD84                            
0007FD84                            ; ------------------------------------------------------------------------------
0007FD84                            ; Pauses current sample playback
0007FD84                            ; ------------------------------------------------------------------------------
0007FD84                            
0007FD84                            MegaPCM_PausePlayback:
0007FD84                            	MPCM_pause
0007FD84                          M 	mpcm_stopz80
0007FD84                          M 	pusho
0007FD84                          M 	opt	l-
0007FD84 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FD8C                          M 	@wait_20:
0007FD8C 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FD94 66F6                     M 	bne.s	@wait_20
0007FD96                          M 	popo
0007FD96 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
0007FD9E                          M 	mpcm_startz80
