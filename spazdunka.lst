00005C32 5278 FFF4                  		addq.w	#1,($FFFFFFF4).w
00005C36 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	credits	finished?
00005C3C 6400                       		bcc.s	EndDemo_Exit	; if yes, branch
00005C3E 31FC 8001 FFF0             		move.w	#$8001,($FFFFFFF0).w ; force demo mode
00005C44 11FC 0008 F600             		move.b	#8,($FFFFF600).w ; set game mode to 08 (demo)
00005C4A 11FC 0003 FE12             		move.b	#3,($FFFFFE12).w ; set lives to	3
00005C50 7000                       		moveq	#0,d0
00005C52 31C0 FE20                  		move.w	d0,($FFFFFE20).w ; clear rings
00005C56 21C0 FE22                  		move.l	d0,($FFFFFE22).w ; clear time
00005C5A 21C0 FE26                  		move.l	d0,($FFFFFE26).w ; clear score
00005C5E 11C0 FE30                  		move.b	d0,($FFFFFE30).w ; clear lamppost counter
