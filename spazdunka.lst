0001517C                            ; Subroutine to	animate	Sonic's sprites
0001517C                            ; ---------------------------------------------------------------------------
0001517C                            
0001517C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
