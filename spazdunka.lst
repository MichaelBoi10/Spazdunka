00014FFC 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00015000 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
00015004 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
00015006                            
00015006                            SAnim_Next:
00015006 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
0001500A 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
0001500E                            
0001500E                            SAnim_Delay:
0001500E 4E75                       		rts	
00015010                            ; ===========================================================================
00015010                            
00015010                            SAnim_End_FF:
00015010 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00015012 6600                       		bne.s	SAnim_End_FE	; if not, branch
00015014 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
0001501A 1029 0001                  		move.b	1(a1),d0	; read sprite number
0001501E 60E6                       		bra.s	SAnim_Next
00015020                            ; ===========================================================================
00015020                            
00015020                            SAnim_End_FE:
00015020 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00015022 6600                       		bne.s	SAnim_End_FD	; if not, branch
00015024 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015028 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
0001502C 9200                       		sub.b	d0,d1
0001502E 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015032 60D2                       		bra.s	SAnim_Next
00015034                            ; ===========================================================================
00015034                            
00015034                            SAnim_End_FD:
00015034 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015036 6600                       		bne.s	SAnim_End	; if not, branch
00015038 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
0001503E                            
0001503E                            SAnim_End:
0001503E 4E75                       		rts	
00015040                            ; ===========================================================================
00015040                            
00015040                            SAnim_WalkRun:				; XREF: SAnim_Do
00015040 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015044 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015046 5200                       		addq.b	#1,d0		; is animation walking/running?
00015048 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
0001504C 7200                       		moveq	#0,d1
0001504E 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015052 1428 0022                  		move.b	$22(a0),d2
00015056 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
0001505A 6600                       		bne.s	loc_13A70	; if yes, branch
0001505C 4600                       		not.b	d0		; reverse angle
0001505E                            
0001505E                            loc_13A70:
0001505E 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015062 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015064 7203                       		moveq	#3,d1
00015066                            
00015066                            loc_13A78:
00015066 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001506C B302                       		eor.b	d1,d2
0001506E 8528 0001                  		or.b	d2,1(a0)
00015072 0828 0005 0022             		btst	#5,$22(a0)
00015078 6600 0000                  		bne.w	SAnim_Push
0001507C E808                       		lsr.b	#4,d0		; divide angle by $10
0001507E 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015082 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015086 6A00                       		bpl.s	loc_13A9C
00015088 4442                       		neg.w	d2
0001508A                            
0001508A                            loc_13A9C:
0001508A 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
0001508E 6700                       		beq.s	Loc_NotSuper
00015090 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
00015096 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
0001509A 6400                       		bhs.s	SuperRun	; if yes, branch
0001509C 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
000150A2 6000                       		bra.s	SuperWalk
000150A4                            
000150A4                            Loc_NotSuper:
000150A4 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
000150AA 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000150AE 6400                       		bhs.s	loc_13AB4	; if yes, branch
000150B0 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000150B6 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000150BA 6400                       		bhs.s	loc_13AB4	; if yes, branch
000150BC 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000150C2                            
000150C2                            SuperWalk:
000150C2 1200                       		move.b	d0,d1
000150C4 E209                       		lsr.b	#1,d1
000150C6 D001                       		add.b	d1,d0
000150C8                            
000150C8                            loc_13AB4:
000150C8 D000                       		add.b	d0,d0
000150CA                            
000150CA                            SuperRun:
