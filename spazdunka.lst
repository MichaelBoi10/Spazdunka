0000112A 7608                       		moveq	#8,d3
0000112C 7400                       		moveq	#0,d2
0000112E 7800                       		moveq	#0,d4
00001130 6100 0000                  		bsr.w	NemDec4
00001134 1A18                       		move.b	(a0)+,d5
00001136 E145                       		asl.w	#8,d5
00001138 1A18                       		move.b	(a0)+,d5
