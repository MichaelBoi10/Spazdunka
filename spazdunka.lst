00014A44 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
00014A4A 11FC 0010 D200             	move.b	#$10,($FFFFD200).w ; load Obj10 (super sonic stars object) at $FFFFD200
00014A50 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
00014A56 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014A5C 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
00014A62 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014A68 11FC 0001 FE2D             	move.b	#1,($FFFFFE2D).w ; make Sonic invincible
00014A6E 303C 00D4                  	move.w	#$D4,d0         ;
00014A72 4EB9 0000 0FC2             	jsr	(PlaySound).l	; Play special ring sound effect.
00014A78 303C 0094                  	move.w	#$94,d0
00014A7C 4EF9 0000 0FC8             	jmp	(PlaySound_Special).l	; Play the super theme
