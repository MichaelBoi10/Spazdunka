0007FE88                            
0007FE88                            ; ------------------------------------------------------------------------------
0007FE88                            ; Sets volume for normal (non-SFX) samples
0007FE88                            ; ------------------------------------------------------------------------------
0007FE88                            ; INPUT:
0007FE88                            ;		d0	 .b		volume level (0 = max .. $F = min)
0007FE88                            ; ------------------------------------------------------------------------------
0007FE88                            
0007FE88                            MegaPCM_SetVolume:
0007FE88                            	MPCM_setVol	d0
0007FE88                          M 	mpcm_stopz80
0007FE88                          M 	pusho
0007FE88                          M 	opt	l-
0007FE88 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FE90                          M 	@wait_35:
0007FE90 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FE98 66F6                     M 	bne.s	@wait_35
0007FE9A                          M 	popo
0007FE9A 13C0 00A0 1FC3           M 	move.b	d0,mpcm_z80_ram+z_mpcm_volumeinput
0007FEA0                          M 	mpcm_startz80
0007FEA0 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FEA8 4E75                       	rts
0007FEAA                            
0007FEAA                            ; ------------------------------------------------------------------------------
0007FEAA                            ; Sets volume for SFX samples (added with FLAGS_SFX)
0007FEAA                            ; ------------------------------------------------------------------------------
0007FEAA                            ; INPUT:
0007FEAA                            ;		d0	 .b		volume level (0 = max .. $F = min)
0007FEAA                            ; ------------------------------------------------------------------------------
0007FEAA                            
0007FEAA                            MegaPCM_SetSFXVolume:
0007FEAA                            	MPCM_setSfxVol	d0
0007FEAA                          M 	mpcm_stopz80
0007FEAA                          M 	pusho
0007FEAA                          M 	opt	l-
0007FEAA 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FEB2                          M 	@wait_38:
0007FEB2 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FEBA 66F6                     M 	bne.s	@wait_38
0007FEBC                          M 	popo
0007FEBC 13C0 00A0 1FC4           M 	move.b	d0,mpcm_z80_ram+z_mpcm_sfxvolumeinput
0007FEC2                          M 	mpcm_startz80
0007FEC2 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FECA 4E75                       	rts
0007FECC                            
0007FECC                            ; ------------------------------------------------------------------------------
0007FECC                            ; Updates pitch for the currently playing sample
0007FECC                            ; ------------------------------------------------------------------------------
0007FECC                            ; INPUT:
0007FECC                            ;		d0	.b		sample pitch (0 = 0% base rate .. $FF = 100% base rate)
0007FECC                            ; ------------------------------------------------------------------------------
0007FECC                            
0007FECC                            MegaPCM_SetActiveSamplePitch:
0007FECC                            	MPCM_setPitch	d0
0007FECC                          M 	mpcm_stopz80
0007FECC                          M 	pusho
0007FECC                          M 	opt	l-
0007FECC 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FED4                          M 	@wait_41:
0007FED4 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FEDC 66F6                     M 	bne.s	@wait_41
0007FEDE                          M 	popo
0007FEDE 13C0 00A0 1FD2           M 	move.b	d0,mpcm_z80_ram+z_mpcm_activesamplepitch
0007FEE4                          M 	mpcm_startz80
0007FEE4 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FEEC 4E75                       	rts
