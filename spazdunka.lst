00001CEA 6200                       		bhi.s	FCI_NoRed				; MJ: if not, branch
00001CEC 5403                       		addq.b	#$02,d3					; MJ: increase red
00001CEE                            
00001CEE                            FCI_NoRed:
00001CEE 30C3                       		move.w	d3,(a0)+				; MJ: save colour
00001CF0 4E75                       		rts						; MJ: return
