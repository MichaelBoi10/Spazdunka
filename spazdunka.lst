00005BC0                            
00005BC0                            Credits:				; XREF: GameModeArray
00005BC0 6100 B6D8                  		bsr.w	ClearPLC
00005BC4 6100 C12C                  		bsr.w	Pal_FadeFrom
00005BC8 4DF9 00C0 0004             		lea	($C00004).l,a6
00005BCE 3CBC 8004                  		move.w	#$8004,(a6)
00005BD2 3CBC 8230                  		move.w	#$8230,(a6)
00005BD6 3CBC 8407                  		move.w	#$8407,(a6)
00005BDA 3CBC 9001                  		move.w	#$9001,(a6)
00005BDE 3CBC 9200                  		move.w	#$9200,(a6)
00005BE2 3CBC 8B03                  		move.w	#$8B03,(a6)
00005BE6 3CBC 8720                  		move.w	#$8720,(a6)
00005BEA 4238 F64E                  		clr.b	($FFFFF64E).w
