00083144 66F6                     M 	bne.s	@wait_47
00083146                          M 	popo
00083146 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
0008314E                          M 	mpcm_startz80
0008314E 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00083156 4E75                       	rts
