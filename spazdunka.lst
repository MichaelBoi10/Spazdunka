0001508A 6600                       		bne.s	SAnim_End_FE	; if not, branch
0001508C 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015092 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015096 60E6                       		bra.s	SAnim_Next
00015098                            ; ===========================================================================
00015098                            
00015098                            SAnim_End_FE:
00015098 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0001509A 6600                       		bne.s	SAnim_End_FD	; if not, branch
0001509C 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
000150A0 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
000150A4 9200                       		sub.b	d0,d1
000150A6 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
000150AA 60D2                       		bra.s	SAnim_Next
000150AC                            ; ===========================================================================
000150AC                            
000150AC                            SAnim_End_FD:
000150AC 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
000150AE 6600                       		bne.s	SAnim_End	; if not, branch
000150B0 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
000150B6                            
000150B6                            SAnim_End:
000150B6 4E75                       		rts	
000150B8                            ; ===========================================================================
000150B8                            
000150B8                            SAnim_WalkRun:				; XREF: SAnim_Do
000150B8 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150BC 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
000150BE 5200                       		addq.b	#1,d0		; is animation walking/running?
000150C0 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
000150C4 7200                       		moveq	#0,d1
000150C6 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
000150CA 1428 0022                  		move.b	$22(a0),d2
