00005C94                            
00005C94                            EndingDemoLoad:				; XREF: Credits
00005C94 3038 FFF4                  		move.w	($FFFFFFF4).w,d0
00005C98 0240 000F                  		andi.w	#$F,d0
00005C9C D040                       		add.w	d0,d0
00005C9E 303B 0000                  		move.w	EndDemo_Levels(pc,d0.w),d0 ; load level	array
00005CA2 31C0 FE10                  		move.w	d0,($FFFFFE10).w ; set level from level	array
00005CA6 5278 FFF4                  		addq.w	#1,($FFFFFFF4).w
00005CAA 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	credits	finished?
00005CB0 6400                       		bcc.s	EndDemo_Exit	; if yes, branch
00005CB2 31FC 8001 FFF0             		move.w	#$8001,($FFFFFFF0).w ; force demo mode
00005CB8 11FC 0008 F600             		move.b	#8,($FFFFF600).w ; set game mode to 08 (demo)
00005CBE 11FC 0003 FE12             		move.b	#3,($FFFFFE12).w ; set lives to	3
00005CC4 7000                       		moveq	#0,d0
00005CC6 31C0 FE20                  		move.w	d0,($FFFFFE20).w ; clear rings
00005CCA 21C0 FE22                  		move.l	d0,($FFFFFE22).w ; clear time
00005CCE 21C0 FE26                  		move.l	d0,($FFFFFE26).w ; clear score
00005CD2 11C0 FE30                  		move.b	d0,($FFFFFE30).w ; clear lamppost counter
00005CD6 0C78 0004 FFF4             		cmpi.w	#4,($FFFFFFF4).w ; is SLZ demo running?
00005CDC 6600                       		bne.s	EndDemo_Exit	; if not, branch
00005CDE 43F9 0000 0000             		lea	(EndDemo_LampVar).l,a1 ; load lamppost variables
00005CE4 45F8 FE30                  		lea	($FFFFFE30).w,a2
00005CE8 303C 0008                  		move.w	#8,d0
00005CEC                            
