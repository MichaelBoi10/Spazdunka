0000E3F6                            SpeedToPos:
0000E3F6 2428 0008                  		move.l	8(a0),d2
0000E3FA 2628 000C                  		move.l	$C(a0),d3
0000E3FE 3028 0010                  		move.w	$10(a0),d0	; load horizontal speed
0000E402 48C0                       		ext.l	d0
0000E404 E180                       		asl.l	#8,d0		; multiply speed by $100
0000E406 D480                       		add.l	d0,d2		; add to x-axis	position
0000E408 3028 0012                  		move.w	$12(a0),d0	; load vertical	speed
0000E40C 48C0                       		ext.l	d0
0000E40E E180                       		asl.l	#8,d0		; multiply by $100
0000E410 D680                       		add.l	d0,d3		; add to y-axis	position
0000E412 2142 0008                  		move.l	d2,8(a0)	; update x-axis	position
0000E416 2143 000C                  		move.l	d3,y_pos(a0)	; update y-axis	position
0000E41A 4E75                       		rts	
0000E41C                            ; End of function SpeedToPos
