00081A8A                            
00081A8A                            
00081A8A                            ; ------------------------------------------------------------------------------
00081A8A                            ; Plays a given sample
00081A8A                            ; ------------------------------------------------------------------------------
00081A8A                            ; INPUT:
00081A8A                            ;		d0	.b		sample id (>$81)
00081A8A                            ;
00081A8A                            ; EXAMPLES:
00081A8A                            ;		move.b	#$81, d0
00081A8A                            ;		jsr		MegaPCM_PlaySample
00081A8A                            ;
00081A8A                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081A8A                            ;		jsr		MegaPCM_PlaySample
00081A8A                            ; ------------------------------------------------------------------------------
00081A8A                            
00081A8A                            MegaPCM_PlaySample:
00081A8A                            	MPCM_play	d0
00081A8A                          M 	mpcm_stopz80
00081A8A                          M 	pusho
00081A8A                          M 	opt	l-
00081A8A 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081A92                          M 	@wait_11:
00081A92 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081A9A 66F6                     M 	bne.s	@wait_11
00081A9C                          M 	popo
00081A9C 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081AA2                          M 	mpcm_startz80
00081AA2 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081AAA 4E75                       	rts
00081AAC                            
00081AAC                            ; ------------------------------------------------------------------------------
00081AAC                            ; Pauses current sample playback
00081AAC                            ; ------------------------------------------------------------------------------
00081AAC                            
00081AAC                            MegaPCM_PausePlayback:
00081AAC                            	MPCM_pause
00081AAC                          M 	mpcm_stopz80
00081AAC                          M 	pusho
00081AAC                          M 	opt	l-
00081AAC 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081AB4                          M 	@wait_14:
00081AB4 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081ABC 66F6                     M 	bne.s	@wait_14
00081ABE                          M 	popo
00081ABE 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00081AC6                          M 	mpcm_startz80
00081AC6 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081ACE 4E75                       	rts
