000832C2                            
000832C2 =000811AA                  MegaPCM_LoadDriver:	equ	MegaPCMLibraryBlob+$0
000832C2 =00081214                  MegaPCM_LoadSampleTable:	equ	MegaPCMLibraryBlob+$6A
000832C2 =0008145A                  MegaPCM:	equ	MegaPCMLibraryBlob+$2B0
000832C2 =000832C1                  MegaPCM_End:	equ	MegaPCMLibraryBlob+$2117
