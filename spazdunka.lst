000038BC 6600                       		bne.s	LevSel_NoMove	; if not, branch
000038BE 1238 F605                  		move.b	($FFFFF605).w,d1
000038C2 0201 000C                  		andi.b	#$C,d1		; is left/right	pressed?
000038C6 6700                       		beq.s	LevSel_NoMove	; if not, branch
000038C8 3038 FF84                  		move.w	($FFFFFF84).w,d0
000038CC 0801 0002                  		btst	#2,d1		; is left pressed?
000038D0 6700                       		beq.s	LevSel_Right	; if not, branch
000038D2 5340                       		subq.w	#1,d0		; subtract 1 from sound	test
000038D4 6400                       		bcc.s	LevSel_Right
000038D6 704F                       		moveq	#$4F,d0		; if sound test	moves below 0, set to $4F
000038D8                            
000038D8                            LevSel_Right:
