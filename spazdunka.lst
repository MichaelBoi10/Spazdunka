000150F2                            loc_13ADE:
000150F2 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000150F8 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000150FC 6400                       		bcc.s	loc_13AF0	; if yes, branch
000150FE 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
00015104                            
00015104                            loc_13AF0:
00015104 4442                       		neg.w	d2
00015106 0642 0400                  		addi.w	#$400,d2
0001510A 6A00                       		bpl.s	loc_13AFA
