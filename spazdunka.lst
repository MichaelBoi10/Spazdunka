0000DD2E                            
0000DD2E                            Obj36_Solid:				; XREF: Obj36_Index
0000DD2E 6100 0000                  		bsr.w	Obj36_Type0x	; make the object move
0000DD32 343C 0004                  		move.w	#4,d2
0000DD36 0C28 0005 001A             		cmpi.b	#5,mapping_frame(a0)	; is object type $5x ?
0000DD3C 6700                       		beq.s	Obj36_SideWays	; if yes, branch
0000DD3E 0C28 0001 001A             		cmpi.b	#1,mapping_frame(a0)	; is object type $1x ?
0000DD44 6600                       		bne.s	Obj36_Upright	; if not, branch
0000DD46 343C 0014                  		move.w	#$14,d2
0000DD4A                            
0000DD4A                            ; Spikes types $1x and $5x face	sideways
0000DD4A                            
0000DD4A                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DD4A 323C 001B                  		move.w	#$1B,d1
0000DD4E 3602                       		move.w	d2,d3
0000DD50 5243                       		addq.w	#1,d3
0000DD52 3828 0008                  		move.w	8(a0),d4
0000DD56 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DD5A 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DD5E 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DD62 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DD66 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DD6C 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DD6E 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DD70 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DD72 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DD74 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DD76                            ; ===========================================================================
0000DD76                            
0000DD76                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DD76                            
0000DD76                            Obj36_Upright:				; XREF: Obj36_Solid
0000DD76 7200                       		moveq	#0,d1
0000DD78 1228 0019                  		move.b	$19(a0),d1
0000DD7C 0641 000B                  		addi.w	#$B,d1
0000DD80 343C 0010                  		move.w	#$10,d2
0000DD84 363C 0011                  		move.w	#$11,d3
0000DD88 3828 0008                  		move.w	8(a0),d4
0000DD8C 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DD90 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DD96 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DD98 4A44                       		tst.w	d4			; check response value from SolidObject
0000DD9A 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DD9C 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DDA0 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DDA4 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DDAA 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DDAC 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DDAE 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DDB0 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DDB2                            		; otherwise, fall through to Spik_Hurt
0000DDB2                            
0000DDB2                            Obj36_Hurt:				; XREF: Obj36_SideWays; Obj36_Upright
0000DDB2 4A38 FE2D                  		tst.b	($FFFFFE2D).w	; is Sonic invincible?
0000DDB6 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DDB8 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DDBC 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
0000DDBE 2F08                       		move.l	a0,-(sp)
0000DDC0 2448                       		movea.l	a0,a2
0000DDC2 41F8 D000                  		lea	($FFFFD000).w,a0
0000DDC6 0C28 0004 0024             		cmpi.b	#4,routine(a0)
0000DDCC 6400                       		bcc.s	loc_CF20
0000DDCE 2628 000C                  		move.l	$C(a0),d3
0000DDD2 3028 0012                  		move.w	$12(a0),d0
0000DDD6 48C0                       		ext.l	d0
0000DDD8 E180                       		asl.l	#8,d0
0000DDDA 9680                       		sub.l	d0,d3
0000DDDC 2143 000C                  		move.l	d3,y_pos(a0)
0000DDE0 4EB9 0000 0000             		jsr	HurtSonic
