000832C2                            ; ------------------------------------------------------------------------------
000832C2                            ; Mega PCM API Routines
000832C2                            ; ------------------------------------------------------------------------------
000832C2                            
000832C2                            
000832C2                            ; ------------------------------------------------------------------------------
000832C2                            ; Plays a given sample
000832C2                            ; ------------------------------------------------------------------------------
000832C2                            ; INPUT:
000832C2                            ;		d0	.b		sample id (>$81)
000832C2                            ;
000832C2                            ; EXAMPLES:
000832C2                            ;		move.b	#$81, d0
000832C2                            ;		jsr		MegaPCM_PlaySample
000832C2                            ;
000832C2                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
000832C2                            ;		jsr		MegaPCM_PlaySample
000832C2                            ; ------------------------------------------------------------------------------
000832C2                            
000832C2                            MegaPCM_PlaySample:
000832C2                            	MPCM_play	d0
000832C2                          M 	mpcm_stopz80
000832C2                          M 	pusho
000832C2                          M 	opt	l-
000832C2 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
000832CA                          M 	@wait_75:
000832CA 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
000832D2 66F6                     M 	bne.s	@wait_75
000832D4                          M 	popo
000832D4 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
000832DA                          M 	mpcm_startz80
000832DA 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
000832E2 4E75                       	rts
000832E4                            
000832E4                            ; ------------------------------------------------------------------------------
000832E4                            ; Pauses current sample playback
000832E4                            ; ------------------------------------------------------------------------------
000832E4                            
000832E4                            MegaPCM_PausePlayback:
000832E4                            	MPCM_pause
000832E4                          M 	mpcm_stopz80
000832E4                          M 	pusho
000832E4                          M 	opt	l-
000832E4 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
000832EC                          M 	@wait_78:
000832EC 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
000832F4 66F6                     M 	bne.s	@wait_78
000832F6                          M 	popo
000832F6 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
000832FE                          M 	mpcm_startz80
000832FE 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00083306 4E75                       	rts
00083308                            
