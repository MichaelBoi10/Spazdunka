000150C0 5368 003A                  		subq.w	#1,$3A(a0)	; subtract 1 from time delay
000150C4 6600                       		bne.s	locret_13914
000150C6 31FC 0001 FE02             		move.w	#1,($FFFFFE02).w ; restart the level
