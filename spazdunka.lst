0007FDB6                            ; ------------------------------------------------------------------------------
0007FDB6                            ; Exported symbols
0007FDB6                            ; ------------------------------------------------------------------------------
0007FDB6                            
0007FDB6 =0007DC9E                  MegaPCM_LoadDriver:	equ	MegaPCMLibraryBlob+$0
0007FDB6 =0007DD08                  MegaPCM_LoadSampleTable:	equ	MegaPCMLibraryBlob+$6A
0007FDB6 =0007DF4E                  MegaPCM:	equ	MegaPCMLibraryBlob+$2B0
0007FDB6 =0007FDB5                  MegaPCM_End:	equ	MegaPCMLibraryBlob+$2117
0007FDB6                            
0007FDB6                            
0007FDB6                            ; ==============================================================================
0007FDB6                            ; ------------------------------------------------------------------------------
0007FDB6                            ; Mega PCM API Routines
0007FDB6                            ; ------------------------------------------------------------------------------
0007FDB6                            
0007FDB6                            
0007FDB6                            ; ------------------------------------------------------------------------------
0007FDB6                            ; Plays a given sample
0007FDB6                            ; ------------------------------------------------------------------------------
0007FDB6                            ; INPUT:
0007FDB6                            ;		d0	.b		sample id (>$81)
0007FDB6                            ;
0007FDB6                            ; EXAMPLES:
0007FDB6                            ;		move.b	#$81, d0
0007FDB6                            ;		jsr		MegaPCM_PlaySample
0007FDB6                            ;
0007FDB6                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
0007FDB6                            ;		jsr		MegaPCM_PlaySample
0007FDB6                            ; ------------------------------------------------------------------------------
0007FDB6                            
0007FDB6                            MegaPCM_PlaySample:
0007FDB6                            	MPCM_play	d0
0007FDB6                          M 	mpcm_stopz80
0007FDB6                          M 	pusho
0007FDB6                          M 	opt	l-
0007FDB6 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FDBE                          M 	@wait_17:
0007FDBE 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FDC6 66F6                     M 	bne.s	@wait_17
0007FDC8                          M 	popo
0007FDC8 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0007FDCE                          M 	mpcm_startz80
0007FDCE 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FDD6 4E75                       	rts
0007FDD8                            
0007FDD8                            ; ------------------------------------------------------------------------------
0007FDD8                            ; Pauses current sample playback
0007FDD8                            ; ------------------------------------------------------------------------------
0007FDD8                            
0007FDD8                            MegaPCM_PausePlayback:
0007FDD8                            	MPCM_pause
0007FDD8                          M 	mpcm_stopz80
0007FDD8                          M 	pusho
0007FDD8                          M 	opt	l-
0007FDD8 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FDE0                          M 	@wait_20:
0007FDE0 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FDE8 66F6                     M 	bne.s	@wait_20
0007FDEA                          M 	popo
0007FDEA 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
0007FDF2                          M 	mpcm_startz80
0007FDF2 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FDFA 4E75                       	rts
0007FDFC                            
0007FDFC                            ; ------------------------------------------------------------------------------
0007FDFC                            ; Unpauses playback
0007FDFC                            ; ------------------------------------------------------------------------------
0007FDFC                            
0007FDFC                            MegaPCM_UnpausePlayback:
0007FDFC                            	MPCM_unpause
0007FDFC                          M 	mpcm_stopz80
0007FDFC                          M 	pusho
0007FDFC                          M 	opt	l-
0007FDFC 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FE04                          M 	@wait_23:
0007FE04 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FE0C 66F6                     M 	bne.s	@wait_23
0007FE0E                          M 	popo
0007FE0E 13FC 0000 00A0 0001      M 	move.b	#0,mpcm_z80_ram+z_mpcm_commandinput
0007FE16                          M 	mpcm_startz80
0007FE16 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FE1E 4E75                       	rts
0007FE20                            
0007FE20                            ; ------------------------------------------------------------------------------
0007FE20                            ; Stops all playback
0007FE20                            ; ------------------------------------------------------------------------------
0007FE20                            
0007FE20                            MegaPCM_StopPlayback:
0007FE20                            	MPCM_stop
0007FE20                          M 	mpcm_stopz80
0007FE20                          M 	pusho
0007FE20                          M 	opt	l-
0007FE20 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FE28                          M 	@wait_26:
0007FE28 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FE30 66F6                     M 	bne.s	@wait_26
0007FE32                          M 	popo
0007FE32 13FC 0001 00A0 0001      M 	move.b	#z_mpcm_command_stop,mpcm_z80_ram+z_mpcm_commandinput
0007FE3A                          M 	mpcm_startz80
0007FE3A 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FE42 4E75                       	rts
