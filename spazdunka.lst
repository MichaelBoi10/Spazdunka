0008314A 66F6                     M 	bne.s	@wait_47
0008314C                          M 	popo
0008314C 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00083154                          M 	mpcm_startz80
00083154 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0008315C 4E75                       	rts
