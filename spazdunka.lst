0000E34E 2628 000C                  		move.l	$C(a0),d3
0000E352 3028 0010                  		move.w	$10(a0),d0
0000E356 48C0                       		ext.l	d0
0000E358 E180                       		asl.l	#8,d0
0000E35A D480                       		add.l	d0,d2
0000E35C 3028 0012                  		move.w	$12(a0),d0
0000E360 0668 0038 0012             		addi.w	#$38,y_vel(a0)	; increase vertical speed
0000E366 48C0                       		ext.l	d0
0000E368 E180                       		asl.l	#8,d0
0000E36A D680                       		add.l	d0,d3
0000E36C 2142 0008                  		move.l	d2,8(a0)
0000E370 2143 000C                  		move.l	d3,y_pos(a0)
0000E374 4E75                       		rts	
