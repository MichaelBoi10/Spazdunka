00013E22                            Sonic_PanCamera:
00013E22 3238 F7A0                          move.w    ($FFFFF7A0).w,d1        ; get the current camera pan value
00013E26 3028 0014                          move.w    $14(a0),d0        ; get sonic's inertia
00013E2A 6A00                               bpl.s    Sonic_PanCamera_abs_inertia            ; if sonic's inertia is positive, branch ahead
00013E2C 4440                               neg.w    d0                        ; otherwise, we negate it to get the absolute value
00013E2E                            
00013E2E                            Sonic_PanCamera_abs_inertia:
00013E2E                            
00013E2E                            ; These lines were intended to prevent the Camera from panning while
00013E2E                            ; going up the very first giant ramp in Palmtree Panic Zone Act 1.
00013E2E                            ; However, given that no such object exists in Sonic 1, I just went
00013E2E                            ; ahead and commented these out.
00013E2E                            ;        btst    #1,$2C(a0)                ; is sonic going up a giant ramp in PPZ?
00013E2E                            ;        beq.s    Sonic_PanCamera_skip                    ; if not, branch
00013E2E                            ;        cmpi.w    #$1B00,($FFFFD008).w            ; is sonic's x position lower than $1B00?
00013E2E                            ;        bcs.s    Sonic_PanCamera_reset_pan                ; if so, branch
00013E2E                            
00013E2E                            ; These lines aren't part of the original routine; I added them myself.
00013E2E                            ; If you've ported the Spin Dash, uncomment the following lines of code
00013E2E                            ; to allow the camera to pan ahead while charging the Spin Dash:
00013E2E 4A28 0039                          tst.b    $39(a0)                    ; is sonic charging up a spin dash?
00013E32 6700                               beq.s    Sonic_PanCamera_skip                    ; if not, branch
00013E34 0828 0000 0022                     btst    #0,$22(a0)            ; check the direction that sonic is facing
00013E3A 6600                               bne.s    Sonic_PanCamera_pan_right                ; if he's facing right, pan the camera to the right
00013E3C 6000                               bra.s    Sonic_PanCamera_pan_left                ; otherwise, pan the camera to the left
00013E3E                            
00013E3E                            Sonic_PanCamera_skip:
00013E3E 0C40 0600                          cmpi.w    #$600,d0                ; is sonic's inertia greater than $600
00013E42 6500                               bcs.s    Sonic_PanCamera_reset_pan                ; if not, recenter the screen (if needed)
00013E44 4A68 0014                          tst.w    $14(a0)            ; otherwise, check the direction of inertia (by subtracting it from 0)
00013E48 6A00                               bpl.s    Sonic_PanCamera_pan_left                ; if the result was positive, then inertia was negative, so we pan the screen left
00013E4A                            
00013E4A                            Sonic_PanCamera_pan_right:
00013E4A 5441                               addq.w    #2,d1                    ; add 2 to the pan value
00013E4C 0C41 00E0                          cmpi.w    #224,d1                    ; is the pan value greater than 224 pixels?
00013E50 6500                               bcs.s    Sonic_PanCamera_update_pan                ; if not, branch
00013E52 323C 00E0                          move.w    #224,d1                    ; otherwise, cap the value at the maximum of 224 pixels
00013E56 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00013E58                            ; ---------------------------------------------------------------------------
00013E58                            
00013E58                            Sonic_PanCamera_pan_left:
00013E58 5541                               subq.w    #2,d1                    ; subtract 2 from the pan value
00013E5A 0C41 0060                          cmpi.w    #96,d1                    ; is the pan value less than 96 pixels?
00013E5E 6400                               bcc.s    Sonic_PanCamera_update_pan                ; if not, branch
00013E60 323C 0060                          move.w    #96,d1                    ; otherwise, cap the value at the minimum of 96 pixels
00013E64 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00013E66                            ; ---------------------------------------------------------------------------
00013E66                            
00013E66                            Sonic_PanCamera_reset_pan:
00013E66 0C41 00A0                          cmpi.w    #160,d1                    ; is the pan value 160 pixels?
00013E6A 6700                               beq.s    Sonic_PanCamera_update_pan                ; if so, branch
00013E6C 6400                               bcc.s    Sonic_PanCamera_reset_left                ; otherwise, branch if it greater than 160
00013E6E                                 
00013E6E                            Sonic_PanCamera_reset_right:
00013E6E 5441                               addq.w    #2,d1                    ; add 2 to the pan value
00013E70 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00013E72                            ; ---------------------------------------------------------------------------
00013E72                            
00013E72                            Sonic_PanCamera_reset_left:
00013E72 5541                               subq.w    #2,d1                    ; subtract 2 from the pan value
00013E74                            
00013E74                            Sonic_PanCamera_update_pan:
00013E74 31C1 F7A0                          move.w    d1,($FFFFF7A0).w        ; update the camera pan value
00013E78 4E75                               rts                                ; return
00013E7A                                 
00013E7A                            ; End of function Sonic_PanCamera
00013E7A                            ; ===========================================================================
