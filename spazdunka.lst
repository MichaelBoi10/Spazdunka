00015074 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00015078 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
0001507C 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
0001507E                            
0001507E                            SAnim_Next:
0001507E 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00015082 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00015086                            
00015086                            SAnim_Delay:
00015086 4E75                       		rts	
00015088                            ; ===========================================================================
00015088                            
00015088                            SAnim_End_FF:
