00007866 245F                       		movea.l	(sp)+,a2
00007868 584A                       		addq.w	#4,a2
0000786A 7000                       		moveq	#0,d0
0000786C 1012                       		move.b	(a2),d0
0000786E 6700                       		beq.s	locret_6D10
00007870 6100 99CA                  		bsr.w	LoadPLC		; load pattern load cues
