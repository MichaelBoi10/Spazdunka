001EC38A                            SampleDebugger:
001EC38A                            	Console.WriteLine "%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
001EC38A 40E7                     M 	move.w	sr,-(sp)
001EC38C                          M 	_console.writeline	<"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>">,<>
001EC38C                          M 	__fstring_generateargumentscode	"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
001EC38C =00000001                M 	__pos:	= instr("%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'%<')
001EC38C =00000000                M 	__stack:=	0
001EC38C =00000000                M 	__sp:	= 0
001EC38C                          M 	pusho
001EC38C                          M 	opt	ae-
001EC38C                          M 	while	(__pos)
001EC38C =00000007                M 	__endpos:	= instr(__pos+1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'>')
001EC38C =0000000E                M 	__midpos:	= instr(__pos+5,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",' ')
001EC38C =00000007                M 	__midpos:	= __endpos
001EC38C                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
001EC38C                          M 	__type:	substr __pos+1+1,__pos+1+1+1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
001EC38C =00000015                M 	__pos:	= instr(__pos+1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'%<')
001EC38C =0000001B                M 	__endpos:	= instr(__pos+1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'>')
001EC38C =00000020                M 	__midpos:	= instr(__pos+5,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",' ')
001EC38C =0000001B                M 	__midpos:	= __endpos
001EC38C                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
