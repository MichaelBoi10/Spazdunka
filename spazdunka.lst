0001CE8C                            ; ---------------------------------------------------------------------------
0001CE8C                            ; Hurting Sonic	subroutine
0001CE8C                            ; ---------------------------------------------------------------------------
0001CE8C                            
0001CE8C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001CE8C                            
0001CE8C                            
0001CE8C                            HurtSonic:
0001CE8C 4A38 FE2C                  		tst.b	($FFFFFE2C).w	; does Sonic have a shield?
0001CE90 6600                       		bne.s	Hurt_Shield	; if yes, branch
0001CE92 4A78 FE20                  		tst.w	($FFFFFE20).w	; does Sonic have any rings?
0001CE96 6700 0000                  		beq.w	Hurt_NoRings	; if not, branch
0001CE9A 4EB9 0000 E9F2             		jsr	SingleObjLoad
0001CEA0 6600                       		bne.s	Hurt_Shield
0001CEA2 12BC 0037                  		move.b	#$37,0(a1)	; load bouncing	multi rings object
0001CEA6 3368 0008 0008             		move.w	8(a0),8(a1)
0001CEAC 3368 000C 000C             		move.w	$C(a0),$C(a1)
0001CEB2                            
0001CEB2                            Hurt_Shield:
0001CEB2 11FC 0000 FE2C             		move.b	#0,($FFFFFE2C).w ; remove shield
0001CEB8 117C 0004 0024             		move.b	#4,$24(a0)
0001CEBE 6100 81A4                  		bsr.w	Sonic_ResetOnFloor
0001CEC2 08E8 0001 0022             		bset	#1,$22(a0)
0001CEC8 317C FC00 0012             		move.w	#-$400,$12(a0)	; make Sonic bounce away from the object
0001CECE 317C FE00 0010             		move.w	#-$200,$10(a0)
0001CED4 0828 0006 0022             		btst	#6,$22(a0)
0001CEDA 6700                       		beq.s	Hurt_Reverse
0001CEDC 317C FE00 0012             		move.w	#-$200,$12(a0)
0001CEE2 317C FF00 0010             		move.w	#-$100,$10(a0)
0001CEE8                            
0001CEE8                            Hurt_Reverse:
0001CEE8 3028 0008                  		move.w	8(a0),d0
0001CEEC B06A 0008                  		cmp.w	8(a2),d0
0001CEF0 6500                       		bcs.s	Hurt_ChkSpikes	; if Sonic is left of the object, branch
0001CEF2 4468 0010                  		neg.w	$10(a0)		; if Sonic is right of the object, reverse
0001CEF6                            
0001CEF6                            Hurt_ChkSpikes:
0001CEF6 117C 0000 0039             		move.b	#0,$39(a0)	; clear spindash flag
0001CEFC 317C 0000 0014             		move.w	#0,$14(a0)
0001CF02 117C 001A 001C             		move.b	#$1A,$1C(a0)
0001CF08 317C 0078 0030             		move.w	#$78,$30(a0)
0001CF0E 303C 00A3                  		move.w	#$A3,d0		; load normal damage sound
0001CF12 0C12 0036                  		cmpi.b	#$36,(a2)	; was damage caused by spikes?
0001CF16 6600                       		bne.s	Hurt_Sound	; if not, branch
0001CF18 0C12 0016                  		cmpi.b	#$16,(a2)	; was damage caused by LZ harpoon?
0001CF1C 6600                       		bne.s	Hurt_Sound	; if not, branch
0001CF1E 303C 00A6                  		move.w	#$A6,d0		; load spikes damage sound
0001CF22                            
0001CF22                            Hurt_Sound:
0001CF22 4EB9 0000 0FC8             		jsr	(PlaySound_Special).l
0001CF28 70FF                       		moveq	#-1,d0
0001CF2A 4E75                       		rts	
0001CF2C                            ; ===========================================================================
0001CF2C                            
0001CF2C                            Hurt_NoRings:
0001CF2C 4A78 FFFA                  		tst.w	($FFFFFFFA).w	; is debug mode	cheat on?
0001CF30 6600 FF80                  		bne.w	Hurt_Shield	; if yes, branch
0001CF34                            ; End of function HurtSonic
0001CF34                            
0001CF34                            ; ---------------------------------------------------------------------------
0001CF34                            ; Subroutine to	kill Sonic
0001CF34                            ; ---------------------------------------------------------------------------
0001CF34                            
0001CF34                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001CF34                            
0001CF34                            
0001CF34                            KillSonic:
0001CF34 4A78 FE08                  		tst.w	($FFFFFE08).w	; is debug mode	active?
0001CF38 6600                       		bne.s	Kill_NoDeath	; if yes, branch
0001CF3A 11FC 0000 FE2D             		move.b	#0,($FFFFFE2D).w ; remove invincibility
0001CF40 117C 0006 0024             		move.b	#6,routine(a0)
0001CF46 6100 811C                  		bsr.w	Sonic_ResetOnFloor
0001CF4A 08E8 0001 0022             		bset	#1,status(a0)
0001CF50 317C F900 0012             		move.w	#-$700,y_vel(a0)
0001CF56 317C 0050 0010             		move.w	#$50,x_vel(a0)
0001CF5C 317C 0000 0014             		move.w	#0,$14(a0)
0001CF62 3168 000C 0038             		move.w	$C(a0),$38(a0)
0001CF68 117C 0018 001C             		move.b	#$18,anim(a0)
0001CF6E 08E8 0007 0002             		bset	#7,art_tile(a0)
0001CF74 303C 00A3                  		move.w	#$A3,d0		; play normal death sound
0001CF78 0C12 0036                  		cmpi.b	#$36,(a2)	; check	if you were killed by spikes
0001CF7C 6600                       		bne.s	Kill_Sound
0001CF7E 303C 00A6                  		move.w	#$A6,d0		; play spikes death sound
0001CF82                            
0001CF82                            Kill_Sound:
0001CF82 4EB9 0000 0FC8             		jsr	(PlaySound_Special).l
0001CF88                            
0001CF88                            Kill_NoDeath:
0001CF88 70FF                       		moveq	#-1,d0
0001CF8A 4E75                       		rts	
0001CF8C                            ; End of function KillSonic
