00015310                            SAnim_WalkRun:				; XREF: SAnim_Do
00015310 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015314 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015316 5200                       		addq.b	#1,d0		; is animation walking/running?
00015318 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
0001531C 7200                       		moveq	#0,d1
0001531E 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015322 1428 0022                  		move.b	$22(a0),d2
00015326 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
0001532A 6600                       		bne.s	loc_13A70	; if yes, branch
0001532C 4600                       		not.b	d0		; reverse angle
0001532E                            
0001532E                            loc_13A70:
0001532E 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015332 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015334 7203                       		moveq	#3,d1
00015336                            
00015336                            loc_13A78:
00015336 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001533C B302                       		eor.b	d1,d2
0001533E 8528 0001                  		or.b	d2,1(a0)
00015342 0828 0005 0022             		btst	#5,$22(a0)
00015348 6600 0000                  		bne.w	SAnim_Push
0001534C E808                       		lsr.b	#4,d0		; divide angle by $10
0001534E 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015352 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015356 6A00                       		bpl.s	loc_13A9C
00015358 4442                       		neg.w	d2
0001535A                            
0001535A                            loc_13A9C:
0001535A 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
0001535E 6700                       		beq.s	Loc_NotSuper
00015360 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
00015366 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
0001536A 6400                       		bhs.s	SuperRun	; if yes, branch
0001536C 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
00015372 6000                       		bra.s	SuperWalk
00015374                            
00015374                            Loc_NotSuper:
