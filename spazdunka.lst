0001517C                            Sonic_Animate:				; XREF: Obj01_Control; et al
0001517C 43F9 0000 0000             		lea	(SonicAniData).l,a1
00015182 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015186 6700                       		beq.s	SAnim_NotSuper
00015188 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
0001518E                            
0001518E                            SAnim_NotSuper:		
0001518E 7000                       		moveq	#0,d0
00015190 1028 001C                  		move.b	$1C(a0),d0
00015194 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00015198 6700                       		beq.s	SAnim_Do	; if not, branch
0001519A 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
0001519E 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000151A4 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000151AA                            
000151AA                            SAnim_Do:
000151AA D040                       		add.w	d0,d0
000151AC D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000151B0 1011                       		move.b	(a1),d0
000151B2 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000151B4 1228 0022                  		move.b	$22(a0),d1
000151B8 0201 0001                  		andi.b	#1,d1
000151BC 0228 00FC 0001             		andi.b	#$FC,1(a0)
000151C2 8328 0001                  		or.b	d1,1(a0)
000151C6 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000151CA 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000151CC 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000151D0                            
000151D0                            SAnim_Do2:
000151D0 7200                       		moveq	#0,d1
000151D2 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000151D6 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000151DA 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000151DE 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
000151E0                            
000151E0                            SAnim_Next:
000151E0 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000151E4 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000151E8                            
000151E8                            SAnim_Delay:
000151E8 4E75                       		rts	
000151EA                            ; ===========================================================================
000151EA                            
000151EA                            SAnim_End_FF:
000151EA 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000151EC 6600                       		bne.s	SAnim_End_FE	; if not, branch
000151EE 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
000151F4 1029 0001                  		move.b	1(a1),d0	; read sprite number
000151F8 60E6                       		bra.s	SAnim_Next
000151FA                            ; ===========================================================================
000151FA                            
000151FA                            SAnim_End_FE:
000151FA 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
000151FC 6600                       		bne.s	SAnim_End_FD	; if not, branch
000151FE 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015202 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015206 9200                       		sub.b	d0,d1
00015208 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0001520C 60D2                       		bra.s	SAnim_Next
0001520E                            ; ===========================================================================
0001520E                            
0001520E                            SAnim_End_FD:
0001520E 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015210 6600                       		bne.s	SAnim_End	; if not, branch
00015212 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015218                            
00015218                            SAnim_End:
00015218 4E75                       		rts	
0001521A                            ; ===========================================================================
0001521A                            
0001521A                            SAnim_WalkRun:				; XREF: SAnim_Do
0001521A 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
0001521E 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015220 5200                       		addq.b	#1,d0		; is animation walking/running?
00015222 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015226 7200                       		moveq	#0,d1
00015228 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
0001522C 1428 0022                  		move.b	$22(a0),d2
00015230 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015234 6600                       		bne.s	loc_13A70	; if yes, branch
00015236 4600                       		not.b	d0		; reverse angle
00015238                            
00015238                            loc_13A70:
00015238 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
0001523C 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001523E 7203                       		moveq	#3,d1
00015240                            
00015240                            loc_13A78:
00015240 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015246 B302                       		eor.b	d1,d2
00015248 8528 0001                  		or.b	d2,1(a0)
0001524C 0828 0005 0022             		btst	#5,$22(a0)
00015252 6600 0000                  		bne.w	SAnim_Push
00015256 E808                       		lsr.b	#4,d0		; divide angle by $10
00015258 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
0001525C 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015260 6A00                       		bpl.s	loc_13A9C
00015262 4442                       		neg.w	d2
00015264                            
00015264                            loc_13A9C:
00015264 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015268 6700                       		beq.s	Loc_NotSuper
0001526A 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
00015270 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015274 6400                       		bhs.s	SuperRun	; if yes, branch
00015276 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
0001527C 6000                       		bra.s	SuperWalk
0001527E                            
0001527E                            Loc_NotSuper:
0001527E 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00015284 11FC 0006 D1E4             		move.b	#6,($FFFFD1E4).w	; set the spin dash dust routine to skid dust
0001528A 11FC 0015 D1DA                     move.b	#$15,($FFFFD1DA).w
00015290 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015294 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015296 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
0001529C 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000152A0 6400                       		bhs.s	loc_13AB4	; if yes, branch
000152A2 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000152A8                            
000152A8                            SuperWalk:
000152A8 1200                       		move.b	d0,d1
000152AA E209                       		lsr.b	#1,d1
000152AC D001                       		add.b	d1,d0
000152AE                            
000152AE                            loc_13AB4:
000152AE D000                       		add.b	d0,d0
000152B0                            
000152B0                            SuperRun:
000152B0 1600                       		move.b	d0,d3
000152B2 4442                       		neg.w	d2
000152B4 0642 0800                  		addi.w	#$800,d2
000152B8 6A00                       		bpl.s	loc_13AC2
000152BA 7400                       		moveq	#0,d2
000152BC                            
000152BC                            loc_13AC2:
000152BC E04A                       		lsr.w	#8,d2
000152BE 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000152C2 6100 FF0C                  		bsr.w	SAnim_Do2
000152C6 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000152CA 4E75                       		rts	
000152CC                            ; ===========================================================================
000152CC                            
000152CC                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000152CC 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000152CE 6600                       		bne.s	SAnim_Push	; if not, branch
000152D0 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000152D4 6A00                       		bpl.s	loc_13ADE
000152D6 4442                       		neg.w	d2
000152D8                            
000152D8                            loc_13ADE:
000152D8 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
