0001526C                            ; Subroutine to	animate	Sonic's sprites
0001526C                            ; ---------------------------------------------------------------------------
0001526C                            
0001526C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001526C                            
0001526C                            
0001526C                            Sonic_Animate:				; XREF: Obj01_Control; et al
0001526C 43F9 0000 0000             		lea	(SonicAniData).l,a1
00015272 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015276 6700                       		beq.s	SAnim_NotSuper
00015278 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
0001527E                            
0001527E                            SAnim_NotSuper:		
0001527E 7000                       		moveq	#0,d0
00015280 1028 001C                  		move.b	$1C(a0),d0
00015284 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00015288 6700                       		beq.s	SAnim_Do	; if not, branch
0001528A 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
0001528E 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00015294 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
0001529A                            
0001529A                            SAnim_Do:
0001529A D040                       		add.w	d0,d0
0001529C D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000152A0 1011                       		move.b	(a1),d0
000152A2 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000152A4 1228 0022                  		move.b	$22(a0),d1
000152A8 0201 0001                  		andi.b	#1,d1
000152AC 0228 00FC 0001             		andi.b	#$FC,1(a0)
000152B2 8328 0001                  		or.b	d1,1(a0)
000152B6 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000152BA 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000152BC 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000152C0                            
000152C0                            SAnim_Do2:
000152C0 7200                       		moveq	#0,d1
000152C2 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000152C6 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000152CA 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000152CE 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
000152D0                            
000152D0                            SAnim_Next:
000152D0 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000152D4 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000152D8                            
000152D8                            SAnim_Delay:
000152D8 4E75                       		rts	
000152DA                            ; ===========================================================================
000152DA                            
000152DA                            SAnim_End_FF:
000152DA 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000152DC 6600                       		bne.s	SAnim_End_FE	; if not, branch
000152DE 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
000152E4 1029 0001                  		move.b	1(a1),d0	; read sprite number
000152E8 60E6                       		bra.s	SAnim_Next
000152EA                            ; ===========================================================================
000152EA                            
000152EA                            SAnim_End_FE:
000152EA 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
000152EC 6600                       		bne.s	SAnim_End_FD	; if not, branch
000152EE 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
000152F2 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
000152F6 9200                       		sub.b	d0,d1
000152F8 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
000152FC 60D2                       		bra.s	SAnim_Next
000152FE                            ; ===========================================================================
000152FE                            
000152FE                            SAnim_End_FD:
000152FE 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015300 6600                       		bne.s	SAnim_End	; if not, branch
00015302 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015308                            
00015308                            SAnim_End:
00015308 4E75                       		rts	
0001530A                            ; ===========================================================================
0001530A                            
0001530A                            SAnim_WalkRun:				; XREF: SAnim_Do
0001530A 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
0001530E 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015310 5200                       		addq.b	#1,d0		; is animation walking/running?
00015312 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015316 7200                       		moveq	#0,d1
00015318 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
0001531C 1428 0022                  		move.b	$22(a0),d2
00015320 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015324 6600                       		bne.s	loc_13A70	; if yes, branch
00015326 4600                       		not.b	d0		; reverse angle
00015328                            
00015328                            loc_13A70:
00015328 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
0001532C 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001532E 7203                       		moveq	#3,d1
00015330                            
00015330                            loc_13A78:
00015330 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015336 B302                       		eor.b	d1,d2
00015338 8528 0001                  		or.b	d2,1(a0)
0001533C 0828 0005 0022             		btst	#5,$22(a0)
00015342 6600 0000                  		bne.w	SAnim_Push
00015346 E808                       		lsr.b	#4,d0		; divide angle by $10
00015348 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
0001534C 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015350 6A00                       		bpl.s	loc_13A9C
00015352 4442                       		neg.w	d2
00015354                            
00015354                            loc_13A9C:
00015354 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015358 6700                       		beq.s	Loc_NotSuper
0001535A 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
00015360 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015364 6400                       		bhs.s	SuperRun	; if yes, branch
00015366 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
0001536C 6000                       		bra.s	SuperWalk
0001536E                            
0001536E                            Loc_NotSuper:
0001536E 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00015374 0C42 0B00                  		cmpi.w	#$B00,d2	; is Sonic at running speed?
00015378 6400                       		bhs.s	loc_13AB4	; if yes, branch
0001537A 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
00015380 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00015384 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015386 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
0001538C                            
0001538C                            SuperWalk:
0001538C 1200                       		move.b	d0,d1
0001538E E209                       		lsr.b	#1,d1
00015390 D001                       		add.b	d1,d0
00015392                            
00015392                            loc_13AB4:
00015392 D000                       		add.b	d0,d0
00015394                            
00015394                            SuperRun:
00015394 1600                       		move.b	d0,d3
00015396 4442                       		neg.w	d2
00015398 0642 0800                  		addi.w	#$800,d2
0001539C 6A00                       		bpl.s	loc_13AC2
0001539E 7400                       		moveq	#0,d2
000153A0                            
000153A0                            loc_13AC2:
000153A0 E04A                       		lsr.w	#8,d2
000153A2 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000153A6 6100 FF18                  		bsr.w	SAnim_Do2
000153AA D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000153AE 4E75                       		rts	
000153B0                            ; ===========================================================================
000153B0                            
000153B0                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000153B0 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000153B2 6600                       		bne.s	SAnim_Push	; if not, branch
000153B4 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000153B8 6A00                       		bpl.s	loc_13ADE
000153BA 4442                       		neg.w	d2
000153BC                            
000153BC                            loc_13ADE:
000153BC 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000153C2 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000153C6 6400                       		bcc.s	loc_13AF0	; if yes, branch
000153C8 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000153CE                            
000153CE                            loc_13AF0:
000153CE 4442                       		neg.w	d2
000153D0 0642 0400                  		addi.w	#$400,d2
000153D4 6A00                       		bpl.s	loc_13AFA
000153D6 7400                       		moveq	#0,d2
000153D8                            
000153D8                            loc_13AFA:
000153D8 E04A                       		lsr.w	#8,d2
000153DA 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000153DE 1228 0022                  		move.b	$22(a0),d1
000153E2 0201 0001                  		andi.b	#1,d1
000153E6 0228 00FC 0001             		andi.b	#$FC,1(a0)
000153EC 8328 0001                  		or.b	d1,1(a0)
000153F0 6000 FECE                  		bra.w	SAnim_Do2
000153F4                            ; ===========================================================================
000153F4                            
000153F4                            SAnim_Push:				; XREF: SAnim_RollJump
000153F4 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000153F8 6B00                       		bmi.s	loc_13B1E
000153FA 4442                       		neg.w	d2
000153FC                            
000153FC                            loc_13B1E:
000153FC 0642 0800                  		addi.w	#$800,d2
00015400 6A00                       		bpl.s	loc_13B26
00015402 7400                       		moveq	#0,d2
00015404                            
00015404                            loc_13B26:
00015404 EC4A                       		lsr.w	#6,d2
00015406 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001540A 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00015410 1228 0022                  		move.b	$22(a0),d1
00015414 0201 0001                  		andi.b	#1,d1
00015418 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001541E 8328 0001                  		or.b	d1,1(a0)
00015422 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015426 6700                       		beq.s	Loc_NotSuper2
00015428 43F9 0000 0000             		lea	(SupSonAni_Push).l,a1 ; use	running	animation
0001542E                            
0001542E                            Loc_NotSuper2:
