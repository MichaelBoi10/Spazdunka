00001C78 6100                       		bsr.s	Pal_FadeIn
00001C7A 5504                       		subq.b	#$02,d4					; MJ: decrease colour check
00001C7C 66E6                       		bne.s	loc_1DCE				; MJ: if it has not reached null, branch
00001C7E 11FC 0012 F62A             		move.b	#$12,($FFFFF62A).w			; MJ: wait for V-blank again (so colours transfer)
