000140B6 31FC 000C F762             		move.w	#$C,($FFFFF762).w ; restore Sonic's acceleration
000140BC 31FC 0080 F764             		move.w	#$80,($FFFFF764).w ; restore Sonic's deceleration
000140C2 11FC 0000 FE2E             		move.b	#0,($FFFFFE2E).w ; cancel speed	shoes
000140C8 303C 00E3                  		move.w	#$E3,d0
