000152E2 6600                       		bne.s	SAnim_End_FE	; if not, branch
000152E4 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
000152EA 1029 0001                  		move.b	1(a1),d0	; read sprite number
000152EE 60E6                       		bra.s	SAnim_Next
000152F0                            ; ===========================================================================
000152F0                            
000152F0                            SAnim_End_FE:
000152F0 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
000152F2 6600                       		bne.s	SAnim_End_FD	; if not, branch
000152F4 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
000152F8 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
000152FC 9200                       		sub.b	d0,d1
000152FE 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015302 60D2                       		bra.s	SAnim_Next
00015304                            ; ===========================================================================
00015304                            
00015304                            SAnim_End_FD:
00015304 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015306 6600                       		bne.s	SAnim_End	; if not, branch
00015308 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
0001530E                            
0001530E                            SAnim_End:
