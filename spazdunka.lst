00001CCA                            Pal_AddColor:				; XREF: Pal_FadeIn
00001CCA 1A11                       		move.b	(a1),d5					; MJ: load blue
00001CCC 3219                       		move.w	(a1)+,d1				; MJ: load green and red
00001CCE 1401                       		move.b	d1,d2					; MJ: load red
00001CD0 E809                       		lsr.b	#$04,d1					; MJ: get only green
00001CD2 0202 000E                  		andi.b	#$0E,d2					; MJ: get only red
00001CD6 3610                       		move.w	(a0),d3					; MJ: load current colour in buffer
00001CD8 B805                       		cmp.b	d5,d4					; MJ: is it time for blue to fade?
00001CDA 6200                       		bhi.s	FCI_NoBlue				; MJ: if not, branch
00001CDC 0643 0200                  		addi.w	#$0200,d3				; MJ: increase blue
00001CE0                            
00001CE0                            FCI_NoBlue:
00001CE0 B801                       		cmp.b	d1,d4					; MJ: is it time for green to fade?
00001CE2 6200                       		bhi.s	FCI_NoGreen				; MJ: if not, branch
