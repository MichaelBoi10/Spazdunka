00013FFA                            		
00013FFA                            ; ---------------------------------------------------------------------------
00013FFA                            ; Subroutine to    horizontally pan the camera view ahead of the player
00013FFA                            ; (Ported from the US version of Sonic CD's "R11A__.MMD" by Nat The Porcupine, ported to Hivebrain disasm by DelayHacks)
00013FFA                            ; ---------------------------------------------------------------------------
00013FFA                            
00013FFA                            ; ||||||||||||||| S U B    R O U T    I N E |||||||||||||||||||||||||||||||||||||||
00013FFA                            
00013FFA                            Sonic_PanCamera:
00013FFA 3238 F7A0                          move.w    ($FFFFF7A0).w,d1        ; get the current camera pan value
00013FFE 3028 0014                          move.w    $14(a0),d0        ; get sonic's inertia
00014002 6A00                               bpl.s    Sonic_PanCamera_abs_inertia            ; if sonic's inertia is positive, branch ahead
00014004 4440                               neg.w    d0                        ; otherwise, we negate it to get the absolute value
00014006                            
00014006                            Sonic_PanCamera_abs_inertia:
00014006                            
00014006                            ; These lines were intended to prevent the Camera from panning while
00014006                            ; going up the very first giant ramp in Palmtree Panic Zone Act 1.
00014006                            ; However, given that no such object exists in Sonic 1, I just went
00014006                            ; ahead and commented these out.
00014006                            ;        btst    #1,$2C(a0)                ; is sonic going up a giant ramp in PPZ?
00014006                            ;        beq.s    Sonic_PanCamera_skip                    ; if not, branch
00014006                            ;        cmpi.w    #$1B00,($FFFFD008).w            ; is sonic's x position lower than $1B00?
00014006                            ;        bcs.s    Sonic_PanCamera_reset_pan                ; if so, branch
00014006                            
00014006                            ; These lines aren't part of the original routine; I added them myself.
00014006                            ; If you've ported the Spin Dash, uncomment the following lines of code
00014006                            ; to allow the camera to pan ahead while charging the Spin Dash:
00014006 4A28 0039                          tst.b    $39(a0)                    ; is sonic charging up a spin dash?
0001400A 6700                               beq.s    Sonic_PanCamera_skip                    ; if not, branch
0001400C 0828 0000 0022                     btst    #0,$22(a0)            ; check the direction that sonic is facing
00014012 6600                               bne.s    Sonic_PanCamera_pan_right                ; if he's facing right, pan the camera to the right
00014014 6000                               bra.s    Sonic_PanCamera_pan_left                ; otherwise, pan the camera to the left
00014016                            
00014016                            Sonic_PanCamera_skip:
00014016 0C40 0600                          cmpi.w    #$600,d0                ; is sonic's inertia greater than $600
0001401A 6500                               bcs.s    Sonic_PanCamera_reset_pan                ; if not, recenter the screen (if needed)
0001401C 4A68 0014                          tst.w    $14(a0)            ; otherwise, check the direction of inertia (by subtracting it from 0)
00014020 6A00                               bpl.s    Sonic_PanCamera_pan_left                ; if the result was positive, then inertia was negative, so we pan the screen left
00014022                            
00014022                            Sonic_PanCamera_pan_right:
00014022 5441                               addq.w    #2,d1                    ; add 2 to the pan value
00014024 0C41 00E0                          cmpi.w    #224,d1                    ; is the pan value greater than 224 pixels?
00014028 6500                               bcs.s    Sonic_PanCamera_update_pan                ; if not, branch
0001402A 323C 00E0                          move.w    #224,d1                    ; otherwise, cap the value at the maximum of 224 pixels
0001402E 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00014030                            ; ---------------------------------------------------------------------------
00014030                            
00014030                            Sonic_PanCamera_pan_left:
00014030 5541                               subq.w    #2,d1                    ; subtract 2 from the pan value
00014032 0C41 0060                          cmpi.w    #96,d1                    ; is the pan value less than 96 pixels?
00014036 6400                               bcc.s    Sonic_PanCamera_update_pan                ; if not, branch
00014038 323C 0060                          move.w    #96,d1                    ; otherwise, cap the value at the minimum of 96 pixels
0001403C 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
0001403E                            ; ---------------------------------------------------------------------------
0001403E                            
0001403E                            Sonic_PanCamera_reset_pan:
0001403E 0C41 00A0                          cmpi.w    #160,d1                    ; is the pan value 160 pixels?
00014042 6700                               beq.s    Sonic_PanCamera_update_pan                ; if so, branch
00014044 6400                               bcc.s    Sonic_PanCamera_reset_left                ; otherwise, branch if it greater than 160
00014046                                 
00014046                            Sonic_PanCamera_reset_right:
00014046 5441                               addq.w    #2,d1                    ; add 2 to the pan value
00014048 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
0001404A                            ; ---------------------------------------------------------------------------
0001404A                            
0001404A                            Sonic_PanCamera_reset_left:
0001404A 5541                               subq.w    #2,d1                    ; subtract 2 from the pan value
0001404C                            
0001404C                            Sonic_PanCamera_update_pan:
0001404C 31C1 F7A0                          move.w    d1,($FFFFF7A0).w        ; update the camera pan value
00014050 4E75                               rts                                ; return
00014052                                 
00014052                            ; End of function Sonic_PanCamera
00014052                            ; ===========================================================================
