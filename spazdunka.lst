00014B7E                            
00014B7E                            loc2_1AC8E:
00014B7E 117C 0009 001C             		move.b	#9,anim(a0)
00014B84 1038 F602                  		move.b	($FFFFF602).w,d0	; read controller
00014B88 0800 0001                  		btst	#1,d0			; check down button
00014B8C 6600 0000                  		bne.w	loc2_1AD30		; if set, branch
00014B90 117C 000E 0016             		move.b	#$E,y_radius(a0)		; $16(a0) is height/2
00014B96 117C 0007 0017             		move.b	#7,x_radius(a0)		; $17(a0) is width/2
00014B9C 117C 0002 001C             		move.b	#2,anim(a0)		; set animation to roll
00014BA2 5A68 000C                  		addq.w	#5,y_pos(a0)		; $C(a0) is Y coordinate
00014BA6 117C 0000 0039             		move.b	#0,$39(a0)		; clear Spin Dash flag
00014BAC 7000                       		moveq	#0,d0
00014BAE 1028 003A                  		move.b	$3A(a0),d0		; copy charge count
00014BB2 D040                       		add.w	d0,d0			; double it
00014BB4 317B 0000 0014             		move.w	Dash_Speeds(pc,d0.w),$14(a0) ; get normal speed
00014BBA 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00014BBE 6700                       		beq.s	loc2_1AC8F
00014BC0 317B 0000 0014             		move.w	Dash_Speeds_Super(pc,d0.w),inertia(a0)
00014BC6                            
00014BC6                            loc2_1AC8F:
00014BC6 3028 0014                  		move.w	$14(a0),d0		; get inertia
00014BCA 0440 0800                  		subi.w	#$800,d0		; subtract $800
00014BCE D040                       		add.w	d0,d0			; double it
00014BD0 0240 1F00                  		andi.w	#$1F00,d0		; mask it against $1F00
00014BD4 4440                       		neg.w	d0			; negate it
00014BD6 0640 2000                  		addi.w	#$2000,d0		; add $2000
00014BDA 31C0 C904                  		move.w	d0,($FFFFC904).w	; move to $C904
00014BDE 0828 0000 0022             		btst	#0,status(a0)		; is sonic facing right?
00014BE4 6700                       		beq.s	loc2_1ACF4		; if not, branch
00014BE6 4468 0014                  		neg.w	$14(a0)			; negate inertia
00014BEA                            
00014BEA                            loc2_1ACF4:
00014BEA 08E8 0002 0022             		bset	#2,status(a0)		; set unused (in s1) flag
00014BF0 11FC 0000 D1DC             		move.b	#0,($FFFFD1DC).w	; clear Spin Dash dust animation.
00014BF6 303C 00BC                  		move.w	#$BC,d0			; spin release sound
00014BFA 4EB9 0000 0FC8             		jsr	(PlaySound_Special).l	; play it!
00014C00 6000                       		bra.s	loc2_1AD78
00014C02                            ; ===========================================================================
00014C02                            Dash_Speeds:
00014C02 0800                       		dc.w  $800		; 0
00014C04 0880                       		dc.w  $880		; 1
00014C06 0900                       		dc.w  $900		; 2
00014C08 0980                       		dc.w  $980		; 3
00014C0A 0A00                       		dc.w  $A00		; 4
00014C0C 0A80                       		dc.w  $A80		; 5
00014C0E 0B00                       		dc.w  $B00		; 6
00014C10 0B80                       		dc.w  $B80		; 7
00014C12 0C00                       		dc.w  $C00		; 8
00014C14                            Dash_Speeds_Super:
00014C14 0B00                       		dc.w  $B00	; 0
00014C16 0B80                       		dc.w  $B80	; 1
00014C18 0C00                       		dc.w  $C00	; 2
00014C1A 0C80                       		dc.w  $C80	; 3
00014C1C 0D00                       		dc.w  $D00	; 4
00014C1E 0D80                       		dc.w  $D80	; 5
00014C20 0E00                       		dc.w  $E00	; 6
00014C22 0E80                       		dc.w  $E80	; 7
00014C24 0F00                       		dc.w  $F00	; 8
00014C26                            ; ===========================================================================
00014C26                            
00014C26                            loc2_1AD30:				; If still charging the dash...
00014C26 4A68 003A                  		tst.w	$3A(a0)		; check charge count
00014C2A 6700                       		beq.s	loc2_1AD48	; if zero, branch
00014C2C 3028 003A                  		move.w	$3A(a0),d0	; otherwise put it in d0
00014C30 EA48                       		lsr.w	#5,d0		; shift right 5 (divide it by 32)
00014C32 9168 003A                  		sub.w	d0,$3A(a0)	; subtract from charge count
00014C36 6400                       		bcc.s	loc2_1AD48	; ??? branch if carry clear
00014C38 317C 0000 003A             		move.w	#0,$3A(a0)	; set charge count to 0
00014C3E                            
00014C3E                            loc2_1AD48:
00014C3E 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014C42 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C?
00014C46 6700 0000                  		beq.w	loc2_1AD78		; if not, branch
00014C4A 317C 0900 001C             		move.w	#$900,anim(a0)		; reset spdsh animation
00014C50 303C 00D2                  		move.w	#$D2,d0			; was $E0 in sonic 2
00014C54 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014C5A 4EB9 0000 0FC8             		jsr	(PlaySound_Special).l	; play charge sound
00014C60 0668 0200 003A             		addi.w	#$200,$3A(a0)		; increase charge count
00014C66 0C68 0800 003A             		cmpi.w	#$800,$3A(a0)		; check if it's maxed
00014C6C 6500                       		bcs.s	loc2_1AD78		; if not, then branch
00014C6E 317C 0800 003A             		move.w	#$800,$3A(a0)		; reset it to max
00014C74                            
00014C74                            loc2_1AD78:
00014C74 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014C76 0C78 0060 EED8             		cmpi.w	#$60,($FFFFEED8).w	; $EED8 only ever seems
00014C7C 6700                       		beq.s	loc2_1AD8C		; to be used in Spin Dash
00014C7E 6400                       		bcc.s	loc2_1AD88
00014C80 5878 EED8                  		addq.w	#4,($FFFFEED8).w
00014C84                            
00014C84                            loc2_1AD88:
00014C84 5578 EED8                  		subq.w	#2,($FFFFEED8).w
00014C88                            
