000833FA                            ;	dcSample
000833FA                            	dcSample	TYPE_PCM, KickS3, 7360				; $81	- Snare (S3)
000833FA =00000012                M 	@desc_101:	equ type_pcm|prio_normal
000833FA                          M 	@macroinvokeid:	substr 2,,"_101"
000833FA =00000064                M 	@macroprevinvokeid:	= @macroinvokeid-1
000833FA =00000080                M 	__st_sampleid:	= $80
000833FA =000833FA                M 	__st_sampleptr_101:	equ *
000833FA =00000081                M 	__st_sampleid:	= __st_sampleid+1
000833FA =00000000                M 	@pitch_101:	= 0
000833FA =0000004A                M 	@pitch_101:	= (7360+0)*256/type_pcm_base_rate
000833FA 12                       M 	dc.b	@desc_101
000833FB 4A                       M 	dc.b	@pitch_101
000833FC 0000 0000                M 	dc.l	kicks3
00083400 0000 0000                M 	dc.l	kicks3_end
00083404                            	dcSample	TYPE_PCM, SnareS3, 7360					; $82	- Kick (S3)
00083404 =00000012                M 	@desc_102:	equ type_pcm|prio_normal
00083404                          M 	@macroinvokeid:	substr 2,,"_102"
00083404 =00000065                M 	@macroprevinvokeid:	= @macroinvokeid-1
00083404 =00083404                M 	__st_sampleptr_102:	equ *
00083404 =00000082                M 	__st_sampleid:	= __st_sampleid+1
00083404 =00000000                M 	@pitch_102:	= 0
00083404 =0000004A                M 	@pitch_102:	= (7360+0)*256/type_pcm_base_rate
00083404 12                       M 	dc.b	@desc_102
