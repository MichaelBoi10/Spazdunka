00081E1A                            	MPCM_pause
00081E1A                          M 	mpcm_stopz80
00081E1A                          M 	pusho
00081E1A                          M 	opt	l-
00081E1A 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081E22                          M 	@wait_14:
00081E22 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081E2A 66F6                     M 	bne.s	@wait_14
00081E2C                          M 	popo
00081E2C 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00081E34                          M 	mpcm_startz80
00081E34 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081E3C 4E75                       	rts
