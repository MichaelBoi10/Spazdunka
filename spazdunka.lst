0001416E 31FC 0630 F760             		move.w	#$630,($FFFFF760).w ; restore Sonic's speed
00014174 31FC 000C F762             		move.w	#$C,($FFFFF762).w ; restore Sonic's acceleration
0001417A 31FC 0080 F764             		move.w	#$80,($FFFFF764).w ; restore Sonic's deceleration
00014180 4A38 FE19                  		tst.b	(Super_Sonic_flag).w	; Is Sonic Super?
00014184 6700                       		beq.s	@Skip			; If not branch
