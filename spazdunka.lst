00000FD4                            ; Subroutine to	pause the game
00000FD4                            ; ---------------------------------------------------------------------------
00000FD4                            
00000FD4                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
