000077B8                            LoadZoneTiles:
000077B8 7000                       		moveq	#0,d0			; Clear d0
000077BA 1038 FE10                  		move.b	($FFFFFE10).w,d0		; Load number of current zone to d0
000077BE E948                       		lsl.w	#4,d0			; Multiply by $10, converting the zone ID into an offset
000077C0 45F9 0000 0000             		lea	(MainLoadBlocks).l,a2	; Load LevelHeaders's address into a2
000077C6 45F2 0000                  		lea	(a2,d0.w),a2		; Offset LevelHeaders by the zone-offset, and load the resultant address to a2
000077CA 201A                       		move.l	(a2)+,d0		; Move the first longword of data that a2 points to to d0, this contains the zone's first PLC ID and its art's address.
000077CC                            						; The auto increment is pointless as a2 is overwritten later, and nothing reads from a2 before then
000077CC 0280 00FF FFFF             		andi.l	#$FFFFFF,d0    		; Filter out the first byte, which contains the first PLC ID, leaving the address of the zone's art in d0
000077D2 2040                       		movea.l	d0,a0			; Load the address of the zone's art into a0 (source)
000077D4 43F9 00FF 0000             		lea	($FF0000).l,a1		; Load v_256x256/StartOfRAM (in this context, an art buffer) into a1 (destination)
000077DA 6100 9D7C                  		bsr.w	KosDec			; Decompress a0 to a1 (Kosinski compression)
000077DE                            
000077DE 3609                       		move.w	a1,d3			; Move a word of a1 to d3, note that a1 doesn't exactly contain the address of v_256x256/StartOfRAM anymore, after KosDec, a1 now contains v_256x256/StartOfRAM + the size of the file decompressed to it, d3 now contains the length of the file that was decompressed
000077E0 3E03                       		move.w	d3,d7			; Move d3 to d7, for use in seperate calculations
000077E2                            
000077E2 0243 0FFF                  		andi.w	#$FFF,d3		; Remove the high nibble of the high byte of the length of decompressed file, this nibble is how many $1000 bytes the decompressed art is
000077E6 E24B                       		lsr.w	#1,d3			; Half the value of 'length of decompressed file', d3 becomes the 'DMA transfer length'
000077E8                            
000077E8 E95F                       		rol.w	#4,d7			; Rotate (left) length of decompressed file by one nibble
000077EA 0247 000F                  		andi.w	#$F,d7			; Only keep the low nibble of low byte (the same one filtered out of d3 above), this nibble is how many $1000 bytes the decompressed art is
000077EE                            
000077EE 3407                       @loop:		move.w	d7,d2			; Move d7 to d2, note that the ahead dbf removes 1 byte from d7 each time it loops, meaning that the following calculations will have different results each time
000077F0 EF4A                       		lsl.w	#7,d2
000077F2 EB4A                       		lsl.w	#5,d2			; Shift (left) d2 by $C, making it high nibble of the high byte, d2 is now the size of the decompressed file rounded down to the nearest $1000 bytes, d2 becomes the 'destination address'
000077F4                            
000077F4 223C 00FF FFFF             		move.l	#$FFFFFF,d1		; Fill d1 with $FF
000077FA 3202                       		move.w	d2,d1			; Move d2 to d1, overwriting the last word of $FF's with d2, this turns d1 into 'StartOfRAM'+'However many $1000 bytes the decompressed art is', d1 becomes the 'source address'
000077FC                            
000077FC 4EB9 0000 106C             		jsr	(DMA_68KtoVRAM).l	; Use d1, d2, and d3 to locate the decompressed art and ready for transfer to VRAM
00007802 3F07                       		move.w	d7,-(sp)		; Store d7 in the Stack
00007804 11FC 000C F62A             		move.b	#$C,($FFFFF62A).w
0000780A 6100 B228                  		bsr.w	DelayProgram
0000780E 6100 9A98                  		bsr.w	RunPLC_RAM
00007812 3E1F                       		move.w	(sp)+,d7		; Restore d7 from the Stack
00007814 363C 0800                  		move.w	#$800,d3		; Force the DMA transfer length to be $1000/2 (the first cycle is dynamic because the art's DMA'd backwards)
00007818 51CF FFD4                  		dbf	d7,@loop		; Loop for each $1000 bytes the decompressed art is
0000781C                            
0000781C 4E75                       		rts
0000781E                            ; End of function LoadZoneTiles
