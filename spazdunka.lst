0000E3CE 2628 000C                  		move.l	$C(a0),d3
0000E3D2 3028 0010                  		move.w	$10(a0),d0
0000E3D6 48C0                       		ext.l	d0
0000E3D8 E180                       		asl.l	#8,d0
0000E3DA D480                       		add.l	d0,d2
0000E3DC 3028 0012                  		move.w	$12(a0),d0
0000E3E0 0668 0038 0012             		addi.w	#$38,y_vel(a0)	; increase vertical speed
0000E3E6 48C0                       		ext.l	d0
0000E3E8 E180                       		asl.l	#8,d0
0000E3EA D680                       		add.l	d0,d3
0000E3EC 2142 0008                  		move.l	d2,8(a0)
0000E3F0 2143 000C                  		move.l	d3,y_pos(a0)
