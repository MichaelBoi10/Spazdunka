0001DA44                            ; ---------------------------------------------------------------------------
0001DA44                            ; Subroutine to limit Sonic's upward vertical speed
0001DA44                            ; ---------------------------------------------------------------------------
0001DA44                            
0001DA44                            Obj09_JumpHeight:			; XREF: Obj09_InAir
0001DA44 1038 F602                  		move.b	($FFFFF602).w,d0	; is the jump button up?
0001DA48 0200 0070                  		andi.b	#$70,d0
0001DA4C 6600                       		bne.s	locret_1BBB4		; if not, branch to return
0001DA4E 0828 0007 0022             		btst	#7,$22(a0)		; did Sonic jump or is he just falling or hit by a bumper?
0001DA54 6700                       		beq.s	locret_1BBB4		; if not, branch to return
0001DA56 1038 F780                  		move.b	($FFFFF780).w,d0	; get SS angle
0001DA5A 0200 00FC                  		andi.b	#$FC,d0
0001DA5E 4400                       		neg.b	d0
0001DA60 0400 0040                  		subi.b	#$40,d0
0001DA64 4EB9 0000 2A66             		jsr	(CalcSine).l			
0001DA6A 3428 0012                  		move.w	$12(a0),d2		; get Y speed
0001DA6E C1C2                       		muls.w	d2,d0			; multiply Y speed by sin
0001DA70 E080                       		asr.l	#8,d0			; find the new Y speed
0001DA72 3428 0010                  		move.w	$10(a0),d2		; get X speed
0001DA76 C3C2                       		muls.w	d2,d1			; multiply X speed by cos
0001DA78 E081                       		asr.l	#8,d1			; find the new X speed
0001DA7A D240                       		add.w	d0,d1			; combine the two speeds
0001DA7C 0C41 0400                  		cmpi.w	#$400,d1		; compare the combined speed with the jump release speed
0001DA80 6F00                       		ble.s	locret_1BBB4		; if it's less, branch to return
0001DA82 1038 F780                  		move.b	($FFFFF780).w,d0
0001DA86 0200 00FC                  		andi.b	#$FC,d0
0001DA8A 4400                       		neg.b	d0
0001DA8C 0400 0040                  		subi.b	#$40,d0
0001DA90 4EB9 0000 2A66             		jsr	(CalcSine).l
0001DA96 C3FC 0400                  		muls.w	#$400,d1
0001DA9A E081                       		asr.l	#8,d1
0001DA9C 3141 0010                  		move.w	d1,$10(a0)
0001DAA0 C1FC 0400                  		muls.w	#$400,d0
0001DAA4 E080                       		asr.l	#8,d0
0001DAA6 3140 0012                  		move.w	d0,$12(a0)		; set the speed to the jump release speed
0001DAAA 08A8 0007 0022             		bclr	#7,$22(a0)		; clear "Sonic has jumped" flag
