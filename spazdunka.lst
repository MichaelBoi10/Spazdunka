000834CC                            ; ------------------------------------------------------------------------------
000834CC                            ; Plays a given sample
000834CC                            ; ------------------------------------------------------------------------------
000834CC                            ; INPUT:
000834CC                            ;		d0	.b		sample id (>$81)
000834CC                            ;
000834CC                            ; EXAMPLES:
000834CC                            ;		move.b	#$81, d0
000834CC                            ;		jsr		MegaPCM_PlaySample
000834CC                            ;
000834CC                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
000834CC                            ;		jsr		MegaPCM_PlaySample
000834CC                            ; ------------------------------------------------------------------------------
000834CC                            
000834CC                            MegaPCM_PlaySample:
000834CC                            	MPCM_play	d0
000834CC                          M 	mpcm_stopz80
000834CC                          M 	pusho
000834CC                          M 	opt	l-
000834CC 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
000834D4                          M 	@wait_44:
000834D4 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
000834DC 66F6                     M 	bne.s	@wait_44
000834DE                          M 	popo
000834DE 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
000834E4                          M 	mpcm_startz80
000834E4 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
000834EC 4E75                       	rts
000834EE                            
