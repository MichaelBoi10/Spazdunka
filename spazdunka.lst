00083112                            ; ------------------------------------------------------------------------------
00083112                            ; Plays a given sample
00083112                            ; ------------------------------------------------------------------------------
00083112                            ; INPUT:
00083112                            ;		d0	.b		sample id (>$81)
00083112                            ;
00083112                            ; EXAMPLES:
00083112                            ;		move.b	#$81, d0
00083112                            ;		jsr		MegaPCM_PlaySample
00083112                            ;
00083112                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00083112                            ;		jsr		MegaPCM_PlaySample
00083112                            ; ------------------------------------------------------------------------------
00083112                            
00083112                            MegaPCM_PlaySample:
00083112                            	MPCM_play	d0
00083112                          M 	mpcm_stopz80
00083112                          M 	pusho
00083112                          M 	opt	l-
00083112 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0008311A                          M 	@wait_44:
0008311A 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00083122 66F6                     M 	bne.s	@wait_44
00083124                          M 	popo
00083124 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0008312A                          M 	mpcm_startz80
0008312A 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00083132 4E75                       	rts
00083134                            
