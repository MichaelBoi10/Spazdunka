00005C9A 6100 B60C                  		bsr.w	RunPLC_RAM
00005C9E 4A78 F614                  		tst.w	($FFFFF614).w	; have 2 seconds elapsed?
00005CA2 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005CA4 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005CA8 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005CAA 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
00005CB0 6700 0000                  		beq.w	TryAgainEnd	; if yes, branch
00005CB4 4E75                       		rts	
