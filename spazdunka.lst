0000E37A 2628 000C                  		move.l	$C(a0),d3
0000E37E 3028 0010                  		move.w	$10(a0),d0	; load horizontal speed
0000E382 48C0                       		ext.l	d0
0000E384 E180                       		asl.l	#8,d0		; multiply speed by $100
0000E386 D480                       		add.l	d0,d2		; add to x-axis	position
0000E388 3028 0012                  		move.w	$12(a0),d0	; load vertical	speed
