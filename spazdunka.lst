0001491A 0038 0080 FE1D             	ori.b	#$80,(Update_HUD_rings).w
00014920                            @update2
00014920 5378 FE20                  	subq.w	#1,(Ring_count).w
00014924 6600                       	bne.s	return_1AC3C
