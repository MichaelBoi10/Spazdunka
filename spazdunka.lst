00001098                            ; ---------------------------------------------------------------------------
00001098                            ; Subroutine to load VDP commands into the DMA transfer queue
00001098                            ;
00001098                            ; In case you wish to use this queue system outside of the spin dash, this is the
00001098                            ; registers in which it expects data in:
00001098                            ; d1.l: Address to data (In 68k address space)
00001098                            ; d2.w: Destination in VRAM
00001098                            ; d3.w: Length of data
00001098                            ; ---------------------------------------------------------------------------
00001098                            
00001098                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001098                            
00001098                            
00001098                            DMA_68KtoVRAM:
00001098 2278 C8FC                  		movea.l	($FFFFC8FC).w,a1
0000109C B2FC C8FC                  		cmpa.w	#$C8FC,a1	; is the DMA queue full?
000010A0 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
000010A2                            
000010A2                            		; piece together some VDP commands and store them for later...
000010A2 303C 9300                  		move.w	#$9300,d0	; command to specify DMA transfer length & $00FF
000010A6 1003                       		move.b	d3,d0
000010A8 32C0                       		move.w	d0,(a1)+	; store command
000010AA                            
000010AA 303C 9400                  		move.w	#$9400,d0	; command to specify DMA transfer length & $FF00
000010AE E04B                       		lsr.w	#8,d3
000010B0 1003                       		move.b	d3,d0
000010B2 32C0                       		move.w	d0,(a1)+	; store command
000010B4                            
000010B4 303C 9500                  		move.w	#$9500,d0	; command to specify source address & $0001FE
000010B8 E289                       		lsr.l	#1,d1
000010BA 1001                       		move.b	d1,d0
000010BC 32C0                       		move.w	d0,(a1)+	; store command
000010BE                            
000010BE 303C 9600                  		move.w	#$9600,d0	; command to specify source address & $01FE00
000010C2 E089                       		lsr.l	#8,d1
000010C4 1001                       		move.b	d1,d0
000010C6 32C0                       		move.w	d0,(a1)+	; store command
000010C8                            
000010C8 303C 9700                  		move.w	#$9700,d0	; command to specify source address & $FE0000
000010CC E089                       		lsr.l	#8,d1
000010CE 1001                       		move.b	d1,d0
000010D0 32C0                       		move.w	d0,(a1)+	; store command
000010D2                            
000010D2 0282 0000 FFFF             		andi.l	#$FFFF,d2	; command to specify destination address and begin DMA
000010D8 E58A                       		lsl.l	#2,d2
000010DA E44A                       		lsr.w	#2,d2
000010DC 4842                       		swap	d2
000010DE 0082 4000 0080             		ori.l	#$40000080,d2 ; set bits to specify VRAM transfer
000010E4 22C2                       		move.l	d2,(a1)+	; store command
000010E6                            
000010E6 21C9 C8FC                  		move.l	a1,($FFFFC8FC).w ; set the next free slot address
000010EA B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
000010EE 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
000010F0 32BC 0000                  		move.w	#0,(a1) ; put a stop token at the end of the used part of the buffer
000010F4                            
000010F4                            DMA_68KtoVRAM_Done:			; XREF: DMA_68KtoVRAM
000010F4 4E75                       		rts
000010F6                            ; End of function DMA_68KtoVRAM
000010F6                            
000010F6                            ; ---------------------------------------------------------------------------
000010F6                            ; Process all VDP commands and then reset the DMA queue when it's done
000010F6                            ; ---------------------------------------------------------------------------
000010F6                            
000010F6                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000010F6                            
000010F6                            
000010F6                            Process_DMA:
000010F6 4BF9 00C0 0004             		lea	($C00004).l,a5
000010FC 43F8 C800                  		lea	($FFFFC800).w,a1
00001100                            
00001100                            Process_DMA_Loop:			; XREF: Process_DMA
00001100 3019                       		move.w	(a1)+,d0	; has a stop token been encountered?
00001102 6700                       		beq.s	Process_DMA_Done ; branch if we reached a stop token
00001104                            
00001104                            		; issue a set of VDP commands...
00001104 3A80                       		move.w	d0,(a5)		; transfer length
00001106 3A99                       		move.w	(a1)+,(a5)	; transfer length
00001108 3A99                       		move.w	(a1)+,(a5)	; source address
0000110A 3A99                       		move.w	(a1)+,(a5)	; source address
0000110C 3A99                       		move.w	(a1)+,(a5)	; source address
0000110E 3A99                       		move.w	(a1)+,(a5)	; destination
00001110 3A99                       		move.w	(a1)+,(a5)	; destination
00001112 B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
00001116 66E8                       		bne.s	Process_DMA_Loop ; loop if we haven't reached the end of the buffer
00001118                            
00001118                            Process_DMA_Done:			; XREF: Process_DMA
00001118 31FC 0000 C800             		move.w	#0,($FFFFC800).w
0000111E 21FC FFFF C800 C8FC        		move.l	#$FFFFC800,($FFFFC8FC).w
00001126 4E75                       		rts
00001128                            ; End of function Process_DMA
