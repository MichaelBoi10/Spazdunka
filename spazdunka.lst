00014A16                            ; ---------------------------------------------------------------------------
00014A16                            ; Subroutine to make Sonic perform a peelout
00014A16                            ; ---------------------------------------------------------------------------
00014A16                            ; If you use this makes sure to search for ;Peelout in Sonic1.asm
00014A16                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014A16                            
00014A16                            ;SCDPeelout:
00014A16 0828 0001 0039             		btst	#1,$39(a0)
00014A1C 6600                       		bne.s	SCDPeelout_Launch
00014A1E 0C28 0007 001C             		cmpi.b	#7,$1C(a0) ;check to see if your looking up
00014A24 6600                       		bne.s	@return
00014A26 1038 F603                  		move.b	($FFFFF603).w,d0
00014A2A 0200 0070                  		andi.b	#%01110000,d0
00014A2E 6700 0000                  		beq.w	@return
00014A32 117C 0001 001C             		move.b	#1,$1C(a0)
00014A38 317C 0000 003A             		move.w	#0,$3A(a0)
00014A3E 303C 00D2                  		move.w	#$D2,d0
00014A42 11FC 0002 D1DC                             move.b	#2,($FFFFD1DC).w
00014A48 4EB9 0000 0FC8             		jsr		(PlaySound_Special).l 	; Play peelout charge sound
00014A4E                            	       ;sfx 	sfx_PeeloutCharge 		; These are if you use AMPS
00014A4E 588F                       		addq.l	#4,sp
00014A50 08E8 0001 0039             		bset	#1,$39(a0)
00014A56                            		
00014A56 4268 0014                  		clr.w	$14(a0)
00014A5A                             
00014A5A 6100 FCB6                  		bsr.w	Sonic_LevelBound
00014A5E 6100 0000                  		bsr.w	Sonic_AnglePos
00014A62                             
00014A62                            	@return:
00014A62 4E75                       		rts	
00014A64                            ; ---------------------------------------------------------------------------
00014A64                             
00014A64                            SCDPeelout_Launch:
00014A64 117C 0023 001C             		move.b	#$23,anim(a0)
00014A6A 1038 F602                  		move.b	($FFFFF602).w,d0
00014A6E 0800 0000                  		btst	#0,d0
00014A72 6600 0000                  		bne.w	SCDPeelout_Charge
00014A76 08A8 0001 0039             		bclr	#1,$39(a0)	; stop Dashing
00014A7C 0C28 0020 001C             		cmpi.b	#$20,$1C(a0)	; launches here (peelout sprites)
00014A82 6700                       		beq.s	SCDPeelout_Stop_Sound
00014A84 117C 0000 001C             		move.b	#0,$1C(a0)	; launches here (peelout sprites)
00014A8A 317C 0001 0010             		move.w	#1,$10(a0)	; force X speed to nonzero for camera lag's benefit
00014A90 3028 0014                  		move.w	$14(a0),d0
00014A94 0440 0700                  		subi.w	#$700,d0
00014A98 D040                       		add.w	d0,d0
00014A9A 0240 0700                  		andi.w	#$700,d0
00014A9E 4440                       		neg.w	d0
00014AA0 0640 0700                  		addi.w	#$700,d0
00014AA4 31C0 C904                  		move.w	d0,($FFFFC904).w	; move to $C904
00014AA8 0828 0000 0022             		btst	#0,$22(a0)
00014AAE 6700                       		beq.s	@dontflip
00014AB0 4468 0014                  		neg.w	$14(a0)
00014AB4                             
00014AB4                            @dontflip:
00014AB4 08A8 0007 0022             		bclr	#7,$22(a0)
00014ABA 303C 00D3                  		move.w	#$D3,d0
00014ABE 4EB9 0000 0FC8             		jsr		(PlaySound_Special).l
00014AC4                            		; sfx 	sfx_PeeloutRelease
00014AC4 6000 0000                  		bra.w	SCDPeelout_ResetScr
00014AC8                            ; ---------------------------------------------------------------------------
00014AC8                             
00014AC8                            SCDPeelout_Charge:				; If still charging the dash...
00014AC8 3238 F760                  		move.w	($FFFFF760).w,d1	; get top peelout speed
00014ACC 3401                       		move.w	d1,d2
00014ACE D241                       		add.w	d1,d1
00014AD0 4A38 FE2E                  		tst.b   ($FFFFFE2E).w 		; test for speed shoes
00014AD4 6700                       		beq.s	@noshoes
00014AD6 E242                       		asr.w	#1,d2
00014AD8 9242                       		sub.w	d2,d1
00014ADA                            
00014ADA                            @noshoes:
00014ADA 0668 0064 0014             		addi.w	#$64,$14(a0)		; increment speed
00014AE0 B268 0014                  		cmp.w	$14(a0),d1
00014AE4 6E00                       		bgt.s	@inctimer
00014AE6 3141 0014                  		move.w	d1,$14(a0)
00014AEA                            
00014AEA                            @inctimer:
00014AEA 5228 003A                  		addq.b	#1,$3A(a0)		; increment timer
00014AEE 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)
00014AF4 6500                       		bcs.s	SCDPeelout_ResetScr
00014AF6 117C 001E 003A             		move.b	#$1E,$3A(a0)
00014AFC 4EF9 0000 0000             		jmp 	SCDPeelout_ResetScr
00014B02                            		
00014B02                            SCDPeelout_Stop_Sound:
00014B02 303C 00BC                  		move.w	#$BC,d0
00014B06 4EB9 0000 0FC8             		jsr		(PlaySound_Special).l
00014B0C                            		; sfx 	sfx_PeeloutStop
00014B0C 4268 0014                  		clr.w	$14(a0)
00014B10                            
00014B10                            SCDPeelout_ResetScr:
00014B10 588F                       		addq.l	#4,sp			; increase stack ptr ; was 4
00014B12 0C78 0060 F73E             		cmpi.w	#$60,($FFFFF73E).w
00014B18 6700                       		beq.s	@finish
00014B1A 6400                       		bcc.s	@skip
00014B1C 5878 F73E                  		addq.w	#4,($FFFFF73E).w
00014B20                             
00014B20                            	@skip:
00014B20 5578 F73E                  		subq.w	#2,($FFFFF73E).w
00014B24                             
00014B24                            	@finish:
00014B24 6100 FBEC                  		bsr.w	Sonic_LevelBound
00014B28 6100 0000                  		bsr.w	Sonic_AnglePos
00014B2C 4E75                       		rts
