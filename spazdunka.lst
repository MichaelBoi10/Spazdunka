00005BA4 6100 B72E                  		bsr.w	RunPLC_RAM
00005BA8 4A78 F614                  		tst.w	($FFFFF614).w	; have 2 seconds elapsed?
00005BAC 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005BAE 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005BB2 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005BB4 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
00005BBA 6700 0000                  		beq.w	TryAgainEnd	; if yes, branch
