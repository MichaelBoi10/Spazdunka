00083118                            ; ------------------------------------------------------------------------------
00083118                            ; Plays a given sample
00083118                            ; ------------------------------------------------------------------------------
00083118                            ; INPUT:
00083118                            ;		d0	.b		sample id (>$81)
00083118                            ;
00083118                            ; EXAMPLES:
00083118                            ;		move.b	#$81, d0
00083118                            ;		jsr		MegaPCM_PlaySample
00083118                            ;
00083118                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00083118                            ;		jsr		MegaPCM_PlaySample
00083118                            ; ------------------------------------------------------------------------------
00083118                            
00083118                            MegaPCM_PlaySample:
00083118                            	MPCM_play	d0
00083118                          M 	mpcm_stopz80
00083118                          M 	pusho
00083118                          M 	opt	l-
00083118 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00083120                          M 	@wait_44:
00083120 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00083128 66F6                     M 	bne.s	@wait_44
0008312A                          M 	popo
0008312A 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00083130                          M 	mpcm_startz80
00083130 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00083138 4E75                       	rts
0008313A                            
