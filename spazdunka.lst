00000000                            	include "MegaPCM.Macros.asm"
00000000                            
00000000                            ; ==============================================================================
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Mega PCM 2.1 - DAC Sound Driver (Macro Definitions)
00000000                            ;
00000000                            ; Documentation, examples and source code are available at:
00000000                            ; - https://github.com/vladikcomper/MegaPCM/tree/2.x
00000000                            ;
00000000                            ; (c) 2012-2026, Vladikcomper
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            ; ==============================================================================
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macros
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to generate sample record in a sample table
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	type - Sample type (e.g. TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE)
00000000                            ;	samplePtr - Sample pointer/name (assigned via `incdac` macro)
00000000                            ;	sampleRateHz? - (Optional) Sample rate in Hz, auto-detected for .WAV, .DPCMQ
00000000                            ;	flags? - (Optional) Additional flags (FLAGS_SFX, FLAGS_LOOP, PRIO_NORMAL...)
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            dcSample: macro	*, type, samplePtr, sampleRateHz, flags
00000000                            	; Make sure macro is invoked correctly
00000000                            	if (narg>4)|((narg=1)&(\type<>TYPE_NONE))
00000000                            		inform 2, "Incorrect number of arguments. USAGE: dcSample type, samplePtr, sampleRateHz?, flags?"
00000000                            	endif
00000000                            	; Setup default sample description field (based on flags and type)
00000000                            	if narg<4 ; if "flags" parameter is not specified
00000000                            		@desc\@: equ \type|PRIO_NORMAL
00000000                            	elseif instr("\flags", "PRIO_")
00000000                            		@desc\@: equ \type|\flags
00000000                            	else	; if "priority" flag isn't present, default to PRIO_NORMAL
00000000                            		@desc\@: equ \type|\flags|PRIO_NORMAL
00000000                            	endif
00000000                            	; Track sample ID since start of the sample table (supports multiple tables)
00000000                            	; This trick works for both linkable and non-linkable builds
00000000                            	@macroInvokeId: substr 2,,"\@"
00000000                            	@macroPrevInvokeId: = @macroInvokeId-1
00000000                            	if ~def(__ST_SampleID)
00000000                            		__ST_SampleID: = $80
00000000                            	elseif def(__ST_SamplePtr_\#@macroPrevInvokeId)
00000000                            		if (*-__ST_SamplePtr_\#@macroPrevInvokeId>10)
00000000                            			__ST_SampleID: = $80
00000000                            		endif
00000000                            	endif
00000000                            	__ST_SamplePtr\@:	equ	*	; offset of the current sample for back-reference
00000000                            	__ST_SampleID: = __ST_SampleID+1
00000000                            	; Define additional properties if the label is given
00000000                            	if ~strcmp("\*","")
00000000                            \*:		equ	*
00000000                            \*.id: 	equ	__ST_SampleID
00000000                            	endif
00000000                            	@pitch\@: = 0
00000000                            	if \type=TYPE_PCM
00000000                            		if \sampleRateHz+0>TYPE_PCM_MAX_RATE
00000000                            			inform 2, "Invalid sample rate: \sampleRateHz\. TYPE_PCM only supports sample rates <= \#TYPE_PCM_MAX_RATE Hz"
00000000                            		endif
00000000                            		@pitch\@: = (\sampleRateHz+0)*256/TYPE_PCM_BASE_RATE
00000000                            		dc.b	@desc\@									; $00	- type, flags
00000000                            		dc.b	@pitch\@								; $01	- pitch (based on sample rate)
00000000                            		dc.l	\samplePtr								; $02	- start offset
00000000                            		dc.l	\samplePtr\_End							; $06	- end offset
00000000                            	elseif \type=TYPE_PCM_TURBO
00000000                            		if (\sampleRateHz+0<>TYPE_PCM_TURBO_MAX_RATE)&(\sampleRateHz+0<>0)
00000000                            			inform 2, "Invalid sample rate: \sampleRateHz\. TYPE_PCM_TURBO only supports sample rate of \#TYPE_PCM_TURBO_MAX_RATE Hz"
00000000                            		endif
00000000                            		dc.b	@desc\@									; $00	- type, flags
00000000                            		dc.b	$FF										; $01	- pitch (ignored in Turbo mode)
00000000                            		dc.l	\samplePtr								; $02	- start offset
00000000                            		dc.l	\samplePtr\_End							; $06	- end offset
00000000                            	elseif \type=TYPE_DPCM
00000000                            		if \sampleRateHz+0>TYPE_DPCM_MAX_RATE
00000000                            			inform 2, "Invalid sample rate: \sampleRateHz\. TYPE_DPCM only supports sample rates <= \#TYPE_DPCM_MAX_RATE Hz"
00000000                            		endif
00000000                            		@pitch\@: = (\sampleRateHz+0)*256/TYPE_DPCM_BASE_RATE
00000000                            		dc.b	@desc\@									; $00	- type, flags
00000000                            		dc.b	@pitch\@								; $01	- pitch (based on sample rate)
00000000                            		dc.l	\samplePtr								; $02	- start offset
00000000                            		dc.l	\samplePtr\_End							; $06	- end offset
00000000                            	elseif \type=TYPE_DPCM_TURBO
00000000                            		if (\sampleRateHz+0<>TYPE_DPCM_TURBO_MAX_RATE)&(\sampleRateHz+0<>0)
00000000                            			inform 2, "Invalid sample rate: \sampleRateHz\. TYPE_DPCM_TURBO only supports sample rate of \#TYPE_DPCM_TURBO_MAX_RATE Hz"
00000000                            		endif
00000000                            		dc.b	@desc\@									; $00	- type, flags
00000000                            		dc.b	$FF										; $01	- pitch (ignored in Turbo mode)
00000000                            		dc.l	\samplePtr								; $02	- start offset
00000000                            		dc.l	\samplePtr\_End							; $06	- end offset
00000000                            	elseif \type=TYPE_NONE
00000000                            		dc.b	@desc\@									; $00	- type, flags (ignored)
00000000                            		dc.b	0										; $01	- pitch (ignored for empty samples)
00000000                            		dc.l	0										; $02	- start offset (ignored for empty samples)
00000000                            		dc.l	0										; $06	- end offset (ignored for empty samples)
00000000                            	else
00000000                            		inform 2, "Unknown sample type. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_DPCM_TURBO, TYPE_NONE"
00000000                            	endif
00000000                            	if ~strcmp("\*","")
00000000                            	if (@pitch\@<>0)
00000000                            \*.pitch: 	equ	@pitch\@
00000000                            	endif
00000000                            \*.desc:	equ	@desc\@
00000000                            	endif
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to include a sample file
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	name - Name assigned to the sample (label)
00000000                            ;	path - Sample's include path (string)
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            incdac:	macro name, path
00000000                            		even
00000000                            	\name:
00000000                            		incbin	\path
00000000                            	\name\_End:
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to play sample
00000000                            ; Fast alternative to `jsr MegaPCM_PlaySample`
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	sampleIdOp - Sample operand (e.g. #$81, #mysample.id, d0)
00000000                            ;
00000000                            ; EXAMPLES:
00000000                            ;	MPCM_play #$81
00000000                            ;	MPCM_play #mysample.id	; if sample has a label in sample table
00000000                            ;	MPCM_play d1			; value stored in d1
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_play:	macro sampleIdOp
00000000                            	MPCM_stopZ80
00000000                            	move.b	\sampleIdOp, MPCM_Z80_RAM+Z_MPCM_CommandInput
00000000                            	MPCM_startZ80
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to pause current sample playback
00000000                            ; Fast alternative to `jsr MegaPCM_PausePlayback`
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_pause:	macro
00000000                            	MPCM_stopZ80
00000000                            	move.b	#Z_MPCM_COMMAND_PAUSE, MPCM_Z80_RAM+Z_MPCM_CommandInput
00000000                            	MPCM_startZ80
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to unpause playback
00000000                            ; Fast alternative to `jsr MegaPCM_UnpausePlayback`
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_unpause:	macro
00000000                            	MPCM_stopZ80
00000000                            	move.b	#0, MPCM_Z80_RAM+Z_MPCM_CommandInput
00000000                            	MPCM_startZ80
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to stop all playback
00000000                            ; Fast alternative to `jsr MegaPCM_StopPlayback`
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_stop:	macro
00000000                            	MPCM_stopZ80
00000000                            	move.b	#Z_MPCM_COMMAND_STOP, MPCM_Z80_RAM+Z_MPCM_CommandInput
00000000                            	MPCM_startZ80
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to set panning for normal (non-SFX) samples
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	panOp - pan operand (e.g. #$40, #$80, #$C0 or d0)
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_setPan:	macro	panOp
00000000                            	if strcmp("\panOp","$40")|strcmp("\panOp","$80")|strcmp("\panOp","$C0")
00000000                            		inform 1, "MPCM_setPan: Possibly erroneous operand: \panOp\. Did you mean #\panOp\?"
00000000                            	endif
00000000                            	MPCM_stopZ80
00000000                            	move.b	\panOp, MPCM_Z80_RAM+Z_MPCM_PanInput
00000000                            	MPCM_startZ80
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to sets panning for SFX samples (added with FLAGS_SFX)
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	panOp - pan operand (e.g. #$40, #$80, #$C0 or d0)
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_setSfxPan:	macro	panOp
00000000                            	if strcmp("\panOp","$40")|strcmp("\panOp","$80")|strcmp("\panOp","$C0")
00000000                            		inform 1, "MPCM_setSfxPan: Possibly erroneous operand: \panOp\. Did you mean #\panOp\?"
00000000                            	endif
00000000                            	MPCM_stopZ80
00000000                            	move.b	\panOp, MPCM_Z80_RAM+Z_MPCM_SFXPanInput
00000000                            	MPCM_startZ80
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to set volume for normal (non-SFX) samples
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	volumeOp - volume operand (e.g. #0 (max), #$F (min) or d0)
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_setVol:	macro	volumeOp
00000000                            	MPCM_stopZ80
00000000                            	move.b	\volumeOp, MPCM_Z80_RAM+Z_MPCM_VolumeInput
00000000                            	MPCM_startZ80
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to set volume for SFX samples (added with FLAGS_SFX)
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	volumeOp - volume operand (e.g. #0 (max), #$F (min) or d0)
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_setSfxVol:	macro	volumeOp
00000000                            	MPCM_stopZ80
00000000                            	move.b	\volumeOp, MPCM_Z80_RAM+Z_MPCM_SFXVolumeInput
00000000                            	MPCM_startZ80
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to set pitch (alternative to `jsr MegaPCM_SetActiveSamplePitch`)
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	pitchOp	- pitch operand (e.g. #mypcm.pitch, #0 = 0%, #$FF = 100% base rate)
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_setPitch:	macro pitchOp
00000000                            	MPCM_stopZ80
00000000                            	move.b	\pitchOp, MPCM_Z80_RAM+Z_MPCM_ActiveSamplePitch
00000000                            	MPCM_startZ80
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to stop Z80 and take over its bus
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	opBusReq? - (Optional) Custom operand for Z80_BUSREQ
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_stopZ80:	macro opBusReq
00000000                            	pusho
00000000                            	opt		l-		; make sure "@" marks local labels
00000000                            	if narg=1
00000000                            		move.w	#$100, \opBusReq
00000000                            		@wait\@:
00000000                            			btst	#0, \opBusReq
00000000                            			bne.s	@wait\@
00000000                            	else
00000000                            		move.w	#$100, MPCM_Z80_BUSREQ
00000000                            		@wait\@:
00000000                            			btst	#0, MPCM_Z80_BUSREQ
00000000                            			bne.s	@wait\@
00000000                            	endif
00000000                            	popo
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Macro to start Z80 and release its bus
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	opBusReq? - (Optional) Custom operand for Z80_BUSREQ
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_startZ80:	macro opBusReq
00000000                            	if narg=1
00000000                            		move.w	#0, \opBusReq
00000000                            	else
00000000                            		move.w	#0, MPCM_Z80_BUSREQ
00000000                            	endif
00000000                            	endm
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Ensures Mega PCM 2 isn't busy writing to YM (other than DAC output obviously)
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; ARGUMENTS:
00000000                            ;	opBusReq? - (Optional) Custom operand for Z80_BUSREQ
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            MPCM_ensureYMWriteReady:	macro opBusReq
00000000                            	pusho
00000000                            	opt		l-		; make sure "@" marks local labels
00000000                            	@chk_ready\@:
00000000                            		tst.b	(MPCM_Z80_RAM+Z_MPCM_DriverReady).l
00000000                            		bne.s	@ready\@
00000000                            		MPCM_startZ80 \opBusReq
00000000                            		move.w	d0, -(sp)
00000000                            		moveq	#10, d0
00000000                            		dbf		d0, *						; waste 100+ cycles
00000000                            		move.w	(sp)+, d0
00000000                            		MPCM_stopZ80 \opBusReq
00000000                            		bra.s	@chk_ready\@
00000000                            	@ready\@:
00000000                            	popo
00000000                            	endm
00000000                            
00000000                            ; ==============================================================================
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Constants
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Definitions for sample table (`dcSample` macro)
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000                            ; "Type" field constants
00000000 =00000000                  TYPE_NONE:		equ $00		; marks empty slot
00000000 =00000002                  TYPE_PCM:		equ	$02		; PCM/WAV samples
00000000 =00000004                  TYPE_PCM_TURBO:	equ	$04		; PCM/WAV samples (32 kHz Turbo playback mode)
00000000 =00000006                  TYPE_DPCM:		equ	$06		; DPCM/DPCM-HQ samples
00000000 =00000008                  TYPE_DPCM_TURBO:equ	$08		; DPCM/DPCM-HQ samples (25.8 kHz Turbo playback mode)
00000000                            
00000000                            ; "Flags" field constants
00000000 =00000001                  FLAGS_LOOP:		equ	$01		; loop sample indefinitely
00000000 =00000040                  FLAGS_SFX:		equ	$40		; sample is SFX, normal BGM drums cannot interrupt it
00000000                            
00000000                            ; "Priority" field constants
00000000                            ; Note that SFX and normal samples have their own level of priorities
00000000 =00000000                  PRIO_LOW:		equ	$00		; priority level 0 (low)
00000000 =00000010                  PRIO_NORMAL:	equ	$10		; priority level 1 (normal) - that's the default
00000000 =00000020                  PRIO_HIGH:		equ	$20		; priority level 2 (high)
00000000 =00000030                  PRIO_HIGHEST:	equ	$30		; priority level 3 (higest)
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Maximum playback rates:
00000000 =00007D00                  TYPE_PCM_TURBO_MAX_RATE:	equ	32000 ; Hz
00000000 =0000620C                  TYPE_PCM_MAX_RATE:			equ	25100 ; Hz
00000000 =000064C8                  TYPE_DPCM_TURBO_MAX_RATE:	equ	25800 ; Hz
00000000 =00005078                  TYPE_DPCM_MAX_RATE:			equ	20600 ; Hz
00000000                            
00000000                            ; Internal driver's base rates for pitched playback.
00000000                            ; NOTICE: Actual max rates are slightly lower,
00000000                            ; because the highest pitch is 255/256, not 256/256.
00000000 =00006278                  TYPE_PCM_BASE_RATE:			equ	25208 ; Hz
00000000 =000050D3                  TYPE_DPCM_BASE_RATE:		equ	20691 ; Hz
00000000                            
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Return error codes for `MegaPCM_LoadSampleTable`
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000 =00000001                  MPCM_ST_TOO_MANY_SAMPLES:			equ $01		; Too many samples in table
00000000 =00000002                  MPCM_ST_UNKNOWN_SAMPLE_TYPE:		equ $02		; Unknown sample type or missing end marker. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE
00000000                            
00000000 =00000010                  MPCM_ST_PITCH_NOT_SET:				equ $10		; Sample rate can't be auto-detected (only works for .WAV files). Please set it manually
00000000                            
00000000 =00000020                  MPCM_ST_WAVE_INVALID_HEADER:		equ $20		; WAVE error: Invalid WAVE header
00000000 =00000021                  MPCM_ST_WAVE_BAD_AUDIO_FORMAT:		equ $21		; WAVE error: Unsupported audio format. Only PCM is supported
00000000 =00000022                  MPCM_ST_WAVE_NOT_MONO:				equ $22		; WAVE error: Audio must be mono
00000000 =00000023                  MPCM_ST_WAVE_NOT_8BIT:				equ $23		; WAVE error: Audio must be 8-bit unsigned PCM
00000000 =00000024                  MPCM_ST_WAVE_BAD_SAMPLE_RATE:		equ $24		; WAVE error: Unsupported sample rate. Use <=25100 Hz for TYPE_PCM or 32000 Hz for TYPE_PCM_TURBO.
00000000 =00000025                  MPCM_ST_WAVE_MISSING_DATA_CHUNK:	equ $25		; WAVE error: Failed to locate 'data' chunk
00000000                            
00000000 =00000030                  MPCM_ST_DPCM_HQ_UNSUPPORTED_VERSION:equ $30		; DPCM-HQ error: Unsupported version specified in header
00000000 =00000031                  MPCM_ST_DPCM_HQ_BAD_SAMPLE_RATE:	equ $31		; DPCM-HQ error: Unsupported sample rate. Use <=20600 Hz for TYPE_DPCM or 25800 Hz for TYPE_DPCM_TURBO.
00000000                            
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; System Ports used by Mega PCM
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000 =00A00000                  MPCM_Z80_RAM:		equ		$A00000
00000000 =00A11100                  MPCM_Z80_BUSREQ:	equ		$A11100
00000000 =00A11200                  MPCM_Z80_RESET:		equ		$A11200
00000000                            
00000000 =00A04000                  MPCM_YM2612_A0:		equ		$A04000
00000000 =00A04001                  MPCM_YM2612_D0:		equ		$A04001
00000000 =00A04002                  MPCM_YM2612_A1:		equ		$A04002
00000000 =00A04003                  MPCM_YM2612_D1:		equ		$A04003
00000000                            
00000000                            ; ------------------------------------------------------------------------------
00000000                            ; Z80 equates
00000000                            ; ------------------------------------------------------------------------------
00000000                            
00000000 =00001FC2                  Z_MPCM_DriverReady:	equ $1fc2
00000000 =00000001                  Z_MPCM_CommandInput:	equ $1
00000000 =00001FC3                  Z_MPCM_VolumeInput:	equ $1fc3
00000000 =00001FC4                  Z_MPCM_SFXVolumeInput:	equ $1fc4
00000000 =00001FC5                  Z_MPCM_PanInput:	equ $1fc5
00000000 =00001FC6                  Z_MPCM_SFXPanInput:	equ $1fc6
00000000 =00001FD3                  Z_MPCM_LoopId:	equ $1fd3
00000000 =00001FD2                  Z_MPCM_ActiveSamplePitch:	equ $1fd2
00000000 =00001FD9                  Z_MPCM_VBlankActive:	equ $1fd9
00000000 =00001FDA                  Z_MPCM_CalibrationApplied:	equ $1fda
00000000 =00001FDB                  Z_MPCM_CalibrationScore_ROM:	equ $1fdb
00000000 =00001FDD                  Z_MPCM_CalibrationScore_RAM:	equ $1fdd
00000000 =00001FDF                  Z_MPCM_LastErrorCode:	equ $1fdf
00000000 =00000808                  Z_MPCM_SampleTable:	equ $808
00000000 =00000001                  Z_MPCM_COMMAND_STOP:	equ $1
00000000 =00000002                  Z_MPCM_COMMAND_PAUSE:	equ $2
00000000 =00000001                  Z_MPCM_LOOP_IDLE:	equ $1
00000000 =00000002                  Z_MPCM_LOOP_PAUSE:	equ $2
00000000 =00000010                  Z_MPCM_LOOP_PCM:	equ $10
00000000 =00000018                  Z_MPCM_LOOP_PCM_TURBO:	equ $18
00000000 =00000020                  Z_MPCM_LOOP_DPCM:	equ $20
00000000 =00000080                  Z_MPCM_LOOP_CALIBRATION:	equ $80
00000000 =00000000                  Z_MPCM_TYPE_NONE:	equ $0
00000000 =00000002                  Z_MPCM_TYPE_PCM:	equ $2
00000000 =00000004                  Z_MPCM_TYPE_PCM_TURBO:	equ $4
00000000 =00000006                  Z_MPCM_TYPE_DPCM:	equ $6
00000000 =00000008                  Z_MPCM_TYPE_DPCM_TURBO:	equ $8
00000000 =0000000A                  Z_MPCM_TYPE_DPCM_HQ:	equ $a
00000000 =0000000C                  Z_MPCM_TYPE_DPCM_HQ_TURBO:	equ $c
00000000 =00000001                  Z_MPCM_ERROR__BAD_SAMPLE_TYPE:	equ $1
00000000 =00000080                  Z_MPCM_ERROR__UNKNOWN_COMMAND:	equ $80
00000000                            
