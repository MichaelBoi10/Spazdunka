00001DF8                            Pal_DecColor2:				; XREF: Pal_WhiteToBlack
00001DF8 1A11                       		move.b	(a1),d5					; MJ: load blue
00001DFA 3219                       		move.w	(a1)+,d1				; MJ: load green and red
