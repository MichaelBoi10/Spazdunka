0000DB94                            ; ===========================================================================
0000DB94                            ; ---------------------------------------------------------------------------
0000DB94                            ; Object 36 - spikes
0000DB94                            ; ---------------------------------------------------------------------------
0000DB94                            
0000DB94                            Obj36:					; XREF: Obj_Index
0000DB94 7000                       		moveq	#0,d0
0000DB96 1028 0024                  		move.b	$24(a0),d0
0000DB9A 323B 0000                  		move.w	Obj36_Index(pc,d0.w),d1
0000DB9E 4EFB 1000                  		jmp	Obj36_Index(pc,d1.w)
0000DBA2                            ; ===========================================================================
0000DBA2 0000                       Obj36_Index:	dc.w Obj36_Main-Obj36_Index
0000DBA4 0000                       		dc.w Obj36_Solid-Obj36_Index
0000DBA6                            
0000DBA6 0014                       Obj36_Var:	dc.b 0,	$14		; frame	number,	object width
0000DBA8 0110                       		dc.b 1,	$10
0000DBAA 0204                       		dc.b 2,	4
0000DBAC 031C                       		dc.b 3,	$1C
0000DBAE 0440                       		dc.b 4,	$40
0000DBB0 0510                       		dc.b 5,	$10
0000DBB2                            ; ===========================================================================
0000DBB2                            
0000DBB2                            Obj36_Main:				; XREF: Obj36_Index
0000DBB2 5428 0024                  		addq.b	#2,routine(a0)
0000DBB6 217C 0000 0000 0004        		move.l	#Map_obj36,mappings(a0)
0000DBBE 317C 051B 0002             		move.w	#$51B,art_tile(a0)
0000DBC4 0028 0004 0001             		ori.b	#4,render_flags(a0)
0000DBCA 117C 0004 0018             		move.b	#4,priority(a0)
0000DBD0 1028 0028                  		move.b	$28(a0),d0
0000DBD4 0228 000F 0028             		andi.b	#$F,subtype(a0)
0000DBDA 0240 00F0                  		andi.w	#$F0,d0
0000DBDE 43F9 0000 DBA6             		lea	(Obj36_Var).l,a1
0000DBE4 E648                       		lsr.w	#3,d0
0000DBE6 D2C0                       		adda.w	d0,a1
0000DBE8 1159 001A                  		move.b	(a1)+,mapping_frame(a0)
0000DBEC 1159 0019                  		move.b	(a1)+,width_pixels(a0)
0000DBF0 3168 0008 0030             		move.w	8(a0),$30(a0)
0000DBF6 3168 000C 0032             		move.w	$C(a0),$32(a0)
0000DBFC                            
0000DBFC                            Obj36_Solid:				; XREF: Obj36_Index
0000DBFC 6100 0000                  		bsr.w	Obj36_Type0x	; make the object move
0000DC00 343C 0004                  		move.w	#4,d2
0000DC04 0C28 0005 001A             		cmpi.b	#5,mapping_frame(a0)	; is object type $5x ?
0000DC0A 6700                       		beq.s	Obj36_SideWays	; if yes, branch
0000DC0C 0C28 0001 001A             		cmpi.b	#1,mapping_frame(a0)	; is object type $1x ?
0000DC12 6600                       		bne.s	Obj36_Upright	; if not, branch
0000DC14 343C 0014                  		move.w	#$14,d2
0000DC18                            
0000DC18                            ; Spikes types $1x and $5x face	sideways
0000DC18                            
0000DC18                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DC18 323C 001B                  		move.w	#$1B,d1
0000DC1C 3602                       		move.w	d2,d3
0000DC1E 5243                       		addq.w	#1,d3
0000DC20 3828 0008                  		move.w	8(a0),d4
0000DC24 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DC28 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DC2C 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DC30 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DC34 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DC3A 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DC3C 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DC3E 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DC40 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DC42 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DC44                            ; ===========================================================================
0000DC44                            
0000DC44                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DC44                            
0000DC44                            Obj36_Upright:				; XREF: Obj36_Solid
0000DC44 7200                       		moveq	#0,d1
0000DC46 1228 0019                  		move.b	$19(a0),d1
0000DC4A 0641 000B                  		addi.w	#$B,d1
0000DC4E 343C 0010                  		move.w	#$10,d2
0000DC52 363C 0011                  		move.w	#$11,d3
0000DC56 3828 0008                  		move.w	8(a0),d4
0000DC5A 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DC5E 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DC64 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DC66 4A44                       		tst.w	d4			; check response value from SolidObject
0000DC68 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DC6A 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DC6E 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DC72 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DC78 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DC7A 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DC7C 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DC7E 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DC80                            		; otherwise, fall through to Spik_Hurt
0000DC80                            
