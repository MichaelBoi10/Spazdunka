00081DF8                            
00081DF8                            
00081DF8                            ; ------------------------------------------------------------------------------
00081DF8                            ; Plays a given sample
00081DF8                            ; ------------------------------------------------------------------------------
00081DF8                            ; INPUT:
00081DF8                            ;		d0	.b		sample id (>$81)
00081DF8                            ;
00081DF8                            ; EXAMPLES:
00081DF8                            ;		move.b	#$81, d0
00081DF8                            ;		jsr		MegaPCM_PlaySample
00081DF8                            ;
00081DF8                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081DF8                            ;		jsr		MegaPCM_PlaySample
00081DF8                            ; ------------------------------------------------------------------------------
00081DF8                            
00081DF8                            MegaPCM_PlaySample:
00081DF8                            	MPCM_play	d0
00081DF8                          M 	mpcm_stopz80
00081DF8                          M 	pusho
00081DF8                          M 	opt	l-
00081DF8 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081E00                          M 	@wait_11:
00081E00 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081E08 66F6                     M 	bne.s	@wait_11
00081E0A                          M 	popo
00081E0A 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081E10                          M 	mpcm_startz80
00081E10 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081E18 4E75                       	rts
00081E1A                            
00081E1A                            ; ------------------------------------------------------------------------------
00081E1A                            ; Pauses current sample playback
