0001490C                            ; Subroutine called at the peak of a jump that transforms Sonic into Super Sonic
0001490C                            ; if he has enough rings and emeralds
0001490C                            ; ---------------------------------------------------------------------------
0001490C                            
0001490C                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0001490C                            
0001490C                            ; loc_1AB38: test_set_SS:
0001490C                            Sonic_CheckGoSuper:
0001490C 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014910 6600 0000                  	bne.w	return_1ABA4		; if yes, branch
00014914 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
0001491A 6600                       	bne.s	return_1ABA4		; if not, branch
0001491C 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014922 6500                       	bcs.s	return_1ABA4		; if not, branch
00014924 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
00014928 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
0001492C 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014932 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
00014938 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
0001493E 11FC 0001 F7C8             	move.b	#1,($FFFFF7C8).w ; lock	controls
00014944 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
0001494A 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
00014950 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014956 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
0001495C 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014962 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
00014968 303C 00D4                  	move.w	#$D4,d0         ; 
0001496C 4EB9 0000 0FC8             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
00014972 303C 0094                  	move.w	#$94,d0
00014976 4EF9 0000 0FC2             	jmp	(PlaySound).l	; Play the super theme
0001497C                            ; ---------------------------------------------------------------------------
0001497C                            return_1ABA4:
0001497C 4E75                       	rts
0001497E                            ; End of subroutine Sonic_CheckGoSuper
0001497E                            
0001497E                            ; ---------------------------------------------------------------------------
0001497E                            ; Subroutine doing the extra logic for Super Sonic
0001497E                            ; ---------------------------------------------------------------------------
0001497E                            
0001497E                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0001497E                            
0001497E                            ; loc_1ABA6:
0001497E                            Sonic_Super:
0001497E 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; Ignore all this code if not Super Sonic
00014982 6700 0000                  	beq.w	return_1AC3C
00014986 4A38 FE1E                  	tst.b	(Update_HUD_timer).w
0001498A 6700                       	beq.s	Sonic_RevertToNormal ; ?
0001498C 5378 F670                  	subq.w	#1,(Super_Sonic_frame_count).w
00014990 6A00 0000                  	bpl.w	return_1AC3C
00014994 31FC 003C F670             	move.w	#60,(Super_Sonic_frame_count).w	; Reset frame counter to 60
0001499A 4A78 FE20                  	tst.w	(Ring_count).w
0001499E 6700                       	beq.s	Sonic_RevertToNormal
000149A0 0038 0001 FE1D             	ori.b	#1,(Update_HUD_rings).w
000149A6 0C78 0001 FE20             	cmpi.w	#1,(Ring_count).w
000149AC 6700                       	beq.s	@update
000149AE 0C78 000A FE20             	cmpi.w	#10,(Ring_count).w
000149B4 6700                       	beq.s	@update
000149B6 0C78 0064 FE20             	cmpi.w	#100,(Ring_count).w
000149BC 6600                       	bne.s	@update2
000149BE                            @update
000149BE 0038 0080 FE1D             	ori.b	#$80,(Update_HUD_rings).w
000149C4                            @update2
000149C4 5378 FE20                  	subq.w	#1,(Ring_count).w
000149C8 6600                       	bne.s	return_1AC3C
000149CA                            ; loc_1ABF2:
000149CA                            Sonic_RevertToNormal:
000149CA 11FC 0002 F65F             	move.b	#2,(Super_Sonic_palette).w	; Remove rotating palette
000149D0 31FC 0028 F65C             	move.w	#$28,($FFFFF65C).w	; Unknown
000149D6 11FC 0000 FE19             	move.b	#0,(Super_Sonic_flag).w
000149DC 117C 0001 001D             	move.b	#1,next_anim(a0)	; Change animation back to normal ?
000149E2 317C 0001 0032             	move.w	#1,invincibility_time(a0)	; Remove invincibility
000149E8 31FC 0630 F760             	move.w	#$630,(Sonic_top_speed).w
000149EE 31FC 000C F762             	move.w	#$C,(Sonic_acceleration).w
000149F4 31FC 0080 F764             	move.w	#$80,(Sonic_deceleration).w
000149FA 0828 0006 0022             	btst	#6,status(a0)	; Check if underwater, return if not
00014A00 6700                       	beq.s	return_1AC3C
00014A02 31FC 0300 F760             	move.w	#$300,(Sonic_top_speed).w
00014A08 31FC 0006 F762             	move.w	#6,(Sonic_acceleration).w
00014A0E 31FC 0040 F764             	move.w	#$40,(Sonic_deceleration).w
00014A14                            
00014A14                            return_1AC3C:
00014A14 4E75                       	rts
00014A16                            ; End of subroutine Sonic_Super
00014A16                            Sonic_Peelout:
