0001CF50 08E8 0001 0022             		bset	#1,status(a0)
0001CF56 317C F900 0012             		move.w	#-$700,y_vel(a0)
0001CF5C 317C 0050 0010             		move.w	#$50,x_vel(a0)
0001CF62 317C 0000 0014             		move.w	#0,$14(a0)
0001CF68 3168 000C 0038             		move.w	$C(a0),$38(a0)
