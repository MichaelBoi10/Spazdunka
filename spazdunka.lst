00013F56 4A68 0034                  		tst.w	$34(a0)		; check	time remaining
00013F5A 6700                       		beq.s	Obj01_ExitChk
00013F5C 5368 0034                  		subq.w	#1,$34(a0)	; subtract 1 from time
00013F60 6600                       		bne.s	Obj01_ExitChk
