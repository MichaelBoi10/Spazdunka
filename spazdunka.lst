0001E724 4A38 FE1F                  		tst.b	($FFFFFE1F).w	; does the score need updating?
0001E728 6700                       		beq.s	Hud_ChkRings	; if not, branch
0001E72A 4238 FE1F                  		clr.b	($FFFFFE1F).w
0001E72E 203C 5C80 0003             		move.l	#$5C800003,d0	; set VRAM address
0001E734 2238 FE26                  		move.l	($FFFFFE26).w,d1 ; load	score
0001E738 6100 0000                  		bsr.w	Hud_Score
