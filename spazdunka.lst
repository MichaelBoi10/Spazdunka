000150CE                            ; ---------------------------------------------------------------------------
000150CE                            ; Subroutine to	make Sonic run around loops (GHZ/SLZ)
000150CE                            ; ---------------------------------------------------------------------------
000150CE                            
000150CE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000150CE                            
000150CE                            
000150CE                            Sonic_Loops:				; XREF: Obj01_Control
000150CE 0C38 0003 FE10             		cmpi.b	#3,($FFFFFE10).w ; is level SLZ	?
000150D4 6700                       		beq.s	loc_13926	; if yes, branch
000150D6 4A38 FE10                  		tst.b	($FFFFFE10).w	; is level GHZ ?
000150DA 6600 0000                  		bne.w	locret_139C2	; if not, branch
000150DE                            
000150DE                            loc_13926:
000150DE 3028 000C                  		move.w	$C(a0),d0
000150E2 E248                       		lsr.w	#1,d0
000150E4 0240 0380                  		andi.w	#$380,d0
000150E8 1228 0008                  		move.b	8(a0),d1
000150EC 0241 007F                  		andi.w	#$7F,d1
000150F0 D041                       		add.w	d1,d0
000150F2 43F8 A400                  		lea	($FFFFA400).w,a1
000150F6 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
000150FA B238 F7AE                  		cmp.b	($FFFFF7AE).w,d1
000150FE 6700 F6CE                  		beq.w	Obj01_ChkRoll
00015102 B238 F7AF                  		cmp.b	($FFFFF7AF).w,d1
00015106 6700 F6C6                  		beq.w	Obj01_ChkRoll
0001510A B238 F7AC                  		cmp.b	($FFFFF7AC).w,d1
0001510E 6700                       		beq.s	loc_13976
00015110 B238 F7AD                  		cmp.b	($FFFFF7AD).w,d1
00015114 6700                       		beq.s	loc_13966
00015116 08A8 0006 0001             		bclr	#6,render_flags(a0)
0001511C 4E75                       		rts	
0001511E                            ; ===========================================================================
0001511E                            
0001511E                            loc_13966:
0001511E 0828 0001 0022             		btst	#1,status(a0)
00015124 6700                       		beq.s	loc_13976
00015126 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
0001512C 4E75                       		rts	
0001512E                            ; ===========================================================================
0001512E                            
0001512E                            loc_13976:
0001512E 3428 0008                  		move.w	8(a0),d2
00015132 0C02 002C                  		cmpi.b	#$2C,d2
00015136 6400                       		bcc.s	loc_13988
00015138 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
0001513E 4E75                       		rts	
00015140                            ; ===========================================================================
00015140                            
00015140                            loc_13988:
00015140 0C02 00E0                  		cmpi.b	#-$20,d2
00015144 6500                       		bcs.s	loc_13996
00015146 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
0001514C 4E75                       		rts	
0001514E                            ; ===========================================================================
0001514E                            
0001514E                            loc_13996:
0001514E 0828 0006 0001             		btst	#6,render_flags(a0)
00015154 6600                       		bne.s	loc_139B2
00015156 1228 0026                  		move.b	$26(a0),d1
0001515A 6700                       		beq.s	locret_139C2
0001515C 0C01 0080                  		cmpi.b	#-$80,d1
00015160 6200                       		bhi.s	locret_139C2
00015162 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
00015168 4E75                       		rts	
0001516A                            ; ===========================================================================
0001516A                            
0001516A                            loc_139B2:
