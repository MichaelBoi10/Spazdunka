000150D8 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000150DC 6100 FF18                  		bsr.w	SAnim_Do2
000150E0 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000150E4 4E75                       		rts	
000150E6                            ; ===========================================================================
000150E6                            
000150E6                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000150E6 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000150E8 6600                       		bne.s	SAnim_Push	; if not, branch
000150EA 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000150EE 6A00                       		bpl.s	loc_13ADE
000150F0 4442                       		neg.w	d2
