00000000                            ; Processor:	    68000
00000000                            ; Target Assembler: 680x0 Assembler in MRI compatible mode
00000000                            ; This file should be compiled with "as	-M"
00000000                            
00000000                            ; ===========================================================================
00000000                            align:	macro
00000000                            	if (narg=1)
00000000                            	dcb.b (\1-(*%\1))%\1,0
00000000                            	else
00000000                            	dcb.b (\1-(*%\1))%\1,\2
00000000                            	endc
00000000                            	endm
00000000                            	
00000000 =00000000                  	S2MenuNoCheating: = 0
00000000 =00000000                  	FactoryLight: = 0
00000000 =00000001                  	SoundTrack: = 1
00000000 =00000001                  	AntiCheat: = 1
00000000 =00000001                  	Spindash: = 1
00000000 =00000000                  	OGSpazdunka: = 0
00000000 =00000000                  	Michael: = 0
00000000                            	include	"Debugger.asm"
