000152E2 6400                       		bcc.s	loc_13AF0	; if yes, branch
000152E4 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000152EA                            
000152EA                            loc_13AF0:
000152EA 4442                       		neg.w	d2
000152EC 0642 0400                  		addi.w	#$400,d2
000152F0 6A00                       		bpl.s	loc_13AFA
000152F2 7400                       		moveq	#0,d2
000152F4                            
000152F4                            loc_13AFA:
000152F4 E04A                       		lsr.w	#8,d2
000152F6 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000152FA 1228 0022                  		move.b	$22(a0),d1
000152FE 0201 0001                  		andi.b	#1,d1
00015302 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015308 8328 0001                  		or.b	d1,1(a0)
0001530C 6000 FEC2                  		bra.w	SAnim_Do2
00015310                            ; ===========================================================================
