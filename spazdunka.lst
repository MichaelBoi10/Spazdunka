00015278 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
0001527C 6700                       		beq.s	SAnim_NotSuper
0001527E 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
00015284                            
00015284                            SAnim_NotSuper:		
00015284 7000                       		moveq	#0,d0
00015286 1028 001C                  		move.b	$1C(a0),d0
0001528A B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0001528E 6700                       		beq.s	SAnim_Do	; if not, branch
00015290 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
00015294 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
0001529A 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000152A0                            
000152A0                            SAnim_Do:
000152A0 D040                       		add.w	d0,d0
000152A2 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000152A6 1011                       		move.b	(a1),d0
000152A8 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000152AA 1228 0022                  		move.b	$22(a0),d1
000152AE 0201 0001                  		andi.b	#1,d1
000152B2 0228 00FC 0001             		andi.b	#$FC,1(a0)
000152B8 8328 0001                  		or.b	d1,1(a0)
000152BC 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000152C0 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000152C2 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000152C6                            
000152C6                            SAnim_Do2:
000152C6 7200                       		moveq	#0,d1
000152C8 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000152CC 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000152D0 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000152D4 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
000152D6                            
000152D6                            SAnim_Next:
000152D6 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000152DA 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000152DE                            
000152DE                            SAnim_Delay:
000152DE 4E75                       		rts	
000152E0                            ; ===========================================================================
000152E0                            
000152E0                            SAnim_End_FF:
