00000FD4                            PauseGame:				; XREF: Level_MainLoop; et al
00000FD4 4E71                       		nop	
00000FD6 4A38 FE12                  		tst.b	($FFFFFE12).w	; do you have any lives	left?
00000FDA 6700                       		beq.s	Unpause		; if not, branch
00000FDC 4A78 F63A                  		tst.w	($FFFFF63A).w	; is game already paused?
00000FE0 6600                       		bne.s	loc_13BE	; if yes, branch
00000FE2 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
00000FE8 6700                       		beq.s	Pause_DoNothing	; if not, branch
00000FEA                            
00000FEA                            loc_13BE:
00000FEA 31FC 0001 F63A             		move.w	#1,($FFFFF63A).w ; freeze time
00000FF0 11FC 0001 F003             		move.b	#1,($FFFFF003).w ; pause music
00000FF6                            
00000FF6                            loc_13CA:
00000FF6 11FC 0010 F62A             		move.b	#$10,($FFFFF62A).w
00000FFC 6100 0000                  		bsr.w	DelayProgram
00001000 4A38 FFE1                  		tst.b	($FFFFFFE1).w	; is slow-motion cheat on?
00001004 6700                       		beq.s	Pause_ChkStart	; if not, branch
00001006 0838 0006 F605             		btst	#6,($FFFFF605).w ; is button A pressed?
0000100C 6700                       		beq.s	Pause_ChkBC	; if not, branch
0000100E 11FC 0004 F600             		move.b	#4,($FFFFF600).w ; set game mode to 4 (title screen)
00001014 4E71                       		nop	
00001016 6000                       		bra.s	loc_1404
00001018                            ; ===========================================================================
00001018                            
00001018                            Pause_ChkBC:				; XREF: PauseGame
00001018 0838 0004 F604             		btst	#4,($FFFFF604).w ; is button B pressed?
0000101E 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001020 0838 0005 F605             		btst	#5,($FFFFF605).w ; is button C pressed?
00001026 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001028                            
00001028                            Pause_ChkStart:				; XREF: PauseGame
00001028 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
0000102E 67C6                       		beq.s	loc_13CA	; if not, branch
00001030                            
00001030                            loc_1404:				; XREF: PauseGame
00001030 11FC 0080 F003             		move.b	#$80,($FFFFF003).w
00001036                            
00001036                            Unpause:				; XREF: PauseGame
00001036 31FC 0000 F63A             		move.w	#0,($FFFFF63A).w ; unpause the game
0000103C                            
0000103C                            Pause_DoNothing:			; XREF: PauseGame
0000103C 4E75                       		rts	
0000103E                            ; ===========================================================================
0000103E                            
0000103E                            Pause_SlowMo:				; XREF: PauseGame
0000103E 31FC 0001 F63A             		move.w	#1,($FFFFF63A).w
00001044 11FC 0080 F003             		move.b	#$80,($FFFFF003).w
0000104A 4E75                       		rts	
0000104C                            ; End of function PauseGame
