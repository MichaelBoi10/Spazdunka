000151BA                            
000151BA                            Obj01_ResetLevel:			; XREF: Obj01_Index
000151BA 4A68 003A                  		tst.w	$3A(a0)
000151BE 6700                       		beq.s	locret_13914
000151C0 5368 003A                  		subq.w	#1,$3A(a0)	; subtract 1 from time delay
000151C4 6600                       		bne.s	locret_13914
000151C6 31FC 0001 FE02             		move.w	#1,($FFFFFE02).w ; restart the level
000151CC                            
000151CC                            locret_13914:
000151CC 4E75                       		rts	
000151CE                            
000151CE                            Sonic_Loops:				; XREF: Obj01_Control
000151CE 3028 000C                  		move.w	$C(a0),d0
000151D2 E248                       		lsr.w	#1,d0
000151D4 0240 0380                  		andi.w	#$380,d0
000151D8 1228 0008                  		move.b	8(a0),d1
000151DC 0241 007F                  		andi.w	#$7F,d1
000151E0 D041                       		add.w	d1,d0
000151E2 43F8 A400                  		lea	($FFFFA400).w,a1
000151E6 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
000151EA B238 F7AE                  		cmp.b	($FFFFF7AE).w,d1
000151EE 6700 F6E2                  		beq.w	Obj01_ChkRoll
000151F2 B238 F7AF                  		cmp.b	($FFFFF7AF).w,d1
000151F6 6700 F6DA                  		beq.w	Obj01_ChkRoll
000151FA B238 F7AC                  		cmp.b	($FFFFF7AC).w,d1
000151FE 6700                       		beq.s	loc_13976
00015200 B238 F7AD                  		cmp.b	($FFFFF7AD).w,d1
00015204 6700                       		beq.s	loc_13966
00015206 08A8 0007 0022             		bclr	#7,status(a0)
0001520C 4E75                       		rts	
0001520E                            ; ===========================================================================
0001520E                            
0001520E                            loc_13966:
0001520E 0828 0001 0022             		btst	#1,status(a0)
00015214 6700                       		beq.s	loc_13976
00015216 08A8 0007 0022             		bclr	#7,status(a0)	; send Sonic to	high plane
0001521C 4E75                       		rts	
0001521E                            ; ===========================================================================
0001521E                            
0001521E                            loc_13976:
0001521E 3428 0008                  		move.w	8(a0),d2
00015222 0C02 002C                  		cmpi.b	#$2C,d2
00015226 6400                       		bcc.s	loc_13988
00015228 08A8 0007 0022             		bclr	#7,status(a0)	; send Sonic to	high plane
0001522E 4E75                       		rts	
00015230                            ; ===========================================================================
00015230                            
00015230                            loc_13988:
00015230 0C02 00E0                  		cmpi.b	#-$20,d2
00015234 6500                       		bcs.s	loc_13996
00015236 08E8 0007 0022             		bset	#7,status(a0)	; send Sonic to	low plane
0001523C 4E75                       		rts	
0001523E                            ; ===========================================================================
0001523E                            
0001523E                            loc_13996:
0001523E 0828 0007 0022             		btst	#7,status(a0)
00015244 6600                       		bne.s	loc_139B2
00015246 1228 0026                  		move.b	$26(a0),d1
0001524A 6700                       		beq.s	locret_139C2
0001524C 0C01 0080                  		cmpi.b	#-$80,d1
00015250 6200                       		bhi.s	locret_139C2
00015252 08E8 0007 0022             		bset	#7,status(a0)	; send Sonic to	low plane
00015258 4E75                       		rts	
