00014A10                            ; loc_1AB38: test_set_SS:
00014A10                            Sonic_CheckGoSuper:
00014A10 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014A14 6600                       	bne.s	return_1ABA4		; if yes, branch
00014A16 0C38 0006 FE57             	cmpi.b	#6,($FFFFFE57).w	; does Sonic have exactly 6 emeralds?
00014A1C 6600                       	bne.s	return_1ABA4		; if not, branch
00014A1E 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014A24 6500                       	bcs.s	return_1ABA4		; if not, branch
00014A26 4A38 FE1E                  	tst.b	($FFFFFE1E).w	; stop time counter
00014A2A 6700                       	beq.s	return_1ABA4
00014A2C 11FC 0001 F7C8             	move.b	#1,($FFFFF7C8).w ; freeze Sonic
00014A32 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014A38 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
00014A3E 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
