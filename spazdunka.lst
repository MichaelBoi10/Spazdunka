0007F4E4                            ; ------------------------------------------------------------------------------
0007F4E4                            ; Mega PCM API Routines
0007F4E4                            ; ------------------------------------------------------------------------------
0007F4E4                            
0007F4E4                            
0007F4E4                            ; ------------------------------------------------------------------------------
0007F4E4                            ; Plays a given sample
0007F4E4                            ; ------------------------------------------------------------------------------
0007F4E4                            ; INPUT:
0007F4E4                            ;		d0	.b		sample id (>$81)
0007F4E4                            ;
0007F4E4                            ; EXAMPLES:
0007F4E4                            ;		move.b	#$81, d0
0007F4E4                            ;		jsr		MegaPCM_PlaySample
0007F4E4                            ;
0007F4E4                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
0007F4E4                            ;		jsr		MegaPCM_PlaySample
0007F4E4                            ; ------------------------------------------------------------------------------
0007F4E4                            
0007F4E4                            MegaPCM_PlaySample:
0007F4E4                            	MPCM_play	d0
0007F4E4                          M 	mpcm_stopz80
0007F4E4                          M 	pusho
0007F4E4                          M 	opt	l-
0007F4E4 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007F4EC                          M 	@wait_14:
0007F4EC 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007F4F4 66F6                     M 	bne.s	@wait_14
0007F4F6                          M 	popo
0007F4F6 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0007F4FC                          M 	mpcm_startz80
0007F4FC 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007F504 4E75                       	rts
0007F506                            
0007F506                            ; ------------------------------------------------------------------------------
0007F506                            ; Pauses current sample playback
0007F506                            ; ------------------------------------------------------------------------------
0007F506                            
0007F506                            MegaPCM_PausePlayback:
0007F506                            	MPCM_pause
0007F506                          M 	mpcm_stopz80
0007F506                          M 	pusho
0007F506                          M 	opt	l-
0007F506 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007F50E                          M 	@wait_17:
0007F50E 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007F516 66F6                     M 	bne.s	@wait_17
0007F518                          M 	popo
0007F518 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
0007F520                          M 	mpcm_startz80
0007F520 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007F528 4E75                       	rts
