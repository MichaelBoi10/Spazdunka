000149CC                            Sonic_SpinDash:
000149CC 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
000149D0 6600                       		bne.s	loc2_1AC8E		; if set, branch
000149D2 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
000149D8 6600                       		bne.s	locret2_1AC8C		; if not, return
000149DA 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
000149DE 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
000149E2 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
000149E6 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
000149EC 303C 00D1                  		move.w	#$D1,d0			; spin sound ($E0 in s2)
000149F0 4EB9 0000 0FF4             		jsr	(PlaySound_Special).l	; play spin sound
000149F6 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
000149F8 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
000149FE 317C 0000 003A             		move.w	#0,$3A(a0)		; set charge count to 0
00014A04 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
