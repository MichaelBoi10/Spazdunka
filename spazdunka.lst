0007F4E4                            
0007F4E4 =0007D3CC                  MegaPCM_LoadDriver:	equ	MegaPCMLibraryBlob+$0
0007F4E4 =0007D436                  MegaPCM_LoadSampleTable:	equ	MegaPCMLibraryBlob+$6A
0007F4E4 =0007D67C                  MegaPCM:	equ	MegaPCMLibraryBlob+$2B0
