0000E38E E180                       		asl.l	#8,d0		; multiply by $100
0000E390 D680                       		add.l	d0,d3		; add to y-axis	position
0000E392 2142 0008                  		move.l	d2,8(a0)	; update x-axis	position
0000E396 2143 000C                  		move.l	d3,y_pos(a0)	; update y-axis	position
0000E39A 4E75                       		rts	
