0000B240                            ; ---------------------------------------------------------------------------
0000B240                            ; Subroutine to	animate	a sprite using an animation script
0000B240                            ; ---------------------------------------------------------------------------
0000B240                            
0000B240                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B240                            
0000B240                            
0000B240                            AnimateSprite:
0000B240 7000                       		moveq	#0,d0
0000B242 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B246 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B24A 6700                       		beq.s	Anim_Run	; if not, branch
0000B24C 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B250 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B256 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B25C                            
0000B25C                            Anim_Run:
0000B25C 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B260 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B262 D040                       		add.w	d0,d0
0000B264 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B268 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B26C 7200                       		moveq	#0,d1
0000B26E 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B272 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B276 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B278                            
0000B278                            Anim_Next:
0000B278 1200                       		move.b	d0,d1
0000B27A 0200 001F                  		andi.b	#$1F,d0
0000B27E 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B282 1028 0022                  		move.b	$22(a0),d0
0000B286 E719                       		rol.b	#3,d1
0000B288 B101                       		eor.b	d0,d1
0000B28A 0201 0003                  		andi.b	#3,d1
0000B28E 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B294 8328 0001                  		or.b	d1,render_flags(a0)
0000B298 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B29C                            
0000B29C                            Anim_Wait:
0000B29C 4E75                       		rts	
0000B29E                            ; ===========================================================================
0000B29E                            
0000B29E                            Anim_End_FF:
0000B29E 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B2A0 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B2A2 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B2A8 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B2AC 60CA                       		bra.s	Anim_Next
0000B2AE                            ; ===========================================================================
0000B2AE                            
0000B2AE                            Anim_End_FE:
0000B2AE 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B2B0 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B2B2 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B2B6 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B2BA 9200                       		sub.b	d0,d1
0000B2BC 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B2C0 60B6                       		bra.s	Anim_Next
0000B2C2                            ; ===========================================================================
0000B2C2                            
0000B2C2                            Anim_End_FD:
0000B2C2 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B2C4 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B2C6 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B2CC                            
0000B2CC                            Anim_End_FC:
0000B2CC 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B2CE 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B2D0 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B2D4                            
0000B2D4                            Anim_End_FB:
0000B2D4 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B2D6 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B2D8 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B2DE 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B2E2                            
0000B2E2                            Anim_End_FA:
0000B2E2 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B2E4 6600                       		bne.s	Anim_End	; if not, branch
0000B2E6 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B2EA                            
0000B2EA                            Anim_End:
0000B2EA 4E75                       		rts	
0000B2EC                            ; End of function AnimateSprite
