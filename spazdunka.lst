00015386 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
0001538A 6400                       		bhs.s	loc_13AB4	; if yes, branch
0001538C 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
