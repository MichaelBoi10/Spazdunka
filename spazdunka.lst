0000E3F6                            ; Subroutine translating object	speed to update	object position
0000E3F6                            ; ---------------------------------------------------------------------------
0000E3F6                            
0000E3F6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
