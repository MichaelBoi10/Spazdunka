0001CB80                            HurtSonic:
0001CB80 4A38 FE2C                  		tst.b	($FFFFFE2C).w	; does Sonic have a shield?
0001CB84 6600                       		bne.s	Hurt_Shield	; if yes, branch
0001CB86 4A78 FE20                  		tst.w	($FFFFFE20).w	; does Sonic have any rings?
0001CB8A 6700 0000                  		beq.w	Hurt_NoRings	; if not, branch
