00081E4E 66F6                     M 	bne.s	@wait_17
00081E50                          M 	popo
00081E50 13FC 0000 00A0 0001      M 	move.b	#0,mpcm_z80_ram+z_mpcm_commandinput
00081E58                          M 	mpcm_startz80
00081E58 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081E60 4E75                       	rts
