00000000                            
00000000                            ; Processor:	    68000
00000000                            ; Target Assembler: 680x0 Assembler in MRI compatible mode
00000000                            ; This file should be compiled with "as	-M"
00000000                            
00000000                            ; ===========================================================================
00000000                            align:	macro
00000000                            	if (narg=1)
00000000                            	dcb.b (\1-(*%\1))%\1,0
00000000                            	else
00000000                            	dcb.b (\1-(*%\1))%\1,\2
00000000                            	endc
00000000                            	endm
00000000                            	
00000000 =00000000                  	S2MenuNoCheating: = 0 ; Makes so if you manage to activate the Level Select menu via
00000000                            						  ; Game Genie codes, you will get softlocked, and will need to
00000000                            						  ; Hard Reset the game.
00000000                            	
00000000                            	
00000000 =00000000                  	FactoryLight: = 0 ; The way the first demo (including HotFix) managed to make you
00000000                            					  ; only play Polluted Hill (even tho, confirming by the name you
00000000                            					  ; were meant to only play Factory Light Zone)
00000000                            	
00000000                            	
00000000 =00000001                  	SoundTrack: = 1 ; Set to 0, and it will now start playing the soundtrack from the
00000000                            					; OG Sonic Spazdunka, might get some errors if set to 1.
00000000                            
00000000                            	;AntiCheat: = 0 ; I think this just makes ceirtan stages crash? Fully Scrapped.
00000000                            	
00000000                            	
00000000 =00000001                  	Spindash: = 1 ; Why tf does ts exist? Scrapped.
00000000                            	
00000000 =00000001                  	OGSpazdunka: = 1 ;  Scrapped, fully scrapped.
00000000                            	
00000000 =00000000                  	Michael: = 0 ; Made so Sonic's palette is replaced with the recolor of them
00000000                            				 ; creator of this hack, Scrapped.
