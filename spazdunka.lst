00000000                            ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
00000000                            smpsModSet macro wait,speed,change,step
00000000                            	dc.b	$F0
00000000                            				   
00000000                            	dc.b	wait,speed,change,step
00000000                            	 
00000000                            							 
00000000                            	  
00000000                            						
00000000                            	endm
