000148DE 6700 0000                  	beq.w	return_1AC3C
000148E2 4A38 FE1E                  	tst.b	(Update_HUD_timer).w
000148E6 6700                       	beq.s	Sonic_RevertToNormal ; ?
000148E8 5378 F670                  	subq.w	#1,(Super_Sonic_frame_count).w
000148EC 6A00 0000                  	bpl.w	return_1AC3C
000148F0 31FC 003C F670             	move.w	#60,(Super_Sonic_frame_count).w	; Reset frame counter to 60
000148F6 4A78 FE20                  	tst.w	(Ring_count).w
000148FA 6700                       	beq.s	Sonic_RevertToNormal
000148FC 0038 0001 FE1D             	ori.b	#1,(Update_HUD_rings).w
00014902 0C78 0001 FE20             	cmpi.w	#1,(Ring_count).w
00014908 6700                       	beq.s	@update
0001490A 0C78 000A FE20             	cmpi.w	#10,(Ring_count).w
00014910 6700                       	beq.s	@update
00014912 0C78 0064 FE20             	cmpi.w	#100,(Ring_count).w
00014918 6600                       	bne.s	@update2
