0000DD24                            Obj36_Main:				; XREF: Obj36_Index
0000DD24 5428 0024                  		addq.b	#2,routine(a0)
0000DD28 217C 0000 0000 0004        		move.l	#Map_obj36,mappings(a0)
0000DD30 317C 051B 0002             		move.w	#$51B,art_tile(a0)
0000DD36 0028 0004 0001             		ori.b	#4,render_flags(a0)
