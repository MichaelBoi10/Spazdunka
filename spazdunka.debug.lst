00083302                            ; ------------------------------------------------------------------------------
00083302                            ; Plays a given sample
00083302                            ; ------------------------------------------------------------------------------
00083302                            ; INPUT:
00083302                            ;		d0	.b		sample id (>$81)
00083302                            ;
00083302                            ; EXAMPLES:
00083302                            ;		move.b	#$81, d0
00083302                            ;		jsr		MegaPCM_PlaySample
00083302                            ;
00083302                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00083302                            ;		jsr		MegaPCM_PlaySample
00083302                            ; ------------------------------------------------------------------------------
00083302                            
00083302                            MegaPCM_PlaySample:
00083302                            	MPCM_play	d0
00083302                          M 	mpcm_stopz80
00083302                          M 	pusho
00083302                          M 	opt	l-
00083302 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0008330A                          M 	@wait_78:
0008330A 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00083312 66F6                     M 	bne.s	@wait_78
00083314                          M 	popo
00083314 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0008331A                          M 	mpcm_startz80
0008331A 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00083322 4E75                       	rts
