0000B2B0                            ; ---------------------------------------------------------------------------
0000B2B0                            ; Subroutine to	animate	a sprite using an animation script
0000B2B0                            ; ---------------------------------------------------------------------------
0000B2B0                            
0000B2B0                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B2B0                            
0000B2B0                            
0000B2B0                            AnimateSprite:
0000B2B0 7000                       		moveq	#0,d0
0000B2B2 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B2B6 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B2BA 6700                       		beq.s	Anim_Run	; if not, branch
0000B2BC 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B2C0 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B2C6 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B2CC                            
0000B2CC                            Anim_Run:
0000B2CC 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B2D0 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B2D2 D040                       		add.w	d0,d0
0000B2D4 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B2D8 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B2DC 7200                       		moveq	#0,d1
0000B2DE 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B2E2 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B2E6 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B2E8                            
0000B2E8                            Anim_Next:
0000B2E8 1200                       		move.b	d0,d1
0000B2EA 0200 001F                  		andi.b	#$1F,d0
0000B2EE 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B2F2 1028 0022                  		move.b	$22(a0),d0
0000B2F6 E719                       		rol.b	#3,d1
0000B2F8 B101                       		eor.b	d0,d1
0000B2FA 0201 0003                  		andi.b	#3,d1
0000B2FE 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B304 8328 0001                  		or.b	d1,render_flags(a0)
0000B308 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B30C                            
0000B30C                            Anim_Wait:
0000B30C 4E75                       		rts	
0000B30E                            ; ===========================================================================
0000B30E                            
0000B30E                            Anim_End_FF:
0000B30E 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B310 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B312 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B318 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B31C 60CA                       		bra.s	Anim_Next
0000B31E                            ; ===========================================================================
0000B31E                            
0000B31E                            Anim_End_FE:
0000B31E 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B320 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B322 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B326 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B32A 9200                       		sub.b	d0,d1
0000B32C 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B330 60B6                       		bra.s	Anim_Next
0000B332                            ; ===========================================================================
0000B332                            
0000B332                            Anim_End_FD:
0000B332 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B334 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B336 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B33C                            
0000B33C                            Anim_End_FC:
0000B33C 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B33E 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B340 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B344                            
0000B344                            Anim_End_FB:
0000B344 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B346 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B348 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B34E 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B352                            
0000B352                            Anim_End_FA:
0000B352 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B354 6600                       		bne.s	Anim_End	; if not, branch
0000B356 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B35A                            
0000B35A                            Anim_End:
0000B35A 4E75                       		rts	
