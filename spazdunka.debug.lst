000834E7                            @Str_PitchNotSet:
000834E7 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
0008353E                            @Str_WaveInvalidHeader:
0008353E 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
0008355E                            @Str_WaveBadAudioFormat:
