00014B6E                             
00014B6E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014B6E                             
00014B6E                             
00014B6E                            Sonic_SpinDash:
00014B6E 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
00014B72 6600                       		bne.s	loc2_1AC8E		; if set, branch
00014B74 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
00014B7A 6600                       		bne.s	locret2_1AC8C		; if not, return
00014B7C 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014B80 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
00014B84 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
00014B88 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
00014B8E 303C 00D2                  		move.w	#$D2,d0			; spin sound ($E0 in s2)
00014B92 4EB9 0000 1008             		jsr	(PlaySound_Special).l	; play spin sound
00014B98 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014B9A 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
00014BA0 317C 0000 003A             		move.w	#0,$3A(a0)		; set charge count to 0
00014BA6 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
00014BAC 6500                       		bcs.s	loc2_1AC84		; ??? branch if carry
00014BAE 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014BB4                            						; the smoke/dust object
00014BB4                            loc2_1AC84:
00014BB4 6100 FB9C                  		bsr.w	Sonic_LevelBound
00014BB8 6100 0000                  		bsr.w	Sonic_AnglePos
