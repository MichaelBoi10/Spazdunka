0001E6C4                            HUD_Show:                        ; Routine 2
0001E6C4                            
0001E6C4 0C68 0090 0008                         cmpi.w  #$90,8(a0)    ; has HUD reached $90 x-position?
0001E6CA 6400                                   bcc.s   HUD_Flash        ; go to HUD_Flash if x-pos is higher or equal
0001E6CC 5C68 0008                              addq.w  #6,8(a0)        ; move HUD to the right
0001E6D0 4EF9 0000 E50E                         jmp    (DisplaySprite).l
0001E6D6                            
0001E6D6                            HUD_Flash:    ; Routine 2
0001E6D6 4A38 FE1E                          tst.b  ($FFFFFE1E).w  ; Is the timer active?
0001E6DA 6600                               bne.s  HUD_Display      ; If so, branch
0001E6DC 5428 0024                          addq.b #2,$24(a0) ; Go to HUD move routine
0001E6E0                            
0001E6E0                            HUD_Display:
0001E6E0 4A78 FE20                          tst.w    ($FFFFFE20).w    ; do you have any rings?
0001E6E4 6700                               beq.s    @norings    ; if not, branch
0001E6E6 4228 001A                          clr.b	$1A(a0)		; make all counters yellow
0001E6EA 4EF9 0000 E50E             		jmp	(DisplaySprite).l
0001E6F0                            ; ===========================================================================
0001E6F0                            
0001E6F0                            @norings:
