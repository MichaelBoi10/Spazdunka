000151BE 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
000151C2 7200                       		moveq	#0,d1
000151C4 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
000151C8 1428 0022                  		move.b	$22(a0),d2
000151CC 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
000151D0 6600                       		bne.s	loc_13A70	; if yes, branch
000151D2 4600                       		not.b	d0		; reverse angle
000151D4                            
000151D4                            loc_13A70:
000151D4 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
000151D8 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
000151DA 7203                       		moveq	#3,d1
000151DC                            
000151DC                            loc_13A78:
000151DC 0228 00FC 0001             		andi.b	#$FC,1(a0)
000151E2 B302                       		eor.b	d1,d2
000151E4 8528 0001                  		or.b	d2,1(a0)
000151E8 0828 0005 0022             		btst	#5,$22(a0)
000151EE 6600 0000                  		bne.w	SAnim_Push
000151F2 E808                       		lsr.b	#4,d0		; divide angle by $10
000151F4 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
000151F8 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000151FC 6A00                       		bpl.s	loc_13A9C
000151FE 4442                       		neg.w	d2
00015200                            
