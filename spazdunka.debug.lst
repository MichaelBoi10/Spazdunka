0000DD68 3168 000C 0032             		move.w	$C(a0),$32(a0)
0000DD6E                            
0000DD6E                            Obj36_Solid:				; XREF: Obj36_Index
0000DD6E 6100 0000                  		bsr.w	Obj36_Type0x	; make the object move
0000DD72 343C 0004                  		move.w	#4,d2
0000DD76 0C28 0005 001A             		cmpi.b	#5,mapping_frame(a0)	; is object type $5x ?
0000DD7C 6700                       		beq.s	Obj36_SideWays	; if yes, branch
0000DD7E 0C28 0001 001A             		cmpi.b	#1,mapping_frame(a0)	; is object type $1x ?
0000DD84 6600                       		bne.s	Obj36_Upright	; if not, branch
0000DD86 343C 0014                  		move.w	#$14,d2
0000DD8A                            
0000DD8A                            ; Spikes types $1x and $5x face	sideways
0000DD8A                            
0000DD8A                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DD8A 323C 001B                  		move.w	#$1B,d1
0000DD8E 3602                       		move.w	d2,d3
0000DD90 5243                       		addq.w	#1,d3
0000DD92 3828 0008                  		move.w	8(a0),d4
0000DD96 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DD9A 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DD9E 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DDA2 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DDA6 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DDAC 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DDAE 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DDB0 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DDB2 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DDB4 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DDB6                            ; ===========================================================================
0000DDB6                            
0000DDB6                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DDB6                            
0000DDB6                            Obj36_Upright:				; XREF: Obj36_Solid
0000DDB6 7200                       		moveq	#0,d1
0000DDB8 1228 0019                  		move.b	$19(a0),d1
0000DDBC 0641 000B                  		addi.w	#$B,d1
0000DDC0 343C 0010                  		move.w	#$10,d2
0000DDC4 363C 0011                  		move.w	#$11,d3
0000DDC8 3828 0008                  		move.w	8(a0),d4
0000DDCC 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DDD0 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DDD6 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DDD8 4A44                       		tst.w	d4			; check response value from SolidObject
0000DDDA 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DDDC 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DDE0 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DDE4 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DDEA 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DDEC 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DDEE 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DDF0 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DDF2                            		; otherwise, fall through to Spik_Hurt
0000DDF2                            
0000DDF2                            Obj36_Hurt:				; XREF: Obj36_SideWays; Obj36_Upright
0000DDF2 4A38 FE2D                  		tst.b	($FFFFFE2D).w	; is Sonic invincible?
0000DDF6 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DDF8 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DDFC 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
0000DDFE 2F08                       		move.l	a0,-(sp)
0000DE00 2448                       		movea.l	a0,a2
0000DE02 41F8 D000                  		lea	($FFFFD000).w,a0
0000DE06 0C28 0004 0024             		cmpi.b	#4,routine(a0)
0000DE0C 6400                       		bcc.s	loc_CF20
