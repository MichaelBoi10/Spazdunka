0007F804                            @ErrorCodeToDescription:
0007F804                            	;		Raw error code								  String pointer
0007F804 0000 0000                  	dc.l	(MPCM_ST_TOO_MANY_SAMPLES<<24) 				| @Str_TooManySamples
0007F808 0000 0000                  	dc.l	(MPCM_ST_UNKNOWN_SAMPLE_TYPE<<24)			| @Str_UnknownSampleType
0007F80C 0000 0000                  	dc.l	(MPCM_ST_PITCH_NOT_SET<<24)					| @Str_PitchNotSet
0007F810 0000 0000                  	dc.l	(MPCM_ST_WAVE_INVALID_HEADER<<24)			| @Str_WaveInvalidHeader
0007F814 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_AUDIO_FORMAT<<24)			| @Str_WaveBadAudioFormat
0007F818 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_MONO<<24)					| @Str_WaveNotMono
0007F81C 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_8BIT<<24)					| @Str_WaveNot8bit
0007F820 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_SAMPLE_RATE<<24)			| @Str_WaveBadSampleRate
0007F824 0000 0000                  	dc.l	(MPCM_ST_WAVE_MISSING_DATA_CHUNK<<24)		| @Str_WaveMissingDataChunk
0007F828 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_UNSUPPORTED_VERSION<<24)	| @Str_DpcmHqUnsupportedVersion
0007F82C 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_BAD_SAMPLE_RATE<<24)		| @Str_DpcmHqBadSampleRate
0007F830 FF00                       	dc.b	$FF, 0		; end marker
0007F832                            
0007F832                            ; ------------------------------------------------------------------------------
0007F832                            @Str_TooManySamples:
0007F832 546F 6F20 6D61 6E79 2073+  	dc.b	"Too many samples in table", 0
0007F84C                            @Str_UnknownSampleType:
0007F84C 556E 6B6E 6F77 6E20 7361+  	dc.b	"Unknown sample type or missing end marker. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE", 0
0007F8B9                            @Str_PitchNotSet:
0007F8B9 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
0007F910                            @Str_WaveInvalidHeader:
0007F910 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
0007F930                            @Str_WaveBadAudioFormat:
0007F930 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported audio format. Only PCM is supported", 0
0007F96C                            @Str_WaveNotMono:
0007F96C 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be mono", 0
0007F98B                            @Str_WaveNot8bit:
0007F98B 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be 8-bit unsigned PCM", 0
0007F9B8                            @Str_WaveBadSampleRate:
0007F9B8 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported sample rate. Use <=\#TYPE_PCM_MAX_RATE\ Hz for TYPE_PCM or \#TYPE_PCM_TURBO_MAX_RATE\ Hz for TYPE_PCM_TURBO.", 0
0007FA19                            @Str_WaveMissingDataChunk:
0007FA19 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Failed to locate 'data' chunk", 0
0007FA43                            @Str_DpcmHqUnsupportedVersion:
0007FA43 4450 434D 2D48 5120 6572+  	dc.b	"DPCM-HQ error: Unsupported version specified in header", 0
0007FA7A                            @Str_DpcmHqBadSampleRate:
0007FA7A 4450 434D 2D48 5120 6572+  	dc.b	"DPCM-HQ error: Unsupported sample rate. Use <=\#TYPE_DPCM_MAX_RATE\ Hz for TYPE_DPCM or \#TYPE_DPCM_TURBO_MAX_RATE\ Hz for TYPE_DPCM_TURBO.", 0
0007FAE0                            @Str_UnknownError:
0007FAE0 556B 6E6F 776E 2065 7272+  	dc.b	"Uknown error code", 0
