00006380                            ; ---------------------------------------------------------------------------
00006380                            ; Level size array
00006380                            ; ---------------------------------------------------------------------------
00006380                            
00006380                            lvlsize macro left,right,top,bottom
00006380                            	; $0004 is an unused value, $0060 is the default vertical screen shift.
00006380                            	; Both are always the same and redundant.
00006380                            	dc.w $0004, left, right, top, bottom, $0060
00006380                            	endm
00006380                            
00006380                            ; ---------------------------------------------------------------------------
00006380                            
00006380                            LevelSizeArray:
00006380                            		;           |---------------------------------Left boundary
00006380                            		;           |      |--------------------------Right boundary
00006380                            		;           |      |      |-------------------Top boundary
00006380                            		;           |      |      |      |------------Bottom boundary
00006380                            		; GHZ       |      |      |      |
00006380                            		lvlsize     0, $32BF,     0,  $349 ; GHZ1
00006380 0004 0000 32BF 0000 0349+M 	dc.w	$0004,left,right,top,bottom,$0060
0000638C                            		lvlsize     0, $1EBF,     0,  $300 ; GHZ2
0000638C 0004 0000 1EBF 0000 0300+M 	dc.w	$0004,left,right,top,bottom,$0060
00006398                            		lvlsize     0, $2960,     0,  $300 ; GHZ3
00006398 0004 0000 2960 0000 0300+M 	dc.w	$0004,left,right,top,bottom,$0060
000063A4                            		lvlsize     0, $2ABF,     0,  $300 ; GHZ4 (unused)
000063A4 0004 0000 2ABF 0000 0300+M 	dc.w	$0004,left,right,top,bottom,$0060
000063B0                            		; LZ                          
000063B0                            		lvlsize     0, $19BF,     0,  $530 ; LZ1
000063B0 0004 0000 19BF 0000 0530+M 	dc.w	$0004,left,right,top,bottom,$0060
000063BC                            		lvlsize     0, $10AF,     0,  $720 ; LZ2
000063BC 0004 0000 10AF 0000 0720+M 	dc.w	$0004,left,right,top,bottom,$0060
000063C8                            		lvlsize     0, $202F, -$100,  $800 ; LZ3 (level wrapping)
000063C8 0004 0000 202F FF00 0800+M 	dc.w	$0004,left,right,top,bottom,$0060
000063D4                            		lvlsize     0, $20BF,     0,  $720 ; LZ4 (SBZ3)
000063D4 0004 0000 20BF 0000 0720+M 	dc.w	$0004,left,right,top,bottom,$0060
000063E0                            		; MZ                          
000063E0                            		lvlsize     0, $17BF,     0,  $1D0 ; MZ1
000063E0 0004 0000 17BF 0000 01D0+M 	dc.w	$0004,left,right,top,bottom,$0060
000063EC                            		lvlsize     0, $17BF,     0,  $520 ; MZ2
000063EC 0004 0000 17BF 0000 0520+M 	dc.w	$0004,left,right,top,bottom,$0060
000063F8                            		lvlsize     0, $1800,     0,  $720 ; MZ3
000063F8 0004 0000 1800 0000 0720+M 	dc.w	$0004,left,right,top,bottom,$0060
00006404                            		lvlsize     0, $16BF,     0,  $720 ; MZ4 (unused)
00006404 0004 0000 16BF 0000 0720+M 	dc.w	$0004,left,right,top,bottom,$0060
00006410                            		; SLZ                         
00006410                            		lvlsize     0, $1FBF,     0,  $640 ; SLZ1
00006410 0004 0000 1FBF 0000 0640+M 	dc.w	$0004,left,right,top,bottom,$0060
0000641C                            		lvlsize     0, $1FBF,     0,  $640 ; SLZ2
0000641C 0004 0000 1FBF 0000 0640+M 	dc.w	$0004,left,right,top,bottom,$0060
00006428                            		lvlsize     0, $2000,     0,  $6C0 ; SLZ3
00006428 0004 0000 2000 0000 06C0+M 	dc.w	$0004,left,right,top,bottom,$0060
00006434                            		lvlsize     0, $3EC0,     0,  $720 ; SLZ4 (unused)
00006434 0004 0000 3EC0 0000 0720+M 	dc.w	$0004,left,right,top,bottom,$0060
00006440                            		; SYZ                         
00006440                            		lvlsize     0, $22C0,     0,  $420 ; SYZ1
00006440 0004 0000 22C0 0000 0420+M 	dc.w	$0004,left,right,top,bottom,$0060
0000644C                            		lvlsize     0, $28C0,     0,  $520 ; SYZ2
0000644C 0004 0000 28C0 0000 0520+M 	dc.w	$0004,left,right,top,bottom,$0060
00006458                            		lvlsize     0, $2C00,     0,  $620 ; SYZ3
00006458 0004 0000 2C00 0000 0620+M 	dc.w	$0004,left,right,top,bottom,$0060
00006464                            		lvlsize     0, $2EC0,     0,  $620 ; SYZ4 (unused)
00006464 0004 0000 2EC0 0000 0620+M 	dc.w	$0004,left,right,top,bottom,$0060
00006470                            		; SBZ                         
00006470                            		lvlsize     0, $21C0,     0,  $720 ; SBZ1
00006470 0004 0000 21C0 0000 0720+M 	dc.w	$0004,left,right,top,bottom,$0060
0000647C                            		lvlsize     0, $1E40, -$100,  $800 ; SBZ2 (level wrapping)
0000647C 0004 0000 1E40 FF00 0800+M 	dc.w	$0004,left,right,top,bottom,$0060
00006488                            		lvlsize $2080, $2460,  $510,  $510 ; SBZ3 (FZ)
00006488 0004 2080 2460 0510 0510+M 	dc.w	$0004,left,right,top,bottom,$0060
00006494                            		lvlsize     0, $3EC0,     0,  $720 ; SBZ4 (unused)
00006494 0004 0000 3EC0 0000 0720+M 	dc.w	$0004,left,right,top,bottom,$0060
000064A0                            		; Ending
000064A0                            		lvlsize     0,  $1A00,  $110,  $120 ; good ending
000064A0 0004 0000 1A00 0110 0120+M 	dc.w	$0004,left,right,top,bottom,$0060
000064AC                            		lvlsize     0,  $DC0,  $110,  $120 ; bad ending
000064AC 0004 0000 0DC0 0110 0120+M 	dc.w	$0004,left,right,top,bottom,$0060
000064B8                            		lvlsize     0, $2FFF,     0,  $320 ; (unused)
000064B8 0004 0000 2FFF 0000 0320+M 	dc.w	$0004,left,right,top,bottom,$0060
000064C4                            		lvlsize     0, $2FFF,     0,  $320 ; (unused)
000064C4 0004 0000 2FFF 0000 0320+M 	dc.w	$0004,left,right,top,bottom,$0060
