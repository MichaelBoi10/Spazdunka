00014772                            ; ---------------------------------------------------------------------------
00014772                            ; Subroutine called at the peak of a jump that transforms Sonic into Super Sonic
00014772                            ; if he has enough rings and emeralds
00014772                            ; ---------------------------------------------------------------------------
00014772                            
00014772                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00014772                            
00014772                            ; loc_1AB38: test_set_SS:
00014772                            Sonic_CheckGoSuper:
00014772 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014776 6600 0000                  	bne.w	return_1ABA4		; if yes, branch
0001477A 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
00014780 6600                       	bne.s	return_1ABA4		; if not, branch
00014782 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014788 6500                       	bcs.s	return_1ABA4		; if not, branch
0001478A 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
0001478E 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
00014792 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014798 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
0001479E 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
000147A4 11FC 0001 F7C8             	move.b	#1,($FFFFF7C8).w ; lock	controls
000147AA 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
000147B0 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
000147B6 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
000147BC 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
000147C2 317C 0000 0032             	move.w	#0,invincibility_time(a0)
000147C8 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
000147CE 303C 00D4                  	move.w	#$D4,d0         ; 
000147D2 4EB9 0000 1034             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
000147D8 303C 0087                  	move.w	#$87,d0
000147DC 4EF9 0000 102E             	jmp	(PlaySound).l	; Play the super theme
000147E2                            ; ---------------------------------------------------------------------------
000147E2                            return_1ABA4:
000147E2 4E75                       	rts
000147E4                            ; End of subroutine Sonic_CheckGoSuper
