000149BE                            Sonic_Super:
000149BE 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; Ignore all this code if not Super Sonic
000149C2 6700 0000                  	beq.w	return_1AC3C
000149C6 4A38 FE1E                  	tst.b	(Update_HUD_timer).w
000149CA 6700                       	beq.s	Sonic_RevertToNormal ; ?
000149CC 5378 F670                  	subq.w	#1,(Super_Sonic_frame_count).w
000149D0 6A00 0000                  	bpl.w	return_1AC3C
000149D4 31FC 003C F670             	move.w	#60,(Super_Sonic_frame_count).w	; Reset frame counter to 60
000149DA 4A78 FE20                  	tst.w	(Ring_count).w
000149DE 6700                       	beq.s	Sonic_RevertToNormal
000149E0 0038 0001 FE1D             	ori.b	#1,(Update_HUD_rings).w
000149E6 0C78 0001 FE20             	cmpi.w	#1,(Ring_count).w
000149EC 6700                       	beq.s	@update
000149EE 0C78 000A FE20             	cmpi.w	#10,(Ring_count).w
000149F4 6700                       	beq.s	@update
000149F6 0C78 0064 FE20             	cmpi.w	#100,(Ring_count).w
000149FC 6600                       	bne.s	@update2
