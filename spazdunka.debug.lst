00005C4C 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005C4E 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005C52 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005C54 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
