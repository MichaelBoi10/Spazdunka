0000DBD4 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DBD6 4A44                       		tst.w	d4			; check response value from SolidObject
0000DBD8 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
