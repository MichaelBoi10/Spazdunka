00083158                            ; ------------------------------------------------------------------------------
00083158                            ; Plays a given sample
00083158                            ; ------------------------------------------------------------------------------
00083158                            ; INPUT:
00083158                            ;		d0	.b		sample id (>$81)
00083158                            ;
00083158                            ; EXAMPLES:
00083158                            ;		move.b	#$81, d0
00083158                            ;		jsr		MegaPCM_PlaySample
00083158                            ;
00083158                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00083158                            ;		jsr		MegaPCM_PlaySample
00083158                            ; ------------------------------------------------------------------------------
00083158                            
00083158                            MegaPCM_PlaySample:
00083158                            	MPCM_play	d0
00083158                          M 	mpcm_stopz80
00083158                          M 	pusho
00083158                          M 	opt	l-
00083158 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00083160                          M 	@wait_47:
00083160 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00083168 66F6                     M 	bne.s	@wait_47
0008316A                          M 	popo
0008316A 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00083170                          M 	mpcm_startz80
00083170 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00083178 4E75                       	rts
0008317A                            
