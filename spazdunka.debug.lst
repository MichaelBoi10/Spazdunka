0001F006                            ; Main level load blocks
0001F006                            ; ---------------------------------------------------------------------------
0001F006                            MainLoadBlocks:
0001F006                            	include "_inc\Main level load blocks.asm"
0001F006                            ; ---------------------------------------------------------------------------
0001F006                            ; Main level load blocks
0001F006                            ;
0001F006                            ; ===FORMAT===
0001F006                            ; level	patterns + (1st	PLC num	* 10^6)
0001F006                            ; 16x16	mappings + (2nd	PLC num	* 10^6)
0001F006                            ; 256x256 mappings
