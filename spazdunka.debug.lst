0001F11A 0000 0000                  	dc.l Blk256_SYZ
0001F11E 0085 0808                  	dc.b 0,	$85, 8,	8
0001F122 0000 0000                  	dc.l Kos_SBZ+$E000000
0001F126 0000 0000                  	dc.l Blk16_SBZ+$F000000
0001F12A 0000 0000                  	dc.l Blk256_SBZ
0001F12E 0086 0909                  	dc.b 0,	$86, 9,	9
