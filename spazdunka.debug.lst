00083290                            	opt		l-
00083290                            
00083290                            ; ------------------------------------------------------------------------------
00083290                            ; DEBUGGER: Displays details for `MegaPCM_LoadSampleTable` error code
00083290                            ; ------------------------------------------------------------------------------
00083290                            ; INPUT:
00083290                            ;		d0	.w	Error code returned by `MegaPCM_LoadSampleTable`
00083290                            ;		a0		Pointer to faulty sample
00083290                            ; ------------------------------------------------------------------------------
00083290                            
00083290                            MPCM_Debugger_LoadSampleTableException:
00083290                            
00083290                            	; Print raw error code
00083290                            	Console.Write "%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00083290 40E7                     M 	move.w	sr,-(sp)
00083292                          M 	_console.write	<"%<pal1>Error code: %<pal0>%<.b d0>%<endl>">,<>
00083292                          M 	__fstring_generateargumentscode	"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00083292 =00000001                M 	__pos:	= instr("%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'%<')
00083292 =00000000                M 	__stack:=	0
00083292 =00000000                M 	__sp:	= 0
00083292                          M 	pusho
00083292                          M 	opt	ae-
00083292                          M 	while	(__pos)
00083292 =00000007                M 	__endpos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'>')
00083292 =0000000D                M 	__midpos:	= instr(__pos+5,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",' ')
00083292 =00000007                M 	__midpos:	= __endpos
00083292                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00083292                          M 	__type:	substr __pos+1+1,__pos+1+1+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00083292 =00000014                M 	__pos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'%<')
00083292 =0000001A                M 	__endpos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'>')
00083292 =0000001F                M 	__midpos:	= instr(__pos+5,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",' ')
00083292 =0000001A                M 	__midpos:	= __endpos
00083292                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
