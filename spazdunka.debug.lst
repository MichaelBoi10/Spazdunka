00015350 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015354 6700                       		beq.s	SAnim_NotSuper
00015356 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
0001535C                            
0001535C                            SAnim_NotSuper:		
0001535C 7000                       		moveq	#0,d0
0001535E 1028 001C                  		move.b	$1C(a0),d0
00015362 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00015366 6700                       		beq.s	SAnim_Do	; if not, branch
00015368 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
0001536C 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00015372 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00015378                            
00015378                            SAnim_Do:
00015378 D040                       		add.w	d0,d0
0001537A D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0001537E 1011                       		move.b	(a1),d0
00015380 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00015382 1228 0022                  		move.b	$22(a0),d1
00015386 0201 0001                  		andi.b	#1,d1
0001538A 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015390 8328 0001                  		or.b	d1,1(a0)
00015394 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015398 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
0001539A 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
0001539E                            
0001539E                            SAnim_Do2:
0001539E 7200                       		moveq	#0,d1
000153A0 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000153A4 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000153A8 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000153AC 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
000153AE                            
000153AE                            SAnim_Next:
000153AE 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000153B2 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000153B6                            
000153B6                            SAnim_Delay:
000153B6 4E75                       		rts	
000153B8                            ; ===========================================================================
000153B8                            
000153B8                            SAnim_End_FF:
000153B8 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000153BA 6600                       		bne.s	SAnim_End_FE	; if not, branch
000153BC 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
000153C2 1029 0001                  		move.b	1(a1),d0	; read sprite number
000153C6 60E6                       		bra.s	SAnim_Next
000153C8                            ; ===========================================================================
000153C8                            
000153C8                            SAnim_End_FE:
000153C8 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
000153CA 6600                       		bne.s	SAnim_End_FD	; if not, branch
000153CC 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
000153D0 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
000153D4 9200                       		sub.b	d0,d1
000153D6 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
000153DA 60D2                       		bra.s	SAnim_Next
000153DC                            ; ===========================================================================
000153DC                            
000153DC                            SAnim_End_FD:
000153DC 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
000153DE 6600                       		bne.s	SAnim_End	; if not, branch
000153E0 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
000153E6                            
000153E6                            SAnim_End:
000153E6 4E75                       		rts	
000153E8                            ; ===========================================================================
000153E8                            
000153E8                            SAnim_WalkRun:				; XREF: SAnim_Do
000153E8 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000153EC 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
000153EE 5200                       		addq.b	#1,d0		; is animation walking/running?
000153F0 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
000153F4 7200                       		moveq	#0,d1
000153F6 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
000153FA 1428 0022                  		move.b	$22(a0),d2
000153FE 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015402 6600                       		bne.s	loc_13A70	; if yes, branch
00015404 4600                       		not.b	d0		; reverse angle
00015406                            
00015406                            loc_13A70:
00015406 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
0001540A 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001540C 7203                       		moveq	#3,d1
0001540E                            
0001540E                            loc_13A78:
0001540E 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015414 B302                       		eor.b	d1,d2
00015416 8528 0001                  		or.b	d2,1(a0)
0001541A 0828 0005 0022             		btst	#5,$22(a0)
00015420 6600 0000                  		bne.w	SAnim_Push
00015424 E808                       		lsr.b	#4,d0		; divide angle by $10
00015426 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
0001542A 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
0001542E 6A00                       		bpl.s	loc_13A9C
00015430 4442                       		neg.w	d2
00015432                            
00015432                            loc_13A9C:
00015432 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015436 6700                       		beq.s	Loc_NotSuper
00015438 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
0001543E 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015442 6400                       		bhs.s	SuperRun	; if yes, branch
00015444 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
0001544A 6000                       		bra.s	SuperWalk
0001544C                            
0001544C                            Loc_NotSuper:
0001544C 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00015452 0C42 0B00                  		cmpi.w	#$B00,d2	; is Sonic at running speed?
00015456 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015458 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
0001545E 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00015462 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015464 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
0001546A                            
0001546A                            SuperWalk:
0001546A 1200                       		move.b	d0,d1
0001546C E209                       		lsr.b	#1,d1
0001546E D001                       		add.b	d1,d0
00015470                            
00015470                            loc_13AB4:
00015470 D000                       		add.b	d0,d0
00015472                            
00015472                            SuperRun:
00015472 1600                       		move.b	d0,d3
00015474 4442                       		neg.w	d2
00015476 0642 0800                  		addi.w	#$800,d2
0001547A 6A00                       		bpl.s	loc_13AC2
0001547C 7400                       		moveq	#0,d2
0001547E                            
0001547E                            loc_13AC2:
0001547E E04A                       		lsr.w	#8,d2
00015480 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015484 6100 FF18                  		bsr.w	SAnim_Do2
00015488 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
0001548C 4E75                       		rts	
0001548E                            ; ===========================================================================
0001548E                            
0001548E                            SAnim_RollJump:				; XREF: SAnim_WalkRun
0001548E 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
00015490 6600                       		bne.s	SAnim_Push	; if not, branch
00015492 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015496 6A00                       		bpl.s	loc_13ADE
00015498 4442                       		neg.w	d2
0001549A                            
0001549A                            loc_13ADE:
0001549A 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000154A0 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000154A4 6400                       		bcc.s	loc_13AF0	; if yes, branch
000154A6 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000154AC                            
000154AC                            loc_13AF0:
000154AC 4442                       		neg.w	d2
000154AE 0642 0400                  		addi.w	#$400,d2
000154B2 6A00                       		bpl.s	loc_13AFA
000154B4 7400                       		moveq	#0,d2
000154B6                            
000154B6                            loc_13AFA:
000154B6 E04A                       		lsr.w	#8,d2
000154B8 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000154BC 1228 0022                  		move.b	$22(a0),d1
000154C0 0201 0001                  		andi.b	#1,d1
000154C4 0228 00FC 0001             		andi.b	#$FC,1(a0)
000154CA 8328 0001                  		or.b	d1,1(a0)
000154CE 6000 FECE                  		bra.w	SAnim_Do2
000154D2                            ; ===========================================================================
000154D2                            
000154D2                            SAnim_Push:				; XREF: SAnim_RollJump
000154D2 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000154D6 6B00                       		bmi.s	loc_13B1E
000154D8 4442                       		neg.w	d2
000154DA                            
000154DA                            loc_13B1E:
000154DA 0642 0800                  		addi.w	#$800,d2
000154DE 6A00                       		bpl.s	loc_13B26
000154E0 7400                       		moveq	#0,d2
000154E2                            
000154E2                            loc_13B26:
000154E2 EC4A                       		lsr.w	#6,d2
000154E4 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000154E8 43F9 0000 0000             		lea	(SonAni_Push).l,a1
000154EE 1228 0022                  		move.b	$22(a0),d1
000154F2 0201 0001                  		andi.b	#1,d1
000154F6 0228 00FC 0001             		andi.b	#$FC,1(a0)
000154FC 8328 0001                  		or.b	d1,1(a0)
00015500 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015504 6700                       		beq.s	Loc_NotSuper2
00015506 43F9 0000 0000             		lea	(SupSonAni_Push).l,a1 ; use	running	animation
0001550C                            
