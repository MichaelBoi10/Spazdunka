0001499C 4A38 FE2E                  		tst.b   ($FFFFFE2E).w 		; test for speed shoes
000149A0 6700                       		beq.s	@noshoes
000149A2 E242                       		asr.w	#1,d2
000149A4 9242                       		sub.w	d2,d1
