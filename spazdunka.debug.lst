0007F524                            ; ------------------------------------------------------------------------------
0007F524                            ; Exported symbols
0007F524                            ; ------------------------------------------------------------------------------
0007F524                            
0007F524 =0007D40C                  MegaPCM_LoadDriver:	equ	MegaPCMLibraryBlob+$0
0007F524 =0007D476                  MegaPCM_LoadSampleTable:	equ	MegaPCMLibraryBlob+$6A
0007F524 =0007D6BC                  MegaPCM:	equ	MegaPCMLibraryBlob+$2B0
0007F524 =0007F523                  MegaPCM_End:	equ	MegaPCMLibraryBlob+$2117
0007F524                            
0007F524                            
0007F524                            ; ==============================================================================
0007F524                            ; ------------------------------------------------------------------------------
0007F524                            ; Mega PCM API Routines
0007F524                            ; ------------------------------------------------------------------------------
0007F524                            
0007F524                            
0007F524                            ; ------------------------------------------------------------------------------
0007F524                            ; Plays a given sample
0007F524                            ; ------------------------------------------------------------------------------
0007F524                            ; INPUT:
0007F524                            ;		d0	.b		sample id (>$81)
0007F524                            ;
0007F524                            ; EXAMPLES:
0007F524                            ;		move.b	#$81, d0
0007F524                            ;		jsr		MegaPCM_PlaySample
0007F524                            ;
0007F524                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
0007F524                            ;		jsr		MegaPCM_PlaySample
0007F524                            ; ------------------------------------------------------------------------------
0007F524                            
0007F524                            MegaPCM_PlaySample:
0007F524                            	MPCM_play	d0
0007F524                          M 	mpcm_stopz80
0007F524                          M 	pusho
0007F524                          M 	opt	l-
0007F524 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007F52C                          M 	@wait_17:
0007F52C 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007F534 66F6                     M 	bne.s	@wait_17
0007F536                          M 	popo
0007F536 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0007F53C                          M 	mpcm_startz80
0007F53C 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007F544 4E75                       	rts
0007F546                            
0007F546                            ; ------------------------------------------------------------------------------
0007F546                            ; Pauses current sample playback
0007F546                            ; ------------------------------------------------------------------------------
0007F546                            
0007F546                            MegaPCM_PausePlayback:
0007F546                            	MPCM_pause
0007F546                          M 	mpcm_stopz80
0007F546                          M 	pusho
0007F546                          M 	opt	l-
