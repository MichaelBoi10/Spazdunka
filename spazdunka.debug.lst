000152AC                            ; ---------------------------------------------------------------------------
000152AC                            ; Subroutine to	animate	Sonic's sprites
000152AC                            ; ---------------------------------------------------------------------------
000152AC                            
000152AC                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000152AC                            
000152AC                            
000152AC                            Sonic_Animate:				; XREF: Obj01_Control; et al
000152AC 43F9 0000 0000             		lea	(SonicAniData).l,a1
000152B2 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
000152B6 6700                       		beq.s	SAnim_NotSuper
000152B8 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
000152BE                            
000152BE                            SAnim_NotSuper:		
000152BE 7000                       		moveq	#0,d0
000152C0 1028 001C                  		move.b	$1C(a0),d0
000152C4 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
000152C8 6700                       		beq.s	SAnim_Do	; if not, branch
000152CA 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000152CE 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000152D4 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000152DA                            
000152DA                            SAnim_Do:
000152DA D040                       		add.w	d0,d0
000152DC D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000152E0 1011                       		move.b	(a1),d0
000152E2 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000152E4 1228 0022                  		move.b	$22(a0),d1
000152E8 0201 0001                  		andi.b	#1,d1
000152EC 0228 00FC 0001             		andi.b	#$FC,1(a0)
000152F2 8328 0001                  		or.b	d1,1(a0)
000152F6 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000152FA 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000152FC 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00015300                            
00015300                            SAnim_Do2:
00015300 7200                       		moveq	#0,d1
00015302 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
00015306 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0001530A 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
0001530E 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
00015310                            
00015310                            SAnim_Next:
00015310 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00015314 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00015318                            
00015318                            SAnim_Delay:
00015318 4E75                       		rts	
0001531A                            ; ===========================================================================
0001531A                            
0001531A                            SAnim_End_FF:
0001531A 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0001531C 6600                       		bne.s	SAnim_End_FE	; if not, branch
0001531E 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015324 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015328 60E6                       		bra.s	SAnim_Next
0001532A                            ; ===========================================================================
0001532A                            
0001532A                            SAnim_End_FE:
0001532A 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0001532C 6600                       		bne.s	SAnim_End_FD	; if not, branch
0001532E 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015332 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015336 9200                       		sub.b	d0,d1
00015338 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0001533C 60D2                       		bra.s	SAnim_Next
0001533E                            ; ===========================================================================
0001533E                            
0001533E                            SAnim_End_FD:
0001533E 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015340 6600                       		bne.s	SAnim_End	; if not, branch
00015342 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015348                            
00015348                            SAnim_End:
00015348 4E75                       		rts	
0001534A                            ; ===========================================================================
0001534A                            
0001534A                            SAnim_WalkRun:				; XREF: SAnim_Do
0001534A 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
0001534E 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015350 5200                       		addq.b	#1,d0		; is animation walking/running?
00015352 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015356 7200                       		moveq	#0,d1
00015358 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
0001535C 1428 0022                  		move.b	$22(a0),d2
00015360 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015364 6600                       		bne.s	loc_13A70	; if yes, branch
00015366 4600                       		not.b	d0		; reverse angle
00015368                            
00015368                            loc_13A70:
00015368 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
0001536C 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001536E 7203                       		moveq	#3,d1
00015370                            
00015370                            loc_13A78:
00015370 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015376 B302                       		eor.b	d1,d2
00015378 8528 0001                  		or.b	d2,1(a0)
0001537C 0828 0005 0022             		btst	#5,$22(a0)
00015382 6600 0000                  		bne.w	SAnim_Push
00015386 E808                       		lsr.b	#4,d0		; divide angle by $10
00015388 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
0001538C 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015390 6A00                       		bpl.s	loc_13A9C
00015392 4442                       		neg.w	d2
00015394                            
00015394                            loc_13A9C:
00015394 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015398 6700                       		beq.s	Loc_NotSuper
0001539A 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
000153A0 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000153A4 6400                       		bhs.s	SuperRun	; if yes, branch
000153A6 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
000153AC 6000                       		bra.s	SuperWalk
000153AE                            
000153AE                            Loc_NotSuper:
000153AE 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
000153B4 0C42 0B00                  		cmpi.w	#$B00,d2	; is Sonic at running speed?
000153B8 6400                       		bhs.s	loc_13AB4	; if yes, branch
000153BA 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000153C0 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000153C4 6400                       		bhs.s	loc_13AB4	; if yes, branch
000153C6 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000153CC                            
000153CC                            SuperWalk:
000153CC 1200                       		move.b	d0,d1
000153CE E209                       		lsr.b	#1,d1
000153D0 D001                       		add.b	d1,d0
000153D2                            
000153D2                            loc_13AB4:
000153D2 D000                       		add.b	d0,d0
000153D4                            
000153D4                            SuperRun:
000153D4 1600                       		move.b	d0,d3
000153D6 4442                       		neg.w	d2
000153D8 0642 0800                  		addi.w	#$800,d2
000153DC 6A00                       		bpl.s	loc_13AC2
000153DE 7400                       		moveq	#0,d2
000153E0                            
000153E0                            loc_13AC2:
000153E0 E04A                       		lsr.w	#8,d2
000153E2 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000153E6 6100 FF18                  		bsr.w	SAnim_Do2
000153EA D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000153EE 4E75                       		rts	
000153F0                            ; ===========================================================================
000153F0                            
000153F0                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000153F0 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000153F2 6600                       		bne.s	SAnim_Push	; if not, branch
000153F4 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000153F8 6A00                       		bpl.s	loc_13ADE
000153FA 4442                       		neg.w	d2
000153FC                            
000153FC                            loc_13ADE:
000153FC 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
00015402 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00015406 6400                       		bcc.s	loc_13AF0	; if yes, branch
00015408 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
0001540E                            
0001540E                            loc_13AF0:
0001540E 4442                       		neg.w	d2
00015410 0642 0400                  		addi.w	#$400,d2
00015414 6A00                       		bpl.s	loc_13AFA
00015416 7400                       		moveq	#0,d2
00015418                            
00015418                            loc_13AFA:
00015418 E04A                       		lsr.w	#8,d2
0001541A 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001541E 1228 0022                  		move.b	$22(a0),d1
00015422 0201 0001                  		andi.b	#1,d1
00015426 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001542C 8328 0001                  		or.b	d1,1(a0)
00015430 6000 FECE                  		bra.w	SAnim_Do2
00015434                            ; ===========================================================================
00015434                            
00015434                            SAnim_Push:				; XREF: SAnim_RollJump
00015434 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015438 6B00                       		bmi.s	loc_13B1E
0001543A 4442                       		neg.w	d2
0001543C                            
0001543C                            loc_13B1E:
0001543C 0642 0800                  		addi.w	#$800,d2
00015440 6A00                       		bpl.s	loc_13B26
00015442 7400                       		moveq	#0,d2
00015444                            
00015444                            loc_13B26:
00015444 EC4A                       		lsr.w	#6,d2
00015446 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001544A 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00015450 1228 0022                  		move.b	$22(a0),d1
00015454 0201 0001                  		andi.b	#1,d1
00015458 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001545E 8328 0001                  		or.b	d1,1(a0)
00015462 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015466 6700                       		beq.s	Loc_NotSuper2
00015468 43F9 0000 0000             		lea	(SupSonAni_Push).l,a1 ; use	running	animation
0001546E                            
0001546E                            Loc_NotSuper2:
0001546E 6000 FE90                  		bra.w	SAnim_Do2
00015472                            ; End of function Sonic_Animate
