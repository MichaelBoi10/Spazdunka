00015346 6600                       		bne.s	SAnim_End	; if not, branch
00015348 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
0001534E                            
0001534E                            SAnim_End:
0001534E 4E75                       		rts	
