001B8044                               include   "SampleDebugger.asm"
001B8044                            SampleDebugger:
001B8044                            	Console.WriteLine "%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
001B8044 40E7                     M 	move.w	sr,-(sp)
001B8046                          M 	_console.writeline	<"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>">,<>
001B8046                          M 	__fstring_generateargumentscode	"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
001B8046 =00000001                M 	__pos:	= instr("%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'%<')
001B8046 =00000000                M 	__stack:=	0
001B8046 =00000000                M 	__sp:	= 0
001B8046                          M 	pusho
