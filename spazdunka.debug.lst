000077F8                            LoadZoneTiles:
000077F8 7000                       		moveq	#0,d0			; Clear d0
000077FA 1038 FE10                  		move.b	($FFFFFE10).w,d0		; Load number of current zone to d0
000077FE E948                       		lsl.w	#4,d0			; Multiply by $10, converting the zone ID into an offset
00007800 45F9 0000 0000             		lea	(MainLoadBlocks).l,a2	; Load LevelHeaders's address into a2
00007806 45F2 0000                  		lea	(a2,d0.w),a2		; Offset LevelHeaders by the zone-offset, and load the resultant address to a2
0000780A 201A                       		move.l	(a2)+,d0		; Move the first longword of data that a2 points to to d0, this contains the zone's first PLC ID and its art's address.
0000780C                            						; The auto increment is pointless as a2 is overwritten later, and nothing reads from a2 before then
0000780C 0280 00FF FFFF             		andi.l	#$FFFFFF,d0    		; Filter out the first byte, which contains the first PLC ID, leaving the address of the zone's art in d0
00007812 2040                       		movea.l	d0,a0			; Load the address of the zone's art into a0 (source)
00007814 43F9 00FF 0000             		lea	($FF0000).l,a1		; Load v_256x256/StartOfRAM (in this context, an art buffer) into a1 (destination)
0000781A 6100 9D7C                  		bsr.w	KosDec			; Decompress a0 to a1 (Kosinski compression)
0000781E                            
0000781E 3609                       		move.w	a1,d3			; Move a word of a1 to d3, note that a1 doesn't exactly contain the address of v_256x256/StartOfRAM anymore, after KosDec, a1 now contains v_256x256/StartOfRAM + the size of the file decompressed to it, d3 now contains the length of the file that was decompressed
00007820 3E03                       		move.w	d3,d7			; Move d3 to d7, for use in seperate calculations
00007822                            
00007822 0243 0FFF                  		andi.w	#$FFF,d3		; Remove the high nibble of the high byte of the length of decompressed file, this nibble is how many $1000 bytes the decompressed art is
00007826 E24B                       		lsr.w	#1,d3			; Half the value of 'length of decompressed file', d3 becomes the 'DMA transfer length'
00007828                            
00007828 E95F                       		rol.w	#4,d7			; Rotate (left) length of decompressed file by one nibble
0000782A 0247 000F                  		andi.w	#$F,d7			; Only keep the low nibble of low byte (the same one filtered out of d3 above), this nibble is how many $1000 bytes the decompressed art is
0000782E                            
0000782E 3407                       @loop:		move.w	d7,d2			; Move d7 to d2, note that the ahead dbf removes 1 byte from d7 each time it loops, meaning that the following calculations will have different results each time
00007830 EF4A                       		lsl.w	#7,d2
00007832 EB4A                       		lsl.w	#5,d2			; Shift (left) d2 by $C, making it high nibble of the high byte, d2 is now the size of the decompressed file rounded down to the nearest $1000 bytes, d2 becomes the 'destination address'
00007834                            
00007834 223C 00FF FFFF             		move.l	#$FFFFFF,d1		; Fill d1 with $FF
0000783A 3202                       		move.w	d2,d1			; Move d2 to d1, overwriting the last word of $FF's with d2, this turns d1 into 'StartOfRAM'+'However many $1000 bytes the decompressed art is', d1 becomes the 'source address'
0000783C                            
0000783C 4EB9 0000 10AC             		jsr	(DMA_68KtoVRAM).l	; Use d1, d2, and d3 to locate the decompressed art and ready for transfer to VRAM
00007842 3F07                       		move.w	d7,-(sp)		; Store d7 in the Stack
00007844 11FC 000C F62A             		move.b	#$C,($FFFFF62A).w
0000784A 6100 B228                  		bsr.w	DelayProgram
0000784E 6100 9A98                  		bsr.w	RunPLC_RAM
