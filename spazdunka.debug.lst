00206E20                            ; Menu do Sonic 2 No Sonic 1 reprogramado por Esrael L. G. Neto
00206E20                            ; [ In�cio ]
00206E20                            ;
00206E20                            ; O c�digo deste menu foi desenvolvido para funcionar com
00206E20                            ; o disassembly do Sonic 1 feito por -> drx (www.hacking-cult.org)
00206E20                            ; 
00206E20                            ; Se estiver usando um disassembly diferente modifique os jumps no final do 
00206E20                            ; c�digo para que aponte para as rotinas equivalentes.
00206E20                            ; 
00206E20                            ; Para pode utilizar este menu basta fazer a seguinte modifica��o no c�digo 
00206E20                            ; original:
00206E20                            ; Localize o label  -> loc_3242 adicione -> jmp     Level_Select_Menu
00206E20                            ; O c�digo deve ficar como abaixo
00206E20                            ;               ......................
00206E20                            ; loc_3242:
00206E20                            ;		tst.b	($FFFFFFE0).w
00206E20                            ;		beq.w	PlayLevel	
00206E20                            ;		btst	#6,($FFFFF604).w 
00206E20                            ;		beq.w	PlayLevel	  		
00206E20                            ;		jmp     Level_Select_Menu ; <- Carrega o Menu do Sonic 2	
00206E20                            ;		moveq	#2,d0		
00206E20                            ;		bsr.w	PalLoad		 
00206E20                            ;               ...............
00206E20                            ;
00206E20                            ; N�o esque�a de incluir este asm em seu c�digo com a diretiva include:
00206E20                            ;               include 's2_menu.asm'
00206E20                            ;===============================================================================  
00206E20 =FFFFFFE1                  Slow_Motion_Flag      equ $FFFFFFE1
00206E20 =FFFFFFE2                  Debug_Mode_Flag       equ $FFFFFFE2
00206E20                            
