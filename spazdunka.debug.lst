000150A4 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150A8 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000150AA 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000150AE                            
000150AE                            SAnim_Do2:
000150AE 7200                       		moveq	#0,d1
000150B0 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000150B4 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000150B8 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000150BC 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
000150BE                            
000150BE                            SAnim_Next:
000150BE 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000150C2 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000150C6                            
000150C6                            SAnim_Delay:
000150C6 4E75                       		rts	
000150C8                            ; ===========================================================================
000150C8                            
000150C8                            SAnim_End_FF:
000150C8 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000150CA 6600                       		bne.s	SAnim_End_FE	; if not, branch
000150CC 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
000150D2 1029 0001                  		move.b	1(a1),d0	; read sprite number
000150D6 60E6                       		bra.s	SAnim_Next
000150D8                            ; ===========================================================================
000150D8                            
000150D8                            SAnim_End_FE:
000150D8 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
000150DA 6600                       		bne.s	SAnim_End_FD	; if not, branch
000150DC 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
000150E0 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
000150E4 9200                       		sub.b	d0,d1
000150E6 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
000150EA 60D2                       		bra.s	SAnim_Next
000150EC                            ; ===========================================================================
000150EC                            
000150EC                            SAnim_End_FD:
000150EC 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
000150EE 6600                       		bne.s	SAnim_End	; if not, branch
000150F0 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
000150F6                            
000150F6                            SAnim_End:
000150F6 4E75                       		rts	
000150F8                            ; ===========================================================================
000150F8                            
000150F8                            SAnim_WalkRun:				; XREF: SAnim_Do
000150F8 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150FC 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
000150FE 5200                       		addq.b	#1,d0		; is animation walking/running?
00015100 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015104 7200                       		moveq	#0,d1
00015106 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
0001510A 1428 0022                  		move.b	$22(a0),d2
0001510E 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015112 6600                       		bne.s	loc_13A70	; if yes, branch
00015114 4600                       		not.b	d0		; reverse angle
00015116                            
00015116                            loc_13A70:
00015116 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
0001511A 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001511C 7203                       		moveq	#3,d1
0001511E                            
0001511E                            loc_13A78:
0001511E 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015124 B302                       		eor.b	d1,d2
00015126 8528 0001                  		or.b	d2,1(a0)
0001512A 0828 0005 0022             		btst	#5,$22(a0)
00015130 6600 0000                  		bne.w	SAnim_Push
00015134 E808                       		lsr.b	#4,d0		; divide angle by $10
00015136 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
0001513A 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
0001513E 6A00                       		bpl.s	loc_13A9C
00015140 4442                       		neg.w	d2
00015142                            
00015142                            loc_13A9C:
00015142 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015146 6700                       		beq.s	Loc_NotSuper
00015148 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
0001514E 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015152 6400                       		bhs.s	SuperRun	; if yes, branch
00015154 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
0001515A 6000                       		bra.s	SuperWalk
0001515C                            
0001515C                            Loc_NotSuper:
0001515C 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00015162 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015166 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015168 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
0001516E 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00015172 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015174 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
0001517A                            
0001517A                            SuperWalk:
0001517A 1200                       		move.b	d0,d1
0001517C E209                       		lsr.b	#1,d1
0001517E D001                       		add.b	d1,d0
00015180                            
00015180                            loc_13AB4:
00015180 D000                       		add.b	d0,d0
00015182                            
00015182                            SuperRun:
00015182 1600                       		move.b	d0,d3
00015184 4442                       		neg.w	d2
00015186 0642 0800                  		addi.w	#$800,d2
0001518A 6A00                       		bpl.s	loc_13AC2
0001518C 7400                       		moveq	#0,d2
0001518E                            
0001518E                            loc_13AC2:
0001518E E04A                       		lsr.w	#8,d2
00015190 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015194 6100 FF18                  		bsr.w	SAnim_Do2
00015198 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
0001519C 4E75                       		rts	
0001519E                            ; ===========================================================================
0001519E                            
0001519E                            SAnim_RollJump:				; XREF: SAnim_WalkRun
0001519E 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000151A0 6600                       		bne.s	SAnim_Push	; if not, branch
000151A2 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000151A6 6A00                       		bpl.s	loc_13ADE
000151A8 4442                       		neg.w	d2
000151AA                            
000151AA                            loc_13ADE:
000151AA 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000151B0 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000151B4 6400                       		bcc.s	loc_13AF0	; if yes, branch
000151B6 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000151BC                            
000151BC                            loc_13AF0:
000151BC 4442                       		neg.w	d2
000151BE 0642 0400                  		addi.w	#$400,d2
000151C2 6A00                       		bpl.s	loc_13AFA
000151C4 7400                       		moveq	#0,d2
000151C6                            
000151C6                            loc_13AFA:
000151C6 E04A                       		lsr.w	#8,d2
000151C8 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151CC 1228 0022                  		move.b	$22(a0),d1
000151D0 0201 0001                  		andi.b	#1,d1
000151D4 0228 00FC 0001             		andi.b	#$FC,1(a0)
000151DA 8328 0001                  		or.b	d1,1(a0)
000151DE 6000 FECE                  		bra.w	SAnim_Do2
000151E2                            ; ===========================================================================
000151E2                            
000151E2                            SAnim_Push:				; XREF: SAnim_RollJump
000151E2 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000151E6 6B00                       		bmi.s	loc_13B1E
000151E8 4442                       		neg.w	d2
000151EA                            
000151EA                            loc_13B1E:
000151EA 0642 0800                  		addi.w	#$800,d2
000151EE 6A00                       		bpl.s	loc_13B26
000151F0 7400                       		moveq	#0,d2
000151F2                            
000151F2                            loc_13B26:
000151F2 EC4A                       		lsr.w	#6,d2
000151F4 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151F8 43F9 0000 0000             		lea	(SonAni_Push).l,a1
000151FE 1228 0022                  		move.b	$22(a0),d1
00015202 0201 0001                  		andi.b	#1,d1
00015206 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001520C 8328 0001                  		or.b	d1,1(a0)
00015210 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
