00014C0E D040                       		add.w	d0,d0			; double it
00014C10 0240 1F00                  		andi.w	#$1F00,d0		; mask it against $1F00
00014C14 4440                       		neg.w	d0			; negate it
00014C16 0640 2000                  		addi.w	#$2000,d0		; add $2000
00014C1A 31C0 C904                  		move.w	d0,($FFFFC904).w	; move to $C904
00014C1E 0828 0000 0022             		btst	#0,status(a0)		; is sonic facing right?
00014C24 6700                       		beq.s	loc2_1ACF4		; if not, branch
00014C26 4468 0014                  		neg.w	$14(a0)			; negate inertia
