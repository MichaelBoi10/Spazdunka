0000DCB4 317C 051B 0002             		move.w	#$51B,art_tile(a0)
0000DCBA 0028 0004 0001             		ori.b	#4,render_flags(a0)
0000DCC0 117C 0004 0018             		move.b	#4,priority(a0)
