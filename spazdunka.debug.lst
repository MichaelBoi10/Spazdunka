0000DCC0 343C 0004                  		move.w	#4,d2
0000DCC4 0C28 0005 001A             		cmpi.b	#5,mapping_frame(a0)	; is object type $5x ?
0000DCCA 6700                       		beq.s	Obj36_SideWays	; if yes, branch
0000DCCC 0C28 0001 001A             		cmpi.b	#1,mapping_frame(a0)	; is object type $1x ?
