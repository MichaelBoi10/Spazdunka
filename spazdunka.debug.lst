00015154 1228 0022                  		move.b	$22(a0),d1
00015158 0201 0001                  		andi.b	#1,d1
0001515C 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015162 8328 0001                  		or.b	d1,1(a0)
