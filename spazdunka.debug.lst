0000113C                            ; Nemesis decompression	algorithm
0000113C                            ; ---------------------------------------------------------------------------
0000113C                            
0000113C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000113C                            
0000113C                            
0000113C                            NemDec:
0000113C 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
00001140 47F9 0000 0000             		lea	(loc_1502).l,a3
00001146 49F9 00C0 0000             		lea	($C00000).l,a4
0000114C 6000                       		bra.s	loc_145C
0000114E                            ; ===========================================================================
0000114E 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
00001152 47F9 0000 0000             		lea	(loc_1518).l,a3
00001158                            
00001158                            loc_145C:				; XREF: NemDec
00001158 43F8 AA00                  		lea	($FFFFAA00).w,a1
0000115C 3418                       		move.w	(a0)+,d2
0000115E E34A                       		lsl.w	#1,d2
00001160 6400                       		bcc.s	loc_146A
00001162 D6FC 000A                  		adda.w	#$A,a3
00001166                            
00001166                            loc_146A:
00001166 E54A                       		lsl.w	#2,d2
00001168 3A42                       		movea.w	d2,a5
0000116A 7608                       		moveq	#8,d3
0000116C 7400                       		moveq	#0,d2
0000116E 7800                       		moveq	#0,d4
00001170 6100 0000                  		bsr.w	NemDec4
00001174 1A18                       		move.b	(a0)+,d5
00001176 E145                       		asl.w	#8,d5
00001178 1A18                       		move.b	(a0)+,d5
0000117A 3C3C 0010                  		move.w	#$10,d6
0000117E 6100                       		bsr.s	NemDec2
00001180 4CDF 3BFF                  		movem.l	(sp)+,d0-a1/a3-a5
00001184 4E75                       		rts	
00001186                            ; End of function NemDec
00001186                            
00001186                            
00001186                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001186                            
00001186                            
00001186                            NemDec2:				; XREF: NemDec
00001186 3E06                       		move.w	d6,d7
00001188 5147                       		subq.w	#8,d7
0000118A 3205                       		move.w	d5,d1
0000118C EE69                       		lsr.w	d7,d1
0000118E 0C01 00FC                  		cmpi.b	#-4,d1
