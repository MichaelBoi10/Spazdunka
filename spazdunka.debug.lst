0001403A                            		
0001403A                            ; ---------------------------------------------------------------------------
0001403A                            ; Subroutine to    horizontally pan the camera view ahead of the player
0001403A                            ; (Ported from the US version of Sonic CD's "R11A__.MMD" by Nat The Porcupine, ported to Hivebrain disasm by DelayHacks)
0001403A                            ; ---------------------------------------------------------------------------
0001403A                            
0001403A                            ; ||||||||||||||| S U B    R O U T    I N E |||||||||||||||||||||||||||||||||||||||
0001403A                            
0001403A                            Sonic_PanCamera:
0001403A 3238 F7A0                          move.w    ($FFFFF7A0).w,d1        ; get the current camera pan value
0001403E 3028 0014                          move.w    $14(a0),d0        ; get sonic's inertia
00014042 6A00                               bpl.s    Sonic_PanCamera_abs_inertia            ; if sonic's inertia is positive, branch ahead
00014044 4440                               neg.w    d0                        ; otherwise, we negate it to get the absolute value
00014046                            
00014046                            Sonic_PanCamera_abs_inertia:
00014046                            
00014046                            ; These lines were intended to prevent the Camera from panning while
00014046                            ; going up the very first giant ramp in Palmtree Panic Zone Act 1.
00014046                            ; However, given that no such object exists in Sonic 1, I just went
00014046                            ; ahead and commented these out.
00014046                            ;        btst    #1,$2C(a0)                ; is sonic going up a giant ramp in PPZ?
00014046                            ;        beq.s    Sonic_PanCamera_skip                    ; if not, branch
00014046                            ;        cmpi.w    #$1B00,($FFFFD008).w            ; is sonic's x position lower than $1B00?
00014046                            ;        bcs.s    Sonic_PanCamera_reset_pan                ; if so, branch
00014046                            
00014046                            ; These lines aren't part of the original routine; I added them myself.
00014046                            ; If you've ported the Spin Dash, uncomment the following lines of code
00014046                            ; to allow the camera to pan ahead while charging the Spin Dash:
00014046 4A28 0039                          tst.b    $39(a0)                    ; is sonic charging up a spin dash?
0001404A 6700                               beq.s    Sonic_PanCamera_skip                    ; if not, branch
0001404C 0828 0000 0022                     btst    #0,$22(a0)            ; check the direction that sonic is facing
00014052 6600                               bne.s    Sonic_PanCamera_pan_right                ; if he's facing right, pan the camera to the right
00014054 6000                               bra.s    Sonic_PanCamera_pan_left                ; otherwise, pan the camera to the left
00014056                            
00014056                            Sonic_PanCamera_skip:
00014056 0C40 0600                          cmpi.w    #$600,d0                ; is sonic's inertia greater than $600
0001405A 6500                               bcs.s    Sonic_PanCamera_reset_pan                ; if not, recenter the screen (if needed)
0001405C 4A68 0014                          tst.w    $14(a0)            ; otherwise, check the direction of inertia (by subtracting it from 0)
00014060 6A00                               bpl.s    Sonic_PanCamera_pan_left                ; if the result was positive, then inertia was negative, so we pan the screen left
00014062                            
00014062                            Sonic_PanCamera_pan_right:
00014062 5441                               addq.w    #2,d1                    ; add 2 to the pan value
00014064 0C41 00E0                          cmpi.w    #224,d1                    ; is the pan value greater than 224 pixels?
00014068 6500                               bcs.s    Sonic_PanCamera_update_pan                ; if not, branch
0001406A 323C 00E0                          move.w    #224,d1                    ; otherwise, cap the value at the maximum of 224 pixels
0001406E 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00014070                            ; ---------------------------------------------------------------------------
00014070                            
00014070                            Sonic_PanCamera_pan_left:
00014070 5541                               subq.w    #2,d1                    ; subtract 2 from the pan value
00014072 0C41 0060                          cmpi.w    #96,d1                    ; is the pan value less than 96 pixels?
00014076 6400                               bcc.s    Sonic_PanCamera_update_pan                ; if not, branch
00014078 323C 0060                          move.w    #96,d1                    ; otherwise, cap the value at the minimum of 96 pixels
0001407C 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
0001407E                            ; ---------------------------------------------------------------------------
0001407E                            
0001407E                            Sonic_PanCamera_reset_pan:
0001407E 0C41 00A0                          cmpi.w    #160,d1                    ; is the pan value 160 pixels?
00014082 6700                               beq.s    Sonic_PanCamera_update_pan                ; if so, branch
00014084 6400                               bcc.s    Sonic_PanCamera_reset_left                ; otherwise, branch if it greater than 160
00014086                                 
00014086                            Sonic_PanCamera_reset_right:
00014086 5441                               addq.w    #2,d1                    ; add 2 to the pan value
00014088 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
0001408A                            ; ---------------------------------------------------------------------------
0001408A                            
0001408A                            Sonic_PanCamera_reset_left:
0001408A 5541                               subq.w    #2,d1                    ; subtract 2 from the pan value
0001408C                            
0001408C                            Sonic_PanCamera_update_pan:
0001408C 31C1 F7A0                          move.w    d1,($FFFFF7A0).w        ; update the camera pan value
00014090 4E75                               rts                                ; return
00014092                                 
00014092                            ; End of function Sonic_PanCamera
00014092                            ; ===========================================================================
