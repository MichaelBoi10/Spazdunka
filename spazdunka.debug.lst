0001494C                            ; ---------------------------------------------------------------------------
0001494C                            ; Subroutine called at the peak of a jump that transforms Sonic into Super Sonic
0001494C                            ; if he has enough rings and emeralds
0001494C                            ; ---------------------------------------------------------------------------
0001494C                            
0001494C                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0001494C                            
0001494C                            ; loc_1AB38: test_set_SS:
0001494C                            Sonic_CheckGoSuper:
0001494C 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014950 6600 0000                  	bne.w	return_1ABA4		; if yes, branch
00014954 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
0001495A 6600                       	bne.s	return_1ABA4		; if not, branch
0001495C 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014962 6500                       	bcs.s	return_1ABA4		; if not, branch
00014964 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
00014968 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
0001496C 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014972 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
00014978 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
0001497E 11FC 0001 F7C8             	move.b	#1,($FFFFF7C8).w ; lock	controls
00014984 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
0001498A 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
00014990 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014996 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
0001499C 317C 0000 0032             	move.w	#0,invincibility_time(a0)
000149A2 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
000149A8 303C 00D4                  	move.w	#$D4,d0         ; 
000149AC 4EB9 0000 1008             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
000149B2 303C 0094                  	move.w	#$94,d0
000149B6 4EF9 0000 1002             	jmp	(PlaySound).l	; Play the super theme
000149BC                            ; ---------------------------------------------------------------------------
000149BC                            return_1ABA4:
000149BC 4E75                       	rts
000149BE                            ; End of subroutine Sonic_CheckGoSuper
000149BE                            
000149BE                            ; ---------------------------------------------------------------------------
000149BE                            ; Subroutine doing the extra logic for Super Sonic
000149BE                            ; ---------------------------------------------------------------------------
000149BE                            
000149BE                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
