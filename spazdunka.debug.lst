000038F6                            LevSel_SndTest:				; XREF: LevSelControls
000038F6 0C78 0014 FF82             		cmpi.w	#$14,($FFFFFF82).w ; is	item $14 selected?
000038FC 6600                       		bne.s	LevSel_NoMove	; if not, branch
000038FE 1238 F605                  		move.b	($FFFFF605).w,d1
00003902 0201 000C                  		andi.b	#$C,d1		; is left/right	pressed?
00003906 6700                       		beq.s	LevSel_NoMove	; if not, branch
00003908 3038 FF84                  		move.w	($FFFFFF84).w,d0
0000390C 0801 0002                  		btst	#2,d1		; is left pressed?
00003910 6700                       		beq.s	LevSel_Right	; if not, branch
00003912 5340                       		subq.w	#1,d0		; subtract 1 from sound	test
00003914 6400                       		bcc.s	LevSel_Right
00003916 704F                       		moveq	#$4F,d0		; if sound test	moves below 0, set to $4F
00003918                            
00003918                            LevSel_Right:
00003918 0801 0003                  		btst	#3,d1		; is right pressed?
0000391C 6700                       		beq.s	LevSel_Refresh2	; if not, branch
0000391E 5240                       		addq.w	#1,d0		; add 1	to sound test
00003920 0C40 0050                  		cmpi.w	#$50,d0
00003924 6500                       		bcs.s	LevSel_Refresh2
00003926 7000                       		moveq	#0,d0		; if sound test	moves above $4F, set to	0
00003928                            
00003928                            LevSel_Refresh2:
