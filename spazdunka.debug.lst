00014930                             
00014930                            SCDPeelout_Launch:
00014930 117C 0023 001C             		move.b	#$23,anim(a0)
00014936 1038 F602                  		move.b	($FFFFF602).w,d0
0001493A 0800 0000                  		btst	#0,d0
0001493E 6600 0000                  		bne.w	SCDPeelout_Charge
00014942 08A8 0001 0039             		bclr	#1,$39(a0)	; stop Dashing
00014948 0C28 0020 001C             		cmpi.b	#$20,$1C(a0)	; launches here (peelout sprites)
0001494E 6700                       		beq.s	SCDPeelout_Stop_Sound
00014950 117C 0000 001C             		move.b	#0,$1C(a0)	; launches here (peelout sprites)
00014956 317C 0001 0010             		move.w	#1,$10(a0)	; force X speed to nonzero for camera lag's benefit
0001495C 3028 0014                  		move.w	$14(a0),d0
00014960 0440 0700                  		subi.w	#$700,d0
00014964 D040                       		add.w	d0,d0
00014966 0240 0700                  		andi.w	#$700,d0
0001496A 4440                       		neg.w	d0
0001496C 0640 0700                  		addi.w	#$700,d0
00014970 31C0 C904                  		move.w	d0,($FFFFC904).w	; move to $C904
00014974 0828 0000 0022             		btst	#0,$22(a0)
0001497A 6700                       		beq.s	@dontflip
0001497C 4468 0014                  		neg.w	$14(a0)
00014980                             
