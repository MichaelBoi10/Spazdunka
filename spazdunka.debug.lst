000153BE 6400                       		bhs.s	loc_13AB4	; if yes, branch
000153C0 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000153C6 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000153CA 6400                       		bhs.s	loc_13AB4	; if yes, branch
000153CC 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
