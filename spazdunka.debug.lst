00081AF4                          M 	@wait_17:
00081AF4 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081AFC 66F6                     M 	bne.s	@wait_17
00081AFE                          M 	popo
00081AFE 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00081B06                          M 	mpcm_startz80
00081B06 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081B0E 4E75                       	rts
