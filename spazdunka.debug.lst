000152E8 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000152EA 1228 0022                  		move.b	$22(a0),d1
000152EE 0201 0001                  		andi.b	#1,d1
000152F2 0228 00FC 0001             		andi.b	#$FC,1(a0)
000152F8 8328 0001                  		or.b	d1,1(a0)
000152FC 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015300 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00015302 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00015306                            
00015306                            SAnim_Do2:
00015306 7200                       		moveq	#0,d1
00015308 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0001530C 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00015310 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
00015314 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
00015316                            
00015316                            SAnim_Next:
00015316 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
0001531A 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
0001531E                            
0001531E                            SAnim_Delay:
0001531E 4E75                       		rts	
00015320                            ; ===========================================================================
00015320                            
00015320                            SAnim_End_FF:
00015320 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00015322 6600                       		bne.s	SAnim_End_FE	; if not, branch
00015324 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
0001532A 1029 0001                  		move.b	1(a1),d0	; read sprite number
0001532E 60E6                       		bra.s	SAnim_Next
00015330                            ; ===========================================================================
00015330                            
00015330                            SAnim_End_FE:
00015330 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00015332 6600                       		bne.s	SAnim_End_FD	; if not, branch
00015334 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015338 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
0001533C 9200                       		sub.b	d0,d1
0001533E 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015342 60D2                       		bra.s	SAnim_Next
00015344                            ; ===========================================================================
00015344                            
00015344                            SAnim_End_FD:
