000039E8                            ; ---------------------------------------------------------------------------
000039E8                            ; Level	select menu text
000039E8                            ; ---------------------------------------------------------------------------
000039E8                            lstxt macro textline
000039E8                            	i:   = 1
000039E8                            	len: = strlen(\textline)
000039E8                            	if len<>24
000039E8                            		inform 2, "line length must be exactly 24 characters"
000039E8                            	endif
000039E8                            	while (i<=len)
000039E8                            		char:	substr i,i,\textline
000039E8                            		i: = i+1
000039E8                            		if     "\char"=' '
000039E8                            			dc.b	$FF
000039E8                            		elseif ("\char">='0')&("\char"<='9')
000039E8                            			dc.b	$00+"\char"-'0'
000039E8                            		elseif "\char"='$'
000039E8                            			dc.b	$0A
000039E8                            		elseif "\char"='-'
000039E8                            			dc.b	$0B
000039E8                            		elseif "\char"='='
000039E8                            			dc.b	$0C
000039E8                            		elseif "\char"=">"
000039E8                            			dc.b	$0D
000039E8                            		;elseif "\char"=">"
000039E8                            		;	dc.b	$0E
000039E8                            		elseif "\char"='Y'
000039E8                            			dc.b	$0F
000039E8                            		elseif "\char"='Z'
000039E8                            			dc.b	$10
000039E8                            		elseif ("\char">='A')&("\char"<='X')
000039E8                            			dc.b	$11+"\char"-'A'
000039E8                            		else
000039E8                            			inform 2, "illegal char \char"
000039E8                            		endif
000039E8                            	endw
000039E8                            	endm
000039E8                            
