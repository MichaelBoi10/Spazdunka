000147D8                            Sonic_CheckGoSuper:
000147D8 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
000147DC 6600 0000                  	bne.w	return_1ABA4		; if yes, branch
000147E0 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
000147E6 6600                       	bne.s	return_1ABA4		; if not, branch
000147E8 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
000147EE 6500                       	bcs.s	return_1ABA4		; if not, branch
000147F0 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
000147F4 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
