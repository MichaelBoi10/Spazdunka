00081E38                            ; ------------------------------------------------------------------------------
00081E38                            ; Mega PCM API Routines
00081E38                            ; ------------------------------------------------------------------------------
00081E38                            
00081E38                            
00081E38                            ; ------------------------------------------------------------------------------
00081E38                            ; Plays a given sample
00081E38                            ; ------------------------------------------------------------------------------
00081E38                            ; INPUT:
00081E38                            ;		d0	.b		sample id (>$81)
00081E38                            ;
00081E38                            ; EXAMPLES:
00081E38                            ;		move.b	#$81, d0
00081E38                            ;		jsr		MegaPCM_PlaySample
00081E38                            ;
00081E38                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081E38                            ;		jsr		MegaPCM_PlaySample
00081E38                            ; ------------------------------------------------------------------------------
00081E38                            
00081E38                            MegaPCM_PlaySample:
00081E38                            	MPCM_play	d0
00081E38                          M 	mpcm_stopz80
00081E38                          M 	pusho
00081E38                          M 	opt	l-
00081E38 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081E40                          M 	@wait_14:
00081E40 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081E48 66F6                     M 	bne.s	@wait_14
00081E4A                          M 	popo
00081E4A 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081E50                          M 	mpcm_startz80
00081E50 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081E58 4E75                       	rts
00081E5A                            
