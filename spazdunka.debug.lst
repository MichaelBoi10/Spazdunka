00014994                            Sonic_SpinDash:
00014994 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
00014998 6600                       		bne.s	loc2_1AC8E		; if set, branch
0001499A 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
000149A0 6600                       		bne.s	locret2_1AC8C		; if not, return
000149A2 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
000149A6 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
000149AA 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
000149AE 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
000149B4 303C 00D1                  		move.w	#$D1,d0			; spin sound ($E0 in s2)
000149B8 4EB9 0000 1034             		jsr	(PlaySound_Special).l	; play spin sound
000149BE 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
