0000E47E 3028 0012                  		move.w	$12(a0),d0	; load vertical	speed
0000E482 48C0                       		ext.l	d0
0000E484 E180                       		asl.l	#8,d0		; multiply by $100
0000E486 D680                       		add.l	d0,d3		; add to y-axis	position
0000E488 2142 0008                  		move.l	d2,8(a0)	; update x-axis	position
0000E48C 2143 000C                  		move.l	d3,y_pos(a0)	; update y-axis	position
0000E490 4E75                       		rts	
0000E492                            ; End of function SpeedToPos
