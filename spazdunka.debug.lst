0000B280                            ; ---------------------------------------------------------------------------
0000B280                            ; Subroutine to	animate	a sprite using an animation script
0000B280                            ; ---------------------------------------------------------------------------
0000B280                            
0000B280                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B280                            
0000B280                            
0000B280                            AnimateSprite:
0000B280 7000                       		moveq	#0,d0
0000B282 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B286 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B28A 6700                       		beq.s	Anim_Run	; if not, branch
0000B28C 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B290 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B296 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B29C                            
0000B29C                            Anim_Run:
0000B29C 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B2A0 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B2A2 D040                       		add.w	d0,d0
0000B2A4 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B2A8 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B2AC 7200                       		moveq	#0,d1
0000B2AE 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B2B2 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B2B6 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B2B8                            
0000B2B8                            Anim_Next:
0000B2B8 1200                       		move.b	d0,d1
0000B2BA 0200 001F                  		andi.b	#$1F,d0
0000B2BE 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B2C2 1028 0022                  		move.b	$22(a0),d0
0000B2C6 E719                       		rol.b	#3,d1
0000B2C8 B101                       		eor.b	d0,d1
0000B2CA 0201 0003                  		andi.b	#3,d1
0000B2CE 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B2D4 8328 0001                  		or.b	d1,render_flags(a0)
0000B2D8 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B2DC                            
0000B2DC                            Anim_Wait:
0000B2DC 4E75                       		rts	
0000B2DE                            ; ===========================================================================
0000B2DE                            
0000B2DE                            Anim_End_FF:
0000B2DE 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B2E0 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B2E2 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B2E8 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B2EC 60CA                       		bra.s	Anim_Next
0000B2EE                            ; ===========================================================================
0000B2EE                            
0000B2EE                            Anim_End_FE:
0000B2EE 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B2F0 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B2F2 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B2F6 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B2FA 9200                       		sub.b	d0,d1
0000B2FC 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B300 60B6                       		bra.s	Anim_Next
0000B302                            ; ===========================================================================
0000B302                            
0000B302                            Anim_End_FD:
0000B302 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B304 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B306 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B30C                            
0000B30C                            Anim_End_FC:
0000B30C 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B30E 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B310 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B314                            
0000B314                            Anim_End_FB:
0000B314 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B316 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B318 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B31E 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B322                            
0000B322                            Anim_End_FA:
0000B322 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B324 6600                       		bne.s	Anim_End	; if not, branch
0000B326 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B32A                            
0000B32A                            Anim_End:
0000B32A 4E75                       		rts	
0000B32C                            ; End of function AnimateSprite
