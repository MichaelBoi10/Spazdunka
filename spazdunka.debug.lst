0001DB2C 0200 0070                  		andi.b	#$70,d0
0001DB30 6600                       		bne.s	locret_1BBB4		; if not, branch to return
0001DB32 0828 0007 0022             		btst	#7,$22(a0)		; did Sonic jump or is he just falling or hit by a bumper?
0001DB38 6700                       		beq.s	locret_1BBB4		; if not, branch to return
0001DB3A 1038 F780                  		move.b	($FFFFF780).w,d0	; get SS angle
0001DB3E 0200 00FC                  		andi.b	#$FC,d0
0001DB42 4400                       		neg.b	d0
0001DB44 0400 0040                  		subi.b	#$40,d0
0001DB48 4EB9 0000 2AA6             		jsr	(CalcSine).l			
0001DB4E 3428 0012                  		move.w	$12(a0),d2		; get Y speed
0001DB52 C1C2                       		muls.w	d2,d0			; multiply Y speed by sin
0001DB54 E080                       		asr.l	#8,d0			; find the new Y speed
0001DB56 3428 0010                  		move.w	$10(a0),d2		; get X speed
0001DB5A C3C2                       		muls.w	d2,d1			; multiply X speed by cos
0001DB5C E081                       		asr.l	#8,d1			; find the new X speed
0001DB5E D240                       		add.w	d0,d1			; combine the two speeds
0001DB60 0C41 0400                  		cmpi.w	#$400,d1		; compare the combined speed with the jump release speed
0001DB64 6F00                       		ble.s	locret_1BBB4		; if it's less, branch to return
0001DB66 1038 F780                  		move.b	($FFFFF780).w,d0
0001DB6A 0200 00FC                  		andi.b	#$FC,d0
0001DB6E 4400                       		neg.b	d0
0001DB70 0400 0040                  		subi.b	#$40,d0
0001DB74 4EB9 0000 2AA6             		jsr	(CalcSine).l
0001DB7A C3FC 0400                  		muls.w	#$400,d1
0001DB7E E081                       		asr.l	#8,d1
0001DB80 3141 0010                  		move.w	d1,$10(a0)
0001DB84 C1FC 0400                  		muls.w	#$400,d0
0001DB88 E080                       		asr.l	#8,d0
0001DB8A 3140 0012                  		move.w	d0,$12(a0)		; set the speed to the jump release speed
0001DB8E 08A8 0007 0022             		bclr	#7,$22(a0)		; clear "Sonic has jumped" flag
