0000B0C6                            ; ---------------------------------------------------------------------------
0000B0C6                            ; Subroutine to	animate	a sprite using an animation script
0000B0C6                            ; ---------------------------------------------------------------------------
0000B0C6                            
0000B0C6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B0C6                            
0000B0C6                            
0000B0C6                            AnimateSprite:
0000B0C6 7000                       		moveq	#0,d0
0000B0C8 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B0CC B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B0D0 6700                       		beq.s	Anim_Run	; if not, branch
0000B0D2 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B0D6 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B0DC 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B0E2                            
0000B0E2                            Anim_Run:
0000B0E2 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B0E6 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B0E8 D040                       		add.w	d0,d0
0000B0EA D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B0EE 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B0F2 7200                       		moveq	#0,d1
0000B0F4 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B0F8 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B0FC 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B0FE                            
0000B0FE                            Anim_Next:
0000B0FE 1200                       		move.b	d0,d1
0000B100 0200 001F                  		andi.b	#$1F,d0
0000B104 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B108 1028 0022                  		move.b	$22(a0),d0
0000B10C E719                       		rol.b	#3,d1
0000B10E B101                       		eor.b	d0,d1
0000B110 0201 0003                  		andi.b	#3,d1
0000B114 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B11A 8328 0001                  		or.b	d1,render_flags(a0)
0000B11E 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B122                            
0000B122                            Anim_Wait:
0000B122 4E75                       		rts	
0000B124                            ; ===========================================================================
0000B124                            
0000B124                            Anim_End_FF:
0000B124 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B126 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B128 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B12E 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B132 60CA                       		bra.s	Anim_Next
0000B134                            ; ===========================================================================
0000B134                            
0000B134                            Anim_End_FE:
0000B134 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B136 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B138 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B13C 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B140 9200                       		sub.b	d0,d1
0000B142 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B146 60B6                       		bra.s	Anim_Next
0000B148                            ; ===========================================================================
0000B148                            
0000B148                            Anim_End_FD:
0000B148 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B14A 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B14C 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B152                            
0000B152                            Anim_End_FC:
0000B152 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B154 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B156 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B15A                            
0000B15A                            Anim_End_FB:
0000B15A 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B15C 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B15E 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B164 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B168                            
0000B168                            Anim_End_FA:
0000B168 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B16A 6600                       		bne.s	Anim_End	; if not, branch
0000B16C 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B170                            
0000B170                            Anim_End:
0000B170 4E75                       		rts	
0000B172                            ; End of function AnimateSprite
