0000DCD4 343C 0014                  		move.w	#$14,d2
0000DCD8                            
0000DCD8                            ; Spikes types $1x and $5x face	sideways
0000DCD8                            
0000DCD8                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DCD8 323C 001B                  		move.w	#$1B,d1
0000DCDC 3602                       		move.w	d2,d3
0000DCDE 5243                       		addq.w	#1,d3
0000DCE0 3828 0008                  		move.w	8(a0),d4
0000DCE4 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DCE8 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DCEC 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DCF0 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DCF4 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DCFA 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DCFC 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DCFE 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DD00 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DD02 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DD04                            ; ===========================================================================
0000DD04                            
0000DD04                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DD04                            
0000DD04                            Obj36_Upright:				; XREF: Obj36_Solid
0000DD04 7200                       		moveq	#0,d1
0000DD06 1228 0019                  		move.b	$19(a0),d1
0000DD0A 0641 000B                  		addi.w	#$B,d1
0000DD0E 343C 0010                  		move.w	#$10,d2
0000DD12 363C 0011                  		move.w	#$11,d3
0000DD16 3828 0008                  		move.w	8(a0),d4
0000DD1A 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DD1E 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DD24 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DD26 4A44                       		tst.w	d4			; check response value from SolidObject
0000DD28 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DD2A 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DD2E 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DD32 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DD38 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DD3A 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DD3C 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DD3E 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DD40                            		; otherwise, fall through to Spik_Hurt
0000DD40                            
0000DD40                            Obj36_Hurt:				; XREF: Obj36_SideWays; Obj36_Upright
0000DD40 4A38 FE2D                  		tst.b	($FFFFFE2D).w	; is Sonic invincible?
0000DD44 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DD46 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DD4A 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
0000DD4C 2F08                       		move.l	a0,-(sp)
0000DD4E 2448                       		movea.l	a0,a2
