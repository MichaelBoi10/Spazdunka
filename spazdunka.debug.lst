00080104                            @Str_TooManySamples:
00080104 546F 6F20 6D61 6E79 2073+  	dc.b	"Too many samples in table", 0
0008011E                            @Str_UnknownSampleType:
0008011E 556E 6B6E 6F77 6E20 7361+  	dc.b	"Unknown sample type or missing end marker. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE", 0
0008018B                            @Str_PitchNotSet:
0008018B 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
000801E2                            @Str_WaveInvalidHeader:
000801E2 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
00080202                            @Str_WaveBadAudioFormat:
00080202 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported audio format. Only PCM is supported", 0
0008023E                            @Str_WaveNotMono:
0008023E 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be mono", 0
0008025D                            @Str_WaveNot8bit:
0008025D 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be 8-bit unsigned PCM", 0
0008028A                            @Str_WaveBadSampleRate:
0008028A 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported sample rate. Use <=\#TYPE_PCM_MAX_RATE\ Hz for TYPE_PCM or \#TYPE_PCM_TURBO_MAX_RATE\ Hz for TYPE_PCM_TURBO.", 0
000802EB                            @Str_WaveMissingDataChunk:
000802EB 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Failed to locate 'data' chunk", 0
00080315                            @Str_DpcmHqUnsupportedVersion:
