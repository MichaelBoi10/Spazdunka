0007FDF6                            
0007FDF6 =0007DCDE                  MegaPCM_LoadDriver:	equ	MegaPCMLibraryBlob+$0
0007FDF6 =0007DD48                  MegaPCM_LoadSampleTable:	equ	MegaPCMLibraryBlob+$6A
0007FDF6 =0007DF8E                  MegaPCM:	equ	MegaPCMLibraryBlob+$2B0
