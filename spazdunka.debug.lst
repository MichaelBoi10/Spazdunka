0007FDF6                            ; ------------------------------------------------------------------------------
0007FDF6                            ; Mega PCM API Routines
0007FDF6                            ; ------------------------------------------------------------------------------
0007FDF6                            
0007FDF6                            
0007FDF6                            ; ------------------------------------------------------------------------------
0007FDF6                            ; Plays a given sample
0007FDF6                            ; ------------------------------------------------------------------------------
0007FDF6                            ; INPUT:
0007FDF6                            ;		d0	.b		sample id (>$81)
0007FDF6                            ;
0007FDF6                            ; EXAMPLES:
0007FDF6                            ;		move.b	#$81, d0
0007FDF6                            ;		jsr		MegaPCM_PlaySample
0007FDF6                            ;
0007FDF6                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
0007FDF6                            ;		jsr		MegaPCM_PlaySample
0007FDF6                            ; ------------------------------------------------------------------------------
0007FDF6                            
0007FDF6                            MegaPCM_PlaySample:
0007FDF6                            	MPCM_play	d0
0007FDF6                          M 	mpcm_stopz80
0007FDF6                          M 	pusho
0007FDF6                          M 	opt	l-
0007FDF6 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FDFE                          M 	@wait_20:
0007FDFE 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FE06 66F6                     M 	bne.s	@wait_20
0007FE08                          M 	popo
0007FE08 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0007FE0E                          M 	mpcm_startz80
0007FE0E 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FE16 4E75                       	rts
0007FE18                            
0007FE18                            ; ------------------------------------------------------------------------------
0007FE18                            ; Pauses current sample playback
0007FE18                            ; ------------------------------------------------------------------------------
0007FE18                            
0007FE18                            MegaPCM_PausePlayback:
0007FE18                            	MPCM_pause
0007FE18                          M 	mpcm_stopz80
0007FE18                          M 	pusho
0007FE18                          M 	opt	l-
0007FE18 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FE20                          M 	@wait_23:
0007FE20 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FE28 66F6                     M 	bne.s	@wait_23
0007FE2A                          M 	popo
0007FE2A 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
0007FE32                          M 	mpcm_startz80
0007FE32 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FE3A 4E75                       	rts
0007FE3C                            
0007FE3C                            ; ------------------------------------------------------------------------------
0007FE3C                            ; Unpauses playback
