00014FB8 0241 007F                  		andi.w	#$7F,d1
00014FBC D041                       		add.w	d1,d0
00014FBE 43F8 A400                  		lea	($FFFFA400).w,a1
00014FC2 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
00014FC6 B238 F7AE                  		cmp.b	($FFFFF7AE).w,d1
00014FCA 6700 F6CE                  		beq.w	Obj01_ChkRoll
00014FCE B238 F7AF                  		cmp.b	($FFFFF7AF).w,d1
00014FD2 6700 F6C6                  		beq.w	Obj01_ChkRoll
00014FD6 B238 F7AC                  		cmp.b	($FFFFF7AC).w,d1
00014FDA 6700                       		beq.s	loc_13976
00014FDC B238 F7AD                  		cmp.b	($FFFFF7AD).w,d1
00014FE0 6700                       		beq.s	loc_13966
00014FE2 08A8 0006 0001             		bclr	#6,render_flags(a0)
00014FE8 4E75                       		rts	
00014FEA                            ; ===========================================================================
00014FEA                            
00014FEA                            loc_13966:
00014FEA 0828 0001 0022             		btst	#1,status(a0)
00014FF0 6700                       		beq.s	loc_13976
00014FF2 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
00014FF8 4E75                       		rts	
00014FFA                            ; ===========================================================================
00014FFA                            
00014FFA                            loc_13976:
00014FFA 3428 0008                  		move.w	8(a0),d2
00014FFE 0C02 002C                  		cmpi.b	#$2C,d2
00015002 6400                       		bcc.s	loc_13988
00015004 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
0001500A 4E75                       		rts	
0001500C                            ; ===========================================================================
0001500C                            
0001500C                            loc_13988:
0001500C 0C02 00E0                  		cmpi.b	#-$20,d2
00015010 6500                       		bcs.s	loc_13996
00015012 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
00015018 4E75                       		rts	
0001501A                            ; ===========================================================================
0001501A                            
0001501A                            loc_13996:
0001501A 0828 0006 0001             		btst	#6,render_flags(a0)
00015020 6600                       		bne.s	loc_139B2
00015022 1228 0026                  		move.b	$26(a0),d1
00015026 6700                       		beq.s	locret_139C2
00015028 0C01 0080                  		cmpi.b	#-$80,d1
0001502C 6200                       		bhi.s	locret_139C2
0001502E 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
00015034 4E75                       		rts	
00015036                            ; ===========================================================================
00015036                            
00015036                            loc_139B2:
