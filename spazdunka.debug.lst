000010AC                            ; ---------------------------------------------------------------------------
000010AC                            ; Subroutine to load VDP commands into the DMA transfer queue
000010AC                            ;
000010AC                            ; In case you wish to use this queue system outside of the spin dash, this is the
000010AC                            ; registers in which it expects data in:
000010AC                            ; d1.l: Address to data (In 68k address space)
000010AC                            ; d2.w: Destination in VRAM
000010AC                            ; d3.w: Length of data
000010AC                            ; ---------------------------------------------------------------------------
000010AC                            
000010AC                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000010AC                            
000010AC                            
000010AC                            DMA_68KtoVRAM:
000010AC 2278 C8FC                  		movea.l	($FFFFC8FC).w,a1
000010B0 B2FC C8FC                  		cmpa.w	#$C8FC,a1	; is the DMA queue full?
000010B4 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
000010B6                            
000010B6                            		; piece together some VDP commands and store them for later...
000010B6 303C 9300                  		move.w	#$9300,d0	; command to specify DMA transfer length & $00FF
000010BA 1003                       		move.b	d3,d0
000010BC 32C0                       		move.w	d0,(a1)+	; store command
000010BE                            
000010BE 303C 9400                  		move.w	#$9400,d0	; command to specify DMA transfer length & $FF00
000010C2 E04B                       		lsr.w	#8,d3
000010C4 1003                       		move.b	d3,d0
000010C6 32C0                       		move.w	d0,(a1)+	; store command
000010C8                            
000010C8 303C 9500                  		move.w	#$9500,d0	; command to specify source address & $0001FE
000010CC E289                       		lsr.l	#1,d1
000010CE 1001                       		move.b	d1,d0
000010D0 32C0                       		move.w	d0,(a1)+	; store command
000010D2                            
000010D2 303C 9600                  		move.w	#$9600,d0	; command to specify source address & $01FE00
000010D6 E089                       		lsr.l	#8,d1
000010D8 1001                       		move.b	d1,d0
000010DA 32C0                       		move.w	d0,(a1)+	; store command
000010DC                            
000010DC 303C 9700                  		move.w	#$9700,d0	; command to specify source address & $FE0000
000010E0 E089                       		lsr.l	#8,d1
000010E2 1001                       		move.b	d1,d0
000010E4 32C0                       		move.w	d0,(a1)+	; store command
000010E6                            
000010E6 0282 0000 FFFF             		andi.l	#$FFFF,d2	; command to specify destination address and begin DMA
000010EC E58A                       		lsl.l	#2,d2
000010EE E44A                       		lsr.w	#2,d2
000010F0 4842                       		swap	d2
000010F2 0082 4000 0080             		ori.l	#$40000080,d2 ; set bits to specify VRAM transfer
000010F8 22C2                       		move.l	d2,(a1)+	; store command
000010FA                            
000010FA 21C9 C8FC                  		move.l	a1,($FFFFC8FC).w ; set the next free slot address
000010FE B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
00001102 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
00001104 32BC 0000                  		move.w	#0,(a1) ; put a stop token at the end of the used part of the buffer
00001108                            
00001108                            DMA_68KtoVRAM_Done:			; XREF: DMA_68KtoVRAM
00001108 4E75                       		rts
0000110A                            ; End of function DMA_68KtoVRAM
0000110A                            
0000110A                            ; ---------------------------------------------------------------------------
0000110A                            ; Process all VDP commands and then reset the DMA queue when it's done
0000110A                            ; ---------------------------------------------------------------------------
0000110A                            
0000110A                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000110A                            
0000110A                            
0000110A                            Process_DMA:
0000110A 4BF9 00C0 0004             		lea	($C00004).l,a5
00001110 43F8 C800                  		lea	($FFFFC800).w,a1
00001114                            
00001114                            Process_DMA_Loop:			; XREF: Process_DMA
00001114 3019                       		move.w	(a1)+,d0	; has a stop token been encountered?
00001116 6700                       		beq.s	Process_DMA_Done ; branch if we reached a stop token
00001118                            
00001118                            		; issue a set of VDP commands...
00001118 3A80                       		move.w	d0,(a5)		; transfer length
0000111A 3A99                       		move.w	(a1)+,(a5)	; transfer length
0000111C 3A99                       		move.w	(a1)+,(a5)	; source address
0000111E 3A99                       		move.w	(a1)+,(a5)	; source address
00001120 3A99                       		move.w	(a1)+,(a5)	; source address
00001122 3A99                       		move.w	(a1)+,(a5)	; destination
00001124 3A99                       		move.w	(a1)+,(a5)	; destination
00001126 B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
0000112A 66E8                       		bne.s	Process_DMA_Loop ; loop if we haven't reached the end of the buffer
0000112C                            
0000112C                            Process_DMA_Done:			; XREF: Process_DMA
0000112C 31FC 0000 C800             		move.w	#0,($FFFFC800).w
00001132 21FC FFFF C800 C8FC        		move.l	#$FFFFC800,($FFFFC8FC).w
0000113A 4E75                       		rts
0000113C                            ; End of function Process_DMA
