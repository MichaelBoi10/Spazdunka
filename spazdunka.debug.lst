0007FDA2                            
0007FDA2                            
0007FDA2                            ; ------------------------------------------------------------------------------
0007FDA2                            ; Plays a given sample
0007FDA2                            ; ------------------------------------------------------------------------------
0007FDA2                            ; INPUT:
0007FDA2                            ;		d0	.b		sample id (>$81)
0007FDA2                            ;
0007FDA2                            ; EXAMPLES:
0007FDA2                            ;		move.b	#$81, d0
0007FDA2                            ;		jsr		MegaPCM_PlaySample
0007FDA2                            ;
0007FDA2                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
0007FDA2                            ;		jsr		MegaPCM_PlaySample
0007FDA2                            ; ------------------------------------------------------------------------------
0007FDA2                            
0007FDA2                            MegaPCM_PlaySample:
0007FDA2                            	MPCM_play	d0
0007FDA2                          M 	mpcm_stopz80
0007FDA2                          M 	pusho
0007FDA2                          M 	opt	l-
0007FDA2 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FDAA                          M 	@wait_20:
0007FDAA 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FDB2 66F6                     M 	bne.s	@wait_20
0007FDB4                          M 	popo
0007FDB4 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0007FDBA                          M 	mpcm_startz80
0007FDBA 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FDC2 4E75                       	rts
0007FDC4                            
0007FDC4                            ; ------------------------------------------------------------------------------
