00001014                            PauseGame:				; XREF: Level_MainLoop; et al
00001014 4E71                       		nop	
00001016 4A38 FE12                  		tst.b	($FFFFFE12).w	; do you have any lives	left?
0000101A 6700                       		beq.s	Unpause		; if not, branch
0000101C 4A78 F63A                  		tst.w	($FFFFF63A).w	; is game already paused?
00001020 6600                       		bne.s	loc_13BE	; if yes, branch
00001022 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
00001028 6700                       		beq.s	Pause_DoNothing	; if not, branch
0000102A                            
0000102A                            loc_13BE:
0000102A 31FC 0001 F63A             		move.w	#1,($FFFFF63A).w ; freeze time
00001030 11FC 0001 F003             		move.b	#1,($FFFFF003).w ; pause music
00001036                            
00001036                            loc_13CA:
00001036 11FC 0010 F62A             		move.b	#$10,($FFFFF62A).w
0000103C 6100 0000                  		bsr.w	DelayProgram
00001040 4A38 FFE1                  		tst.b	($FFFFFFE1).w	; is slow-motion cheat on?
00001044 6700                       		beq.s	Pause_ChkStart	; if not, branch
00001046 0838 0006 F605             		btst	#6,($FFFFF605).w ; is button A pressed?
0000104C 6700                       		beq.s	Pause_ChkBC	; if not, branch
0000104E 11FC 0004 F600             		move.b	#4,($FFFFF600).w ; set game mode to 4 (title screen)
00001054 4E71                       		nop	
00001056 6000                       		bra.s	loc_1404
00001058                            ; ===========================================================================
00001058                            
00001058                            Pause_ChkBC:				; XREF: PauseGame
00001058 0838 0004 F604             		btst	#4,($FFFFF604).w ; is button B pressed?
0000105E 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001060 0838 0005 F605             		btst	#5,($FFFFF605).w ; is button C pressed?
00001066 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001068                            
00001068                            Pause_ChkStart:				; XREF: PauseGame
00001068 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
0000106E 67C6                       		beq.s	loc_13CA	; if not, branch
00001070                            
00001070                            loc_1404:				; XREF: PauseGame
00001070 11FC 0080 F003             		move.b	#$80,($FFFFF003).w
00001076                            
00001076                            Unpause:				; XREF: PauseGame
