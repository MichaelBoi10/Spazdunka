0001F06C                            ; ---------------------------------------------------------------------------
0001F06C                            ; Main level load blocks
0001F06C                            ; ---------------------------------------------------------------------------
0001F06C                            MainLoadBlocks:
0001F06C                            	include "_inc\Main level load blocks.asm"
0001F06C                            LoadZoneTiles:
0001F06C 7000                       		moveq	#0,d0			; Clear d0
0001F06E 1038 FE10                  		move.b	($FFFFFE10).w,d0		; Load number of current zone to d0
0001F072 E948                       		lsl.w	#4,d0			; Multiply by $10, converting the zone ID into an offset
0001F074 45F9 0001 F06C             		lea	(MainLoadBlocks).l,a2	; Load LevelHeaders's address into a2
0001F07A 45F2 0000                  		lea	(a2,d0.w),a2		; Offset LevelHeaders by the zone-offset, and load the resultant address to a2
0001F07E 201A                       		move.l	(a2)+,d0		; Move the first longword of data that a2 points to to d0, this contains the zone's first PLC ID and its art's address.
0001F080                            						; The auto increment is pointless as a2 is overwritten later, and nothing reads from a2 before then
0001F080 0280 00FF FFFF             		andi.l	#$FFFFFF,d0    		; Filter out the first byte, which contains the first PLC ID, leaving the address of the zone's art in d0
0001F086 2040                       		movea.l	d0,a0			; Load the address of the zone's art into a0 (source)
0001F088 43F9 00FF 0000             		lea	($FF0000).l,a1		; Load v_256x256/StartOfRAM (in this context, an art buffer) into a1 (destination)
0001F08E 4EB8 1598                  		jsr	KosDec			; Decompress a0 to a1 (Kosinski compression)
0001F092                            
0001F092 3609                       		move.w	a1,d3			; Move a word of a1 to d3, note that a1 doesn't exactly contain the address of v_256x256/StartOfRAM anymore, after KosDec, a1 now contains v_256x256/StartOfRAM + the size of the file decompressed to it, d3 now contains the length of the file that was decompressed
0001F094 3E03                       		move.w	d3,d7			; Move d3 to d7, for use in seperate calculations
0001F096                            
0001F096 0243 0FFF                  		andi.w	#$FFF,d3		; Remove the high nibble of the high byte of the length of decompressed file, this nibble is how many $1000 bytes the decompressed art is
0001F09A E24B                       		lsr.w	#1,d3			; Half the value of 'length of decompressed file', d3 becomes the 'DMA transfer length'
0001F09C                            
0001F09C E95F                       		rol.w	#4,d7			; Rotate (left) length of decompressed file by one nibble
0001F09E 0247 000F                  		andi.w	#$F,d7			; Only keep the low nibble of low byte (the same one filtered out of d3 above), this nibble is how many $1000 bytes the decompressed art is
0001F0A2                            
0001F0A2 3407                       @loop:		move.w	d7,d2			; Move d7 to d2, note that the ahead dbf removes 1 byte from d7 each time it loops, meaning that the following calculations will have different results each time
0001F0A4 EF4A                       		lsl.w	#7,d2
0001F0A6 EB4A                       		lsl.w	#5,d2			; Shift (left) d2 by $C, making it high nibble of the high byte, d2 is now the size of the decompressed file rounded down to the nearest $1000 bytes, d2 becomes the 'destination address'
0001F0A8                            
0001F0A8 223C 00FF FFFF             		move.l	#$FFFFFF,d1		; Fill d1 with $FF
0001F0AE 3202                       		move.w	d2,d1			; Move d2 to d1, overwriting the last word of $FF's with d2, this turns d1 into 'StartOfRAM'+'However many $1000 bytes the decompressed art is', d1 becomes the 'source address'
0001F0B0                            
0001F0B0 4EB9 0000 10AC             		jsr	(DMA_68KtoVRAM).l	; Use d1, d2, and d3 to locate the decompressed art and ready for transfer to VRAM
0001F0B6 3F07                       		move.w	d7,-(sp)		; Store d7 in the Stack
0001F0B8 11FC 000C F62A             		move.b	#$C,($FFFFF62A).w
0001F0BE 4EB8 2A24                  		jsr	DelayProgram
0001F0C2 4EB8 12E8                  		jsr	RunPLC_RAM
0001F0C6 3E1F                       		move.w	(sp)+,d7		; Restore d7 from the Stack
0001F0C8 363C 0800                  		move.w	#$800,d3		; Force the DMA transfer length to be $1000/2 (the first cycle is dynamic because the art's DMA'd backwards)
0001F0CC 51CF FFD4                  		dbf	d7,@loop		; Loop for each $1000 bytes the decompressed art is
0001F0D0                            
0001F0D0 4E75                       		rts
0001F0D2                            
