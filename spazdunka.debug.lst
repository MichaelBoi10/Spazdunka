00015350                            SAnim_WalkRun:				; XREF: SAnim_Do
00015350 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015354 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015356 5200                       		addq.b	#1,d0		; is animation walking/running?
00015358 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
0001535C 7200                       		moveq	#0,d1
0001535E 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015362 1428 0022                  		move.b	$22(a0),d2
00015366 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
0001536A 6600                       		bne.s	loc_13A70	; if yes, branch
0001536C 4600                       		not.b	d0		; reverse angle
0001536E                            
0001536E                            loc_13A70:
0001536E 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015372 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015374 7203                       		moveq	#3,d1
00015376                            
00015376                            loc_13A78:
00015376 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001537C B302                       		eor.b	d1,d2
0001537E 8528 0001                  		or.b	d2,1(a0)
00015382 0828 0005 0022             		btst	#5,$22(a0)
00015388 6600 0000                  		bne.w	SAnim_Push
0001538C E808                       		lsr.b	#4,d0		; divide angle by $10
0001538E 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015392 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015396 6A00                       		bpl.s	loc_13A9C
00015398 4442                       		neg.w	d2
0001539A                            
0001539A                            loc_13A9C:
0001539A 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
0001539E 6700                       		beq.s	Loc_NotSuper
000153A0 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
000153A6 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000153AA 6400                       		bhs.s	SuperRun	; if yes, branch
000153AC 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
000153B2 6000                       		bra.s	SuperWalk
000153B4                            
000153B4                            Loc_NotSuper:
000153B4 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
