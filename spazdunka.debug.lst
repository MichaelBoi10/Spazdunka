00014FE2                            ; Subroutine to	animate	Sonic's sprites
00014FE2                            ; ---------------------------------------------------------------------------
00014FE2                            
00014FE2                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014FE2                            
00014FE2                            
00014FE2                            Sonic_Animate:				; XREF: Obj01_Control; et al
00014FE2 43F9 0000 0000             		lea	(SonicAniData).l,a1
00014FE8 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00014FEC 6700                       		beq.s	SAnim_NotSuper
00014FEE 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
00014FF4                            
00014FF4                            SAnim_NotSuper:		
00014FF4 7000                       		moveq	#0,d0
00014FF6 1028 001C                  		move.b	$1C(a0),d0
00014FFA B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00014FFE 6700                       		beq.s	SAnim_Do	; if not, branch
00015000 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
00015004 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
0001500A 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00015010                            
00015010                            SAnim_Do:
00015010 D040                       		add.w	d0,d0
00015012 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00015016 1011                       		move.b	(a1),d0
00015018 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
0001501A 1228 0022                  		move.b	$22(a0),d1
0001501E 0201 0001                  		andi.b	#1,d1
00015022 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015028 8328 0001                  		or.b	d1,1(a0)
0001502C 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015030 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00015032 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00015036                            
00015036                            SAnim_Do2:
00015036 7200                       		moveq	#0,d1
00015038 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0001503C 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00015040 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
00015044 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
00015046                            
00015046                            SAnim_Next:
00015046 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
0001504A 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
0001504E                            
0001504E                            SAnim_Delay:
0001504E 4E75                       		rts	
00015050                            ; ===========================================================================
00015050                            
00015050                            SAnim_End_FF:
00015050 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00015052 6600                       		bne.s	SAnim_End_FE	; if not, branch
00015054 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
0001505A 1029 0001                  		move.b	1(a1),d0	; read sprite number
0001505E 60E6                       		bra.s	SAnim_Next
00015060                            ; ===========================================================================
00015060                            
00015060                            SAnim_End_FE:
00015060 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00015062 6600                       		bne.s	SAnim_End_FD	; if not, branch
00015064 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015068 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
0001506C 9200                       		sub.b	d0,d1
0001506E 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015072 60D2                       		bra.s	SAnim_Next
00015074                            ; ===========================================================================
00015074                            
00015074                            SAnim_End_FD:
00015074 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015076 6600                       		bne.s	SAnim_End	; if not, branch
00015078 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
0001507E                            
0001507E                            SAnim_End:
0001507E 4E75                       		rts	
00015080                            ; ===========================================================================
00015080                            
00015080                            SAnim_WalkRun:				; XREF: SAnim_Do
00015080 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015084 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015086 5200                       		addq.b	#1,d0		; is animation walking/running?
00015088 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
0001508C 7200                       		moveq	#0,d1
0001508E 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015092 1428 0022                  		move.b	$22(a0),d2
00015096 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
0001509A 6600                       		bne.s	loc_13A70	; if yes, branch
0001509C 4600                       		not.b	d0		; reverse angle
0001509E                            
0001509E                            loc_13A70:
0001509E 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
000150A2 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
000150A4 7203                       		moveq	#3,d1
000150A6                            
000150A6                            loc_13A78:
000150A6 0228 00FC 0001             		andi.b	#$FC,1(a0)
000150AC B302                       		eor.b	d1,d2
000150AE 8528 0001                  		or.b	d2,1(a0)
000150B2 0828 0005 0022             		btst	#5,$22(a0)
000150B8 6600 0000                  		bne.w	SAnim_Push
000150BC E808                       		lsr.b	#4,d0		; divide angle by $10
000150BE 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
000150C2 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000150C6 6A00                       		bpl.s	loc_13A9C
000150C8 4442                       		neg.w	d2
000150CA                            
000150CA                            loc_13A9C:
000150CA 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
000150CE 6700                       		beq.s	Loc_NotSuper
000150D0 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
000150D6 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000150DA 6400                       		bhs.s	SuperRun	; if yes, branch
000150DC 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
000150E2 6000                       		bra.s	SuperWalk
000150E4                            
000150E4                            Loc_NotSuper:
000150E4 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
000150EA 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000150EE 6400                       		bhs.s	loc_13AB4	; if yes, branch
000150F0 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000150F6 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000150FA 6400                       		bhs.s	loc_13AB4	; if yes, branch
000150FC 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00015102                            
00015102                            SuperWalk:
00015102 1200                       		move.b	d0,d1
00015104 E209                       		lsr.b	#1,d1
00015106 D001                       		add.b	d1,d0
00015108                            
00015108                            loc_13AB4:
00015108 D000                       		add.b	d0,d0
0001510A                            
0001510A                            SuperRun:
0001510A 1600                       		move.b	d0,d3
0001510C 4442                       		neg.w	d2
0001510E 0642 0800                  		addi.w	#$800,d2
00015112 6A00                       		bpl.s	loc_13AC2
00015114 7400                       		moveq	#0,d2
00015116                            
00015116                            loc_13AC2:
00015116 E04A                       		lsr.w	#8,d2
00015118 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001511C 6100 FF18                  		bsr.w	SAnim_Do2
00015120 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
00015124 4E75                       		rts	
00015126                            ; ===========================================================================
00015126                            
00015126                            SAnim_RollJump:				; XREF: SAnim_WalkRun
00015126 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
00015128 6600                       		bne.s	SAnim_Push	; if not, branch
0001512A 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
0001512E 6A00                       		bpl.s	loc_13ADE
00015130 4442                       		neg.w	d2
00015132                            
00015132                            loc_13ADE:
00015132 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
00015138 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
0001513C 6400                       		bcc.s	loc_13AF0	; if yes, branch
0001513E 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
00015144                            
00015144                            loc_13AF0:
00015144 4442                       		neg.w	d2
00015146 0642 0400                  		addi.w	#$400,d2
0001514A 6A00                       		bpl.s	loc_13AFA
