0001E6F8 6600                       		bne.s	@display
0001E6FA 5240                       		addq.w	#1,d0		; make ring counter flash red
0001E6FC 0C38 0009 FE23             		cmpi.b	#9,($FFFFFE23).w ; have	9 minutes elapsed?
0001E702 6600                       		bne.s	@display	; if not, branch
0001E704 5440                                       addq.w	#2,d0		; make time counter flash red
0001E706                            
0001E706                                @display:
0001E706 1140 001A                          move.b	d0,$1A(a0)
0001E70A 4EF9 0000 E50E             		jmp	(DisplaySprite).l
