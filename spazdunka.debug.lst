00080082                            @ErrorCodeToDescription:
00080082                            	;		Raw error code								  String pointer
00080082 0000 0000                  	dc.l	(MPCM_ST_TOO_MANY_SAMPLES<<24) 				| @Str_TooManySamples
00080086 0000 0000                  	dc.l	(MPCM_ST_UNKNOWN_SAMPLE_TYPE<<24)			| @Str_UnknownSampleType
0008008A 0000 0000                  	dc.l	(MPCM_ST_PITCH_NOT_SET<<24)					| @Str_PitchNotSet
0008008E 0000 0000                  	dc.l	(MPCM_ST_WAVE_INVALID_HEADER<<24)			| @Str_WaveInvalidHeader
00080092 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_AUDIO_FORMAT<<24)			| @Str_WaveBadAudioFormat
00080096 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_MONO<<24)					| @Str_WaveNotMono
0008009A 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_8BIT<<24)					| @Str_WaveNot8bit
0008009E 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_SAMPLE_RATE<<24)			| @Str_WaveBadSampleRate
000800A2 0000 0000                  	dc.l	(MPCM_ST_WAVE_MISSING_DATA_CHUNK<<24)		| @Str_WaveMissingDataChunk
000800A6 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_UNSUPPORTED_VERSION<<24)	| @Str_DpcmHqUnsupportedVersion
000800AA 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_BAD_SAMPLE_RATE<<24)		| @Str_DpcmHqBadSampleRate
000800AE FF00                       	dc.b	$FF, 0		; end marker
000800B0                            
000800B0                            ; ------------------------------------------------------------------------------
000800B0                            @Str_TooManySamples:
000800B0 546F 6F20 6D61 6E79 2073+  	dc.b	"Too many samples in table", 0
000800CA                            @Str_UnknownSampleType:
000800CA 556E 6B6E 6F77 6E20 7361+  	dc.b	"Unknown sample type or missing end marker. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE", 0
00080137                            @Str_PitchNotSet:
00080137 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
0008018E                            @Str_WaveInvalidHeader:
0008018E 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
000801AE                            @Str_WaveBadAudioFormat:
000801AE 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported audio format. Only PCM is supported", 0
000801EA                            @Str_WaveNotMono:
000801EA 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be mono", 0
00080209                            @Str_WaveNot8bit:
00080209 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be 8-bit unsigned PCM", 0
00080236                            @Str_WaveBadSampleRate:
00080236 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported sample rate. Use <=\#TYPE_PCM_MAX_RATE\ Hz for TYPE_PCM or \#TYPE_PCM_TURBO_MAX_RATE\ Hz for TYPE_PCM_TURBO.", 0
00080297                            @Str_WaveMissingDataChunk:
00080297 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Failed to locate 'data' chunk", 0
000802C1                            @Str_DpcmHqUnsupportedVersion:
000802C1 4450 434D 2D48 5120 6572+  	dc.b	"DPCM-HQ error: Unsupported version specified in header", 0
000802F8                            @Str_DpcmHqBadSampleRate:
000802F8 4450 434D 2D48 5120 6572+  	dc.b	"DPCM-HQ error: Unsupported sample rate. Use <=\#TYPE_DPCM_MAX_RATE\ Hz for TYPE_DPCM or \#TYPE_DPCM_TURBO_MAX_RATE\ Hz for TYPE_DPCM_TURBO.", 0
0008035E                            @Str_UnknownError:
0008035E 556B 6E6F 776E 2065 7272+  	dc.b	"Uknown error code", 0
00080370                            	even
