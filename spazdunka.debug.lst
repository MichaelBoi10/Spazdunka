00081F70                            ; ------------------------------------------------------------------------------
00081F70                            ; DEBUGGER: Displays details for `MegaPCM_LoadSampleTable` error code
00081F70                            ; ------------------------------------------------------------------------------
00081F70                            ; INPUT:
00081F70                            ;		d0	.w	Error code returned by `MegaPCM_LoadSampleTable`
00081F70                            ;		a0		Pointer to faulty sample
00081F70                            ; ------------------------------------------------------------------------------
00081F70                            
00081F70                            MPCM_Debugger_LoadSampleTableException:
00081F70                            
00081F70                            	; Print raw error code
00081F70                            	Console.Write "%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00081F70 40E7                     M 	move.w	sr,-(sp)
