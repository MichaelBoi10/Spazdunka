00015126                            ; ---------------------------------------------------------------------------
00015126                            
00015126                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00015126                            
00015126                            
00015126                            Sonic_HurtStop:				; XREF: Obj01_Hurt
00015126 3038 F72E                  		move.w	($FFFFF72E).w,d0
0001512A 0640 00E0                  		addi.w	#$E0,d0
0001512E B068 000C                  		cmp.w	$C(a0),d0
00015132 6500 F796                  		bcs.w	JmpTo_KillSonic
00015136 6100 FD70                  		bsr.w	Sonic_Floor
0001513A 0828 0001 0022             		btst	#1,status(a0)
00015140 6600                       		bne.s	locret_13860
00015142 7000                       		moveq	#0,d0
00015144 3140 0012                  		move.w	d0,y_vel(a0)
00015148 3140 0010                  		move.w	d0,x_vel(a0)
0001514C 3140 0014                  		move.w	d0,$14(a0)
00015150 117C 0000 001C             		move.b	#0,anim(a0)
00015156 5528 0024                  		subq.b	#2,routine(a0)
0001515A 317C 0078 0030             		move.w	#$78,$30(a0)
00015160                            
00015160                            locret_13860:
00015160 4E75                       		rts	
00015162                            ; End of function Sonic_HurtStop
00015162                            
00015162                            ; ===========================================================================
00015162                            ; ---------------------------------------------------------------------------
00015162                            ; Sonic	when he	dies
00015162                            ; ---------------------------------------------------------------------------
00015162                            
00015162                            Obj01_Death:				; XREF: Obj01_Index
00015162 6100 0000                  		bsr.w	GameOver
00015166 4EBA 92D8                  		jsr	ObjectFall
0001516A 6100 EFA8                  		bsr.w	Sonic_RecordPos
0001516E 6100 0000                  		bsr.w	Sonic_Animate
00015172 6100 0000                  		bsr.w	LoadSonicDynPLC
00015176 4EFA 931A                  		jmp	DisplaySprite
0001517A                            
0001517A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001517A                            
0001517A                            
0001517A                            GameOver:				; XREF: Obj01_Death
0001517A 3038 F704                  		move.w	($FFFFF704).w,d0
0001517E 0640 0100                  		addi.w	#$100,d0
00015182 B068 000C                  		cmp.w	$C(a0),d0
00015186 6C00 0000                  		bge.w	locret_13900
0001518A 317C FFC8 0012             		move.w	#-$38,y_vel(a0)
00015190 5428 0024                  		addq.b	#2,routine(a0)
00015194 4238 FE1E                  		clr.b	($FFFFFE1E).w	; stop time counter
00015198 5238 FE1C                  		addq.b	#1,($FFFFFE1C).w ; update lives	counter
0001519C 5338 FE12                  		subq.b	#1,($FFFFFE12).w ; subtract 1 from number of lives
000151A0 6600                       		bne.s	loc_138D4
000151A2 317C 0000 003A             		move.w	#0,$3A(a0)
000151A8 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load GAME object
000151AE 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
000151B4 11FC 0001 D0DA             		move.b	#1,($FFFFD0DA).w ; set OVER object to correct frame
000151BA 4238 FE1A                  		clr.b	($FFFFFE1A).w
000151BE                            
000151BE                            loc_138C2:
000151BE 11FC 0014 F600             		move.b	#$14,($FFFFF600).w ; set mode to $14 (continue screen)
000151C4 7003                       		moveq	#3,d0
000151C6 4EF9 0000 127C             		jmp	(LoadPLC).l	; load game over patterns
000151CC                            ; ===========================================================================
000151CC                            
000151CC                            loc_138D4:
000151CC 317C 003C 003A             		move.w	#60,$3A(a0)	; set time delay to 1 second
000151D2 4A38 FE1A                  		tst.b	($FFFFFE1A).w	; is TIME OVER tag set?
000151D6 6700                       		beq.s	locret_13900	; if not, branch
000151D8 317C 0000 003A             		move.w	#0,$3A(a0)
000151DE 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load TIME object
000151E4 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
000151EA 11FC 0002 D09A             		move.b	#2,($FFFFD09A).w
000151F0 11FC 0003 D0DA             		move.b	#3,($FFFFD0DA).w
000151F6 60C6                       		bra.s	loc_138C2
000151F8                            ; ===========================================================================
000151F8                            
000151F8                            locret_13900:
000151F8 4E75                       		rts	
000151FA                            ; End of function GameOver
000151FA                            
000151FA                            ; ===========================================================================
000151FA                            ; ---------------------------------------------------------------------------
000151FA                            ; Sonic	when the level is restarted
000151FA                            ; ---------------------------------------------------------------------------
000151FA                            
000151FA                            Obj01_ResetLevel:			; XREF: Obj01_Index
000151FA 4A68 003A                  		tst.w	$3A(a0)
000151FE 6700                       		beq.s	locret_13914
00015200 5368 003A                  		subq.w	#1,$3A(a0)	; subtract 1 from time delay
00015204 6600                       		bne.s	locret_13914
00015206 31FC 0001 FE02             		move.w	#1,($FFFFFE02).w ; restart the level
0001520C                            
0001520C                            locret_13914:
0001520C 4E75                       		rts	
0001520E                            
0001520E                            Sonic_Loops:				; XREF: Obj01_Control
0001520E 3028 000C                  		move.w	$C(a0),d0
00015212 E248                       		lsr.w	#1,d0
00015214 0240 0380                  		andi.w	#$380,d0
00015218 1228 0008                  		move.b	8(a0),d1
0001521C 0241 007F                  		andi.w	#$7F,d1
00015220 D041                       		add.w	d1,d0
00015222 43F8 A400                  		lea	($FFFFA400).w,a1
00015226 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
0001522A B238 F7AE                  		cmp.b	($FFFFF7AE).w,d1
0001522E 6700 F6E2                  		beq.w	Obj01_ChkRoll
00015232 B238 F7AF                  		cmp.b	($FFFFF7AF).w,d1
00015236 6700 F6DA                  		beq.w	Obj01_ChkRoll
0001523A B238 F7AC                  		cmp.b	($FFFFF7AC).w,d1
0001523E 6700                       		beq.s	loc_13976
00015240 B238 F7AD                  		cmp.b	($FFFFF7AD).w,d1
00015244 6700                       		beq.s	loc_13966
00015246 08A8 0007 0022             		bclr	#7,status(a0)
0001524C 4E75                       		rts	
0001524E                            ; ===========================================================================
0001524E                            
0001524E                            loc_13966:
0001524E 0828 0001 0022             		btst	#1,status(a0)
00015254 6700                       		beq.s	loc_13976
00015256 08A8 0007 0022             		bclr	#7,status(a0)	; send Sonic to	high plane
0001525C 4E75                       		rts	
0001525E                            ; ===========================================================================
0001525E                            
0001525E                            loc_13976:
0001525E 3428 0008                  		move.w	8(a0),d2
00015262 0C02 002C                  		cmpi.b	#$2C,d2
00015266 6400                       		bcc.s	loc_13988
00015268 08A8 0007 0022             		bclr	#7,status(a0)	; send Sonic to	high plane
0001526E 4E75                       		rts	
00015270                            ; ===========================================================================
00015270                            
00015270                            loc_13988:
00015270 0C02 00E0                  		cmpi.b	#-$20,d2
00015274 6500                       		bcs.s	loc_13996
00015276 08E8 0007 0022             		bset	#7,status(a0)	; send Sonic to	low plane
0001527C 4E75                       		rts	
0001527E                            ; ===========================================================================
0001527E                            
0001527E                            loc_13996:
0001527E 0828 0007 0022             		btst	#7,status(a0)
00015284 6600                       		bne.s	loc_139B2
00015286 1228 0026                  		move.b	$26(a0),d1
0001528A 6700                       		beq.s	locret_139C2
0001528C 0C01 0080                  		cmpi.b	#-$80,d1
00015290 6200                       		bhi.s	locret_139C2
00015292 08E8 0007 0022             		bset	#7,status(a0)	; send Sonic to	low plane
00015298 4E75                       		rts	
0001529A                            ; ===========================================================================
0001529A                            
0001529A                            loc_139B2:
0001529A 1228 0026                  		move.b	$26(a0),d1
0001529E 0C01 0080                  		cmpi.b	#-$80,d1
000152A2 6300                       		bls.s	locret_139C2
000152A4 08A8 0007 0022             		bclr	#7,status(a0)	; send Sonic to	high plane
000152AA                            
000152AA                            locret_139C2:
000152AA 4E75                       		rts	
000152AC                            ; End of function Sonic_Loops
