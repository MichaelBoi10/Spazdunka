00015048                            ; Subroutine to	animate	Sonic's sprites
00015048                            ; ---------------------------------------------------------------------------
00015048                            
00015048                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00015048                            
00015048                            
00015048                            Sonic_Animate:				; XREF: Obj01_Control; et al
00015048 43F9 0000 0000             		lea	(SonicAniData).l,a1
0001504E 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015052 6700                       		beq.s	SAnim_NotSuper
00015054 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
0001505A                            
0001505A                            SAnim_NotSuper:		
0001505A 7000                       		moveq	#0,d0
0001505C 1028 001C                  		move.b	$1C(a0),d0
00015060 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00015064 6700                       		beq.s	SAnim_Do	; if not, branch
00015066 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
0001506A 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00015070 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00015076                            
00015076                            SAnim_Do:
00015076 D040                       		add.w	d0,d0
00015078 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0001507C 1011                       		move.b	(a1),d0
0001507E 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00015080 1228 0022                  		move.b	$22(a0),d1
00015084 0201 0001                  		andi.b	#1,d1
00015088 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001508E 8328 0001                  		or.b	d1,1(a0)
00015092 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015096 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00015098 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
0001509C                            
0001509C                            SAnim_Do2:
0001509C 7200                       		moveq	#0,d1
0001509E 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000150A2 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000150A6 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000150AA 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
000150AC                            
000150AC                            SAnim_Next:
000150AC 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000150B0 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000150B4                            
000150B4                            SAnim_Delay:
000150B4 4E75                       		rts	
000150B6                            ; ===========================================================================
000150B6                            
000150B6                            SAnim_End_FF:
000150B6 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000150B8 6600                       		bne.s	SAnim_End_FE	; if not, branch
000150BA 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
000150C0 1029 0001                  		move.b	1(a1),d0	; read sprite number
000150C4 60E6                       		bra.s	SAnim_Next
000150C6                            ; ===========================================================================
000150C6                            
000150C6                            SAnim_End_FE:
000150C6 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
000150C8 6600                       		bne.s	SAnim_End_FD	; if not, branch
000150CA 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
000150CE 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
000150D2 9200                       		sub.b	d0,d1
000150D4 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
000150D8 60D2                       		bra.s	SAnim_Next
000150DA                            ; ===========================================================================
000150DA                            
000150DA                            SAnim_End_FD:
000150DA 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
000150DC 6600                       		bne.s	SAnim_End	; if not, branch
000150DE 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
000150E4                            
000150E4                            SAnim_End:
000150E4 4E75                       		rts	
000150E6                            ; ===========================================================================
000150E6                            
000150E6                            SAnim_WalkRun:				; XREF: SAnim_Do
000150E6 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150EA 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
000150EC 5200                       		addq.b	#1,d0		; is animation walking/running?
000150EE 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
000150F2 7200                       		moveq	#0,d1
000150F4 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
000150F8 1428 0022                  		move.b	$22(a0),d2
000150FC 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015100 6600                       		bne.s	loc_13A70	; if yes, branch
00015102 4600                       		not.b	d0		; reverse angle
00015104                            
00015104                            loc_13A70:
00015104 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015108 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001510A 7203                       		moveq	#3,d1
0001510C                            
0001510C                            loc_13A78:
0001510C 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015112 B302                       		eor.b	d1,d2
00015114 8528 0001                  		or.b	d2,1(a0)
00015118 0828 0005 0022             		btst	#5,$22(a0)
0001511E 6600 0000                  		bne.w	SAnim_Push
00015122 E808                       		lsr.b	#4,d0		; divide angle by $10
00015124 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015128 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
0001512C 6A00                       		bpl.s	loc_13A9C
0001512E 4442                       		neg.w	d2
00015130                            
00015130                            loc_13A9C:
00015130 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015134 6700                       		beq.s	Loc_NotSuper
00015136 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
0001513C 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015140 6400                       		bhs.s	SuperRun	; if yes, branch
00015142 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
00015148 6000                       		bra.s	SuperWalk
0001514A                            
0001514A                            Loc_NotSuper:
0001514A 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00015150 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015154 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015156 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
0001515C 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00015160 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015162 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00015168                            
00015168                            SuperWalk:
00015168 1200                       		move.b	d0,d1
0001516A E209                       		lsr.b	#1,d1
0001516C D001                       		add.b	d1,d0
0001516E                            
0001516E                            loc_13AB4:
0001516E D000                       		add.b	d0,d0
00015170                            
00015170                            SuperRun:
00015170 1600                       		move.b	d0,d3
00015172 4442                       		neg.w	d2
00015174 0642 0800                  		addi.w	#$800,d2
00015178 6A00                       		bpl.s	loc_13AC2
0001517A 7400                       		moveq	#0,d2
0001517C                            
0001517C                            loc_13AC2:
0001517C E04A                       		lsr.w	#8,d2
0001517E 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015182 6100 FF18                  		bsr.w	SAnim_Do2
00015186 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
0001518A 4E75                       		rts	
0001518C                            ; ===========================================================================
0001518C                            
0001518C                            SAnim_RollJump:				; XREF: SAnim_WalkRun
0001518C 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
0001518E 6600                       		bne.s	SAnim_Push	; if not, branch
00015190 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015194 6A00                       		bpl.s	loc_13ADE
00015196 4442                       		neg.w	d2
00015198                            
00015198                            loc_13ADE:
00015198 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
0001519E 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000151A2 6400                       		bcc.s	loc_13AF0	; if yes, branch
000151A4 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000151AA                            
000151AA                            loc_13AF0:
000151AA 4442                       		neg.w	d2
000151AC 0642 0400                  		addi.w	#$400,d2
000151B0 6A00                       		bpl.s	loc_13AFA
000151B2 7400                       		moveq	#0,d2
000151B4                            
000151B4                            loc_13AFA:
000151B4 E04A                       		lsr.w	#8,d2
000151B6 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151BA 1228 0022                  		move.b	$22(a0),d1
000151BE 0201 0001                  		andi.b	#1,d1
000151C2 0228 00FC 0001             		andi.b	#$FC,1(a0)
000151C8 8328 0001                  		or.b	d1,1(a0)
000151CC 6000 FECE                  		bra.w	SAnim_Do2
000151D0                            ; ===========================================================================
000151D0                            
000151D0                            SAnim_Push:				; XREF: SAnim_RollJump
000151D0 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000151D4 6B00                       		bmi.s	loc_13B1E
000151D6 4442                       		neg.w	d2
000151D8                            
000151D8                            loc_13B1E:
000151D8 0642 0800                  		addi.w	#$800,d2
000151DC 6A00                       		bpl.s	loc_13B26
000151DE 7400                       		moveq	#0,d2
000151E0                            
000151E0                            loc_13B26:
000151E0 EC4A                       		lsr.w	#6,d2
000151E2 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151E6 43F9 0000 0000             		lea	(SonAni_Push).l,a1
000151EC 1228 0022                  		move.b	$22(a0),d1
000151F0 0201 0001                  		andi.b	#1,d1
000151F4 0228 00FC 0001             		andi.b	#$FC,1(a0)
000151FA 8328 0001                  		or.b	d1,1(a0)
000151FE 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015202 6700                       		beq.s	Loc_NotSuper2
00015204 43F9 0000 0000             		lea	(SupSonAni_Push).l,a1 ; use	running	animation
0001520A                            
0001520A                            Loc_NotSuper2:
0001520A 6000 FE90                  		bra.w	SAnim_Do2
