000038AC                            LevSelControls:				; XREF: LevelSelect
000038AC 1238 F605                  		move.b	($FFFFF605).w,d1
000038B0 0201 0003                  		andi.b	#3,d1		; is up/down pressed and held?
000038B4 6600                       		bne.s	LevSel_UpDown	; if yes, branch
000038B6 5378 FF80                  		subq.w	#1,($FFFFFF80).w ; subtract 1 from time	to next	move
000038BA 6A00                       		bpl.s	LevSel_SndTest	; if time remains, branch
000038BC                            
000038BC                            LevSel_UpDown:
000038BC 31FC 000B FF80             		move.w	#$B,($FFFFFF80).w ; reset time delay
000038C2 1238 F604                  		move.b	($FFFFF604).w,d1
000038C6 0201 0003                  		andi.b	#3,d1		; is up/down pressed?
000038CA 6700                       		beq.s	LevSel_SndTest	; if not, branch
000038CC 3038 FF82                  		move.w	($FFFFFF82).w,d0
000038D0 0801 0000                  		btst	#0,d1		; is up	pressed?
000038D4 6700                       		beq.s	LevSel_Down	; if not, branch
000038D6 5340                       		subq.w	#1,d0		; move up 1 selection
000038D8 6400                       		bcc.s	LevSel_Down
000038DA 7014                       		moveq	#$14,d0		; if selection moves below 0, jump to selection	$14
000038DC                            
000038DC                            LevSel_Down:
000038DC 0801 0001                  		btst	#1,d1		; is down pressed?
000038E0 6700                       		beq.s	LevSel_Refresh	; if not, branch
000038E2 5240                       		addq.w	#1,d0		; move down 1 selection
000038E4 0C40 0015                  		cmpi.w	#$15,d0
000038E8 6500                       		bcs.s	LevSel_Refresh
000038EA 7000                       		moveq	#0,d0		; if selection moves above $14,	jump to	selection 0
000038EC                            
000038EC                            LevSel_Refresh:
000038EC 31C0 FF82                  		move.w	d0,($FFFFFF82).w ; set new selection
000038F0 6100 0000                  		bsr.w	LevSelTextLoad	; refresh text
000038F4 4E75                       		rts	
