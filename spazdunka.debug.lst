0000DCDE 1159 001A                  		move.b	(a1)+,mapping_frame(a0)
0000DCE2 1159 0019                  		move.b	(a1)+,width_pixels(a0)
0000DCE6 3168 0008 0030             		move.w	8(a0),$30(a0)
0000DCEC 3168 000C 0032             		move.w	$C(a0),$32(a0)
0000DCF2                            
0000DCF2                            Obj36_Solid:				; XREF: Obj36_Index
0000DCF2 6100 0000                  		bsr.w	Obj36_Type0x	; make the object move
0000DCF6 343C 0004                  		move.w	#4,d2
0000DCFA 0C28 0005 001A             		cmpi.b	#5,mapping_frame(a0)	; is object type $5x ?
0000DD00 6700                       		beq.s	Obj36_SideWays	; if yes, branch
0000DD02 0C28 0001 001A             		cmpi.b	#1,mapping_frame(a0)	; is object type $1x ?
0000DD08 6600                       		bne.s	Obj36_Upright	; if not, branch
0000DD0A 343C 0014                  		move.w	#$14,d2
0000DD0E                            
0000DD0E                            ; Spikes types $1x and $5x face	sideways
0000DD0E                            
0000DD0E                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DD0E 323C 001B                  		move.w	#$1B,d1
0000DD12 3602                       		move.w	d2,d3
0000DD14 5243                       		addq.w	#1,d3
0000DD16 3828 0008                  		move.w	8(a0),d4
0000DD1A 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DD1E 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DD22 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DD26 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DD2A 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DD30 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DD32 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DD34 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DD36 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DD38 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DD3A                            ; ===========================================================================
0000DD3A                            
0000DD3A                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DD3A                            
0000DD3A                            Obj36_Upright:				; XREF: Obj36_Solid
0000DD3A 7200                       		moveq	#0,d1
0000DD3C 1228 0019                  		move.b	$19(a0),d1
0000DD40 0641 000B                  		addi.w	#$B,d1
0000DD44 343C 0010                  		move.w	#$10,d2
0000DD48 363C 0011                  		move.w	#$11,d3
0000DD4C 3828 0008                  		move.w	8(a0),d4
0000DD50 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DD54 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DD5A 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DD5C 4A44                       		tst.w	d4			; check response value from SolidObject
0000DD5E 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DD60 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DD64 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DD68 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DD6E 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DD70 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DD72 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DD74 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DD76                            		; otherwise, fall through to Spik_Hurt
0000DD76                            
0000DD76                            Obj36_Hurt:				; XREF: Obj36_SideWays; Obj36_Upright
0000DD76 4A38 FE2D                  		tst.b	($FFFFFE2D).w	; is Sonic invincible?
0000DD7A 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DD7C 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DD80 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
0000DD82 2F08                       		move.l	a0,-(sp)
0000DD84 2448                       		movea.l	a0,a2
0000DD86 41F8 D000                  		lea	($FFFFD000).w,a0
0000DD8A 0C28 0004 0024             		cmpi.b	#4,routine(a0)
0000DD90 6400                       		bcc.s	loc_CF20
0000DD92 2628 000C                  		move.l	$C(a0),d3
0000DD96 3028 0012                  		move.w	$12(a0),d0
0000DD9A 48C0                       		ext.l	d0
0000DD9C E180                       		asl.l	#8,d0
0000DD9E 9680                       		sub.l	d0,d3
0000DDA0 2143 000C                  		move.l	d3,y_pos(a0)
0000DDA4 4EB9 0000 0000             		jsr	HurtSonic
