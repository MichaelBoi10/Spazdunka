000148E2                            ;SCDPeelout:
000148E2 0828 0001 0039             		btst	#1,$39(a0)
000148E8 6600                       		bne.s	SCDPeelout_Launch
000148EA 0C28 0007 001C             		cmpi.b	#7,$1C(a0) ;check to see if your looking up
000148F0 6600                       		bne.s	@return
000148F2 1038 F603                  		move.b	($FFFFF603).w,d0
000148F6 0200 0070                  		andi.b	#%01110000,d0
000148FA 6700 0000                  		beq.w	@return
000148FE 117C 0001 001C             		move.b	#1,$1C(a0)
00014904 317C 0000 003A             		move.w	#0,$3A(a0)
0001490A 303C 00D2                  		move.w	#$D2,d0
0001490E 11FC 0002 D1DC                             move.b	#2,($FFFFD1DC).w
00014914 4EB9 0000 1008             		jsr		(PlaySound_Special).l 	; Play peelout charge sound
0001491A                            	       ;sfx 	sfx_PeeloutCharge 		; These are if you use AMPS
0001491A 588F                       		addq.l	#4,sp
0001491C 08E8 0001 0039             		bset	#1,$39(a0)
00014922                            		
00014922 4268 0014                  		clr.w	$14(a0)
00014926                             
00014926 6100 FCB6                  		bsr.w	Sonic_LevelBound
0001492A 6100 0000                  		bsr.w	Sonic_AnglePos
0001492E                             
0001492E                            	@return:
0001492E 4E75                       		rts	
