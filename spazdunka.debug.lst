0000B268                            ; ---------------------------------------------------------------------------
0000B268                            ; Subroutine to	animate	a sprite using an animation script
0000B268                            ; ---------------------------------------------------------------------------
0000B268                            
0000B268                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B268                            
0000B268                            
0000B268                            AnimateSprite:
0000B268 7000                       		moveq	#0,d0
0000B26A 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B26E B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B272 6700                       		beq.s	Anim_Run	; if not, branch
0000B274 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B278 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B27E 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B284                            
0000B284                            Anim_Run:
0000B284 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B288 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B28A D040                       		add.w	d0,d0
0000B28C D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B290 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B294 7200                       		moveq	#0,d1
0000B296 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B29A 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B29E 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B2A0                            
0000B2A0                            Anim_Next:
0000B2A0 1200                       		move.b	d0,d1
0000B2A2 0200 001F                  		andi.b	#$1F,d0
0000B2A6 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B2AA 1028 0022                  		move.b	$22(a0),d0
0000B2AE E719                       		rol.b	#3,d1
0000B2B0 B101                       		eor.b	d0,d1
0000B2B2 0201 0003                  		andi.b	#3,d1
0000B2B6 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B2BC 8328 0001                  		or.b	d1,render_flags(a0)
0000B2C0 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B2C4                            
0000B2C4                            Anim_Wait:
0000B2C4 4E75                       		rts	
0000B2C6                            ; ===========================================================================
0000B2C6                            
0000B2C6                            Anim_End_FF:
0000B2C6 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B2C8 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B2CA 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B2D0 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B2D4 60CA                       		bra.s	Anim_Next
0000B2D6                            ; ===========================================================================
0000B2D6                            
0000B2D6                            Anim_End_FE:
0000B2D6 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B2D8 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B2DA 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B2DE 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B2E2 9200                       		sub.b	d0,d1
0000B2E4 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B2E8 60B6                       		bra.s	Anim_Next
0000B2EA                            ; ===========================================================================
0000B2EA                            
0000B2EA                            Anim_End_FD:
0000B2EA 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B2EC 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B2EE 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B2F4                            
0000B2F4                            Anim_End_FC:
0000B2F4 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B2F6 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B2F8 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B2FC                            
0000B2FC                            Anim_End_FB:
0000B2FC 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B2FE 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B300 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B306 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B30A                            
0000B30A                            Anim_End_FA:
0000B30A 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B30C 6600                       		bne.s	Anim_End	; if not, branch
0000B30E 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B312                            
0000B312                            Anim_End:
0000B312 4E75                       		rts	
0000B314                            ; End of function AnimateSprite
