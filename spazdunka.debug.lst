00014AE8                            ; loc_1AB38: test_set_SS:
00014AE8                            Sonic_CheckGoSuper:
00014AE8 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014AEC 6600                       	bne.s	return_1ABA4		; if yes, branch
00014AEE 0C38 0006 FE57             	cmpi.b	#6,($FFFFFE57).w	; does Sonic have exactly 6 emeralds?
00014AF4 6600                       	bne.s	return_1ABA4		; if not, branch
00014AF6 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014AFC 6500                       	bcs.s	return_1ABA4		; if not, branch
00014AFE 4A38 FE1E                  	tst.b	($FFFFFE1E).w	; stop time counter
00014B02 6700                       	beq.s	return_1ABA4
00014B04                            
00014B04 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014B0A 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
00014B10 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
00014B16 11FC 0001 F7C8             	move.b	#1,($FFFFF7C8).w ; freeze Sonic
00014B1C 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
00014B22 11FC 0010 D200             	move.b	#$10,($FFFFD200).w ; load Obj10 (super sonic stars object) at $FFFFD200
00014B28 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
00014B2E 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014B34 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
00014B3A 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014B40 11FC 0001 FE2D             	move.b	#1,($FFFFFE2D).w ; make Sonic invincible
00014B46 303C 00D4                  	move.w	#$D4,d0         ;
00014B4A 4EB9 0000 1002             	jsr	(PlaySound).l	; Play special ring sound effect.
00014B50 303C 0094                  	move.w	#$94,d0
00014B54 4EF9 0000 1008             	jmp	(PlaySound_Special).l	; Play the super theme
00014B5A                            ; ---------------------------------------------------------------------------
00014B5A                            return_1ABA4:
00014B5A 4E75                       	rts
