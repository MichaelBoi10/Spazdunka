0000B1FC                            ; ---------------------------------------------------------------------------
0000B1FC                            ; Subroutine to	animate	a sprite using an animation script
0000B1FC                            ; ---------------------------------------------------------------------------
0000B1FC                            
0000B1FC                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B1FC                            
0000B1FC                            
0000B1FC                            AnimateSprite:
0000B1FC 7000                       		moveq	#0,d0
0000B1FE 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B202 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B206 6700                       		beq.s	Anim_Run	; if not, branch
0000B208 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B20C 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B212 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B218                            
0000B218                            Anim_Run:
0000B218 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B21C 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B21E D040                       		add.w	d0,d0
0000B220 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B224 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B228 7200                       		moveq	#0,d1
0000B22A 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B22E 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B232 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B234                            
0000B234                            Anim_Next:
0000B234 1200                       		move.b	d0,d1
0000B236 0200 001F                  		andi.b	#$1F,d0
0000B23A 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B23E 1028 0022                  		move.b	$22(a0),d0
0000B242 E719                       		rol.b	#3,d1
0000B244 B101                       		eor.b	d0,d1
0000B246 0201 0003                  		andi.b	#3,d1
0000B24A 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B250 8328 0001                  		or.b	d1,render_flags(a0)
0000B254 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B258                            
0000B258                            Anim_Wait:
0000B258 4E75                       		rts	
0000B25A                            ; ===========================================================================
0000B25A                            
0000B25A                            Anim_End_FF:
0000B25A 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B25C 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B25E 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B264 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B268 60CA                       		bra.s	Anim_Next
0000B26A                            ; ===========================================================================
0000B26A                            
0000B26A                            Anim_End_FE:
0000B26A 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B26C 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B26E 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B272 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B276 9200                       		sub.b	d0,d1
0000B278 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B27C 60B6                       		bra.s	Anim_Next
0000B27E                            ; ===========================================================================
0000B27E                            
0000B27E                            Anim_End_FD:
0000B27E 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B280 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B282 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B288                            
0000B288                            Anim_End_FC:
0000B288 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B28A 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B28C 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B290                            
0000B290                            Anim_End_FB:
0000B290 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B292 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B294 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B29A 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B29E                            
0000B29E                            Anim_End_FA:
0000B29E 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B2A0 6600                       		bne.s	Anim_End	; if not, branch
0000B2A2 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B2A6                            
0000B2A6                            Anim_End:
0000B2A6 4E75                       		rts	
0000B2A8                            ; End of function AnimateSprite
