00013FB0                            ; ---------------------------------------------------------------------------
00013FB0                            ; Subroutine to    horizontally pan the camera view ahead of the player
00013FB0                            ; (Ported from the US version of Sonic CD's "R11A__.MMD" by Nat The Porcupine, ported to Hivebrain disasm by DelayHacks)
00013FB0                            ; ---------------------------------------------------------------------------
00013FB0                            
00013FB0                            ; ||||||||||||||| S U B    R O U T    I N E |||||||||||||||||||||||||||||||||||||||
00013FB0                            
00013FB0                            Sonic_PanCamera:
00013FB0 3238 F7A0                          move.w    ($FFFFF7A0).w,d1        ; get the current camera pan value
00013FB4 3028 0014                          move.w    $14(a0),d0        ; get sonic's inertia
00013FB8 6A00                               bpl.s    Sonic_PanCamera_abs_inertia            ; if sonic's inertia is positive, branch ahead
00013FBA 4440                               neg.w    d0                        ; otherwise, we negate it to get the absolute value
00013FBC                            
00013FBC                            Sonic_PanCamera_abs_inertia:
00013FBC                            
00013FBC                            ; These lines were intended to prevent the Camera from panning while
00013FBC                            ; going up the very first giant ramp in Palmtree Panic Zone Act 1.
00013FBC                            ; However, given that no such object exists in Sonic 1, I just went
00013FBC                            ; ahead and commented these out.
00013FBC                            ;        btst    #1,$2C(a0)                ; is sonic going up a giant ramp in PPZ?
00013FBC                            ;        beq.s    Sonic_PanCamera_skip                    ; if not, branch
00013FBC                            ;        cmpi.w    #$1B00,($FFFFD008).w            ; is sonic's x position lower than $1B00?
00013FBC                            ;        bcs.s    Sonic_PanCamera_reset_pan                ; if so, branch
00013FBC                            
00013FBC                            ; These lines aren't part of the original routine; I added them myself.
00013FBC                            ; If you've ported the Spin Dash, uncomment the following lines of code
00013FBC                            ; to allow the camera to pan ahead while charging the Spin Dash:
00013FBC 4A28 0039                          tst.b    $39(a0)                    ; is sonic charging up a spin dash?
00013FC0 6700                               beq.s    Sonic_PanCamera_skip                    ; if not, branch
00013FC2 0828 0000 0022                     btst    #0,$22(a0)            ; check the direction that sonic is facing
00013FC8 6600                               bne.s    Sonic_PanCamera_pan_right                ; if he's facing right, pan the camera to the right
00013FCA 6000                               bra.s    Sonic_PanCamera_pan_left                ; otherwise, pan the camera to the left
00013FCC                            
00013FCC                            Sonic_PanCamera_skip:
00013FCC 0C40 0600                          cmpi.w    #$600,d0                ; is sonic's inertia greater than $600
00013FD0 6500                               bcs.s    Sonic_PanCamera_reset_pan                ; if not, recenter the screen (if needed)
00013FD2 4A68 0014                          tst.w    $14(a0)            ; otherwise, check the direction of inertia (by subtracting it from 0)
00013FD6 6A00                               bpl.s    Sonic_PanCamera_pan_left                ; if the result was positive, then inertia was negative, so we pan the screen left
00013FD8                            
00013FD8                            Sonic_PanCamera_pan_right:
00013FD8 5441                               addq.w    #2,d1                    ; add 2 to the pan value
00013FDA 0C41 00E0                          cmpi.w    #224,d1                    ; is the pan value greater than 224 pixels?
00013FDE 6500                               bcs.s    Sonic_PanCamera_update_pan                ; if not, branch
00013FE0 323C 00E0                          move.w    #224,d1                    ; otherwise, cap the value at the maximum of 224 pixels
00013FE4 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00013FE6                            ; ---------------------------------------------------------------------------
00013FE6                            
00013FE6                            Sonic_PanCamera_pan_left:
00013FE6 5541                               subq.w    #2,d1                    ; subtract 2 from the pan value
00013FE8 0C41 0060                          cmpi.w    #96,d1                    ; is the pan value less than 96 pixels?
00013FEC 6400                               bcc.s    Sonic_PanCamera_update_pan                ; if not, branch
00013FEE 323C 0060                          move.w    #96,d1                    ; otherwise, cap the value at the minimum of 96 pixels
00013FF2 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00013FF4                            ; ---------------------------------------------------------------------------
00013FF4                            
00013FF4                            Sonic_PanCamera_reset_pan:
00013FF4 0C41 00A0                          cmpi.w    #160,d1                    ; is the pan value 160 pixels?
00013FF8 6700                               beq.s    Sonic_PanCamera_update_pan                ; if so, branch
00013FFA 6400                               bcc.s    Sonic_PanCamera_reset_left                ; otherwise, branch if it greater than 160
00013FFC                                 
00013FFC                            Sonic_PanCamera_reset_right:
00013FFC 5441                               addq.w    #2,d1                    ; add 2 to the pan value
00013FFE 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00014000                            ; ---------------------------------------------------------------------------
00014000                            
00014000                            Sonic_PanCamera_reset_left:
00014000 5541                               subq.w    #2,d1                    ; subtract 2 from the pan value
00014002                            
00014002                            Sonic_PanCamera_update_pan:
00014002 31C1 F7A0                          move.w    d1,($FFFFF7A0).w        ; update the camera pan value
00014006 4E75                               rts                                ; return
00014008                                 
00014008                            ; End of function Sonic_PanCamera
