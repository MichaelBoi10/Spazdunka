00015198 6600                       		bne.s	SAnim_End_FD	; if not, branch
0001519A 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0001519E 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
000151A2 9200                       		sub.b	d0,d1
