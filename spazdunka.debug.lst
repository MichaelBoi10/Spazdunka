00083466                            ; ------------------------------------------------------------------------------
00083466                            @Str_TooManySamples:
00083466 546F 6F20 6D61 6E79 2073+  	dc.b	"Too many samples in table", 0
00083480                            @Str_UnknownSampleType:
00083480 556E 6B6E 6F77 6E20 7361+  	dc.b	"Unknown sample type or missing end marker. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE", 0
000834ED                            @Str_PitchNotSet:
000834ED 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
00083544                            @Str_WaveInvalidHeader:
00083544 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
00083564                            @Str_WaveBadAudioFormat:
00083564 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported audio format. Only PCM is supported", 0
000835A0                            @Str_WaveNotMono:
000835A0 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be mono", 0
000835BF                            @Str_WaveNot8bit:
000835BF 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be 8-bit unsigned PCM", 0
000835EC                            @Str_WaveBadSampleRate:
000835EC 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported sample rate. Use <=\#TYPE_PCM_MAX_RATE\ Hz for TYPE_PCM or \#TYPE_PCM_TURBO_MAX_RATE\ Hz for TYPE_PCM_TURBO.", 0
0008364D                            @Str_WaveMissingDataChunk:
0008364D 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Failed to locate 'data' chunk", 0
00083677                            @Str_DpcmHqUnsupportedVersion:
