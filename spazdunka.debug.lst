0000DD5A 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DD5C 4A44                       		tst.w	d4			; check response value from SolidObject
0000DD5E 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DD60 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
