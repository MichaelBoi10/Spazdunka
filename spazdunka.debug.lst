00083152                            ; ------------------------------------------------------------------------------
00083152                            ; Plays a given sample
00083152                            ; ------------------------------------------------------------------------------
00083152                            ; INPUT:
00083152                            ;		d0	.b		sample id (>$81)
00083152                            ;
00083152                            ; EXAMPLES:
00083152                            ;		move.b	#$81, d0
00083152                            ;		jsr		MegaPCM_PlaySample
00083152                            ;
00083152                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00083152                            ;		jsr		MegaPCM_PlaySample
00083152                            ; ------------------------------------------------------------------------------
00083152                            
00083152                            MegaPCM_PlaySample:
00083152                            	MPCM_play	d0
00083152                          M 	mpcm_stopz80
00083152                          M 	pusho
00083152                          M 	opt	l-
00083152 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0008315A                          M 	@wait_47:
0008315A 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00083162 66F6                     M 	bne.s	@wait_47
00083164                          M 	popo
00083164 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0008316A                          M 	mpcm_startz80
0008316A 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00083172 4E75                       	rts
00083174                            
