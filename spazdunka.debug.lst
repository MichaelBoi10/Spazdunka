0001DA84                            ; ---------------------------------------------------------------------------
0001DA84                            ; Subroutine to limit Sonic's upward vertical speed
0001DA84                            ; ---------------------------------------------------------------------------
0001DA84                            
0001DA84                            Obj09_JumpHeight:			; XREF: Obj09_InAir
0001DA84 1038 F602                  		move.b	($FFFFF602).w,d0	; is the jump button up?
0001DA88 0200 0070                  		andi.b	#$70,d0
0001DA8C 6600                       		bne.s	locret_1BBB4		; if not, branch to return
0001DA8E 0828 0007 0022             		btst	#7,$22(a0)		; did Sonic jump or is he just falling or hit by a bumper?
0001DA94 6700                       		beq.s	locret_1BBB4		; if not, branch to return
0001DA96 1038 F780                  		move.b	($FFFFF780).w,d0	; get SS angle
0001DA9A 0200 00FC                  		andi.b	#$FC,d0
0001DA9E 4400                       		neg.b	d0
0001DAA0 0400 0040                  		subi.b	#$40,d0
0001DAA4 4EB9 0000 2AA6             		jsr	(CalcSine).l			
0001DAAA 3428 0012                  		move.w	$12(a0),d2		; get Y speed
0001DAAE C1C2                       		muls.w	d2,d0			; multiply Y speed by sin
0001DAB0 E080                       		asr.l	#8,d0			; find the new Y speed
0001DAB2 3428 0010                  		move.w	$10(a0),d2		; get X speed
0001DAB6 C3C2                       		muls.w	d2,d1			; multiply X speed by cos
0001DAB8 E081                       		asr.l	#8,d1			; find the new X speed
0001DABA D240                       		add.w	d0,d1			; combine the two speeds
0001DABC 0C41 0400                  		cmpi.w	#$400,d1		; compare the combined speed with the jump release speed
0001DAC0 6F00                       		ble.s	locret_1BBB4		; if it's less, branch to return
0001DAC2 1038 F780                  		move.b	($FFFFF780).w,d0
0001DAC6 0200 00FC                  		andi.b	#$FC,d0
0001DACA 4400                       		neg.b	d0
0001DACC 0400 0040                  		subi.b	#$40,d0
0001DAD0 4EB9 0000 2AA6             		jsr	(CalcSine).l
0001DAD6 C3FC 0400                  		muls.w	#$400,d1
0001DADA E081                       		asr.l	#8,d1
0001DADC 3141 0010                  		move.w	d1,$10(a0)
0001DAE0 C1FC 0400                  		muls.w	#$400,d0
0001DAE4 E080                       		asr.l	#8,d0
0001DAE6 3140 0012                  		move.w	d0,$12(a0)		; set the speed to the jump release speed
0001DAEA 08A8 0007 0022             		bclr	#7,$22(a0)		; clear "Sonic has jumped" flag
0001DAF0                             
