00081ACA                            
00081ACA                            ; ------------------------------------------------------------------------------
00081ACA                            ; Plays a given sample
00081ACA                            ; ------------------------------------------------------------------------------
00081ACA                            ; INPUT:
00081ACA                            ;		d0	.b		sample id (>$81)
00081ACA                            ;
00081ACA                            ; EXAMPLES:
00081ACA                            ;		move.b	#$81, d0
00081ACA                            ;		jsr		MegaPCM_PlaySample
00081ACA                            ;
00081ACA                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081ACA                            ;		jsr		MegaPCM_PlaySample
00081ACA                            ; ------------------------------------------------------------------------------
00081ACA                            
00081ACA                            MegaPCM_PlaySample:
00081ACA                            	MPCM_play	d0
00081ACA                          M 	mpcm_stopz80
00081ACA                          M 	pusho
00081ACA                          M 	opt	l-
00081ACA 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081AD2                          M 	@wait_14:
00081AD2 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081ADA 66F6                     M 	bne.s	@wait_14
00081ADC                          M 	popo
00081ADC 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081AE2                          M 	mpcm_startz80
00081AE2 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081AEA 4E75                       	rts
00081AEC                            
00081AEC                            ; ------------------------------------------------------------------------------
