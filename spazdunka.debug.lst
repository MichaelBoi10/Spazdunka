0008350C                            ; ------------------------------------------------------------------------------
0008350C                            ; Plays a given sample
0008350C                            ; ------------------------------------------------------------------------------
0008350C                            ; INPUT:
0008350C                            ;		d0	.b		sample id (>$81)
0008350C                            ;
0008350C                            ; EXAMPLES:
0008350C                            ;		move.b	#$81, d0
0008350C                            ;		jsr		MegaPCM_PlaySample
0008350C                            ;
0008350C                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
0008350C                            ;		jsr		MegaPCM_PlaySample
0008350C                            ; ------------------------------------------------------------------------------
0008350C                            
0008350C                            MegaPCM_PlaySample:
0008350C                            	MPCM_play	d0
0008350C                          M 	mpcm_stopz80
0008350C                          M 	pusho
0008350C                          M 	opt	l-
0008350C 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00083514                          M 	@wait_47:
00083514 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0008351C 66F6                     M 	bne.s	@wait_47
0008351E                          M 	popo
0008351E 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00083524                          M 	mpcm_startz80
00083524 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0008352C 4E75                       	rts
0008352E                            
