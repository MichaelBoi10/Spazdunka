0007FDC4                            MegaPCM_PausePlayback:
0007FDC4                            	MPCM_pause
0007FDC4                          M 	mpcm_stopz80
0007FDC4                          M 	pusho
0007FDC4                          M 	opt	l-
0007FDC4 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FDCC                          M 	@wait_23:
0007FDCC 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FDD4 66F6                     M 	bne.s	@wait_23
0007FDD6                          M 	popo
0007FDD6 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
0007FDDE                          M 	mpcm_startz80
0007FDDE 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FDE6 4E75                       	rts
