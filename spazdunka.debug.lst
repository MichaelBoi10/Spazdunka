000078A6 245F                       		movea.l	(sp)+,a2
000078A8 584A                       		addq.w	#4,a2
000078AA 7000                       		moveq	#0,d0
000078AC 1012                       		move.b	(a2),d0
000078AE 6700                       		beq.s	locret_6D10
000078B0 6100 99CA                  		bsr.w	LoadPLC		; load pattern load cues
