00081E62                          M 	@wait_17:
00081E62 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081E6A 66F6                     M 	bne.s	@wait_17
00081E6C                          M 	popo
00081E6C 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00081E74                          M 	mpcm_startz80
00081E74 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081E7C 4E75                       	rts
