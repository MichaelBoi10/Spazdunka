00001092 283C 0080 0000             		move.l	#$800000,d4
00001098                            
00001098                            loc_142C:
00001098 2D40 0004                  		move.l	d0,mappings(a6)
0000109C 3601                       		move.w	d1,d3
0000109E                            
0000109E                            loc_1432:
0000109E 3C99                       		move.w	(a1)+,(a6)
000010A0 51CB FFFC                  		dbf	d3,loc_1432
