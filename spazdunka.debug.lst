0001548E 0000                       		dc.w SonAni_Float1-SonicAniData
00015490 0000                       		dc.w SonAni_Float2-SonicAniData
00015492 0000                       		dc.w SonAni_Spring-SonicAniData
00015494 0000                       		dc.w SonAni_LZHang-SonicAniData
00015496 0000                       		dc.w SonAni_Leap1-SonicAniData
00015498 0000                       		dc.w SonAni_Leap2-SonicAniData
0001549A 0000                       		dc.w SonAni_Surf-SonicAniData
