0008318C 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00083194                          M 	mpcm_startz80
00083194 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
