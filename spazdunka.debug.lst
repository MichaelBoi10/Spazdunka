00014BC4 1038 F602                  		move.b	($FFFFF602).w,d0	; read controller
00014BC8 0800 0001                  		btst	#1,d0			; check down button
00014BCC 6600 0000                  		bne.w	loc2_1AD30		; if set, branch
00014BD0 117C 000E 0016             		move.b	#$E,y_radius(a0)		; $16(a0) is height/2
00014BD6 117C 0007 0017             		move.b	#7,x_radius(a0)		; $17(a0) is width/2
00014BDC 117C 0002 001C             		move.b	#2,anim(a0)		; set animation to roll
00014BE2 5A68 000C                  		addq.w	#5,y_pos(a0)		; $C(a0) is Y coordinate
00014BE6 117C 0000 0039             		move.b	#0,$39(a0)		; clear Spin Dash flag
00014BEC 7000                       		moveq	#0,d0
00014BEE 1028 003A                  		move.b	$3A(a0),d0		; copy charge count
00014BF2 D040                       		add.w	d0,d0			; double it
00014BF4 317B 0000 0014             		move.w	Dash_Speeds(pc,d0.w),$14(a0) ; get normal speed
00014BFA 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00014BFE 6700                       		beq.s	loc2_1AC8F
00014C00 317B 0000 0014             		move.w	Dash_Speeds_Super(pc,d0.w),inertia(a0)
