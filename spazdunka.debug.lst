00013CAC                            		
00013CAC                            ; ---------------------------------------------------------------------------
00013CAC                            ; Subroutine to    horizontally pan the camera view ahead of the player
00013CAC                            ; (Ported from the US version of Sonic CD's "R11A__.MMD" by Nat The Porcupine, ported to Hivebrain disasm by DelayHacks)
00013CAC                            ; ---------------------------------------------------------------------------
00013CAC                            
00013CAC                            ; ||||||||||||||| S U B    R O U T    I N E |||||||||||||||||||||||||||||||||||||||
00013CAC                            
00013CAC                            Sonic_PanCamera:
00013CAC 3238 F7A0                          move.w    ($FFFFF7A0).w,d1        ; get the current camera pan value
00013CB0 3028 0014                          move.w    $14(a0),d0        ; get sonic's inertia
00013CB4 6A00                               bpl.s    Sonic_PanCamera_abs_inertia            ; if sonic's inertia is positive, branch ahead
00013CB6 4440                               neg.w    d0                        ; otherwise, we negate it to get the absolute value
00013CB8                            
00013CB8                            Sonic_PanCamera_abs_inertia:
00013CB8                            
00013CB8                            ; These lines were intended to prevent the Camera from panning while
00013CB8                            ; going up the very first giant ramp in Palmtree Panic Zone Act 1.
00013CB8                            ; However, given that no such object exists in Sonic 1, I just went
00013CB8                            ; ahead and commented these out.
00013CB8                            ;        btst    #1,$2C(a0)                ; is sonic going up a giant ramp in PPZ?
00013CB8                            ;        beq.s    Sonic_PanCamera_skip                    ; if not, branch
00013CB8                            ;        cmpi.w    #$1B00,($FFFFD008).w            ; is sonic's x position lower than $1B00?
00013CB8                            ;        bcs.s    Sonic_PanCamera_reset_pan                ; if so, branch
00013CB8                            
00013CB8                            ; These lines aren't part of the original routine; I added them myself.
00013CB8                            ; If you've ported the Spin Dash, uncomment the following lines of code
00013CB8                            ; to allow the camera to pan ahead while charging the Spin Dash:
00013CB8 4A28 0039                          tst.b    $39(a0)                    ; is sonic charging up a spin dash?
00013CBC 6700                               beq.s    Sonic_PanCamera_skip                    ; if not, branch
00013CBE 0828 0000 0022                     btst    #0,$22(a0)            ; check the direction that sonic is facing
00013CC4 6600                               bne.s    Sonic_PanCamera_pan_right                ; if he's facing right, pan the camera to the right
00013CC6 6000                               bra.s    Sonic_PanCamera_pan_left                ; otherwise, pan the camera to the left
00013CC8                            
00013CC8                            Sonic_PanCamera_skip:
00013CC8 0C40 0600                          cmpi.w    #$600,d0                ; is sonic's inertia greater than $600
00013CCC 6500                               bcs.s    Sonic_PanCamera_reset_pan                ; if not, recenter the screen (if needed)
00013CCE 4A68 0014                          tst.w    $14(a0)            ; otherwise, check the direction of inertia (by subtracting it from 0)
00013CD2 6A00                               bpl.s    Sonic_PanCamera_pan_left                ; if the result was positive, then inertia was negative, so we pan the screen left
00013CD4                            
00013CD4                            Sonic_PanCamera_pan_right:
00013CD4 5441                               addq.w    #2,d1                    ; add 2 to the pan value
00013CD6 0C41 00E0                          cmpi.w    #224,d1                    ; is the pan value greater than 224 pixels?
00013CDA 6500                               bcs.s    Sonic_PanCamera_update_pan                ; if not, branch
00013CDC 323C 00E0                          move.w    #224,d1                    ; otherwise, cap the value at the maximum of 224 pixels
00013CE0 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00013CE2                            ; ---------------------------------------------------------------------------
00013CE2                            
00013CE2                            Sonic_PanCamera_pan_left:
00013CE2 5541                               subq.w    #2,d1                    ; subtract 2 from the pan value
00013CE4 0C41 0060                          cmpi.w    #96,d1                    ; is the pan value less than 96 pixels?
00013CE8 6400                               bcc.s    Sonic_PanCamera_update_pan                ; if not, branch
00013CEA 323C 0060                          move.w    #96,d1                    ; otherwise, cap the value at the minimum of 96 pixels
00013CEE 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00013CF0                            ; ---------------------------------------------------------------------------
00013CF0                            
00013CF0                            Sonic_PanCamera_reset_pan:
00013CF0 0C41 00A0                          cmpi.w    #160,d1                    ; is the pan value 160 pixels?
00013CF4 6700                               beq.s    Sonic_PanCamera_update_pan                ; if so, branch
00013CF6 6400                               bcc.s    Sonic_PanCamera_reset_left                ; otherwise, branch if it greater than 160
00013CF8                                 
00013CF8                            Sonic_PanCamera_reset_right:
00013CF8 5441                               addq.w    #2,d1                    ; add 2 to the pan value
00013CFA 6000                               bra.s    Sonic_PanCamera_update_pan                ; branch
00013CFC                            ; ---------------------------------------------------------------------------
00013CFC                            
00013CFC                            Sonic_PanCamera_reset_left:
00013CFC 5541                               subq.w    #2,d1                    ; subtract 2 from the pan value
00013CFE                            
00013CFE                            Sonic_PanCamera_update_pan:
00013CFE 31C1 F7A0                          move.w    d1,($FFFFF7A0).w        ; update the camera pan value
00013D02 4E75                               rts                                ; return
00013D04                                 
00013D04                            ; End of function Sonic_PanCamera
