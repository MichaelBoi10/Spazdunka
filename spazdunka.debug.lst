0001547C 0000                       		dc.w SonAni_Wait-SonicAniData
0001547E 0000                       		dc.w SonAni_Balance-SonicAniData
00015480 0000                       		dc.w SonAni_LookUp-SonicAniData
00015482 0000                       		dc.w SonAni_Duck-SonicAniData
00015484 0000                       		dc.w SonAni_SpinDash-SonicAniData
