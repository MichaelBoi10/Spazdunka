000148A8                            ; loc_1AB38: test_set_SS:
000148A8                            Sonic_CheckGoSuper:
000148A8 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
000148AC 6600 0000                  	bne.w	return_1ABA4		; if yes, branch
000148B0 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
000148B6 6600                       	bne.s	return_1ABA4		; if not, branch
000148B8 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
000148BE 6500                       	bcs.s	return_1ABA4		; if not, branch
000148C0 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
000148C4 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
000148C8 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
000148CE 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
000148D4 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
000148DA 11FC 0001 F7C8             	move.b	#1,($FFFFF7C8).w ; lock	controls
000148E0 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
000148E6 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
000148EC 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
000148F2 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
000148F8 317C 0000 0032             	move.w	#0,invincibility_time(a0)
000148FE 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
00014904 303C 00D4                  	move.w	#$D4,d0         ; 
00014908 4EB9 0000 1008             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
0001490E 303C 0087                  	move.w	#$87,d0
00014912 4EF9 0000 1002             	jmp	(PlaySound).l	; Play the super theme
