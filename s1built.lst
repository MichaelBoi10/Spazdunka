0001CB08 317C FE00 0010             		move.w	#-$200,$10(a0)
0001CB0E 0828 0006 0022             		btst	#6,$22(a0)
0001CB14 6700                       		beq.s	Hurt_Reverse
0001CB16 317C FE00 0012             		move.w	#-$200,$12(a0)
0001CB1C 317C FF00 0010             		move.w	#-$100,$10(a0)
0001CB22                            
0001CB22                            Hurt_Reverse:
