00014B42 0B80                       		dc.w  $B80	; 1
00014B44 0C00                       		dc.w  $C00	; 2
00014B46 0C80                       		dc.w  $C80	; 3
00014B48 0D00                       		dc.w  $D00	; 4
00014B4A 0D80                       		dc.w  $D80	; 5
00014B4C 0E00                       		dc.w  $E00	; 6
00014B4E 0E80                       		dc.w  $E80	; 7
00014B50 0F00                       		dc.w  $F00	; 8
