00081DFA                            ; ------------------------------------------------------------------------------
00081DFA                            ; Plays a given sample
00081DFA                            ; ------------------------------------------------------------------------------
00081DFA                            ; INPUT:
00081DFA                            ;		d0	.b		sample id (>$81)
00081DFA                            ;
00081DFA                            ; EXAMPLES:
00081DFA                            ;		move.b	#$81, d0
00081DFA                            ;		jsr		MegaPCM_PlaySample
00081DFA                            ;
00081DFA                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081DFA                            ;		jsr		MegaPCM_PlaySample
00081DFA                            ; ------------------------------------------------------------------------------
00081DFA                            
00081DFA                            MegaPCM_PlaySample:
00081DFA                            	MPCM_play	d0
00081DFA                          M 	mpcm_stopz80
00081DFA                          M 	pusho
00081DFA                          M 	opt	l-
00081DFA 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081E02                          M 	@wait_11:
00081E02 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081E0A 66F6                     M 	bne.s	@wait_11
00081E0C                          M 	popo
00081E0C 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081E12                          M 	mpcm_startz80
00081E12 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081E1A 4E75                       	rts
