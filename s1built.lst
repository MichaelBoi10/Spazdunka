00078D46                            
00078D46                            ; ------------------------------------------------------------------------------
00078D46                            ; Plays a given sample
00078D46                            ; ------------------------------------------------------------------------------
00078D46                            ; INPUT:
00078D46                            ;		d0	.b		sample id (>$81)
00078D46                            ;
00078D46                            ; EXAMPLES:
00078D46                            ;		move.b	#$81, d0
00078D46                            ;		jsr		MegaPCM_PlaySample
00078D46                            ;
00078D46                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00078D46                            ;		jsr		MegaPCM_PlaySample
00078D46                            ; ------------------------------------------------------------------------------
00078D46                            
00078D46                            MegaPCM_PlaySample:
00078D46                            	MPCM_play	d0
00078D46                          M 	mpcm_stopz80
00078D46                          M 	pusho
00078D46                          M 	opt	l-
00078D46 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00078D4E                          M 	@wait_2:
00078D4E 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00078D56 66F6                     M 	bne.s	@wait_2
00078D58                          M 	popo
00078D58 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00078D5E                          M 	mpcm_startz80
00078D5E 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00078D66 4E75                       	rts
00078D68                            
00078D68                            ; ------------------------------------------------------------------------------
