0001527C 0000                       		dc.w SonAni_LookUp-SonicAniData
0001527E 0000                       		dc.w SonAni_Duck-SonicAniData
00015280 0000                       		dc.w SonAni_SpinDash-SonicAniData
00015282 0000                       		dc.w SonAni_Warp2-SonicAniData
00015284 0000                       		dc.w SonAni_Warp3-SonicAniData
00015286 0000                       		dc.w SonAni_Warp4-SonicAniData
