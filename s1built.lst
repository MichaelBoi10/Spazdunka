00081EEE                          M 	mpcm_stopz80
00081EEE                          M 	pusho
00081EEE                          M 	opt	l-
00081EEE 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081EF6                          M 	@wait_32:
00081EF6 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081EFE 66F6                     M 	bne.s	@wait_32
00081F00                          M 	popo
00081F00 13C0 00A0 1FC4           M 	move.b	d0,mpcm_z80_ram+z_mpcm_sfxvolumeinput
00081F06                          M 	mpcm_startz80
00081F06 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081F0E 4E75                       	rts
