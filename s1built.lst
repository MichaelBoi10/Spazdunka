00014620 303C 00C3                  	move.w	#$C3,d0         ; 
00014624 4EB9 0000 0FF2             	jsr	(PlaySound).l	; Play special ring sound effect.
0001462A 303C 0094                  	move.w	#$94,d0
0001462E 4EF9 0000 0FF8             	jmp	(PlaySound_Special).l	; Play the super theme
