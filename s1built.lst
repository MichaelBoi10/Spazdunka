0000106E 31FC 0001 F63A             		move.w	#1,($FFFFF63A).w
00001074 11FC 0080 F003             		move.b	#$80,($FFFFF003).w
0000107A 4E75                       		rts	
0000107C                            ; End of function PauseGame
