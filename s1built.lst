00014954                            ;SCDPeelout:
00014954 0828 0001 0039             		btst	#1,$39(a0)
0001495A 6600                       		bne.s	SCDPeelout_Launch
0001495C 0C28 0007 001C             		cmpi.b	#7,$1C(a0) ;check to see if your looking up
00014962 6600                       		bne.s	@return
00014964 1038 F603                  		move.b	($FFFFF603).w,d0
00014968 0200 0070                  		andi.b	#%01110000,d0
0001496C 6700 0000                  		beq.w	@return
00014970 117C 0001 001C             		move.b	#1,$1C(a0)
00014976 317C 0000 003A             		move.w	#0,$3A(a0)
0001497C 303C 00D2                  		move.w	#$D2,d0
00014980 11FC 0002 D1DC                             move.b	#2,($FFFFD1DC).w
00014986 4EB9 0000 0FF4             		jsr		(PlaySound_Special).l 	; Play peelout charge sound
0001498C                            	       ;sfx 	sfx_PeeloutCharge 		; These are if you use AMPS
0001498C 588F                       		addq.l	#4,sp
0001498E 08E8 0001 0039             		bset	#1,$39(a0)
00014994                            		
00014994 4268 0014                  		clr.w	$14(a0)
00014998                             
00014998 6100 FC6C                  		bsr.w	Sonic_LevelBound
0001499C 6100 0000                  		bsr.w	Sonic_AnglePos
000149A0                             
000149A0                            	@return:
000149A0 4E75                       		rts	
000149A2                            ; ---------------------------------------------------------------------------
000149A2                             
000149A2                            SCDPeelout_Launch:
000149A2 1038 F602                  		move.b	($FFFFF602).w,d0
000149A6 0800 0000                  		btst	#0,d0
000149AA 6600 0000                  		bne.w	SCDPeelout_Charge
000149AE 08A8 0001 0039             		bclr	#1,$39(a0)	; stop Dashing
000149B4 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)	; have we been charging long enough?
000149BA 6600                       		bne.s	SCDPeelout_Stop_Sound
000149BC 117C 0000 001C             		move.b	#0,$1C(a0)	; launches here (peelout sprites)
000149C2 317C 0001 0010             		move.w	#1,$10(a0)	; force X speed to nonzero for camera lag's benefit
000149C8 3028 0014                  		move.w	$14(a0),d0
000149CC 0440 0800                  		subi.w	#$800,d0
000149D0 D040                       		add.w	d0,d0
000149D2 0240 0800                  		andi.w	#$800,d0
000149D6 4440                       		neg.w	d0
000149D8 0640 0800                  		addi.w	#$800,d0
000149DC                            		;move.w	d0,(v_cameralag).w
000149DC 0828 0000 0022             		btst	#0,$22(a0)
000149E2 6700                       		beq.s	@dontflip
000149E4 4468 0014                  		neg.w	$14(a0)
000149E8                             
000149E8                            @dontflip:
000149E8 08A8 0007 0022             		bclr	#7,$22(a0)
000149EE 303C 00D3                  		move.w	#$D3,d0
000149F2 4EB9 0000 0FF4             		jsr		(PlaySound_Special).l
000149F8                            		; sfx 	sfx_PeeloutRelease
000149F8 6000 0000                  		bra.w	SCDPeelout_ResetScr
000149FC                            ; ---------------------------------------------------------------------------
000149FC                             
000149FC                            SCDPeelout_Charge:				; If still charging the dash...
000149FC 3238 F760                  		move.w	($FFFFF760).w,d1	; get top peelout speed
00014A00 3401                       		move.w	d1,d2
00014A02 D241                       		add.w	d1,d1
00014A04 4A38 FE2E                  		tst.b   ($FFFFFE2E).w 		; test for speed shoes
00014A08 6700                       		beq.s	@noshoes
00014A0A E242                       		asr.w	#1,d2
00014A0C 9242                       		sub.w	d2,d1
00014A0E                            
00014A0E                            @noshoes:
00014A0E 0668 0064 0014             		addi.w	#$64,$14(a0)		; increment speed
00014A14 B268 0014                  		cmp.w	$14(a0),d1
00014A18 6E00                       		bgt.s	@inctimer
00014A1A 3141 0014                  		move.w	d1,$14(a0)
00014A1E                            
00014A1E                            @inctimer:
