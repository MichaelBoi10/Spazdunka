00014FE6                            ; ---------------------------------------------------------------------------
00014FE6                            ; Sonic	when the level is restarted
00014FE6                            ; ---------------------------------------------------------------------------
00014FE6                            
00014FE6                            Obj01_ResetLevel:			; XREF: Obj01_Index
00014FE6 4A68 003A                  		tst.w	$3A(a0)
00014FEA 6700                       		beq.s	locret_13914
00014FEC 5368 003A                  		subq.w	#1,$3A(a0)	; subtract 1 from time delay
00014FF0 6600                       		bne.s	locret_13914
00014FF2 31FC 0001 FE02             		move.w	#1,($FFFFFE02).w ; restart the level
00014FF8                            
00014FF8                            locret_13914:
00014FF8 4E75                       		rts	
00014FFA                            
00014FFA                            ; ---------------------------------------------------------------------------
00014FFA                            ; Subroutine to	make Sonic run around loops (GHZ/SLZ)
00014FFA                            ; ---------------------------------------------------------------------------
00014FFA                            
00014FFA                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014FFA                            
00014FFA                            
00014FFA                            Sonic_Loops:				; XREF: Obj01_Control
00014FFA 0C38 0003 FE10             		cmpi.b	#3,($FFFFFE10).w ; is level SLZ	?
00015000 6700                       		beq.s	loc_13926	; if yes, branch
00015002 4A38 FE10                  		tst.b	($FFFFFE10).w	; is level GHZ ?
00015006 6600 0000                  		bne.w	locret_139C2	; if not, branch
0001500A                            
0001500A                            loc_13926:
0001500A 3028 000C                  		move.w	$C(a0),d0
0001500E E248                       		lsr.w	#1,d0
00015010 0240 0380                  		andi.w	#$380,d0
00015014 1228 0008                  		move.b	8(a0),d1
00015018 0241 007F                  		andi.w	#$7F,d1
0001501C D041                       		add.w	d1,d0
0001501E 43F8 A400                  		lea	($FFFFA400).w,a1
00015022 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
00015026 B238 F7AE                  		cmp.b	($FFFFF7AE).w,d1
0001502A 6700 F680                  		beq.w	Obj01_ChkRoll
0001502E B238 F7AF                  		cmp.b	($FFFFF7AF).w,d1
00015032 6700 F678                  		beq.w	Obj01_ChkRoll
00015036 B238 F7AC                  		cmp.b	($FFFFF7AC).w,d1
0001503A 6700                       		beq.s	loc_13976
0001503C B238 F7AD                  		cmp.b	($FFFFF7AD).w,d1
00015040 6700                       		beq.s	loc_13966
00015042 08A8 0006 0001             		bclr	#6,render_flags(a0)
00015048 4E75                       		rts	
0001504A                            ; ===========================================================================
0001504A                            
0001504A                            loc_13966:
0001504A 0828 0001 0022             		btst	#1,status(a0)
00015050 6700                       		beq.s	loc_13976
00015052 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
00015058 4E75                       		rts	
0001505A                            ; ===========================================================================
0001505A                            
0001505A                            loc_13976:
0001505A 3428 0008                  		move.w	8(a0),d2
0001505E 0C02 002C                  		cmpi.b	#$2C,d2
00015062 6400                       		bcc.s	loc_13988
00015064 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
0001506A 4E75                       		rts	
0001506C                            ; ===========================================================================
0001506C                            
0001506C                            loc_13988:
0001506C 0C02 00E0                  		cmpi.b	#-$20,d2
00015070 6500                       		bcs.s	loc_13996
00015072 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
00015078 4E75                       		rts	
0001507A                            ; ===========================================================================
0001507A                            
0001507A                            loc_13996:
0001507A 0828 0006 0001             		btst	#6,render_flags(a0)
00015080 6600                       		bne.s	loc_139B2
00015082 1228 0026                  		move.b	$26(a0),d1
00015086 6700                       		beq.s	locret_139C2
00015088 0C01 0080                  		cmpi.b	#-$80,d1
0001508C 6200                       		bhi.s	locret_139C2
0001508E 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
00015094 4E75                       		rts	
00015096                            ; ===========================================================================
00015096                            
00015096                            loc_139B2:
00015096 1228 0026                  		move.b	$26(a0),d1
0001509A 0C01 0080                  		cmpi.b	#-$80,d1
0001509E 6300                       		bls.s	locret_139C2
000150A0 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
000150A6                            
000150A6                            locret_139C2:
000150A6 4E75                       		rts	
000150A8                            ; End of function Sonic_Loops
000150A8                            
000150A8                            ; ---------------------------------------------------------------------------
000150A8                            ; Subroutine to	animate	Sonic's sprites
000150A8                            ; ---------------------------------------------------------------------------
000150A8                            
000150A8                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000150A8                            
000150A8                            
000150A8                            Sonic_Animate:				; XREF: Obj01_Control; et al
000150A8 43F9 0000 0000             		lea	(SonicAniData).l,a1
000150AE 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
000150B2 6700                       		beq.s	SAnim_NotSuper
000150B4 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
000150BA                            
000150BA                            SAnim_NotSuper:		
000150BA 7000                       		moveq	#0,d0
000150BC 1028 001C                  		move.b	$1C(a0),d0
000150C0 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
000150C4 6700                       		beq.s	SAnim_Do	; if not, branch
000150C6 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000150CA 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000150D0 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000150D6                            
000150D6                            SAnim_Do:
000150D6 D040                       		add.w	d0,d0
000150D8 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000150DC 1011                       		move.b	(a1),d0
000150DE 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000150E0 1228 0022                  		move.b	$22(a0),d1
000150E4 0201 0001                  		andi.b	#1,d1
000150E8 0228 00FC 0001             		andi.b	#$FC,1(a0)
000150EE 8328 0001                  		or.b	d1,1(a0)
000150F2 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150F6 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000150F8 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000150FC                            
000150FC                            SAnim_Do2:
000150FC 7200                       		moveq	#0,d1
000150FE 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
00015102 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00015106 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
0001510A 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
0001510C                            
0001510C                            SAnim_Next:
0001510C 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00015110 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00015114                            
00015114                            SAnim_Delay:
00015114 4E75                       		rts	
00015116                            ; ===========================================================================
00015116                            
00015116                            SAnim_End_FF:
00015116 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00015118 6600                       		bne.s	SAnim_End_FE	; if not, branch
0001511A 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015120 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015124 60E6                       		bra.s	SAnim_Next
00015126                            ; ===========================================================================
00015126                            
00015126                            SAnim_End_FE:
00015126 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00015128 6600                       		bne.s	SAnim_End_FD	; if not, branch
0001512A 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0001512E 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015132 9200                       		sub.b	d0,d1
00015134 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015138 60D2                       		bra.s	SAnim_Next
0001513A                            ; ===========================================================================
0001513A                            
0001513A                            SAnim_End_FD:
0001513A 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0001513C 6600                       		bne.s	SAnim_End	; if not, branch
0001513E 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015144                            
00015144                            SAnim_End:
00015144 4E75                       		rts	
00015146                            ; ===========================================================================
00015146                            
00015146                            SAnim_WalkRun:				; XREF: SAnim_Do
00015146 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
0001514A 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
0001514C 5200                       		addq.b	#1,d0		; is animation walking/running?
0001514E 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015152 7200                       		moveq	#0,d1
00015154 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015158 1428 0022                  		move.b	$22(a0),d2
0001515C 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015160 6600                       		bne.s	loc_13A70	; if yes, branch
00015162 4600                       		not.b	d0		; reverse angle
00015164                            
00015164                            loc_13A70:
00015164 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015168 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001516A 7203                       		moveq	#3,d1
0001516C                            
0001516C                            loc_13A78:
0001516C 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015172 B302                       		eor.b	d1,d2
00015174 8528 0001                  		or.b	d2,1(a0)
00015178 0828 0005 0022             		btst	#5,$22(a0)
0001517E 6600 0000                  		bne.w	SAnim_Push
00015182 E808                       		lsr.b	#4,d0		; divide angle by $10
00015184 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015188 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
0001518C 6A00                       		bpl.s	loc_13A9C
0001518E 4442                       		neg.w	d2
00015190                            
00015190                            loc_13A9C:
00015190 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015194 6700                       		beq.s	Loc_NotSuper
00015196 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
0001519C 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000151A0 6400                       		bhs.s	SuperRun	; if yes, branch
000151A2 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
000151A8 6000                       		bra.s	SuperWalk
000151AA                            
000151AA                            Loc_NotSuper:
000151AA 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
000151B0 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000151B4 6400                       		bhs.s	loc_13AB4	; if yes, branch
000151B6 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000151BC 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000151C0 6400                       		bhs.s	loc_13AB4	; if yes, branch
000151C2 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000151C8                            
000151C8                            SuperWalk:
000151C8 1200                       		move.b	d0,d1
000151CA E209                       		lsr.b	#1,d1
000151CC D001                       		add.b	d1,d0
000151CE                            
000151CE                            loc_13AB4:
000151CE D000                       		add.b	d0,d0
000151D0                            
000151D0                            SuperRun:
000151D0 1600                       		move.b	d0,d3
000151D2 4442                       		neg.w	d2
000151D4 0642 0800                  		addi.w	#$800,d2
000151D8 6A00                       		bpl.s	loc_13AC2
000151DA 7400                       		moveq	#0,d2
000151DC                            
000151DC                            loc_13AC2:
000151DC E04A                       		lsr.w	#8,d2
000151DE 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151E2 6100 FF18                  		bsr.w	SAnim_Do2
000151E6 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000151EA 4E75                       		rts	
000151EC                            ; ===========================================================================
000151EC                            
000151EC                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000151EC 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000151EE 6600                       		bne.s	SAnim_Push	; if not, branch
000151F0 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000151F4 6A00                       		bpl.s	loc_13ADE
000151F6 4442                       		neg.w	d2
000151F8                            
000151F8                            loc_13ADE:
000151F8 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000151FE 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00015202 6400                       		bcc.s	loc_13AF0	; if yes, branch
00015204 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
0001520A                            
0001520A                            loc_13AF0:
0001520A 4442                       		neg.w	d2
0001520C 0642 0400                  		addi.w	#$400,d2
00015210 6A00                       		bpl.s	loc_13AFA
00015212 7400                       		moveq	#0,d2
00015214                            
00015214                            loc_13AFA:
00015214 E04A                       		lsr.w	#8,d2
00015216 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001521A 1228 0022                  		move.b	$22(a0),d1
0001521E 0201 0001                  		andi.b	#1,d1
00015222 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015228 8328 0001                  		or.b	d1,1(a0)
0001522C 6000 FECE                  		bra.w	SAnim_Do2
00015230                            ; ===========================================================================
00015230                            
00015230                            SAnim_Push:				; XREF: SAnim_RollJump
00015230 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015234 6B00                       		bmi.s	loc_13B1E
00015236 4442                       		neg.w	d2
00015238                            
00015238                            loc_13B1E:
00015238 0642 0800                  		addi.w	#$800,d2
0001523C 6A00                       		bpl.s	loc_13B26
0001523E 7400                       		moveq	#0,d2
00015240                            
00015240                            loc_13B26:
00015240 EC4A                       		lsr.w	#6,d2
00015242 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015246 43F9 0000 0000             		lea	(SonAni_Push).l,a1
0001524C 1228 0022                  		move.b	$22(a0),d1
00015250 0201 0001                  		andi.b	#1,d1
00015254 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001525A 8328 0001                  		or.b	d1,1(a0)
0001525E 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015262 6700                       		beq.s	Loc_NotSuper2
00015264 43F9 0000 0000             		lea	(SupSonAni_Push).l,a1 ; use	running	animation
0001526A                            
0001526A                            Loc_NotSuper2:
0001526A 6000 FE90                  		bra.w	SAnim_Do2
0001526E                            ; End of function Sonic_Animate
