00014A32 4EB9 0000 0FF4             		jsr		(PlaySound_Special).l
00014A38                            		; sfx 	sfx_PeeloutStop
00014A38 4268 0014                  		clr.w	$14(a0)
00014A3C                            
00014A3C                            SCDPeelout_ResetScr:
00014A3C 588F                       		addq.l	#4,sp			; increase stack ptr ; was 4
00014A3E 0C78 0060 F73E             		cmpi.w	#$60,($FFFFF73E).w
00014A44 6700                       		beq.s	@finish
00014A46 6400                       		bcc.s	@skip
00014A48 5878 F73E                  		addq.w	#4,($FFFFF73E).w
