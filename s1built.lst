0001F0CC                            MainLoadBlocks:
0001F0CC                            	include "_inc\Main level load blocks.asm"
0001F0CC                            ; ---------------------------------------------------------------------------
0001F0CC                            ; Main level load blocks
0001F0CC                            ;
0001F0CC                            ; ===FORMAT===
0001F0CC                            ; level	patterns + (1st	PLC num	* 10^6)
0001F0CC                            ; 16x16	mappings + (2nd	PLC num	* 10^6)
0001F0CC                            ; 256x256 mappings
0001F0CC                            ; blank, music (unused), pal index (unused), pal index
0001F0CC                            ; ---------------------------------------------------------------------------
0001F0CC 0000 0000                  	dc.l Nem_GHZ_2nd+$4000000
