00014B36                            Dash_Speeds:
00014B36 0800                       		dc.w  $800		; 0
00014B38 0880                       		dc.w  $880		; 1
00014B3A 0900                       		dc.w  $900		; 2
00014B3C 0980                       		dc.w  $980		; 3
00014B3E 0A00                       		dc.w  $A00		; 4
00014B40 0A80                       		dc.w  $A80		; 5
00014B42 0B00                       		dc.w  $B00		; 6
00014B44 0B80                       		dc.w  $B80		; 7
00014B46 0C00                       		dc.w  $C00		; 8
00014B48                            Dash_Speeds_Super:
00014B48 0B00                       		dc.w  $B00	; 0
00014B4A 0B80                       		dc.w  $B80	; 1
00014B4C 0C00                       		dc.w  $C00	; 2
00014B4E 0C80                       		dc.w  $C80	; 3
00014B50 0D00                       		dc.w  $D00	; 4
00014B52 0D80                       		dc.w  $D80	; 5
00014B54 0E00                       		dc.w  $E00	; 6
00014B56 0E80                       		dc.w  $E80	; 7
00014B58 0F00                       		dc.w  $F00	; 8
