00014FCE 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00014FD2 1228 0022                  		move.b	$22(a0),d1
00014FD6 0201 0001                  		andi.b	#1,d1
00014FDA 0228 00FC 0001             		andi.b	#$FC,1(a0)
00014FE0 8328 0001                  		or.b	d1,1(a0)
00014FE4 6000 FEEC                  		bra.w	SAnim_Do2
