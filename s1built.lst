0001529C                            Sonic_Animate:				; XREF: Obj01_Control; et al
0001529C 43F9 0000 0000             		lea	(SonicAniData).l,a1
000152A2 7000                       		moveq	#0,d0
000152A4 1028 001C                  		move.b	$1C(a0),d0
000152A8 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
000152AC 6700                       		beq.s	SAnim_Do	; if not, branch
000152AE 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000152B2 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000152B8 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000152BE                            
000152BE                            SAnim_Do:
000152BE D040                       		add.w	d0,d0
000152C0 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000152C4 1011                       		move.b	(a1),d0
000152C6 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000152C8 1228 0022                  		move.b	$22(a0),d1
000152CC 0201 0001                  		andi.b	#1,d1
000152D0 0228 00FC 0001             		andi.b	#$FC,1(a0)
000152D6 8328 0001                  		or.b	d1,1(a0)
000152DA 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000152DE 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000152E0 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000152E4                            
000152E4                            SAnim_Do2:
000152E4 7200                       		moveq	#0,d1
000152E6 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000152EA 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000152EE 6B00                       		bmi.s	SAnim_End_FF	; if animation is complete, branch
000152F0                            
000152F0                            SAnim_Next:
000152F0 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000152F4 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000152F8                            
000152F8                            SAnim_Delay:
000152F8 4E75                       		rts	
000152FA                            ; ===========================================================================
000152FA                            
000152FA                            SAnim_End_FF:
000152FA 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000152FC 6600                       		bne.s	SAnim_End_FE	; if not, branch
000152FE 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015304 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015308 60E6                       		bra.s	SAnim_Next
0001530A                            ; ===========================================================================
0001530A                            
0001530A                            SAnim_End_FE:
0001530A 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0001530C 6600                       		bne.s	SAnim_End_FD	; if not, branch
0001530E 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015312 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015316 9200                       		sub.b	d0,d1
00015318 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0001531C 60D2                       		bra.s	SAnim_Next
0001531E                            ; ===========================================================================
0001531E                            
0001531E                            SAnim_End_FD:
0001531E 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015320 6600                       		bne.s	SAnim_End	; if not, branch
00015322 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015328                            
00015328                            SAnim_End:
00015328 4E75                       		rts	
0001532A                            ; ===========================================================================
0001532A                            
0001532A                            SAnim_WalkRun:				; XREF: SAnim_Do
0001532A 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
0001532E 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015330 5200                       		addq.b	#1,d0		; is animation walking/running?
00015332 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015336 7200                       		moveq	#0,d1
00015338 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
