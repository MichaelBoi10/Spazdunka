00014B7C 303C 00D1                  		move.w	#$D1,d0			; was $E0 in sonic 2
00014B80 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014B86 4EB9 0000 0FF4             		jsr	(PlaySound_Special).l	; play charge sound
