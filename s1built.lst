00001000                            PauseGame:				; XREF: Level_MainLoop; et al
00001000 4E71                       		nop	
00001002 4A38 FE12                  		tst.b	($FFFFFE12).w	; do you have any lives	left?
00001006 6700                       		beq.s	Unpause		; if not, branch
00001008 4A78 F63A                  		tst.w	($FFFFF63A).w	; is game already paused?
0000100C 6600                       		bne.s	loc_13BE	; if yes, branch
0000100E 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
00001014 6700                       		beq.s	Pause_DoNothing	; if not, branch
00001016                            
00001016                            loc_13BE:
00001016 31FC 0001 F63A             		move.w	#1,($FFFFF63A).w ; freeze time
0000101C 11FC 0001 F003             		move.b	#1,($FFFFF003).w ; pause music
00001022                            
00001022                            loc_13CA:
00001022 11FC 0010 F62A             		move.b	#$10,($FFFFF62A).w
00001028 6100 0000                  		bsr.w	DelayProgram
0000102C 4A38 FFE1                  		tst.b	($FFFFFFE1).w	; is slow-motion cheat on?
00001030 6700                       		beq.s	Pause_ChkStart	; if not, branch
00001032 0838 0006 F605             		btst	#6,($FFFFF605).w ; is button A pressed?
00001038 6700                       		beq.s	Pause_ChkBC	; if not, branch
0000103A 11FC 0004 F600             		move.b	#4,($FFFFF600).w ; set game mode to 4 (title screen)
00001040 4E71                       		nop	
00001042 6000                       		bra.s	loc_1404
00001044                            ; ===========================================================================
00001044                            
00001044                            Pause_ChkBC:				; XREF: PauseGame
