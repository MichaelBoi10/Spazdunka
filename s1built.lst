000152F0 6600                       		bne.s	SAnim_End_FE	; if not, branch
000152F2 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
000152F8 1029 0001                  		move.b	1(a1),d0	; read sprite number
000152FC 60E6                       		bra.s	SAnim_Next
000152FE                            ; ===========================================================================
000152FE                            
000152FE                            SAnim_End_FE:
