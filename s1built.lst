00081C8A                            ; ------------------------------------------------------------------------------
00081C8A                            ; Plays a given sample
00081C8A                            ; ------------------------------------------------------------------------------
00081C8A                            ; INPUT:
00081C8A                            ;		d0	.b		sample id (>$81)
00081C8A                            ;
00081C8A                            ; EXAMPLES:
00081C8A                            ;		move.b	#$81, d0
00081C8A                            ;		jsr		MegaPCM_PlaySample
00081C8A                            ;
00081C8A                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081C8A                            ;		jsr		MegaPCM_PlaySample
00081C8A                            ; ------------------------------------------------------------------------------
00081C8A                            
00081C8A                            MegaPCM_PlaySample:
00081C8A                            	MPCM_play	d0
00081C8A                          M 	mpcm_stopz80
00081C8A                          M 	pusho
00081C8A                          M 	opt	l-
00081C8A 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081C92                          M 	@wait_11:
00081C92 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081C9A 66F6                     M 	bne.s	@wait_11
00081C9C                          M 	popo
00081C9C 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081CA2                          M 	mpcm_startz80
00081CA2 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081CAA 4E75                       	rts
