00080086                            ; ==============================================================================
00080086                            ; ------------------------------------------------------------------------------
00080086                            ; Mega PCM API Routines
00080086                            ; ------------------------------------------------------------------------------
00080086                            
00080086                            
00080086                            ; ------------------------------------------------------------------------------
00080086                            ; Plays a given sample
00080086                            ; ------------------------------------------------------------------------------
00080086                            ; INPUT:
00080086                            ;		d0	.b		sample id (>$81)
00080086                            ;
00080086                            ; EXAMPLES:
00080086                            ;		move.b	#$81, d0
00080086                            ;		jsr		MegaPCM_PlaySample
00080086                            ;
00080086                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00080086                            ;		jsr		MegaPCM_PlaySample
00080086                            ; ------------------------------------------------------------------------------
00080086                            
00080086                            MegaPCM_PlaySample:
00080086                            	MPCM_play	d0
00080086                          M 	mpcm_stopz80
00080086                          M 	pusho
00080086                          M 	opt	l-
00080086 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0008008E                          M 	@wait_5:
0008008E 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00080096 66F6                     M 	bne.s	@wait_5
00080098                          M 	popo
00080098 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0008009E                          M 	mpcm_startz80
0008009E 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
000800A6 4E75                       	rts
000800A8                            
000800A8                            ; ------------------------------------------------------------------------------
000800A8                            ; Pauses current sample playback
000800A8                            ; ------------------------------------------------------------------------------
000800A8                            
000800A8                            MegaPCM_PausePlayback:
000800A8                            	MPCM_pause
000800A8                          M 	mpcm_stopz80
000800A8                          M 	pusho
000800A8                          M 	opt	l-
000800A8 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
000800B0                          M 	@wait_8:
000800B0 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
000800B8 66F6                     M 	bne.s	@wait_8
000800BA                          M 	popo
000800BA 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
000800C2                          M 	mpcm_startz80
000800C2 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
000800CA 4E75                       	rts
000800CC                            
000800CC                            ; ------------------------------------------------------------------------------
000800CC                            ; Unpauses playback
000800CC                            ; ------------------------------------------------------------------------------
000800CC                            
000800CC                            MegaPCM_UnpausePlayback:
000800CC                            	MPCM_unpause
000800CC                          M 	mpcm_stopz80
000800CC                          M 	pusho
000800CC                          M 	opt	l-
000800CC 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
000800D4                          M 	@wait_11:
000800D4 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
000800DC 66F6                     M 	bne.s	@wait_11
000800DE                          M 	popo
000800DE 13FC 0000 00A0 0001      M 	move.b	#0,mpcm_z80_ram+z_mpcm_commandinput
000800E6                          M 	mpcm_startz80
000800E6 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
000800EE 4E75                       	rts
000800F0                            
000800F0                            ; ------------------------------------------------------------------------------
000800F0                            ; Stops all playback
000800F0                            ; ------------------------------------------------------------------------------
000800F0                            
000800F0                            MegaPCM_StopPlayback:
000800F0                            	MPCM_stop
000800F0                          M 	mpcm_stopz80
