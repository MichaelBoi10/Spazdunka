00005C8E 6100 BFDE                  		bsr.w	Pal_FadeTo
00005C92                            
00005C92                            Cred_WaitLoop:
00005C92 11FC 0004 F62A             		move.b	#4,($FFFFF62A).w
00005C98 6100 CD90                  		bsr.w	DelayProgram
00005C9C 6100 B636                  		bsr.w	RunPLC_RAM
00005CA0 4A78 F614                  		tst.w	($FFFFF614).w	; have 2 seconds elapsed?
00005CA4 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005CA6 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005CAA 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005CAC 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
00005CB2 6700 0000                  		beq.w	TryAgainEnd	; if yes, branch
00005CB6 4E75                       		rts	
