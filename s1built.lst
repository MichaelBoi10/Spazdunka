0001C534 6600                       		bne.s	Hurt_Shield	; if yes, branch
0001C536 4A78 FE20                  		tst.w	($FFFFFE20).w	; does Sonic have any rings?
0001C53A 6700 0000                  		beq.w	Hurt_NoRings	; if not, branch
