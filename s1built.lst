0001458A                            Sonic_CheckGoSuper:
0001458A 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
0001458E 6600                       	bne.s	return_1ABA4		; if yes, branch
00014590 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
00014596 6600                       	bne.s	return_1ABA4		; if not, branch
00014598 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
0001459E 6500                       	bcs.s	return_1ABA4		; if not, branch
000145A0                            
000145A0 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
000145A6 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
