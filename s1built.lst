00014FA6 6600                       		bne.s	SAnim_Push	; if not, branch
00014FA8 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00014FAC 6A00                       		bpl.s	loc_13ADE
00014FAE 4442                       		neg.w	d2
00014FB0                            
00014FB0                            loc_13ADE:
00014FB0 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
00014FB6 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00014FBA 6400                       		bcc.s	loc_13AF0	; if yes, branch
00014FBC 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
00014FC2                            
00014FC2                            loc_13AF0:
00014FC2 4442                       		neg.w	d2
00014FC4 0642 0400                  		addi.w	#$400,d2
00014FC8 6A00                       		bpl.s	loc_13AFA
00014FCA 7400                       		moveq	#0,d2
00014FCC                            
00014FCC                            loc_13AFA:
