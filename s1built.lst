0001C972 4468 0012                  		neg.w	$12(a0)
0001C976 E0E8 0010                  		asr	$10(a0)
0001C97A E0E8 0012                  		asr	$12(a0)
0001C97E 137C 0000 0020             		move.b	#0,collision_flags(a1)
0001C984 5329 0021                  		subq.b	#1,collision_property(a1)
0001C988 6600                       		bne.s	locret_1AF68
0001C98A 08E9 0007 0022             		bset	#7,status(a1)
