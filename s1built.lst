000145C4 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
000145CA 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
000145D0 317C 0000 0032             	move.w	#0,invincibility_time(a0)
