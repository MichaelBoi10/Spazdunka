00015298 1028 001C                  		move.b	$1C(a0),d0
0001529C B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
000152A0 6700                       		beq.s	SAnim_Do	; if not, branch
000152A2 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000152A6 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000152AC 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000152B2                            
000152B2                            SAnim_Do:
000152B2 D040                       		add.w	d0,d0
000152B4 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000152B8 1011                       		move.b	(a1),d0
