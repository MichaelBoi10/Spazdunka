0001C99E 5478 F7D0                  		addq.w	#2,($FFFFF7D0).w ; add 2 to item bonus counter
0001C9A2 0C40 0006                  		cmpi.w	#6,d0
0001C9A6 6500                       		bcs.s	loc_1AF82
0001C9A8 7006                       		moveq	#6,d0
0001C9AA                            
0001C9AA                            loc_1AF82:
0001C9AA 3340 003E                  		move.w	d0,$3E(a1)
0001C9AE 303B 0000                  		move.w	Enemy_Points(pc,d0.w),d0
