000145DC 303C 00C3                  	move.w	#$C3,d0         ; 
000145E0 4EB9 0000 0FF2             	jsr	(PlaySound).l	; Play special ring sound effect.
000145E6 303C 0094                  	move.w	#$94,d0
000145EA 4EF9 0000 0FF8             	jmp	(PlaySound_Special).l	; Play the super theme
000145F0                            ; ---------------------------------------------------------------------------
