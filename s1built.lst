0001CB50 6600                       		bne.s	Hurt_Sound	; if not, branch
0001CB52 0C12 0016                  		cmpi.b	#$16,(a2)	; was damage caused by LZ harpoon?
0001CB56 6600                       		bne.s	Hurt_Sound	; if not, branch
0001CB58 303C 00A6                  		move.w	#$A6,d0		; load spikes damage sound
