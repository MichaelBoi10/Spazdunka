000800F0                          M 	opt	l-
000800F0 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
000800F8                          M 	@wait_14:
000800F8 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00080100 66F6                     M 	bne.s	@wait_14
00080102                          M 	popo
00080102 13FC 0001 00A0 0001      M 	move.b	#z_mpcm_command_stop,mpcm_z80_ram+z_mpcm_commandinput
0008010A                          M 	mpcm_startz80
0008010A 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00080112 4E75                       	rts
