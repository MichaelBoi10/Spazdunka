00014A62                            ; ---------------------------------------------------------------------------
00014A62                            ; Subroutine to make Sonic perform a spindash
00014A62                            ; ---------------------------------------------------------------------------
00014A62                             
00014A62                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014A62                             
00014A62                             
00014A62                            Sonic_SpinDash:
00014A62 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
00014A66 6600                       		bne.s	loc2_1AC8E		; if set, branch
00014A68 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
00014A6E 6600                       		bne.s	locret2_1AC8C		; if not, return
00014A70 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014A74 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
00014A78 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
00014A7C 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
00014A82 303C 00D1                  		move.w	#$D1,d0			; spin sound ($E0 in s2)
00014A86 4EB9 0000 0FF4             		jsr	(PlaySound_Special).l	; play spin sound
00014A8C 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014A8E 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
00014A94 317C 0000 003A             		move.w	#0,$3A(a0)		; set charge count to 0
00014A9A 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
00014AA0 6500                       		bcs.s	loc2_1AC84		; ??? branch if carry
00014AA2 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014AA8                            						; the smoke/dust object
00014AA8                            loc2_1AC84:
00014AA8 6100 FB5C                  		bsr.w	Sonic_LevelBound
00014AAC 6100 0000                  		bsr.w	Sonic_AnglePos
