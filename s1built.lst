00197A52                            SampleDebugger:
00197A52                            	Console.WriteLine "%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
00197A52 40E7                     M 	move.w	sr,-(sp)
00197A54                          M 	_console.writeline	<"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>">,<>
00197A54                          M 	__fstring_generateargumentscode	"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
00197A54 =00000001                M 	__pos:	= instr("%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'%<')
00197A54 =00000000                M 	__stack:=	0
00197A54 =00000000                M 	__sp:	= 0
00197A54                          M 	pusho
00197A54                          M 	opt	ae-
00197A54                          M 	while	(__pos)
00197A54 =00000007                M 	__endpos:	= instr(__pos+1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'>')
00197A54 =0000000E                M 	__midpos:	= instr(__pos+5,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",' ')
00197A54 =00000007                M 	__midpos:	= __endpos
00197A54                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
00197A54                          M 	__type:	substr __pos+1+1,__pos+1+1+1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
00197A54 =00000015                M 	__pos:	= instr(__pos+1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'%<')
00197A54 =0000001B                M 	__endpos:	= instr(__pos+1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'>')
00197A54 =00000020                M 	__midpos:	= instr(__pos+5,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",' ')
00197A54 =0000001B                M 	__midpos:	= __endpos
00197A54                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>"
