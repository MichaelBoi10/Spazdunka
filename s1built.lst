00005832 3038 FFF4                  		move.w	($FFFFFFF4).w,d0
00005836 0240 000F                  		andi.w	#$F,d0
0000583A D040                       		add.w	d0,d0
0000583C 303B 0000                  		move.w	EndDemo_Levels(pc,d0.w),d0 ; load level	array
00005840 31C0 FE10                  		move.w	d0,($FFFFFE10).w ; set level from level	array
00005844 5278 FFF4                  		addq.w	#1,($FFFFFFF4).w
00005848 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	credits	finished?
0000584E 6400                       		bcc.s	EndDemo_Exit	; if yes, branch
00005850 31FC 8001 FFF0             		move.w	#$8001,($FFFFFFF0).w ; force demo mode
00005856 11FC 0008 F600             		move.b	#8,($FFFFF600).w ; set game mode to 08 (demo)
0000585C 11FC 0003 FE12             		move.b	#3,($FFFFFE12).w ; set lives to	3
00005862 7000                       		moveq	#0,d0
00005864 31C0 FE20                  		move.w	d0,($FFFFFE20).w ; clear rings
00005868 21C0 FE22                  		move.l	d0,($FFFFFE22).w ; clear time
0000586C 21C0 FE26                  		move.l	d0,($FFFFFE26).w ; clear score
00005870 11C0 FE30                  		move.b	d0,($FFFFFE30).w ; clear lamppost counter
00005874 0C78 0004 FFF4             		cmpi.w	#4,($FFFFFFF4).w ; is SLZ demo running?
