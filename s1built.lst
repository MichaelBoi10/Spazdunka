0000B14E                            ; ---------------------------------------------------------------------------
0000B14E                            ; Subroutine to	animate	a sprite using an animation script
0000B14E                            ; ---------------------------------------------------------------------------
0000B14E                            
0000B14E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B14E                            
0000B14E                            
0000B14E                            AnimateSprite:
0000B14E 7000                       		moveq	#0,d0
0000B150 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B154 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B158 6700                       		beq.s	Anim_Run	; if not, branch
0000B15A 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B15E 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B164 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B16A                            
0000B16A                            Anim_Run:
0000B16A 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B16E 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B170 D040                       		add.w	d0,d0
0000B172 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B176 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B17A 7200                       		moveq	#0,d1
0000B17C 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B180 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B184 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B186                            
0000B186                            Anim_Next:
0000B186 1200                       		move.b	d0,d1
0000B188 0200 001F                  		andi.b	#$1F,d0
0000B18C 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B190 1028 0022                  		move.b	$22(a0),d0
0000B194 E719                       		rol.b	#3,d1
0000B196 B101                       		eor.b	d0,d1
0000B198 0201 0003                  		andi.b	#3,d1
0000B19C 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B1A2 8328 0001                  		or.b	d1,render_flags(a0)
0000B1A6 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B1AA                            
0000B1AA                            Anim_Wait:
0000B1AA 4E75                       		rts	
0000B1AC                            ; ===========================================================================
0000B1AC                            
0000B1AC                            Anim_End_FF:
0000B1AC 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B1AE 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B1B0 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B1B6 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B1BA 60CA                       		bra.s	Anim_Next
0000B1BC                            ; ===========================================================================
0000B1BC                            
0000B1BC                            Anim_End_FE:
0000B1BC 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B1BE 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B1C0 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B1C4 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B1C8 9200                       		sub.b	d0,d1
0000B1CA 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B1CE 60B6                       		bra.s	Anim_Next
0000B1D0                            ; ===========================================================================
0000B1D0                            
0000B1D0                            Anim_End_FD:
0000B1D0 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B1D2 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B1D4 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B1DA                            
0000B1DA                            Anim_End_FC:
0000B1DA 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B1DC 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B1DE 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B1E2                            
0000B1E2                            Anim_End_FB:
0000B1E2 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B1E4 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B1E6 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B1EC 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B1F0                            
0000B1F0                            Anim_End_FA:
0000B1F0 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B1F2 6600                       		bne.s	Anim_End	; if not, branch
0000B1F4 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B1F8                            
0000B1F8                            Anim_End:
0000B1F8 4E75                       		rts	
0000B1FA                            ; End of function AnimateSprite
