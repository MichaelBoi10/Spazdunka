00001148 3418                       		move.w	(a0)+,d2
0000114A E34A                       		lsl.w	#1,d2
0000114C 6400                       		bcc.s	loc_146A
0000114E D6FC 000A                  		adda.w	#$A,a3
00001152                            
00001152                            loc_146A:
00001152 E54A                       		lsl.w	#2,d2
00001154 3A42                       		movea.w	d2,a5
00001156 7608                       		moveq	#8,d3
00001158 7400                       		moveq	#0,d2
0000115A 7800                       		moveq	#0,d4
0000115C 6100 0000                  		bsr.w	NemDec4
00001160 1A18                       		move.b	(a0)+,d5
00001162 E145                       		asl.w	#8,d5
00001164 1A18                       		move.b	(a0)+,d5
00001166 3C3C 0010                  		move.w	#$10,d6
