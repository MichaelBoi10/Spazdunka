00015300 6600                       		bne.s	SAnim_End_FD	; if not, branch
00015302 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015306 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
0001530A 9200                       		sub.b	d0,d1
0001530C 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015310 60D2                       		bra.s	SAnim_Next
