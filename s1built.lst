0001CAC2                            ; ---------------------------------------------------------------------------
0001CAC2                            ; Subroutine to	kill Sonic
0001CAC2                            ; ---------------------------------------------------------------------------
0001CAC2                            
0001CAC2                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001CAC2                            
0001CAC2                            
0001CAC2                            KillSonic:
0001CAC2 4A78 FE08                  		tst.w	($FFFFFE08).w	; is debug mode	active?
0001CAC6 6600                       		bne.s	Kill_NoDeath	; if yes, branch
0001CAC8 11FC 0000 FE2D             		move.b	#0,($FFFFFE2D).w ; remove invincibility
0001CACE 117C 0006 0024             		move.b	#6,routine(a0)
0001CAD4 6100 835A                  		bsr.w	Sonic_ResetOnFloor
0001CAD8 08E8 0001 0022             		bset	#1,status(a0)
0001CADE 317C F900 0012             		move.w	#-$700,y_vel(a0)
0001CAE4 317C 0000 0010             		move.w	#0,x_vel(a0)
0001CAEA 317C 0000 0014             		move.w	#0,$14(a0)
0001CAF0 3168 000C 0038             		move.w	$C(a0),$38(a0)
0001CAF6 117C 0018 001C             		move.b	#$18,anim(a0)
0001CAFC 08E8 0007 0002             		bset	#7,art_tile(a0)
0001CB02 303C 00A3                  		move.w	#$A3,d0		; play normal death sound
0001CB06 0C12 0036                  		cmpi.b	#$36,(a2)	; check	if you were killed by spikes
0001CB0A 6600                       		bne.s	Kill_Sound
0001CB0C 303C 00A6                  		move.w	#$A6,d0		; play spikes death sound
0001CB10                            
0001CB10                            Kill_Sound:
0001CB10 4EB9 0000 0FF4             		jsr	(PlaySound_Special).l
0001CB16                            
0001CB16                            Kill_NoDeath:
0001CB16 70FF                       		moveq	#-1,d0
0001CB18 4E75                       		rts	
