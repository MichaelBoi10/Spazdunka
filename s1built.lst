0000DBFA                            ; Spikes types $1x and $5x face	sideways
0000DBFA                            
0000DBFA                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DBFA 323C 001B                  		move.w	#$1B,d1
0000DBFE 3602                       		move.w	d2,d3
0000DC00 5243                       		addq.w	#1,d3
0000DC02 3828 0008                  		move.w	8(a0),d4
0000DC06 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DC0A 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DC0E 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DC12 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DC16 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DC1C 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DC1E 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DC20 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DC22 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DC24 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DC26                            ; ===========================================================================
0000DC26                            
0000DC26                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DC26                            
0000DC26                            Obj36_Upright:				; XREF: Obj36_Solid
0000DC26 7200                       		moveq	#0,d1
0000DC28 1228 0019                  		move.b	$19(a0),d1
