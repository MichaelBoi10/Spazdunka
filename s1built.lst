0000B06E                            ; ---------------------------------------------------------------------------
0000B06E                            ; Subroutine to	animate	a sprite using an animation script
0000B06E                            ; ---------------------------------------------------------------------------
0000B06E                            
0000B06E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B06E                            
0000B06E                            
0000B06E                            AnimateSprite:
0000B06E 7000                       		moveq	#0,d0
0000B070 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B074 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B078 6700                       		beq.s	Anim_Run	; if not, branch
0000B07A 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B07E 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B084 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B08A                            
0000B08A                            Anim_Run:
0000B08A 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B08E 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B090 D040                       		add.w	d0,d0
0000B092 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B096 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B09A 7200                       		moveq	#0,d1
0000B09C 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B0A0 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B0A4 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B0A6                            
0000B0A6                            Anim_Next:
0000B0A6 1200                       		move.b	d0,d1
0000B0A8 0200 001F                  		andi.b	#$1F,d0
0000B0AC 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B0B0 1028 0022                  		move.b	$22(a0),d0
0000B0B4 E719                       		rol.b	#3,d1
0000B0B6 B101                       		eor.b	d0,d1
0000B0B8 0201 0003                  		andi.b	#3,d1
0000B0BC 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B0C2 8328 0001                  		or.b	d1,render_flags(a0)
0000B0C6 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B0CA                            
0000B0CA                            Anim_Wait:
0000B0CA 4E75                       		rts	
0000B0CC                            ; ===========================================================================
0000B0CC                            
0000B0CC                            Anim_End_FF:
0000B0CC 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B0CE 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B0D0 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B0D6 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B0DA 60CA                       		bra.s	Anim_Next
0000B0DC                            ; ===========================================================================
0000B0DC                            
0000B0DC                            Anim_End_FE:
0000B0DC 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B0DE 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B0E0 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B0E4 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B0E8 9200                       		sub.b	d0,d1
0000B0EA 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B0EE 60B6                       		bra.s	Anim_Next
0000B0F0                            ; ===========================================================================
0000B0F0                            
0000B0F0                            Anim_End_FD:
0000B0F0 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B0F2 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B0F4 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B0FA                            
0000B0FA                            Anim_End_FC:
0000B0FA 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B0FC 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B0FE 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B102                            
0000B102                            Anim_End_FB:
0000B102 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B104 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B106 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B10C 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B110                            
0000B110                            Anim_End_FA:
0000B110 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B112 6600                       		bne.s	Anim_End	; if not, branch
