000779F6                            MegaPCM_PlaySample:
000779F6                            	MPCM_play	d0
000779F6                          M 	mpcm_stopz80
000779F6                          M 	pusho
000779F6                          M 	opt	l-
000779F6 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
000779FE                          M 	@wait_5:
000779FE 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00077A06 66F6                     M 	bne.s	@wait_5
00077A08                          M 	popo
00077A08 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00077A0E                          M 	mpcm_startz80
00077A0E 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00077A16 4E75                       	rts
