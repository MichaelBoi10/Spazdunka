00015158 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
0001515C 6400                       		bhs.s	loc_13AB4	; if yes, branch
0001515E 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
