00081C84                            ; ------------------------------------------------------------------------------
00081C84                            ; Plays a given sample
00081C84                            ; ------------------------------------------------------------------------------
00081C84                            ; INPUT:
00081C84                            ;		d0	.b		sample id (>$81)
00081C84                            ;
00081C84                            ; EXAMPLES:
00081C84                            ;		move.b	#$81, d0
00081C84                            ;		jsr		MegaPCM_PlaySample
00081C84                            ;
00081C84                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081C84                            ;		jsr		MegaPCM_PlaySample
00081C84                            ; ------------------------------------------------------------------------------
00081C84                            
00081C84                            MegaPCM_PlaySample:
00081C84                            	MPCM_play	d0
00081C84                          M 	mpcm_stopz80
00081C84                          M 	pusho
00081C84                          M 	opt	l-
00081C84 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081C8C                          M 	@wait_11:
00081C8C 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081C94 66F6                     M 	bne.s	@wait_11
00081C96                          M 	popo
00081C96 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081C9C                          M 	mpcm_startz80
00081C9C 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081CA4 4E75                       	rts
00081CA6                            
00081CA6                            ; ------------------------------------------------------------------------------
