0001518E 6600                       		bne.s	SAnim_Push	; if not, branch
00015190 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015194 6A00                       		bpl.s	loc_13ADE
00015196 4442                       		neg.w	d2
