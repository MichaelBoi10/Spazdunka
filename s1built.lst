000152DE 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000152E2 6B00                       		bmi.s	SAnim_End_FF	; if animation is complete, branch
000152E4                            
000152E4                            SAnim_Next:
000152E4 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000152E8 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000152EC                            
000152EC                            SAnim_Delay:
000152EC 4E75                       		rts	
000152EE                            ; ===========================================================================
000152EE                            
000152EE                            SAnim_End_FF:
