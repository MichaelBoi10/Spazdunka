00005B76 6100 CDE0                  		bsr.w	DelayProgram
00005B7A 6100 B75C                  		bsr.w	RunPLC_RAM
00005B7E 4A78 F614                  		tst.w	($FFFFF614).w	; have 2 seconds elapsed?
00005B82 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005B84 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005B88 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005B8A 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
00005B90 6700 0000                  		beq.w	TryAgainEnd	; if yes, branch
00005B94 4E75                       		rts	
