00014B30 0880                       		dc.w  $880		; 1
00014B32 0900                       		dc.w  $900		; 2
00014B34 0980                       		dc.w  $980		; 3
00014B36 0A00                       		dc.w  $A00		; 4
00014B38 0A80                       		dc.w  $A80		; 5
00014B3A 0B00                       		dc.w  $B00		; 6
00014B3C 0B80                       		dc.w  $B80		; 7
00014B3E 0C00                       		dc.w  $C00		; 8
