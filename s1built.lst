00015002                            ; Subroutine to	make Sonic run around loops (GHZ/SLZ)
00015002                            ; ---------------------------------------------------------------------------
00015002                            
00015002                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00015002                            
00015002                            
00015002                            Sonic_Loops:				; XREF: Obj01_Control
00015002 0C38 0003 FE10             		cmpi.b	#3,($FFFFFE10).w ; is level SLZ	?
00015008 6700                       		beq.s	loc_13926	; if yes, branch
0001500A 4A38 FE10                  		tst.b	($FFFFFE10).w	; is level GHZ ?
0001500E 6600 0000                  		bne.w	locret_139C2	; if not, branch
00015012                            
00015012                            loc_13926:
00015012 3028 000C                  		move.w	$C(a0),d0
00015016 E248                       		lsr.w	#1,d0
00015018 0240 0380                  		andi.w	#$380,d0
0001501C 1228 0008                  		move.b	8(a0),d1
00015020 0241 007F                  		andi.w	#$7F,d1
00015024 D041                       		add.w	d1,d0
00015026 43F8 A400                  		lea	($FFFFA400).w,a1
0001502A 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
0001502E B238 F7AE                  		cmp.b	($FFFFF7AE).w,d1
00015032 6700 F68E                  		beq.w	Obj01_ChkRoll
00015036 B238 F7AF                  		cmp.b	($FFFFF7AF).w,d1
0001503A 6700 F686                  		beq.w	Obj01_ChkRoll
0001503E B238 F7AC                  		cmp.b	($FFFFF7AC).w,d1
00015042 6700                       		beq.s	loc_13976
00015044 B238 F7AD                  		cmp.b	($FFFFF7AD).w,d1
00015048 6700                       		beq.s	loc_13966
0001504A 08A8 0006 0001             		bclr	#6,render_flags(a0)
00015050 4E75                       		rts	
00015052                            ; ===========================================================================
00015052                            
00015052                            loc_13966:
00015052 0828 0001 0022             		btst	#1,status(a0)
00015058 6700                       		beq.s	loc_13976
0001505A 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
00015060 4E75                       		rts	
00015062                            ; ===========================================================================
00015062                            
00015062                            loc_13976:
00015062 3428 0008                  		move.w	8(a0),d2
00015066 0C02 002C                  		cmpi.b	#$2C,d2
0001506A 6400                       		bcc.s	loc_13988
0001506C 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
00015072 4E75                       		rts	
00015074                            ; ===========================================================================
00015074                            
00015074                            loc_13988:
00015074 0C02 00E0                  		cmpi.b	#-$20,d2
00015078 6500                       		bcs.s	loc_13996
0001507A 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
00015080 4E75                       		rts	
00015082                            ; ===========================================================================
00015082                            
00015082                            loc_13996:
00015082 0828 0006 0001             		btst	#6,render_flags(a0)
00015088 6600                       		bne.s	loc_139B2
0001508A 1228 0026                  		move.b	$26(a0),d1
0001508E 6700                       		beq.s	locret_139C2
00015090 0C01 0080                  		cmpi.b	#-$80,d1
00015094 6200                       		bhi.s	locret_139C2
00015096 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
0001509C 4E75                       		rts	
0001509E                            ; ===========================================================================
0001509E                            
0001509E                            loc_139B2:
