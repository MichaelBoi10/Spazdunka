00014A28                            loc2_1AD30:				; If still charging the dash...
00014A28 4A68 003A                  		tst.w	$3A(a0)		; check charge count
00014A2C 6700                       		beq.s	loc2_1AD48	; if zero, branch
00014A2E 3028 003A                  		move.w	$3A(a0),d0	; otherwise put it in d0
00014A32 EA48                       		lsr.w	#5,d0		; shift right 5 (divide it by 32)
00014A34 9168 003A                  		sub.w	d0,$3A(a0)	; subtract from charge count
00014A38 6400                       		bcc.s	loc2_1AD48	; ??? branch if carry clear
00014A3A 317C 0000 003A             		move.w	#0,$3A(a0)	; set charge count to 0
00014A40                            
00014A40                            loc2_1AD48:
00014A40 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014A44 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C?
00014A48 6700 0000                  		beq.w	loc2_1AD78		; if not, branch
00014A4C 317C 0900 001C             		move.w	#$900,anim(a0)		; reset spdsh animation
00014A52 303C 00D1                  		move.w	#$D1,d0			; was $E0 in sonic 2
00014A56 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014A5C 4EB9 0000 0FF8             		jsr	(PlaySound_Special).l	; play charge sound
00014A62 0668 0200 003A             		addi.w	#$200,$3A(a0)		; increase charge count
00014A68 0C68 0800 003A             		cmpi.w	#$800,$3A(a0)		; check if it's maxed
00014A6E 6500                       		bcs.s	loc2_1AD78		; if not, then branch
00014A70 317C 0800 003A             		move.w	#$800,$3A(a0)		; reset it to max
00014A76                            
