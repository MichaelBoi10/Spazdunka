00014F66                            GameOver:				; XREF: Obj01_Death
00014F66 3038 F704                  		move.w	($FFFFF704).w,d0
00014F6A 0640 0100                  		addi.w	#$100,d0
00014F6E B068 000C                  		cmp.w	$C(a0),d0
00014F72 6C00 0000                  		bge.w	locret_13900
00014F76 317C FFC8 0012             		move.w	#-$38,y_vel(a0)
00014F7C 5428 0024                  		addq.b	#2,routine(a0)
00014F80 4238 FE1E                  		clr.b	($FFFFFE1E).w	; stop time counter
00014F84 5238 FE1C                  		addq.b	#1,($FFFFFE1C).w ; update lives	counter
00014F88 5338 FE12                  		subq.b	#1,($FFFFFE12).w ; subtract 1 from number of lives
00014F8C 6600                       		bne.s	loc_138D4
00014F8E 317C 0000 003A             		move.w	#0,$3A(a0)
00014F94 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load GAME object
00014F9A 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
00014FA0 11FC 0001 D0DA             		move.b	#1,($FFFFD0DA).w ; set OVER object to correct frame
00014FA6 4238 FE1A                  		clr.b	($FFFFFE1A).w
00014FAA                            
00014FAA                            loc_138C2:
00014FAA 11FC 0014 F600             		move.b	#$14,($FFFFF600).w ; set mode to $14 (continue screen)
00014FB0 7003                       		moveq	#3,d0
00014FB2 4EF9 0000 1268             		jmp	(LoadPLC).l	; load game over patterns
00014FB8                            ; ===========================================================================
00014FB8                            
00014FB8                            loc_138D4:
00014FB8 317C 003C 003A             		move.w	#60,$3A(a0)	; set time delay to 1 second
00014FBE 4A38 FE1A                  		tst.b	($FFFFFE1A).w	; is TIME OVER tag set?
00014FC2 6700                       		beq.s	locret_13900	; if not, branch
00014FC4 317C 0000 003A             		move.w	#0,$3A(a0)
00014FCA 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load TIME object
00014FD0 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
00014FD6 11FC 0002 D09A             		move.b	#2,($FFFFD09A).w
00014FDC 11FC 0003 D0DA             		move.b	#3,($FFFFD0DA).w
00014FE2 60C6                       		bra.s	loc_138C2
00014FE4                            ; ===========================================================================
00014FE4                            
00014FE4                            locret_13900:
00014FE4 4E75                       		rts	
00014FE6                            ; End of function GameOver
