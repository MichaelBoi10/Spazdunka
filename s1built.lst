00014A5A                             
00014A5A                            Sonic_SpinDash:
00014A5A 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
00014A5E 6600                       		bne.s	loc2_1AC8E		; if set, branch
00014A60 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
00014A66 6600                       		bne.s	locret2_1AC8C		; if not, return
00014A68 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014A6C 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
00014A70 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
00014A74 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
00014A7A 303C 00D1                  		move.w	#$D1,d0			; spin sound ($E0 in s2)
00014A7E 4EB9 0000 0FF4             		jsr	(PlaySound_Special).l	; play spin sound
00014A84 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014A86 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
00014A8C 317C 0000 003A             		move.w	#0,$3A(a0)		; set charge count to 0
00014A92 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
00014A98 6500                       		bcs.s	loc2_1AC84		; ??? branch if carry
00014A9A 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014AA0                            						; the smoke/dust object
00014AA0                            loc2_1AC84:
