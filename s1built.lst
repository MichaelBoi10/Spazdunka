00014986 1038 F602                  		move.b	($FFFFF602).w,d0	; read controller
0001498A 0800 0001                  		btst	#1,d0			; check down button
0001498E 6600 0000                  		bne.w	loc2_1AD30		; if set, branch
00014992 117C 000E 0016             		move.b	#$E,y_radius(a0)		; $16(a0) is height/2
00014998 117C 0007 0017             		move.b	#7,x_radius(a0)		; $17(a0) is width/2
0001499E 117C 0002 001C             		move.b	#2,anim(a0)		; set animation to roll
000149A4 5A68 000C                  		addq.w	#5,y_pos(a0)		; $C(a0) is Y coordinate
000149A8 117C 0000 0039             		move.b	#0,$39(a0)		; clear Spin Dash flag
000149AE 7000                       		moveq	#0,d0
000149B0 1028 003A                  		move.b	$3A(a0),d0		; copy charge count
000149B4 D040                       		add.w	d0,d0			; double it
000149B6 317B 0000 0014             		move.w	Dash_Speeds(pc,d0.w),$14(a0) ; get normal speed
000149BC 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
000149C0 6700                       		beq.s	loc2_1AC8F
000149C2 317B 0000 0014             		move.w	Dash_Speeds_Super(pc,d0.w),inertia(a0)
000149C8                            
000149C8                            loc2_1AC8F:
000149C8 3028 0014                  		move.w	$14(a0),d0		; get inertia
000149CC 0440 0800                  		subi.w	#$800,d0		; subtract $800
000149D0 D040                       		add.w	d0,d0			; double it
000149D2 0240 1F00                  		andi.w	#$1F00,d0		; mask it against $1F00
000149D6 4440                       		neg.w	d0			; negate it
000149D8 0640 2000                  		addi.w	#$2000,d0		; add $2000
000149DC 31C0 C904                  		move.w	d0,($FFFFC904).w	; move to $C904
000149E0 0828 0000 0022             		btst	#0,status(a0)		; is sonic facing right?
000149E6 6700                       		beq.s	loc2_1ACF4		; if not, branch
000149E8 4468 0014                  		neg.w	$14(a0)			; negate inertia
000149EC                            
