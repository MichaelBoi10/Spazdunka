0001C830 3C3C 005F                  		move.w	#$5F,d6
0001C834                            
0001C834                            Touch_Loop:
0001C834 4A29 0001                  		tst.b	1(a1)
0001C838 6A00                       		bpl.s	Touch_NextObj
0001C83A 1029 0020                  		move.b	$20(a1),d0	; load touch response number
0001C83E 6600                       		bne.s	Touch_Height	; if touch response is not 0, branch
0001C840                            
0001C840                            Touch_NextObj:
0001C840 43E9 0040                  		lea	$40(a1),a1	; next object RAM
0001C844 51CE FFEE                  		dbf	d6,Touch_Loop	; repeat $5F more times
0001C848                            
0001C848 7000                       		moveq	#0,d0
0001C84A 4E75                       		rts	
0001C84C                            ; ===========================================================================
