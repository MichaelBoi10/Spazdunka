0001E154                            
0001E154                            HudUpdate:
0001E154 4A78 FE08                  		tst.w	($FFFFFE08).w	; has the player entered debug mode?
0001E158 6600 0000                  		bne.w	HudDebug	; if yes, branch
0001E15C 4A38 FE1F                  		tst.b	($FFFFFE1F).w	; does the score need updating?
0001E160 6700                       		beq.s	Hud_ChkRings	; if not, branch
0001E162 4238 FE1F                  		clr.b	($FFFFFE1F).w
0001E166 203C 5C80 0003             		move.l	#$5C800003,d0	; set VRAM address
0001E16C 2238 FE26                  		move.l	($FFFFFE26).w,d1 ; load	score
0001E170 6100 0000                  		bsr.w	Hud_Score
0001E174                            
0001E174                            Hud_ChkRings:
0001E174 4A38 FE1D                  		tst.b	($FFFFFE1D).w	; does the ring	counter	need updating?
0001E178 6700                       		beq.s	Hud_ChkTime	; if not, branch
0001E17A 6A00                       		bpl.s	loc_1C6E4
0001E17C 6100 0000                  		bsr.w	Hud_LoadZero
0001E180                            
0001E180                            loc_1C6E4:
0001E180 4238 FE1D                  		clr.b	($FFFFFE1D).w
0001E184 203C 5F40 0003             		move.l	#$5F400003,d0	; set VRAM address
0001E18A 7200                       		moveq	#0,d1
0001E18C 3238 FE20                  		move.w	($FFFFFE20).w,d1 ; load	number of rings
0001E190 6100 0000                  		bsr.w	Hud_Rings
0001E194                            
0001E194                            Hud_ChkTime:
0001E194 4A38 FE1E                  		tst.b	($FFFFFE1E).w	; does the time	need updating?
0001E198 6700                       		beq.s	Hud_ChkLives	; if not, branch
0001E19A 4A78 F63A                  		tst.w	($FFFFF63A).w	; is the game paused?
0001E19E 6600                       		bne.s	Hud_ChkLives	; if yes, branch
0001E1A0 43F8 FE22                  		lea	($FFFFFE22).w,a1
0001E1A4 0C99 0009 3B3B             		cmpi.l	#$93B3B,(a1)+	; is the time 9.59?
0001E1AA 6700                       		beq.s	TimeOver	; if yes, branch
0001E1AC 5221                       		addq.b	#1,-(a1)
0001E1AE 0C11 003C                  		cmpi.b	#60,(a1)
0001E1B2 6500                       		bcs.s	Hud_ChkLives
0001E1B4 12BC 0000                  		move.b	#0,(a1)
0001E1B8 5221                       		addq.b	#1,-(a1)
