000145CE                            Sonic_CheckGoSuper:
000145CE 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
000145D2 6600                       	bne.s	return_1ABA4		; if yes, branch
000145D4 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
000145DA 6600                       	bne.s	return_1ABA4		; if not, branch
000145DC 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
000145E2 6500                       	bcs.s	return_1ABA4		; if not, branch
000145E4                            
000145E4 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
