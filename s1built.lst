0000D9A2 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000D9A6 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000D9AA 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000D9AE 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
