0000DB0C 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DB0E 4A44                       		tst.w	d4			; check response value from SolidObject
0000DB10 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DB12 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DB16 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DB1A 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DB20 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DB22 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DB24 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DB26 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DB28                            		; otherwise, fall through to Spik_Hurt
