0000DE28                            Obj36_Upright:				; XREF: Obj36_Solid
0000DE28 7200                       		moveq	#0,d1
0000DE2A 1228 0019                  		move.b	$19(a0),d1
0000DE2E 0641 000B                  		addi.w	#$B,d1
0000DE32 343C 0010                  		move.w	#$10,d2
0000DE36 363C 0011                  		move.w	#$11,d3
0000DE3A 3828 0008                  		move.w	8(a0),d4
0000DE3E 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DE42 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DE48 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DE4A 4A44                       		tst.w	d4			; check response value from SolidObject
0000DE4C 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DE4E 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DE52 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DE56 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DE5C 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DE5E 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DE60 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DE62 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DE64                            		; otherwise, fall through to Spik_Hurt
0000DE64                            
0000DE64                            Obj36_Hurt:				; XREF: Obj36_SideWays; Obj36_Upright
0000DE64 4A38 FE2D                  		tst.b	($FFFFFE2D).w	; is Sonic invincible?
0000DE68 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DE6A 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DE6E 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
0000DE70 2F08                       		move.l	a0,-(sp)
0000DE72 2448                       		movea.l	a0,a2
0000DE74 41F8 D000                  		lea	($FFFFD000).w,a0
0000DE78 0C28 0004 0024             		cmpi.b	#4,routine(a0)
0000DE7E 6400                       		bcc.s	loc_CF20
