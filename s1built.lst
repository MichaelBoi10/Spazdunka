000150D6                            SAnim_End_FD:
000150D6 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
000150D8 6600                       		bne.s	SAnim_End	; if not, branch
000150DA 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
000150E0                            
000150E0                            SAnim_End:
000150E0 4E75                       		rts	
