0001C802                            TouchResponse:				; XREF: Obj01
0001C802 4E71                       		nop	
0001C804 3428 0008                  		move.w	8(a0),d2	; load Sonic's x-axis value
0001C808 3628 000C                  		move.w	$C(a0),d3	; load Sonic's y-axis value
0001C80C 5142                       		subq.w	#8,d2
0001C80E 7A00                       		moveq	#0,d5
0001C810 1A28 0016                  		move.b	$16(a0),d5	; load Sonic's height
0001C814 5705                       		subq.b	#3,d5
0001C816 9645                       		sub.w	d5,d3
0001C818 0C28 0039 001A             		cmpi.b	#$39,mapping_frame(a0)	; is Sonic ducking?
0001C81E 6600                       		bne.s	Touch_NoDuck	; if not, branch
0001C820 0643 000C                  		addi.w	#$C,d3
0001C824 7A0A                       		moveq	#$A,d5
0001C826                            
0001C826                            Touch_NoDuck:
0001C826 383C 0010                  		move.w	#$10,d4
0001C82A DA45                       		add.w	d5,d5
