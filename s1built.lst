0001CAD4 117C 0006 0024             		move.b	#6,routine(a0)
0001CADA 6100 8354                  		bsr.w	Sonic_ResetOnFloor
0001CADE 08E8 0001 0022             		bset	#1,status(a0)
0001CAE4 317C F900 0012             		move.w	#-$700,y_vel(a0)
0001CAEA 317C 0000 0010             		move.w	#0,x_vel(a0)
0001CAF0 317C 0000 0014             		move.w	#0,$14(a0)
0001CAF6 3168 000C 0038             		move.w	$C(a0),$38(a0)
0001CAFC 117C 0018 001C             		move.b	#$18,anim(a0)
