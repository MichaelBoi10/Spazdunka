000DC652                            ; c�digo para que aponte para as rotinas equivalentes.
000DC652                            ; 
000DC652                            ; Para pode utilizar este menu basta fazer a seguinte modifica��o no c�digo 
000DC652                            ; original:
000DC652                            ; Localize o label  -> loc_3242 adicione -> jmp     Level_Select_Menu
000DC652                            ; O c�digo deve ficar como abaixo
000DC652                            ;               ......................
000DC652                            ; loc_3242:
000DC652                            ;		tst.b	($FFFFFFE0).w
000DC652                            ;		beq.w	PlayLevel	
000DC652                            ;		btst	#6,($FFFFF604).w 
