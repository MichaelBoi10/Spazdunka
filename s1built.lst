00014B6A 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014B6E 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C?
00014B72 6700 0000                  		beq.w	loc2_1AD78		; if not, branch
