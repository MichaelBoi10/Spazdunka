00014B5A                            
00014B5A                            loc2_1AD30:				; If still charging the dash...
00014B5A 4A68 003A                  		tst.w	$3A(a0)		; check charge count
00014B5E 6700                       		beq.s	loc2_1AD48	; if zero, branch
00014B60 3028 003A                  		move.w	$3A(a0),d0	; otherwise put it in d0
00014B64 EA48                       		lsr.w	#5,d0		; shift right 5 (divide it by 32)
00014B66 9168 003A                  		sub.w	d0,$3A(a0)	; subtract from charge count
00014B6A 6400                       		bcc.s	loc2_1AD48	; ??? branch if carry clear
00014B6C 317C 0000 003A             		move.w	#0,$3A(a0)	; set charge count to 0
00014B72                            
00014B72                            loc2_1AD48:
00014B72 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014B76 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C?
00014B7A 6700 0000                  		beq.w	loc2_1AD78		; if not, branch
00014B7E 317C 0900 001C             		move.w	#$900,anim(a0)		; reset spdsh animation
00014B84 303C 00D1                  		move.w	#$D1,d0			; was $E0 in sonic 2
00014B88 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014B8E 4EB9 0000 0FF4             		jsr	(PlaySound_Special).l	; play charge sound
00014B94 0668 0200 003A             		addi.w	#$200,$3A(a0)		; increase charge count
00014B9A 0C68 0800 003A             		cmpi.w	#$800,$3A(a0)		; check if it's maxed
00014BA0 6500                       		bcs.s	loc2_1AD78		; if not, then branch
00014BA2 317C 0800 003A             		move.w	#$800,$3A(a0)		; reset it to max
00014BA8                            
00014BA8                            loc2_1AD78:
00014BA8 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014BAA 0C78 0060 EED8             		cmpi.w	#$60,($FFFFEED8).w	; $EED8 only ever seems
00014BB0 6700                       		beq.s	loc2_1AD8C		; to be used in Spin Dash
00014BB2 6400                       		bcc.s	loc2_1AD88
00014BB4 5878 EED8                  		addq.w	#4,($FFFFEED8).w
