0001C9D6 6B00                       		bmi.s	loc_1AFC2
0001C9D8 3028 000C                  		move.w	$C(a0),d0
0001C9DC B069 000C                  		cmp.w	$C(a1),d0
0001C9E0 6400                       		bcc.s	loc_1AFCA
0001C9E2 4468 0012                  		neg.w	$12(a0)
0001C9E6 4E75                       		rts	
