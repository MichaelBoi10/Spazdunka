00080086                            ; ------------------------------------------------------------------------------
00080086                            ; Exported symbols
00080086                            ; ------------------------------------------------------------------------------
00080086                            
00080086 =0007DF6E                  MegaPCM_LoadDriver:	equ	MegaPCMLibraryBlob+$0
00080086 =0007DFD8                  MegaPCM_LoadSampleTable:	equ	MegaPCMLibraryBlob+$6A
00080086 =0007E21E                  MegaPCM:	equ	MegaPCMLibraryBlob+$2B0
00080086 =00080085                  MegaPCM_End:	equ	MegaPCMLibraryBlob+$2117
