0001CAC6                            HurtSonic:
0001CAC6 4A38 FE2C                  		tst.b	($FFFFFE2C).w	; does Sonic have a shield?
0001CACA 6600                       		bne.s	Hurt_Shield	; if yes, branch
0001CACC 4A78 FE20                  		tst.w	($FFFFFE20).w	; does Sonic have any rings?
0001CAD0 6700 0000                  		beq.w	Hurt_NoRings	; if not, branch
0001CAD4 4EB9 0000 EA12             		jsr	SingleObjLoad
0001CADA 6600                       		bne.s	Hurt_Shield
