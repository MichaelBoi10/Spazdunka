0001494C                            ; If you use this makes sure to search for ;Peelout in Sonic1.asm
0001494C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001494C                            
0001494C                            ;SCDPeelout:
0001494C 0828 0001 0039             		btst	#1,$39(a0)
00014952 6600                       		bne.s	SCDPeelout_Launch
00014954 0C28 0007 001C             		cmpi.b	#7,$1C(a0) ;check to see if your looking up
0001495A 6600                       		bne.s	@return
0001495C 1038 F603                  		move.b	($FFFFF603).w,d0
00014960 0200 0070                  		andi.b	#%01110000,d0
00014964 6700 0000                  		beq.w	@return
00014968 117C 0001 001C             		move.b	#1,$1C(a0)
0001496E 317C 0000 003A             		move.w	#0,$3A(a0)
00014974 303C 00D2                  		move.w	#$D2,d0
00014978 11FC 0002 D1DC                             move.b	#2,($FFFFD1DC).w
0001497E 4EB9 0000 0FF4             		jsr		(PlaySound_Special).l 	; Play peelout charge sound
00014984                            	       ;sfx 	sfx_PeeloutCharge 		; These are if you use AMPS
00014984 588F                       		addq.l	#4,sp
00014986 08E8 0001 0039             		bset	#1,$39(a0)
0001498C                            		
0001498C 4268 0014                  		clr.w	$14(a0)
00014990                             
00014990 6100 FC5E                  		bsr.w	Sonic_LevelBound
00014994 6100 0000                  		bsr.w	Sonic_AnglePos
00014998                             
00014998                            	@return:
00014998 4E75                       		rts	
0001499A                            ; ---------------------------------------------------------------------------
0001499A                             
0001499A                            SCDPeelout_Launch:
0001499A 1038 F602                  		move.b	($FFFFF602).w,d0
0001499E 0800 0000                  		btst	#0,d0
000149A2 6600 0000                  		bne.w	SCDPeelout_Charge
000149A6 08A8 0001 0039             		bclr	#1,$39(a0)	; stop Dashing
000149AC 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)	; have we been charging long enough?
000149B2 6600                       		bne.s	SCDPeelout_Stop_Sound
000149B4 117C 0000 001C             		move.b	#0,$1C(a0)	; launches here (peelout sprites)
000149BA 317C 0001 0010             		move.w	#1,$10(a0)	; force X speed to nonzero for camera lag's benefit
000149C0 3028 0014                  		move.w	$14(a0),d0
000149C4 0440 0800                  		subi.w	#$800,d0
000149C8 D040                       		add.w	d0,d0
000149CA 0240 0800                  		andi.w	#$800,d0
000149CE 4440                       		neg.w	d0
000149D0 0640 0800                  		addi.w	#$800,d0
000149D4                            		;move.w	d0,(v_cameralag).w
000149D4 0828 0000 0022             		btst	#0,$22(a0)
000149DA 6700                       		beq.s	@dontflip
000149DC 4468 0014                  		neg.w	$14(a0)
000149E0                             
000149E0                            @dontflip:
000149E0 08A8 0007 0022             		bclr	#7,$22(a0)
000149E6 303C 00D3                  		move.w	#$D3,d0
000149EA 4EB9 0000 0FF4             		jsr		(PlaySound_Special).l
000149F0                            		; sfx 	sfx_PeeloutRelease
000149F0 6000 0000                  		bra.w	SCDPeelout_ResetScr
000149F4                            ; ---------------------------------------------------------------------------
000149F4                             
000149F4                            SCDPeelout_Charge:				; If still charging the dash...
000149F4 3238 F760                  		move.w	($FFFFF760).w,d1	; get top peelout speed
000149F8 3401                       		move.w	d1,d2
000149FA D241                       		add.w	d1,d1
000149FC 4A38 FE2E                  		tst.b   ($FFFFFE2E).w 		; test for speed shoes
00014A00 6700                       		beq.s	@noshoes
00014A02 E242                       		asr.w	#1,d2
00014A04 9242                       		sub.w	d2,d1
00014A06                            
00014A06                            @noshoes:
00014A06 0668 0064 0014             		addi.w	#$64,$14(a0)		; increment speed
00014A0C B268 0014                  		cmp.w	$14(a0),d1
00014A10 6E00                       		bgt.s	@inctimer
00014A12 3141 0014                  		move.w	d1,$14(a0)
00014A16                            
00014A16                            @inctimer:
