0001528C 0000                       		dc.w SonAni_Float2-SonicAniData
0001528E 0000                       		dc.w SonAni_Spring-SonicAniData
00015290 0000                       		dc.w SonAni_LZHang-SonicAniData
00015292 0000                       		dc.w SonAni_Leap1-SonicAniData
00015294 0000                       		dc.w SonAni_Leap2-SonicAniData
00015296 0000                       		dc.w SonAni_Surf-SonicAniData
00015298 0000                       		dc.w SonAni_Bubble-SonicAniData
0001529A 0000                       		dc.w SonAni_Death1-SonicAniData
0001529C 0000                       		dc.w SonAni_Drown-SonicAniData
0001529E 0000                       		dc.w SonAni_Death2-SonicAniData
000152A0 0000                       		dc.w SonAni_Shrink-SonicAniData
000152A2 0000                       		dc.w SonAni_Hurt-SonicAniData
000152A4 0000                       		dc.w SonAni_LZSlide-SonicAniData
000152A6 0000                       		dc.w SonAni_Blank-SonicAniData
000152A8 0000                       		dc.w SonAni_Float3-SonicAniData
000152AA 0000                       		dc.w SonAni_Float4-SonicAniData
000152AC 0000                       		dc.w SonAni_Balance2-SonicAniData
