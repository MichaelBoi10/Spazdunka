0000109C                            ; ---------------------------------------------------------------------------
0000109C                            ; Subroutine to load VDP commands into the DMA transfer queue
0000109C                            ;
0000109C                            ; In case you wish to use this queue system outside of the spin dash, this is the
0000109C                            ; registers in which it expects data in:
0000109C                            ; d1.l: Address to data (In 68k address space)
0000109C                            ; d2.w: Destination in VRAM
0000109C                            ; d3.w: Length of data
0000109C                            ; ---------------------------------------------------------------------------
0000109C                            
0000109C                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000109C                            
0000109C                            
0000109C                            DMA_68KtoVRAM:
0000109C 2278 C8FC                  		movea.l	($FFFFC8FC).w,a1
000010A0 B2FC C8FC                  		cmpa.w	#$C8FC,a1	; is the DMA queue full?
000010A4 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
000010A6                            
000010A6                            		; piece together some VDP commands and store them for later...
000010A6 303C 9300                  		move.w	#$9300,d0	; command to specify DMA transfer length & $00FF
000010AA 1003                       		move.b	d3,d0
000010AC 32C0                       		move.w	d0,(a1)+	; store command
000010AE                            
000010AE 303C 9400                  		move.w	#$9400,d0	; command to specify DMA transfer length & $FF00
000010B2 E04B                       		lsr.w	#8,d3
000010B4 1003                       		move.b	d3,d0
000010B6 32C0                       		move.w	d0,(a1)+	; store command
000010B8                            
000010B8 303C 9500                  		move.w	#$9500,d0	; command to specify source address & $0001FE
000010BC E289                       		lsr.l	#1,d1
000010BE 1001                       		move.b	d1,d0
000010C0 32C0                       		move.w	d0,(a1)+	; store command
000010C2                            
000010C2 303C 9600                  		move.w	#$9600,d0	; command to specify source address & $01FE00
000010C6 E089                       		lsr.l	#8,d1
000010C8 1001                       		move.b	d1,d0
000010CA 32C0                       		move.w	d0,(a1)+	; store command
000010CC                            
000010CC 303C 9700                  		move.w	#$9700,d0	; command to specify source address & $FE0000
000010D0 E089                       		lsr.l	#8,d1
000010D2 1001                       		move.b	d1,d0
000010D4 32C0                       		move.w	d0,(a1)+	; store command
000010D6                            
000010D6 0282 0000 FFFF             		andi.l	#$FFFF,d2	; command to specify destination address and begin DMA
000010DC E58A                       		lsl.l	#2,d2
000010DE E44A                       		lsr.w	#2,d2
000010E0 4842                       		swap	d2
000010E2 0082 4000 0080             		ori.l	#$40000080,d2 ; set bits to specify VRAM transfer
000010E8 22C2                       		move.l	d2,(a1)+	; store command
000010EA                            
000010EA 21C9 C8FC                  		move.l	a1,($FFFFC8FC).w ; set the next free slot address
000010EE B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
000010F2 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
000010F4 32BC 0000                  		move.w	#0,(a1) ; put a stop token at the end of the used part of the buffer
000010F8                            
000010F8                            DMA_68KtoVRAM_Done:			; XREF: DMA_68KtoVRAM
000010F8 4E75                       		rts
000010FA                            ; End of function DMA_68KtoVRAM
000010FA                            
000010FA                            ; ---------------------------------------------------------------------------
000010FA                            ; Process all VDP commands and then reset the DMA queue when it's done
000010FA                            ; ---------------------------------------------------------------------------
000010FA                            
000010FA                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000010FA                            
000010FA                            
000010FA                            Process_DMA:
000010FA 4BF9 00C0 0004             		lea	($C00004).l,a5
00001100 43F8 C800                  		lea	($FFFFC800).w,a1
00001104                            
00001104                            Process_DMA_Loop:			; XREF: Process_DMA
00001104 3019                       		move.w	(a1)+,d0	; has a stop token been encountered?
00001106 6700                       		beq.s	Process_DMA_Done ; branch if we reached a stop token
00001108                            
00001108                            		; issue a set of VDP commands...
00001108 3A80                       		move.w	d0,(a5)		; transfer length
0000110A 3A99                       		move.w	(a1)+,(a5)	; transfer length
0000110C 3A99                       		move.w	(a1)+,(a5)	; source address
0000110E 3A99                       		move.w	(a1)+,(a5)	; source address
00001110 3A99                       		move.w	(a1)+,(a5)	; source address
00001112 3A99                       		move.w	(a1)+,(a5)	; destination
00001114 3A99                       		move.w	(a1)+,(a5)	; destination
00001116 B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
0000111A 66E8                       		bne.s	Process_DMA_Loop ; loop if we haven't reached the end of the buffer
0000111C                            
0000111C                            Process_DMA_Done:			; XREF: Process_DMA
0000111C 31FC 0000 C800             		move.w	#0,($FFFFC800).w
00001122 21FC FFFF C800 C8FC        		move.l	#$FFFFC800,($FFFFC8FC).w
0000112A 4E75                       		rts
0000112C                            ; End of function Process_DMA
0000112C                            
0000112C                            ; ---------------------------------------------------------------------------
