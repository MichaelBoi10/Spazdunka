00014A76 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014A78 0C78 0060 EED8             		cmpi.w	#$60,($FFFFEED8).w	; $EED8 only ever seems
00014A7E 6700                       		beq.s	loc2_1AD8C		; to be used in Spin Dash
00014A80 6400                       		bcc.s	loc2_1AD88
00014A82 5878 EED8                  		addq.w	#4,($FFFFEED8).w
