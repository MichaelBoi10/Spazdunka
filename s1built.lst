0001C8DA                            
0001C8DA                            Touch_ChkValue:
0001C8DA 1229 0020                  		move.b	$20(a1),d1	; load touch response number
0001C8DE 0201 00C0                  		andi.b	#$C0,d1		; is touch response $40	or higher?
0001C8E2 6700 0000                  		beq.w	Touch_Enemy	; if not, branch
0001C8E6 0C01 00C0                  		cmpi.b	#$C0,d1		; is touch response $C0	or higher?
0001C8EA 6700 0000                  		beq.w	Touch_Special	; if yes, branch
0001C8EE 4A01                       		tst.b	d1		; is touch response $80-$BF ?
0001C8F0 6B00 0000                  		bmi.w	Touch_ChkHurt	; if yes, branch
0001C8F4                            
0001C8F4                            ; touch	response is $40-$7F
0001C8F4                            
0001C8F4 1029 0020                  		move.b	$20(a1),d0
0001C8F8 0200 003F                  		andi.b	#$3F,d0
0001C8FC 0C00 0006                  		cmpi.b	#6,d0		; is touch response $46	?
0001C900 6700                       		beq.s	Touch_Monitor	; if yes, branch
0001C902 0C68 005A 0030             		cmpi.w	#$5A,$30(a0)
0001C908 6400 0000                  		bcc.w	locret_1AEF2
0001C90C 5429 0024                  		addq.b	#2,routine(a1)	; advance the object's routine counter
0001C910                            
0001C910                            locret_1AEF2:
0001C910 4E75                       		rts	
0001C912                            ; ===========================================================================
0001C912                            
0001C912                            Touch_Monitor:
0001C912 4A68 0012                  		tst.w	$12(a0)		; is Sonic moving upwards?
0001C916 6A00                       		bpl.s	loc_1AF1E	; if not, branch
0001C918 3028 000C                  		move.w	$C(a0),d0
0001C91C 0440 0010                  		subi.w	#$10,d0
0001C920 B069 000C                  		cmp.w	$C(a1),d0
0001C924 6500                       		bcs.s	locret_1AF2E
0001C926 4468 0012                  		neg.w	$12(a0)		; reverse Sonic's y-motion
0001C92A 337C FE80 0012             		move.w	#-$180,y_vel(a1)
0001C930 4A29 0025                  		tst.b	$25(a1)
0001C934 6600                       		bne.s	locret_1AF2E
0001C936 5829 0025                  		addq.b	#4,routine_secondary(a1)	; advance the monitor's routine counter
0001C93A 4E75                       		rts	
0001C93C                            ; ===========================================================================
0001C93C                            
0001C93C                            loc_1AF1E:
0001C93C 0C28 0002 001C             		cmpi.b	#2,anim(a0)	; is Sonic rolling/jumping?
0001C942 6600                       		bne.s	locret_1AF2E
0001C944 4468 0012                  		neg.w	$12(a0)		; reverse Sonic's y-motion
0001C948 5429 0024                  		addq.b	#2,routine(a1)	; advance the monitor's routine counter
0001C94C                            
0001C94C                            locret_1AF2E:
0001C94C 4E75                       		rts	
0001C94E                            ; ===========================================================================
0001C94E                            
0001C94E                            Touch_Enemy:				; XREF: Touch_ChkValue
0001C94E 4A38 FE2D                  		tst.b	($FFFFFE2D).w	; is Sonic invincible?
0001C952 6600                       		bne.s	loc_1AF40	; if yes, branch
0001C954 0C28 0009 001C             		cmpi.b	#9,anim(a0)	; is Sonic Spin Dashing?
0001C95A 6700 0000                  		beq.w	loc_1AF40	; if yes, branch
0001C95E 0C28 0002 001C             		cmpi.b	#2,anim(a0)	; is Sonic rolling?
0001C964 6600 0000                  		bne.w	Touch_ChkHurt	; if not, branch
