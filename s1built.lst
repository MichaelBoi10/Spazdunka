000152BC 1228 0022                  		move.b	$22(a0),d1
000152C0 0201 0001                  		andi.b	#1,d1
000152C4 0228 00FC 0001             		andi.b	#$FC,1(a0)
000152CA 8328 0001                  		or.b	d1,1(a0)
000152CE 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000152D2 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000152D4 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000152D8                            
000152D8                            SAnim_Do2:
