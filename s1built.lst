0001481A 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
00014820 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
00014826 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
0001482C 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
00014832 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014838 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
0001483E 303C 00D4                  	move.w	#$D4,d0         ; 
00014842 4EB9 0000 0FF4             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
00014848 303C 0087                  	move.w	#$87,d0
0001484C 4EF9 0000 0FEE             	jmp	(PlaySound).l	; Play the super theme
00014852                            
00014852                            return2_1ABA4
00014852 4E75                       	rts
00014854                            ; End of subroutine Sonic_ChkSuper_SMonitor
