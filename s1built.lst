000150D4 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
000150D8 9200                       		sub.b	d0,d1
000150DA 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
000150DE 60D2                       		bra.s	SAnim_Next
