000150B0                            ; Subroutine to	animate	Sonic's sprites
000150B0                            ; ---------------------------------------------------------------------------
000150B0                            
000150B0                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000150B0                            
000150B0                            
000150B0                            Sonic_Animate:				; XREF: Obj01_Control; et al
000150B0 43F9 0000 0000             		lea	(SonicAniData).l,a1
000150B6 7000                       		moveq	#0,d0
000150B8 1028 001C                  		move.b	$1C(a0),d0
000150BC B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
000150C0 6700                       		beq.s	SAnim_Do	; if not, branch
000150C2 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000150C6 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000150CC 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000150D2                            
000150D2                            SAnim_Do:
000150D2 D040                       		add.w	d0,d0
000150D4 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000150D8 1011                       		move.b	(a1),d0
000150DA 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000150DC 1228 0022                  		move.b	$22(a0),d1
000150E0 0201 0001                  		andi.b	#1,d1
000150E4 0228 00FC 0001             		andi.b	#$FC,1(a0)
000150EA 8328 0001                  		or.b	d1,1(a0)
000150EE 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150F2 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000150F4 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000150F8                            
000150F8                            SAnim_Do2:
000150F8 7200                       		moveq	#0,d1
000150FA 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000150FE 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00015102 0C00 00FD                  		cmp.b	#$FD,d0					; MJ: is it a flag from FD to FF?
00015106 6400 0000                  		bhs	SAnim_End_FF				; MJ: if so, branch to flag routines
0001510A                            
0001510A                            SAnim_Next:
0001510A 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
0001510E 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00015112                            
00015112                            SAnim_Delay:
00015112 4E75                       		rts	
00015114                            ; ===========================================================================
00015114                            
00015114                            SAnim_End_FF:
00015114 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00015116 6600                       		bne.s	SAnim_End_FE	; if not, branch
00015118 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
0001511E 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015122 60E6                       		bra.s	SAnim_Next
00015124                            ; ===========================================================================
00015124                            
00015124                            SAnim_End_FE:
00015124 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00015126 6600                       		bne.s	SAnim_End_FD	; if not, branch
00015128 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0001512C 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015130 9200                       		sub.b	d0,d1
00015132 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015136 60D2                       		bra.s	SAnim_Next
00015138                            ; ===========================================================================
00015138                            
00015138                            SAnim_End_FD:
00015138 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0001513A 6600                       		bne.s	SAnim_End	; if not, branch
0001513C 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015142                            
00015142                            SAnim_End:
00015142 4E75                       		rts	
00015144                            ; ===========================================================================
00015144                            
00015144                            SAnim_WalkRun:				; XREF: SAnim_Do
00015144 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015148 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
0001514A 5200                       		addq.b	#1,d0		; is animation walking/running?
0001514C 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015150 7200                       		moveq	#0,d1
00015152 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015156 1428 0022                  		move.b	$22(a0),d2
0001515A 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
0001515E 6600                       		bne.s	loc_13A70	; if yes, branch
00015160 4600                       		not.b	d0		; reverse angle
00015162                            
00015162                            loc_13A70:
00015162 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015166 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015168 7203                       		moveq	#3,d1
0001516A                            
0001516A                            loc_13A78:
0001516A 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015170 B302                       		eor.b	d1,d2
00015172 8528 0001                  		or.b	d2,1(a0)
00015176 0828 0005 0022             		btst	#5,$22(a0)
0001517C 6600 0000                  		bne.w	SAnim_Push
00015180 E808                       		lsr.b	#4,d0		; divide angle by $10
00015182 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015186 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
0001518A 6A00                       		bpl.s	loc_13A9C
0001518C 4442                       		neg.w	d2
0001518E                            
0001518E                            loc_13A9C:
0001518E 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00015194 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015198 6400                       		bcc.s	loc_13AB4	; if yes, branch
0001519A 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000151A0 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000151A4 6400                       		bcc.s	loc_13AB4	; if yes, branch
000151A6 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000151AC 1200                       		move.b	d0,d1
000151AE E209                       		lsr.b	#1,d1
000151B0 D001                       		add.b	d1,d0
000151B2                            
000151B2                            loc_13AB4:
000151B2 D000                       		add.b	d0,d0
000151B4 1600                       		move.b	d0,d3
000151B6 4442                       		neg.w	d2
000151B8 0642 0800                  		addi.w	#$800,d2
000151BC 6A00                       		bpl.s	loc_13AC2
000151BE 7400                       		moveq	#0,d2
000151C0                            
000151C0                            loc_13AC2:
000151C0 E04A                       		lsr.w	#8,d2
000151C2 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151C6 6100 FF30                  		bsr.w	SAnim_Do2
000151CA D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000151CE 4E75                       		rts	
000151D0                            ; ===========================================================================
000151D0                            
000151D0                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000151D0 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000151D2 6600                       		bne.s	SAnim_Push	; if not, branch
000151D4 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000151D8 6A00                       		bpl.s	loc_13ADE
000151DA 4442                       		neg.w	d2
000151DC                            
000151DC                            loc_13ADE:
000151DC 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000151E2 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000151E6 6400                       		bcc.s	loc_13AF0	; if yes, branch
000151E8 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000151EE                            
000151EE                            loc_13AF0:
000151EE 4442                       		neg.w	d2
000151F0 0642 0400                  		addi.w	#$400,d2
000151F4 6A00                       		bpl.s	loc_13AFA
000151F6 7400                       		moveq	#0,d2
000151F8                            
000151F8                            loc_13AFA:
000151F8 E04A                       		lsr.w	#8,d2
000151FA 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151FE 1228 0022                  		move.b	$22(a0),d1
00015202 0201 0001                  		andi.b	#1,d1
00015206 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001520C 8328 0001                  		or.b	d1,1(a0)
00015210 6000 FEE6                  		bra.w	SAnim_Do2
00015214                            ; ===========================================================================
00015214                            
00015214                            SAnim_Push:				; XREF: SAnim_RollJump
00015214 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015218 6B00                       		bmi.s	loc_13B1E
0001521A 4442                       		neg.w	d2
0001521C                            
0001521C                            loc_13B1E:
0001521C 0642 0800                  		addi.w	#$800,d2
00015220 6A00                       		bpl.s	loc_13B26
00015222 7400                       		moveq	#0,d2
00015224                            
00015224                            loc_13B26:
00015224 EC4A                       		lsr.w	#6,d2
00015226 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001522A 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00015230 1228 0022                  		move.b	$22(a0),d1
00015234 0201 0001                  		andi.b	#1,d1
00015238 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001523E 8328 0001                  		or.b	d1,1(a0)
00015242 6000 FEB4                  		bra.w	SAnim_Do2
00015246                            ; End of function Sonic_Animate
