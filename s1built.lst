00014A22 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)
00014A28 6500                       		bcs.s	SCDPeelout_ResetScr
00014A2A 117C 001E 003A             		move.b	#$1E,$3A(a0)
00014A30 4EF9 0000 0000             		jmp 	SCDPeelout_ResetScr
00014A36                            		
