00081EEE                            ; ------------------------------------------------------------------------------
00081EEE                            ; Sets volume for SFX samples (added with FLAGS_SFX)
00081EEE                            ; ------------------------------------------------------------------------------
00081EEE                            ; INPUT:
00081EEE                            ;		d0	 .b		volume level (0 = max .. $F = min)
00081EEE                            ; ------------------------------------------------------------------------------
