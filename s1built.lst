0000DC10                            ; Spikes types $1x and $5x face	sideways
0000DC10                            
0000DC10                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DC10 323C 001B                  		move.w	#$1B,d1
0000DC14 3602                       		move.w	d2,d3
0000DC16 5243                       		addq.w	#1,d3
0000DC18 3828 0008                  		move.w	8(a0),d4
0000DC1C 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DC20 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DC24 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DC28 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DC2C 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DC32 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DC34 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DC36 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DC38 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DC3A 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DC3C                            ; ===========================================================================
0000DC3C                            
0000DC3C                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DC3C                            
0000DC3C                            Obj36_Upright:				; XREF: Obj36_Solid
0000DC3C 7200                       		moveq	#0,d1
0000DC3E 1228 0019                  		move.b	$19(a0),d1
0000DC42 0641 000B                  		addi.w	#$B,d1
0000DC46 343C 0010                  		move.w	#$10,d2
0000DC4A 363C 0011                  		move.w	#$11,d3
0000DC4E 3828 0008                  		move.w	8(a0),d4
0000DC52 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DC56 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DC5C 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DC5E 4A44                       		tst.w	d4			; check response value from SolidObject
0000DC60 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DC62 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DC66 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DC6A 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DC70 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DC72 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DC74 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DC76 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DC78                            		; otherwise, fall through to Spik_Hurt
0000DC78                            
0000DC78                            Obj36_Hurt:				; XREF: Obj36_SideWays; Obj36_Upright
0000DC78 4A38 FE2D                  		tst.b	($FFFFFE2D).w	; is Sonic invincible?
0000DC7C 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DC7E 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DC82 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
0000DC84 2F08                       		move.l	a0,-(sp)
0000DC86 2448                       		movea.l	a0,a2
