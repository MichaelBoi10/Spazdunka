00078D02                            ; ------------------------------------------------------------------------------
00078D02                            ; Plays a given sample
00078D02                            ; ------------------------------------------------------------------------------
00078D02                            ; INPUT:
00078D02                            ;		d0	.b		sample id (>$81)
00078D02                            ;
00078D02                            ; EXAMPLES:
00078D02                            ;		move.b	#$81, d0
00078D02                            ;		jsr		MegaPCM_PlaySample
00078D02                            ;
00078D02                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00078D02                            ;		jsr		MegaPCM_PlaySample
00078D02                            ; ------------------------------------------------------------------------------
00078D02                            
00078D02                            MegaPCM_PlaySample:
00078D02                            	MPCM_play	d0
00078D02                          M 	mpcm_stopz80
00078D02                          M 	pusho
00078D02                          M 	opt	l-
00078D02 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00078D0A                          M 	@wait_2:
00078D0A 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00078D12 66F6                     M 	bne.s	@wait_2
00078D14                          M 	popo
00078D14 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00078D1A                          M 	mpcm_startz80
00078D1A 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00078D22 4E75                       	rts
00078D24                            
