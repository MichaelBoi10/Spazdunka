00005BB4 5278 FFF4                  		addq.w	#1,($FFFFFFF4).w
00005BB8 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	credits	finished?
00005BBE 6400                       		bcc.s	EndDemo_Exit	; if yes, branch
00005BC0 31FC 8001 FFF0             		move.w	#$8001,($FFFFFFF0).w ; force demo mode
00005BC6 11FC 0008 F600             		move.b	#8,($FFFFF600).w ; set game mode to 08 (demo)
00005BCC 11FC 0003 FE12             		move.b	#3,($FFFFFE12).w ; set lives to	3
00005BD2 7000                       		moveq	#0,d0
