000150E2                            SAnim_WalkRun:				; XREF: SAnim_Do
000150E2 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150E6 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
000150E8 5200                       		addq.b	#1,d0		; is animation walking/running?
000150EA 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
000150EE 7200                       		moveq	#0,d1
000150F0 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
000150F4 1428 0022                  		move.b	$22(a0),d2
000150F8 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
000150FC 6600                       		bne.s	loc_13A70	; if yes, branch
000150FE 4600                       		not.b	d0		; reverse angle
00015100                            
00015100                            loc_13A70:
00015100 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015104 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015106 7203                       		moveq	#3,d1
00015108                            
00015108                            loc_13A78:
00015108 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001510E B302                       		eor.b	d1,d2
00015110 8528 0001                  		or.b	d2,1(a0)
00015114 0828 0005 0022             		btst	#5,$22(a0)
0001511A 6600 0000                  		bne.w	SAnim_Push
0001511E E808                       		lsr.b	#4,d0		; divide angle by $10
00015120 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015124 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015128 6A00                       		bpl.s	loc_13A9C
0001512A 4442                       		neg.w	d2
0001512C                            
0001512C                            loc_13A9C:
0001512C 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015130 6700                       		beq.s	Loc_NotSuper
00015132 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
00015138 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
0001513C 6400                       		bhs.s	SuperRun	; if yes, branch
0001513E 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
00015144 6000                       		bra.s	SuperWalk
00015146                            
00015146                            Loc_NotSuper:
