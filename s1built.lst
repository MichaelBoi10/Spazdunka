0001CA20                            HurtSonic:
0001CA20 4A38 FE2C                  		tst.b	($FFFFFE2C).w	; does Sonic have a shield?
0001CA24 6600                       		bne.s	Hurt_Shield	; if yes, branch
0001CA26 4A78 FE20                  		tst.w	($FFFFFE20).w	; does Sonic have any rings?
0001CA2A 6700 0000                  		beq.w	Hurt_NoRings	; if not, branch
0001CA2E 4EB9 0000 E7B0             		jsr	SingleObjLoad
0001CA34 6600                       		bne.s	Hurt_Shield
