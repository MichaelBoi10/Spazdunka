000DC652                            ; [ In�cio ]
000DC652                            ;
000DC652                            ; O c�digo deste menu foi desenvolvido para funcionar com
000DC652                            ; o disassembly do Sonic 1 feito por -> drx (www.hacking-cult.org)
000DC652                            ; 
