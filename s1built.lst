00005C38                            Cred_WaitLoop:
00005C38 11FC 0004 F62A             		move.b	#4,($FFFFF62A).w
00005C3E 6100 CD90                  		bsr.w	DelayProgram
00005C42 6100 B690                  		bsr.w	RunPLC_RAM
00005C46 4A78 F614                  		tst.w	($FFFFF614).w	; have 2 seconds elapsed?
00005C4A 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005C4C 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005C50 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005C52 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
00005C58 6700 0000                  		beq.w	TryAgainEnd	; if yes, branch
00005C5C 4E75                       		rts	
