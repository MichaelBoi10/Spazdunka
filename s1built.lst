00082148                            
00082148                            
00082148                            ; ------------------------------------------------------------------------------
00082148                            ; Plays a given sample
00082148                            ; ------------------------------------------------------------------------------
00082148                            ; INPUT:
00082148                            ;		d0	.b		sample id (>$81)
00082148                            ;
00082148                            ; EXAMPLES:
00082148                            ;		move.b	#$81, d0
00082148                            ;		jsr		MegaPCM_PlaySample
00082148                            ;
00082148                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00082148                            ;		jsr		MegaPCM_PlaySample
00082148                            ; ------------------------------------------------------------------------------
00082148                            
00082148                            MegaPCM_PlaySample:
00082148                            	MPCM_play	d0
00082148                          M 	mpcm_stopz80
00082148                          M 	pusho
00082148                          M 	opt	l-
00082148 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00082150                          M 	@wait_11:
00082150 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00082158 66F6                     M 	bne.s	@wait_11
0008215A                          M 	popo
0008215A 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00082160                          M 	mpcm_startz80
00082160 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00082168 4E75                       	rts
0008216A                            
0008216A                            ; ------------------------------------------------------------------------------
0008216A                            ; Pauses current sample playback
