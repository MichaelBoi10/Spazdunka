0007FFC2                            ; ------------------------------------------------------------------------------
0007FFC2                            ; Exported symbols
0007FFC2                            ; ------------------------------------------------------------------------------
0007FFC2                            
0007FFC2 =0007DEAA                  MegaPCM_LoadDriver:	equ	MegaPCMLibraryBlob+$0
0007FFC2 =0007DF14                  MegaPCM_LoadSampleTable:	equ	MegaPCMLibraryBlob+$6A
0007FFC2 =0007E15A                  MegaPCM:	equ	MegaPCMLibraryBlob+$2B0
0007FFC2 =0007FFC1                  MegaPCM_End:	equ	MegaPCMLibraryBlob+$2117
0007FFC2                            
0007FFC2                            
0007FFC2                            ; ==============================================================================
0007FFC2                            ; ------------------------------------------------------------------------------
0007FFC2                            ; Mega PCM API Routines
0007FFC2                            ; ------------------------------------------------------------------------------
0007FFC2                            
0007FFC2                            
0007FFC2                            ; ------------------------------------------------------------------------------
0007FFC2                            ; Plays a given sample
0007FFC2                            ; ------------------------------------------------------------------------------
0007FFC2                            ; INPUT:
0007FFC2                            ;		d0	.b		sample id (>$81)
0007FFC2                            ;
0007FFC2                            ; EXAMPLES:
0007FFC2                            ;		move.b	#$81, d0
0007FFC2                            ;		jsr		MegaPCM_PlaySample
0007FFC2                            ;
0007FFC2                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
0007FFC2                            ;		jsr		MegaPCM_PlaySample
0007FFC2                            ; ------------------------------------------------------------------------------
0007FFC2                            
0007FFC2                            MegaPCM_PlaySample:
0007FFC2                            	MPCM_play	d0
0007FFC2                          M 	mpcm_stopz80
0007FFC2                          M 	pusho
0007FFC2                          M 	opt	l-
0007FFC2 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FFCA                          M 	@wait_5:
0007FFCA 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FFD2 66F6                     M 	bne.s	@wait_5
0007FFD4                          M 	popo
0007FFD4 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0007FFDA                          M 	mpcm_startz80
0007FFDA 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0007FFE2 4E75                       	rts
0007FFE4                            
0007FFE4                            ; ------------------------------------------------------------------------------
0007FFE4                            ; Pauses current sample playback
0007FFE4                            ; ------------------------------------------------------------------------------
0007FFE4                            
0007FFE4                            MegaPCM_PausePlayback:
0007FFE4                            	MPCM_pause
0007FFE4                          M 	mpcm_stopz80
0007FFE4                          M 	pusho
0007FFE4                          M 	opt	l-
0007FFE4 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007FFEC                          M 	@wait_8:
0007FFEC 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
0007FFF4 66F6                     M 	bne.s	@wait_8
0007FFF6                          M 	popo
0007FFF6 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
0007FFFE                          M 	mpcm_startz80
0007FFFE 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00080006 4E75                       	rts
00080008                            
00080008                            ; ------------------------------------------------------------------------------
