000146CE 6600                       	bne.s	return_1ABA4		; if not, branch
000146D0 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
000146D6 6500                       	bcs.s	return_1ABA4		; if not, branch
000146D8                            
000146D8 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
