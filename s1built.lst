00014FEE                            
00014FEE                            Obj01_ResetLevel:			; XREF: Obj01_Index
00014FEE 4A68 003A                  		tst.w	$3A(a0)
00014FF2 6700                       		beq.s	locret_13914
00014FF4 5368 003A                  		subq.w	#1,$3A(a0)	; subtract 1 from time delay
00014FF8 6600                       		bne.s	locret_13914
00014FFA 31FC 0001 FE02             		move.w	#1,($FFFFFE02).w ; restart the level
00015000                            
00015000                            locret_13914:
