00014EA0 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00014EA6 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00014EAC                            
00014EAC                            SAnim_Do:
00014EAC D040                       		add.w	d0,d0
00014EAE D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00014EB2 1011                       		move.b	(a1),d0
00014EB4 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00014EB6 1228 0022                  		move.b	$22(a0),d1
00014EBA 0201 0001                  		andi.b	#1,d1
00014EBE 0228 00FC 0001             		andi.b	#$FC,1(a0)
00014EC4 8328 0001                  		or.b	d1,1(a0)
00014EC8 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00014ECC 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00014ECE 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00014ED2                            
00014ED2                            SAnim_Do2:
00014ED2 7200                       		moveq	#0,d1
00014ED4 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
00014ED8 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00014EDC 6B00                       		bmi.s	SAnim_End_FF	; if animation is complete, branch
00014EDE                            
00014EDE                            SAnim_Next:
00014EDE 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00014EE2 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00014EE6                            
00014EE6                            SAnim_Delay:
00014EE6 4E75                       		rts	
00014EE8                            ; ===========================================================================
00014EE8                            
00014EE8                            SAnim_End_FF:
00014EE8 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00014EEA 6600                       		bne.s	SAnim_End_FE	; if not, branch
00014EEC 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00014EF2 1029 0001                  		move.b	1(a1),d0	; read sprite number
00014EF6 60E6                       		bra.s	SAnim_Next
00014EF8                            ; ===========================================================================
00014EF8                            
00014EF8                            SAnim_End_FE:
00014EF8 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00014EFA 6600                       		bne.s	SAnim_End_FD	; if not, branch
00014EFC 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00014F00 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00014F04 9200                       		sub.b	d0,d1
00014F06 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00014F0A 60D2                       		bra.s	SAnim_Next
00014F0C                            ; ===========================================================================
00014F0C                            
00014F0C                            SAnim_End_FD:
00014F0C 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00014F0E 6600                       		bne.s	SAnim_End	; if not, branch
00014F10 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00014F16                            
00014F16                            SAnim_End:
00014F16 4E75                       		rts	
00014F18                            ; ===========================================================================
00014F18                            
00014F18                            SAnim_WalkRun:				; XREF: SAnim_Do
00014F18 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00014F1C 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00014F1E 5200                       		addq.b	#1,d0		; is animation walking/running?
00014F20 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00014F24 7200                       		moveq	#0,d1
00014F26 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00014F2A 1428 0022                  		move.b	$22(a0),d2
00014F2E 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00014F32 6600                       		bne.s	loc_13A70	; if yes, branch
00014F34 4600                       		not.b	d0		; reverse angle
00014F36                            
00014F36                            loc_13A70:
00014F36 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00014F3A 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00014F3C 7203                       		moveq	#3,d1
00014F3E                            
00014F3E                            loc_13A78:
00014F3E 0228 00FC 0001             		andi.b	#$FC,1(a0)
00014F44 B302                       		eor.b	d1,d2
00014F46 8528 0001                  		or.b	d2,1(a0)
00014F4A 0828 0005 0022             		btst	#5,$22(a0)
00014F50 6600 0000                  		bne.w	SAnim_Push
00014F54 E808                       		lsr.b	#4,d0		; divide angle by $10
00014F56 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00014F5A 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00014F5E 6A00                       		bpl.s	loc_13A9C
00014F60 4442                       		neg.w	d2
00014F62                            
00014F62                            loc_13A9C:
00014F62 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00014F68 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00014F6C 6400                       		bcc.s	loc_13AB4	; if yes, branch
00014F6E 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
00014F74 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00014F78 6400                       		bcc.s	loc_13AB4	; if yes, branch
00014F7A 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00014F80 1200                       		move.b	d0,d1
00014F82 E209                       		lsr.b	#1,d1
00014F84 D001                       		add.b	d1,d0
00014F86                            
00014F86                            loc_13AB4:
00014F86 D000                       		add.b	d0,d0
00014F88 1600                       		move.b	d0,d3
00014F8A 4442                       		neg.w	d2
00014F8C 0642 0800                  		addi.w	#$800,d2
00014F90 6A00                       		bpl.s	loc_13AC2
00014F92 7400                       		moveq	#0,d2
00014F94                            
00014F94                            loc_13AC2:
00014F94 E04A                       		lsr.w	#8,d2
00014F96 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00014F9A 6100 FF36                  		bsr.w	SAnim_Do2
00014F9E D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
00014FA2 4E75                       		rts	
00014FA4                            ; ===========================================================================
00014FA4                            
