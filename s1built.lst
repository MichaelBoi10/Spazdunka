000151A4 7003                       		moveq	#3,d0
000151A6 4EF9 0000 126C             		jmp	(LoadPLC).l	; load game over patterns
000151AC                            ; ===========================================================================
000151AC                            
000151AC                            loc_138D4:
000151AC 317C 003C 003A             		move.w	#60,$3A(a0)	; set time delay to 1 second
000151B2 4A38 FE1A                  		tst.b	($FFFFFE1A).w	; is TIME OVER tag set?
000151B6 6700                       		beq.s	locret_13900	; if not, branch
000151B8 317C 0000 003A             		move.w	#0,$3A(a0)
000151BE 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load TIME object
000151C4 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
000151CA 11FC 0002 D09A             		move.b	#2,($FFFFD09A).w
000151D0 11FC 0003 D0DA             		move.b	#3,($FFFFD0DA).w
000151D6 60C6                       		bra.s	loc_138C2
000151D8                            ; ===========================================================================
000151D8                            
000151D8                            locret_13900:
