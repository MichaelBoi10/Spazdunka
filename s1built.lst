00081F10                            ; ------------------------------------------------------------------------------
00081F10                            ; INPUT:
00081F10                            ;		d0	.b		sample pitch (0 = 0% base rate .. $FF = 100% base rate)
00081F10                            ; ------------------------------------------------------------------------------
00081F10                            
00081F10                            MegaPCM_SetActiveSamplePitch:
00081F10                            	MPCM_setPitch	d0
00081F10                          M 	mpcm_stopz80
00081F10                          M 	pusho
00081F10                          M 	opt	l-
