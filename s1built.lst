0001529C                            ; ---------------------------------------------------------------------------
0001529C                            ; Subroutine to	animate	Sonic's sprites
0001529C                            ; ---------------------------------------------------------------------------
0001529C                            
0001529C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001529C                            
0001529C                            
0001529C                            Sonic_Animate:				; XREF: Obj01_Control; et al
0001529C 43F9 0000 0000             		lea	(SonicAniData).l,a1
000152A2 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
000152A6 6700                       		beq.s	SAnim_NotSuper
000152A8 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
000152AE                            
000152AE                            SAnim_NotSuper:		
000152AE 7000                       		moveq	#0,d0
000152B0 1028 001C                  		move.b	$1C(a0),d0
000152B4 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
000152B8 6700                       		beq.s	SAnim_Do	; if not, branch
000152BA 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000152BE 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000152C4 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000152CA                            
000152CA                            SAnim_Do:
000152CA D040                       		add.w	d0,d0
000152CC D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000152D0 1011                       		move.b	(a1),d0
000152D2 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000152D4 1228 0022                  		move.b	$22(a0),d1
000152D8 0201 0001                  		andi.b	#1,d1
000152DC 0228 00FC 0001             		andi.b	#$FC,1(a0)
000152E2 8328 0001                  		or.b	d1,1(a0)
000152E6 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000152EA 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000152EC 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000152F0                            
000152F0                            SAnim_Do2:
000152F0 7200                       		moveq	#0,d1
000152F2 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000152F6 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000152FA 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000152FE 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
00015300                            
00015300                            SAnim_Next:
00015300 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00015304 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00015308                            
00015308                            SAnim_Delay:
00015308 4E75                       		rts	
0001530A                            ; ===========================================================================
0001530A                            
0001530A                            SAnim_End_FF:
0001530A 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0001530C 6600                       		bne.s	SAnim_End_FE	; if not, branch
0001530E 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015314 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015318 60E6                       		bra.s	SAnim_Next
0001531A                            ; ===========================================================================
0001531A                            
0001531A                            SAnim_End_FE:
0001531A 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0001531C 6600                       		bne.s	SAnim_End_FD	; if not, branch
0001531E 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015322 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015326 9200                       		sub.b	d0,d1
00015328 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0001532C 60D2                       		bra.s	SAnim_Next
0001532E                            ; ===========================================================================
0001532E                            
0001532E                            SAnim_End_FD:
0001532E 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015330 6600                       		bne.s	SAnim_End	; if not, branch
00015332 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015338                            
00015338                            SAnim_End:
00015338 4E75                       		rts	
0001533A                            ; ===========================================================================
0001533A                            
0001533A                            SAnim_WalkRun:				; XREF: SAnim_Do
0001533A 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
0001533E 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015340 5200                       		addq.b	#1,d0		; is animation walking/running?
00015342 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015346 7200                       		moveq	#0,d1
00015348 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
0001534C 1428 0022                  		move.b	$22(a0),d2
00015350 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015354 6600                       		bne.s	loc_13A70	; if yes, branch
00015356 4600                       		not.b	d0		; reverse angle
00015358                            
00015358                            loc_13A70:
00015358 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
0001535C 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001535E 7203                       		moveq	#3,d1
00015360                            
00015360                            loc_13A78:
00015360 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015366 B302                       		eor.b	d1,d2
00015368 8528 0001                  		or.b	d2,1(a0)
0001536C 0828 0005 0022             		btst	#5,$22(a0)
00015372 6600 0000                  		bne.w	SAnim_Push
00015376 E808                       		lsr.b	#4,d0		; divide angle by $10
00015378 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
0001537C 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015380 6A00                       		bpl.s	loc_13A9C
00015382 4442                       		neg.w	d2
00015384                            
00015384                            loc_13A9C:
00015384 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015388 6700                       		beq.s	Loc_NotSuper
0001538A 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
00015390 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015394 6400                       		bhs.s	SuperRun	; if yes, branch
00015396 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
0001539C 6000                       		bra.s	SuperWalk
0001539E                            
0001539E                            Loc_NotSuper:
0001539E 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
000153A4 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000153A8 6400                       		bhs.s	loc_13AB4	; if yes, branch
000153AA 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000153B0 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000153B4 6400                       		bhs.s	loc_13AB4	; if yes, branch
000153B6 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000153BC                            
000153BC                            SuperWalk:
000153BC 1200                       		move.b	d0,d1
000153BE E209                       		lsr.b	#1,d1
000153C0 D001                       		add.b	d1,d0
000153C2                            
000153C2                            loc_13AB4:
000153C2 D000                       		add.b	d0,d0
000153C4                            
000153C4                            SuperRun:
000153C4 1600                       		move.b	d0,d3
000153C6 4442                       		neg.w	d2
000153C8 0642 0800                  		addi.w	#$800,d2
000153CC 6A00                       		bpl.s	loc_13AC2
000153CE 7400                       		moveq	#0,d2
000153D0                            
000153D0                            loc_13AC2:
000153D0 E04A                       		lsr.w	#8,d2
000153D2 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000153D6 6100 FF18                  		bsr.w	SAnim_Do2
000153DA D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000153DE 4E75                       		rts	
000153E0                            ; ===========================================================================
000153E0                            
000153E0                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000153E0 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000153E2 6600                       		bne.s	SAnim_Push	; if not, branch
000153E4 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000153E8 6A00                       		bpl.s	loc_13ADE
000153EA 4442                       		neg.w	d2
000153EC                            
000153EC                            loc_13ADE:
000153EC 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000153F2 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000153F6 6400                       		bcc.s	loc_13AF0	; if yes, branch
000153F8 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000153FE                            
000153FE                            loc_13AF0:
000153FE 4442                       		neg.w	d2
00015400 0642 0400                  		addi.w	#$400,d2
00015404 6A00                       		bpl.s	loc_13AFA
00015406 7400                       		moveq	#0,d2
00015408                            
00015408                            loc_13AFA:
00015408 E04A                       		lsr.w	#8,d2
0001540A 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001540E 1228 0022                  		move.b	$22(a0),d1
00015412 0201 0001                  		andi.b	#1,d1
00015416 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001541C 8328 0001                  		or.b	d1,1(a0)
00015420 6000 FECE                  		bra.w	SAnim_Do2
00015424                            ; ===========================================================================
00015424                            
00015424                            SAnim_Push:				; XREF: SAnim_RollJump
00015424 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015428 6B00                       		bmi.s	loc_13B1E
0001542A 4442                       		neg.w	d2
0001542C                            
0001542C                            loc_13B1E:
0001542C 0642 0800                  		addi.w	#$800,d2
00015430 6A00                       		bpl.s	loc_13B26
00015432 7400                       		moveq	#0,d2
00015434                            
00015434                            loc_13B26:
00015434 EC4A                       		lsr.w	#6,d2
00015436 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001543A 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00015440 1228 0022                  		move.b	$22(a0),d1
00015444 0201 0001                  		andi.b	#1,d1
00015448 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001544E 8328 0001                  		or.b	d1,1(a0)
00015452 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015456 6700                       		beq.s	Loc_NotSuper2
00015458 43F9 0000 0000             		lea	(SupSonAni_Push).l,a1 ; use	running	animation
0001545E                            
0001545E                            Loc_NotSuper2:
0001545E 6000 FE90                  		bra.w	SAnim_Do2
