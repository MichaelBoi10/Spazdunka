0001485C                            Sonic_ChkSuper_SMonitor:
0001485C 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014860 6600                       	bne.s	return2_1ABA4		; if yes, branch
00014862 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014868 6500                       	bcs.s	return2_1ABA4		; if not, branch
0001486A                            
0001486A 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014870 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
