0000B3AA                            ; ---------------------------------------------------------------------------
0000B3AA                            ; Subroutine to	animate	a sprite using an animation script
0000B3AA                            ; ---------------------------------------------------------------------------
0000B3AA                            
0000B3AA                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B3AA                            
0000B3AA                            
0000B3AA                            AnimateSprite:
0000B3AA 7000                       		moveq	#0,d0
0000B3AC 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B3B0 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B3B4 6700                       		beq.s	Anim_Run	; if not, branch
0000B3B6 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B3BA 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B3C0 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B3C6                            
0000B3C6                            Anim_Run:
0000B3C6 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B3CA 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B3CC D040                       		add.w	d0,d0
0000B3CE D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B3D2 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B3D6 7200                       		moveq	#0,d1
0000B3D8 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B3DC 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B3E0 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B3E2                            
0000B3E2                            Anim_Next:
0000B3E2 1200                       		move.b	d0,d1
0000B3E4 0200 001F                  		andi.b	#$1F,d0
0000B3E8 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B3EC 1028 0022                  		move.b	$22(a0),d0
0000B3F0 E719                       		rol.b	#3,d1
0000B3F2 B101                       		eor.b	d0,d1
0000B3F4 0201 0003                  		andi.b	#3,d1
0000B3F8 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B3FE 8328 0001                  		or.b	d1,render_flags(a0)
0000B402 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B406                            
0000B406                            Anim_Wait:
0000B406 4E75                       		rts	
0000B408                            ; ===========================================================================
0000B408                            
0000B408                            Anim_End_FF:
0000B408 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B40A 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B40C 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B412 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B416 60CA                       		bra.s	Anim_Next
0000B418                            ; ===========================================================================
0000B418                            
0000B418                            Anim_End_FE:
0000B418 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B41A 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B41C 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B420 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B424 9200                       		sub.b	d0,d1
0000B426 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B42A 60B6                       		bra.s	Anim_Next
0000B42C                            ; ===========================================================================
0000B42C                            
0000B42C                            Anim_End_FD:
0000B42C 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B42E 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B430 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B436                            
0000B436                            Anim_End_FC:
0000B436 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B438 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B43A 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B43E                            
0000B43E                            Anim_End_FB:
0000B43E 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B440 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B442 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B448 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B44C                            
0000B44C                            Anim_End_FA:
0000B44C 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B44E 6600                       		bne.s	Anim_End	; if not, branch
0000B450 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B454                            
0000B454                            Anim_End:
0000B454 4E75                       		rts	
0000B456                            ; End of function AnimateSprite
