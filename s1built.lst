00081CAE                          M 	@wait_14:
00081CAE 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081CB6 66F6                     M 	bne.s	@wait_14
00081CB8                          M 	popo
00081CB8 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00081CC0                          M 	mpcm_startz80
00081CC0 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081CC8 4E75                       	rts
