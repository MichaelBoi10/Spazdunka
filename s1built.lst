00014F6E                            GameOver:				; XREF: Obj01_Death
00014F6E 3038 F704                  		move.w	($FFFFF704).w,d0
00014F72 0640 0100                  		addi.w	#$100,d0
00014F76 B068 000C                  		cmp.w	$C(a0),d0
00014F7A 6C00 0000                  		bge.w	locret_13900
00014F7E 317C FFC8 0012             		move.w	#-$38,y_vel(a0)
00014F84 5428 0024                  		addq.b	#2,routine(a0)
00014F88 4238 FE1E                  		clr.b	($FFFFFE1E).w	; stop time counter
00014F8C 5238 FE1C                  		addq.b	#1,($FFFFFE1C).w ; update lives	counter
00014F90 5338 FE12                  		subq.b	#1,($FFFFFE12).w ; subtract 1 from number of lives
00014F94 6600                       		bne.s	loc_138D4
00014F96 317C 0000 003A             		move.w	#0,$3A(a0)
00014F9C 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load GAME object
00014FA2 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
00014FA8 11FC 0001 D0DA             		move.b	#1,($FFFFD0DA).w ; set OVER object to correct frame
00014FAE 4238 FE1A                  		clr.b	($FFFFFE1A).w
00014FB2                            
00014FB2                            loc_138C2:
00014FB2 11FC 0014 F600             		move.b	#$14,($FFFFF600).w ; set mode to $14 (continue screen)
00014FB8 7003                       		moveq	#3,d0
00014FBA 4EF9 0000 1268             		jmp	(LoadPLC).l	; load game over patterns
00014FC0                            ; ===========================================================================
00014FC0                            
00014FC0                            loc_138D4:
00014FC0 317C 003C 003A             		move.w	#60,$3A(a0)	; set time delay to 1 second
00014FC6 4A38 FE1A                  		tst.b	($FFFFFE1A).w	; is TIME OVER tag set?
00014FCA 6700                       		beq.s	locret_13900	; if not, branch
00014FCC 317C 0000 003A             		move.w	#0,$3A(a0)
00014FD2 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load TIME object
00014FD8 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
00014FDE 11FC 0002 D09A             		move.b	#2,($FFFFD09A).w
00014FE4 11FC 0003 D0DA             		move.b	#3,($FFFFD0DA).w
00014FEA 60C6                       		bra.s	loc_138C2
00014FEC                            ; ===========================================================================
00014FEC                            
00014FEC                            locret_13900:
00014FEC 4E75                       		rts	
00014FEE                            ; End of function GameOver
