00077858                            ; ------------------------------------------------------------------------------
00077858                            ; Plays a given sample
00077858                            ; ------------------------------------------------------------------------------
00077858                            ; INPUT:
00077858                            ;		d0	.b		sample id (>$81)
00077858                            ;
00077858                            ; EXAMPLES:
00077858                            ;		move.b	#$81, d0
00077858                            ;		jsr		MegaPCM_PlaySample
00077858                            ;
00077858                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00077858                            ;		jsr		MegaPCM_PlaySample
00077858                            ; ------------------------------------------------------------------------------
00077858                            
00077858                            MegaPCM_PlaySample:
00077858                            	MPCM_play	d0
00077858                          M 	mpcm_stopz80
00077858                          M 	pusho
00077858                          M 	opt	l-
00077858 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
