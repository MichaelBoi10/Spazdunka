00014888 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
0001488E 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014894 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
0001489A 317C 0000 0032             	move.w	#0,invincibility_time(a0)
000148A0 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
000148A6 303C 00C3                  	move.w	#$C3,d0         ; 
000148AA 4EB9 0000 0FEE             	jsr	(PlaySound).l	; Play special ring sound effect.
000148B0 303C 0094                  	move.w	#$94,d0
000148B4 4EF9 0000 0FF4             	jmp	(PlaySound_Special).l	; Play the super theme
000148BA                            
000148BA                            return2_1ABA4
000148BA 4E75                       	rts
