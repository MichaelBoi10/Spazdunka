00078D70                          M 	@wait_5:
00078D70 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00078D78 66F6                     M 	bne.s	@wait_5
00078D7A                          M 	popo
00078D7A 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00078D82                          M 	mpcm_startz80
00078D82 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00078D8A 4E75                       	rts
