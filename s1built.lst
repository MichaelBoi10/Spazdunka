00001132 49F9 00C0 0000             		lea	($C00000).l,a4
00001138 6000                       		bra.s	loc_145C
0000113A                            ; ===========================================================================
0000113A 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
