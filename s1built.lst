0000DACC 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DAD0 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DAD4 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DAD8 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DADC 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DAE2 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DAE4 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DAE6 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DAE8 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DAEA 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
