000151EE                            ; ---------------------------------------------------------------------------
000151EE                            ; Subroutine to	make Sonic run around loops (GHZ/SLZ)
000151EE                            ; ---------------------------------------------------------------------------
000151EE                            
000151EE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000151EE                            
000151EE                            
000151EE                            Sonic_Loops:				; XREF: Obj01_Control
000151EE 0C38 0003 FE10             		cmpi.b	#3,($FFFFFE10).w ; is level SLZ	?
000151F4 6700                       		beq.s	loc_13926	; if yes, branch
000151F6 4A38 FE10                  		tst.b	($FFFFFE10).w	; is level GHZ ?
000151FA 6600 0000                  		bne.w	locret_139C2	; if not, branch
000151FE                            
000151FE                            loc_13926:
000151FE 3028 000C                  		move.w	$C(a0),d0
00015202 E248                       		lsr.w	#1,d0
00015204 0240 0380                  		andi.w	#$380,d0
00015208 1228 0008                  		move.b	8(a0),d1
0001520C 0241 007F                  		andi.w	#$7F,d1
00015210 D041                       		add.w	d1,d0
00015212 43F8 A400                  		lea	($FFFFA400).w,a1
00015216 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
0001521A B238 F7AE                  		cmp.b	($FFFFF7AE).w,d1
0001521E 6700 F68E                  		beq.w	Obj01_ChkRoll
00015222 B238 F7AF                  		cmp.b	($FFFFF7AF).w,d1
00015226 6700 F686                  		beq.w	Obj01_ChkRoll
0001522A B238 F7AC                  		cmp.b	($FFFFF7AC).w,d1
0001522E 6700                       		beq.s	loc_13976
00015230 B238 F7AD                  		cmp.b	($FFFFF7AD).w,d1
00015234 6700                       		beq.s	loc_13966
00015236 08A8 0006 0001             		bclr	#6,render_flags(a0)
0001523C 4E75                       		rts	
0001523E                            ; ===========================================================================
0001523E                            
0001523E                            loc_13966:
0001523E 0828 0001 0022             		btst	#1,status(a0)
00015244 6700                       		beq.s	loc_13976
00015246 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
0001524C 4E75                       		rts	
0001524E                            ; ===========================================================================
0001524E                            
0001524E                            loc_13976:
0001524E 3428 0008                  		move.w	8(a0),d2
00015252 0C02 002C                  		cmpi.b	#$2C,d2
00015256 6400                       		bcc.s	loc_13988
00015258 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
0001525E 4E75                       		rts	
00015260                            ; ===========================================================================
00015260                            
00015260                            loc_13988:
00015260 0C02 00E0                  		cmpi.b	#-$20,d2
00015264 6500                       		bcs.s	loc_13996
00015266 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
0001526C 4E75                       		rts	
0001526E                            ; ===========================================================================
0001526E                            
0001526E                            loc_13996:
0001526E 0828 0006 0001             		btst	#6,render_flags(a0)
00015274 6600                       		bne.s	loc_139B2
00015276 1228 0026                  		move.b	$26(a0),d1
0001527A 6700                       		beq.s	locret_139C2
0001527C 0C01 0080                  		cmpi.b	#-$80,d1
00015280 6200                       		bhi.s	locret_139C2
00015282 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
00015288 4E75                       		rts	
0001528A                            ; ===========================================================================
0001528A                            
0001528A                            loc_139B2:
0001528A 1228 0026                  		move.b	$26(a0),d1
0001528E 0C01 0080                  		cmpi.b	#-$80,d1
00015292 6300                       		bls.s	locret_139C2
00015294 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
0001529A                            
