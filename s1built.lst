000779F6                            ; EXAMPLES:
000779F6                            ;		move.b	#$81, d0
000779F6                            ;		jsr		MegaPCM_PlaySample
000779F6                            ;
000779F6                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
000779F6                            ;		jsr		MegaPCM_PlaySample
000779F6                            ; ------------------------------------------------------------------------------
