00014930                             
00014930                            Sonic_SpinDash:
00014930 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
00014934 6600                       		bne.s	loc2_1AC8E		; if set, branch
00014936 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
0001493C 6600                       		bne.s	locret2_1AC8C		; if not, return
0001493E 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014942 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
00014946 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
0001494A 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
00014950 303C 00D1                  		move.w	#$D1,d0			; spin sound ($E0 in s2)
00014954 4EB9 0000 0FF8             		jsr	(PlaySound_Special).l	; play spin sound
0001495A 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
0001495C 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
00014962 317C 0000 003A             		move.w	#0,$3A(a0)		; set charge count to 0
00014968 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
0001496E 6500                       		bcs.s	loc2_1AC84		; ??? branch if carry
00014970 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014976                            						; the smoke/dust object
00014976                            loc2_1AC84:
00014976 6100 FB5C                  		bsr.w	Sonic_LevelBound
0001497A 6100 0000                  		bsr.w	Sonic_AnglePos
0001497E                            
0001497E                            locret2_1AC8C:
0001497E 4E75                       		rts	
