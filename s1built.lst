00001004                            ; Subroutine to	pause the game
00001004                            ; ---------------------------------------------------------------------------
00001004                            
00001004                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001004                            
00001004                            
00001004                            PauseGame:				; XREF: Level_MainLoop; et al
00001004 4E71                       		nop	
00001006 4A38 FE12                  		tst.b	($FFFFFE12).w	; do you have any lives	left?
0000100A 6700                       		beq.s	Unpause		; if not, branch
0000100C 4A78 F63A                  		tst.w	($FFFFF63A).w	; is game already paused?
00001010 6600                       		bne.s	loc_13BE	; if yes, branch
00001012 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
00001018 6700                       		beq.s	Pause_DoNothing	; if not, branch
0000101A                            
0000101A                            loc_13BE:
0000101A 31FC 0001 F63A             		move.w	#1,($FFFFF63A).w ; freeze time
00001020 11FC 0001 F003             		move.b	#1,($FFFFF003).w ; pause music
00001026                            
00001026                            loc_13CA:
00001026 11FC 0010 F62A             		move.b	#$10,($FFFFF62A).w
0000102C 6100 0000                  		bsr.w	DelayProgram
00001030 4A38 FFE1                  		tst.b	($FFFFFFE1).w	; is slow-motion cheat on?
00001034 6700                       		beq.s	Pause_ChkStart	; if not, branch
00001036 0838 0006 F605             		btst	#6,($FFFFF605).w ; is button A pressed?
0000103C 6700                       		beq.s	Pause_ChkBC	; if not, branch
0000103E 11FC 0004 F600             		move.b	#4,($FFFFF600).w ; set game mode to 4 (title screen)
00001044 4E71                       		nop	
00001046 6000                       		bra.s	loc_1404
00001048                            ; ===========================================================================
00001048                            
00001048                            Pause_ChkBC:				; XREF: PauseGame
00001048 0838 0004 F604             		btst	#4,($FFFFF604).w ; is button B pressed?
0000104E 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001050 0838 0005 F605             		btst	#5,($FFFFF605).w ; is button C pressed?
00001056 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001058                            
00001058                            Pause_ChkStart:				; XREF: PauseGame
00001058 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
0000105E 67C6                       		beq.s	loc_13CA	; if not, branch
00001060                            
00001060                            loc_1404:				; XREF: PauseGame
00001060 11FC 0080 F003             		move.b	#$80,($FFFFF003).w
00001066                            
00001066                            Unpause:				; XREF: PauseGame
00001066 31FC 0000 F63A             		move.w	#0,($FFFFF63A).w ; unpause the game
0000106C                            
0000106C                            Pause_DoNothing:			; XREF: PauseGame
0000106C 4E75                       		rts	
0000106E                            ; ===========================================================================
0000106E                            
0000106E                            Pause_SlowMo:				; XREF: PauseGame
0000106E 31FC 0001 F63A             		move.w	#1,($FFFFF63A).w
00001074 11FC 0080 F003             		move.b	#$80,($FFFFF003).w
0000107A 4E75                       		rts	
0000107C                            ; End of function PauseGame
