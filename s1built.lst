0000DC66 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DC68 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DC6C 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
