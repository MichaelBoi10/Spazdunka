00014EBC 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00014EC0 9200                       		sub.b	d0,d1
00014EC2 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00014EC6 60D2                       		bra.s	SAnim_Next
