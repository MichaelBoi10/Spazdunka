00014800 6600                       	bne.s	return2_1ABA4		; if yes, branch
00014802                            
00014802 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014808 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
