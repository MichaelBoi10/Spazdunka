00005870 D040                       		add.w	d0,d0
00005872 303B 0000                  		move.w	EndDemo_Levels(pc,d0.w),d0 ; load level	array
00005876 31C0 FE10                  		move.w	d0,($FFFFFE10).w ; set level from level	array
0000587A 5278 FFF4                  		addq.w	#1,($FFFFFFF4).w
0000587E 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	credits	finished?
00005884 6400                       		bcc.s	EndDemo_Exit	; if yes, branch
00005886 31FC 8001 FFF0             		move.w	#$8001,($FFFFFFF0).w ; force demo mode
0000588C 11FC 0008 F600             		move.b	#8,($FFFFF600).w ; set game mode to 08 (demo)
00005892 11FC 0003 FE12             		move.b	#3,($FFFFFE12).w ; set lives to	3
00005898 7000                       		moveq	#0,d0
0000589A 31C0 FE20                  		move.w	d0,($FFFFFE20).w ; clear rings
0000589E 21C0 FE22                  		move.l	d0,($FFFFFE22).w ; clear time
000058A2 21C0 FE26                  		move.l	d0,($FFFFFE26).w ; clear score
000058A6 11C0 FE30                  		move.b	d0,($FFFFFE30).w ; clear lamppost counter
000058AA 0C78 0004 FFF4             		cmpi.w	#4,($FFFFFFF4).w ; is SLZ demo running?
000058B0 6600                       		bne.s	EndDemo_Exit	; if not, branch
000058B2 43F9 0000 0000             		lea	(EndDemo_LampVar).l,a1 ; load lamppost variables
000058B8 45F8 FE30                  		lea	($FFFFFE30).w,a2
000058BC 303C 0008                  		move.w	#8,d0
