000801BE                            ; ---------------------------------------------------------------
000801BE                            SampleTable:
000801BE                            	;			type			pointer		Hz
000801BE                            ;	dcSample
000801BE                            	dcSample	TYPE_PCM, KickS3, 13360				; $92	- Snare (S3)
000801BE =00000012                M 	@desc_31:	equ type_pcm|prio_normal
000801BE                          M 	@macroinvokeid:	substr 2,,"_31"
000801BE =0000001E                M 	@macroprevinvokeid:	= @macroinvokeid-1
000801BE =00000080                M 	__st_sampleid:	= $80
000801BE =000801BE                M 	__st_sampleptr_31:	equ *
000801BE =00000081                M 	__st_sampleid:	= __st_sampleid+1
