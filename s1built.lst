0001CA1A                            ; ---------------------------------------------------------------------------
0001CA1A                            ; Hurting Sonic	subroutine
0001CA1A                            ; ---------------------------------------------------------------------------
0001CA1A                            
0001CA1A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001CA1A                            
0001CA1A                            
0001CA1A                            HurtSonic:
0001CA1A 4A38 FE2C                  		tst.b	($FFFFFE2C).w	; does Sonic have a shield?
0001CA1E 6600                       		bne.s	Hurt_Shield	; if yes, branch
0001CA20 4A78 FE20                  		tst.w	($FFFFFE20).w	; does Sonic have any rings?
0001CA24 6700 0000                  		beq.w	Hurt_NoRings	; if not, branch
0001CA28 4EB9 0000 E7B0             		jsr	SingleObjLoad
0001CA2E 6600                       		bne.s	Hurt_Shield
0001CA30 12BC 0037                  		move.b	#$37,0(a1)	; load bouncing	multi rings object
0001CA34 3368 0008 0008             		move.w	8(a0),8(a1)
0001CA3A 3368 000C 000C             		move.w	$C(a0),$C(a1)
0001CA40                            
0001CA40                            Hurt_Shield:
0001CA40 11FC 0000 FE2C             		move.b	#0,($FFFFFE2C).w ; remove shield
0001CA46 117C 0004 0024             		move.b	#4,$24(a0)
0001CA4C 6100 83E2                  		bsr.w	Sonic_ResetOnFloor
0001CA50 08E8 0001 0022             		bset	#1,$22(a0)
0001CA56 317C FC00 0012             		move.w	#-$400,$12(a0)	; make Sonic bounce away from the object
0001CA5C 317C FE00 0010             		move.w	#-$200,$10(a0)
0001CA62 0828 0006 0022             		btst	#6,$22(a0)
0001CA68 6700                       		beq.s	Hurt_Reverse
0001CA6A 317C FE00 0012             		move.w	#-$200,$12(a0)
0001CA70 317C FF00 0010             		move.w	#-$100,$10(a0)
0001CA76                            
0001CA76                            Hurt_Reverse:
0001CA76 3028 0008                  		move.w	8(a0),d0
0001CA7A B06A 0008                  		cmp.w	8(a2),d0
0001CA7E 6500                       		bcs.s	Hurt_ChkSpikes	; if Sonic is left of the object, branch
0001CA80 4468 0010                  		neg.w	$10(a0)		; if Sonic is right of the object, reverse
0001CA84                            
0001CA84                            Hurt_ChkSpikes:
0001CA84 117C 0000 0039             		move.b	#0,$39(a0)	; clear spindash flag
0001CA8A 317C 0000 0014             		move.w	#0,$14(a0)
0001CA90 117C 001A 001C             		move.b	#$1A,$1C(a0)
0001CA96 317C 0078 0030             		move.w	#$78,$30(a0)
0001CA9C 303C 00A3                  		move.w	#$A3,d0		; load normal damage sound
0001CAA0 0C12 0036                  		cmpi.b	#$36,(a2)	; was damage caused by spikes?
0001CAA4 6600                       		bne.s	Hurt_Sound	; if not, branch
0001CAA6 0C12 0016                  		cmpi.b	#$16,(a2)	; was damage caused by LZ harpoon?
0001CAAA 6600                       		bne.s	Hurt_Sound	; if not, branch
0001CAAC 303C 00A6                  		move.w	#$A6,d0		; load spikes damage sound
0001CAB0                            
0001CAB0                            Hurt_Sound:
0001CAB0 4EB9 0000 0FF4             		jsr	(PlaySound_Special).l
0001CAB6 70FF                       		moveq	#-1,d0
0001CAB8 4E75                       		rts	
0001CABA                            ; ===========================================================================
0001CABA                            
0001CABA                            Hurt_NoRings:
0001CABA 4A78 FFFA                  		tst.w	($FFFFFFFA).w	; is debug mode	cheat on?
0001CABE 6600 FF80                  		bne.w	Hurt_Shield	; if yes, branch
0001CAC2                            ; End of function HurtSonic
