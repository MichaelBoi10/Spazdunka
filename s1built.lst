00014790                            ; loc_1AB38: test_set_SS:
00014790                            Sonic_CheckGoSuper:
00014790 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014794 6600 0000                  	bne.w	Sonic_RevertToNormal		; if yes, branch
00014798 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
0001479E 6600                       	bne.s	return_1ABA4		; if not, branch
000147A0 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
000147A6 6500                       	bcs.s	return_1ABA4		; if not, branch
000147A8 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
000147AC 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
000147B0 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
000147B6 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
000147BC 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
000147C2 117C 0081 F7C8             	move.b	#$81,$FFFFF7C8(a0)
000147C8 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
000147CE 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
000147D4 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
000147DA 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
000147E0 317C 0000 0032             	move.w	#0,invincibility_time(a0)
000147E6 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
000147EC 303C 00D4                  	move.w	#$D4,d0         ; 
000147F0 4EB9 0000 0FF4             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
000147F6 303C 0087                  	move.w	#$87,d0
000147FA 4EF9 0000 0FEE             	jmp	(PlaySound).l	; Play the super theme
00014800                            ; ---------------------------------------------------------------------------
00014800                            return_1ABA4:
00014800 4E75                       	rts
