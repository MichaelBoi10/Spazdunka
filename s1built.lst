00014AAA 117C 0009 001C             		move.b	#9,anim(a0)
00014AB0 1038 F602                  		move.b	($FFFFF602).w,d0	; read controller
00014AB4 0800 0001                  		btst	#1,d0			; check down button
00014AB8 6600 0000                  		bne.w	loc2_1AD30		; if set, branch
00014ABC 117C 000E 0016             		move.b	#$E,y_radius(a0)		; $16(a0) is height/2
00014AC2 117C 0007 0017             		move.b	#7,x_radius(a0)		; $17(a0) is width/2
00014AC8 117C 0002 001C             		move.b	#2,anim(a0)		; set animation to roll
00014ACE 5A68 000C                  		addq.w	#5,y_pos(a0)		; $C(a0) is Y coordinate
00014AD2 117C 0000 0039             		move.b	#0,$39(a0)		; clear Spin Dash flag
00014AD8 7000                       		moveq	#0,d0
00014ADA 1028 003A                  		move.b	$3A(a0),d0		; copy charge count
00014ADE D040                       		add.w	d0,d0			; double it
00014AE0 317B 0000 0014             		move.w	Dash_Speeds(pc,d0.w),$14(a0) ; get normal speed
00014AE6 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00014AEA 6700                       		beq.s	loc2_1AC8F
00014AEC 317B 0000 0014             		move.w	Dash_Speeds_Super(pc,d0.w),inertia(a0)
00014AF2                            
00014AF2                            loc2_1AC8F:
00014AF2 3028 0014                  		move.w	$14(a0),d0		; get inertia
00014AF6 0440 0800                  		subi.w	#$800,d0		; subtract $800
00014AFA D040                       		add.w	d0,d0			; double it
00014AFC 0240 1F00                  		andi.w	#$1F00,d0		; mask it against $1F00
00014B00 4440                       		neg.w	d0			; negate it
00014B02 0640 2000                  		addi.w	#$2000,d0		; add $2000
00014B06 31C0 C904                  		move.w	d0,($FFFFC904).w	; move to $C904
00014B0A 0828 0000 0022             		btst	#0,status(a0)		; is sonic facing right?
00014B10 6700                       		beq.s	loc2_1ACF4		; if not, branch
00014B12 4468 0014                  		neg.w	$14(a0)			; negate inertia
00014B16                            
00014B16                            loc2_1ACF4:
00014B16 08E8 0002 0022             		bset	#2,status(a0)		; set unused (in s1) flag
00014B1C 11FC 0000 D1DC             		move.b	#0,($FFFFD1DC).w	; clear Spin Dash dust animation.
00014B22 303C 00BC                  		move.w	#$BC,d0			; spin release sound
00014B26 4EB9 0000 0FF4             		jsr	(PlaySound_Special).l	; play it!
00014B2C 6000                       		bra.s	loc2_1AD78
