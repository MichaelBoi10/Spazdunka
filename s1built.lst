000151DA                            
000151DA                            Obj01_ResetLevel:			; XREF: Obj01_Index
000151DA 4A68 003A                  		tst.w	$3A(a0)
000151DE 6700                       		beq.s	locret_13914
000151E0 5368 003A                  		subq.w	#1,$3A(a0)	; subtract 1 from time delay
000151E4 6600                       		bne.s	locret_13914
000151E6 31FC 0001 FE02             		move.w	#1,($FFFFFE02).w ; restart the level
000151EC                            
000151EC                            locret_13914:
000151EC 4E75                       		rts	
