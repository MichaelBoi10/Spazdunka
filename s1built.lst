0001CAD0 117C 0006 0024             		move.b	#6,routine(a0)
0001CAD6 6100 8354                  		bsr.w	Sonic_ResetOnFloor
0001CADA 08E8 0001 0022             		bset	#1,status(a0)
0001CAE0 317C F900 0012             		move.w	#-$700,y_vel(a0)
0001CAE6 317C 0000 0010             		move.w	#0,x_vel(a0)
0001CAEC 317C 0000 0014             		move.w	#0,$14(a0)
