0000D9BA 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000D9BC 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000D9BE 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000D9C0 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
