0000112C                            
0000112C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000112C                            
0000112C                            
0000112C                            NemDec:
0000112C 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
00001130 47F9 0000 0000             		lea	(loc_1502).l,a3
00001136 49F9 00C0 0000             		lea	($C00000).l,a4
0000113C 6000                       		bra.s	loc_145C
0000113E                            ; ===========================================================================
0000113E 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
00001142 47F9 0000 0000             		lea	(loc_1518).l,a3
00001148                            
00001148                            loc_145C:				; XREF: NemDec
00001148 43F8 AA00                  		lea	($FFFFAA00).w,a1
0000114C 3418                       		move.w	(a0)+,d2
0000114E E34A                       		lsl.w	#1,d2
00001150 6400                       		bcc.s	loc_146A
00001152 D6FC 000A                  		adda.w	#$A,a3
00001156                            
00001156                            loc_146A:
00001156 E54A                       		lsl.w	#2,d2
00001158 3A42                       		movea.w	d2,a5
0000115A 7608                       		moveq	#8,d3
0000115C 7400                       		moveq	#0,d2
0000115E 7800                       		moveq	#0,d4
00001160 6100 0000                  		bsr.w	NemDec4
00001164 1A18                       		move.b	(a0)+,d5
00001166 E145                       		asl.w	#8,d5
00001168 1A18                       		move.b	(a0)+,d5
0000116A 3C3C 0010                  		move.w	#$10,d6
0000116E 6100                       		bsr.s	NemDec2
00001170 4CDF 3BFF                  		movem.l	(sp)+,d0-a1/a3-a5
00001174 4E75                       		rts	
00001176                            ; End of function NemDec
