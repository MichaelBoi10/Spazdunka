0000B0D4                            Anim_Wait:
0000B0D4 4E75                       		rts	
0000B0D6                            ; ===========================================================================
0000B0D6                            
0000B0D6                            Anim_End_FF:
0000B0D6 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B0D8 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B0DA 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B0E0 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B0E4 60CA                       		bra.s	Anim_Next
0000B0E6                            ; ===========================================================================
0000B0E6                            
0000B0E6                            Anim_End_FE:
0000B0E6 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B0E8 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B0EA 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B0EE 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B0F2 9200                       		sub.b	d0,d1
0000B0F4 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B0F8 60B6                       		bra.s	Anim_Next
0000B0FA                            ; ===========================================================================
0000B0FA                            
0000B0FA                            Anim_End_FD:
0000B0FA 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B0FC 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B0FE 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B104                            
0000B104                            Anim_End_FC:
0000B104 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B106 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B108 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B10C                            
0000B10C                            Anim_End_FB:
0000B10C 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B10E 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B110 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B116 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B11A                            
0000B11A                            Anim_End_FA:
0000B11A 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B11C 6600                       		bne.s	Anim_End	; if not, branch
0000B11E 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B122                            
0000B122                            Anim_End:
0000B122 4E75                       		rts	
