0001E172 47F8 FE26                  		lea	($FFFFFE26).w,a3
0001E176 D193                       		add.l	d0,(a3)		; add d0*10 to the score
0001E178 223C 000F 423F             		move.l	#999999,d1
0001E17E B293                       		cmp.l	(a3),d1		; is #999999 higher than the score?
0001E180 6200 0000                  		bhi.w	loc_1C6AC	; if yes, branch
0001E184 2681                       		move.l	d1,(a3)		; reset	score to #999999
0001E186 2481                       		move.l	d1,(a2)
