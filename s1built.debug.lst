00081CC0                            ; ------------------------------------------------------------------------------
00081CC0                            ; Plays a given sample
00081CC0                            ; ------------------------------------------------------------------------------
00081CC0                            ; INPUT:
00081CC0                            ;		d0	.b		sample id (>$81)
00081CC0                            ;
00081CC0                            ; EXAMPLES:
00081CC0                            ;		move.b	#$81, d0
00081CC0                            ;		jsr		MegaPCM_PlaySample
00081CC0                            ;
00081CC0                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081CC0                            ;		jsr		MegaPCM_PlaySample
00081CC0                            ; ------------------------------------------------------------------------------
00081CC0                            
00081CC0                            MegaPCM_PlaySample:
00081CC0                            	MPCM_play	d0
00081CC0                          M 	mpcm_stopz80
00081CC0                          M 	pusho
00081CC0                          M 	opt	l-
00081CC0 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081CC8                          M 	@wait_14:
00081CC8 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081CD0 66F6                     M 	bne.s	@wait_14
00081CD2                          M 	popo
00081CD2 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081CD8                          M 	mpcm_startz80
00081CD8 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081CE0 4E75                       	rts
