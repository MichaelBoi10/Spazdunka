00014A9A                            ; ---------------------------------------------------------------------------
00014A9A                            ; Subroutine to make Sonic perform a spindash
00014A9A                            ; ---------------------------------------------------------------------------
00014A9A                             
00014A9A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014A9A                             
00014A9A                             
00014A9A                            Sonic_SpinDash:
00014A9A 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
00014A9E 6600                       		bne.s	loc2_1AC8E		; if set, branch
00014AA0 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
00014AA6 6600                       		bne.s	locret2_1AC8C		; if not, return
00014AA8 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014AAC 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
00014AB0 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
00014AB4 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
00014ABA 303C 00D1                  		move.w	#$D1,d0			; spin sound ($E0 in s2)
00014ABE 4EB9 0000 1034             		jsr	(PlaySound_Special).l	; play spin sound
00014AC4 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014AC6 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
00014ACC 317C 0000 003A             		move.w	#0,$3A(a0)		; set charge count to 0
00014AD2 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
00014AD8 6500                       		bcs.s	loc2_1AC84		; ??? branch if carry
00014ADA 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014AE0                            						; the smoke/dust object
00014AE0                            loc2_1AC84:
00014AE0 6100 FB4E                  		bsr.w	Sonic_LevelBound
00014AE4 6100 0000                  		bsr.w	Sonic_AnglePos
00014AE8                            
00014AE8                            locret2_1AC8C:
00014AE8 4E75                       		rts	
00014AEA                            ; ---------------------------------------------------------------------------
00014AEA                            
00014AEA                            loc2_1AC8E:
00014AEA 117C 0009 001C             		move.b	#9,anim(a0)
00014AF0 1038 F602                  		move.b	($FFFFF602).w,d0	; read controller
00014AF4 0800 0001                  		btst	#1,d0			; check down button
00014AF8 6600 0000                  		bne.w	loc2_1AD30		; if set, branch
00014AFC 117C 000E 0016             		move.b	#$E,y_radius(a0)		; $16(a0) is height/2
00014B02 117C 0007 0017             		move.b	#7,x_radius(a0)		; $17(a0) is width/2
00014B08 117C 0002 001C             		move.b	#2,anim(a0)		; set animation to roll
00014B0E 5A68 000C                  		addq.w	#5,y_pos(a0)		; $C(a0) is Y coordinate
00014B12 117C 0000 0039             		move.b	#0,$39(a0)		; clear Spin Dash flag
00014B18 7000                       		moveq	#0,d0
00014B1A 1028 003A                  		move.b	$3A(a0),d0		; copy charge count
00014B1E D040                       		add.w	d0,d0			; double it
00014B20 317B 0000 0014             		move.w	Dash_Speeds(pc,d0.w),$14(a0) ; get normal speed
00014B26 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00014B2A 6700                       		beq.s	loc2_1AC8F
00014B2C 317B 0000 0014             		move.w	Dash_Speeds_Super(pc,d0.w),inertia(a0)
00014B32                            
00014B32                            loc2_1AC8F:
00014B32 3028 0014                  		move.w	$14(a0),d0		; get inertia
00014B36 0440 0800                  		subi.w	#$800,d0		; subtract $800
00014B3A D040                       		add.w	d0,d0			; double it
00014B3C 0240 1F00                  		andi.w	#$1F00,d0		; mask it against $1F00
00014B40 4440                       		neg.w	d0			; negate it
00014B42 0640 2000                  		addi.w	#$2000,d0		; add $2000
00014B46 31C0 C904                  		move.w	d0,($FFFFC904).w	; move to $C904
00014B4A 0828 0000 0022             		btst	#0,status(a0)		; is sonic facing right?
00014B50 6700                       		beq.s	loc2_1ACF4		; if not, branch
00014B52 4468 0014                  		neg.w	$14(a0)			; negate inertia
00014B56                            
00014B56                            loc2_1ACF4:
00014B56 08E8 0002 0022             		bset	#2,status(a0)		; set unused (in s1) flag
00014B5C 11FC 0000 D1DC             		move.b	#0,($FFFFD1DC).w	; clear Spin Dash dust animation.
00014B62 303C 00BC                  		move.w	#$BC,d0			; spin release sound
00014B66 4EB9 0000 1034             		jsr	(PlaySound_Special).l	; play it!
00014B6C 6000                       		bra.s	loc2_1AD78
00014B6E                            ; ===========================================================================
00014B6E                            Dash_Speeds:
00014B6E 0800                       		dc.w  $800		; 0
00014B70 0880                       		dc.w  $880		; 1
00014B72 0900                       		dc.w  $900		; 2
00014B74 0980                       		dc.w  $980		; 3
00014B76 0A00                       		dc.w  $A00		; 4
00014B78 0A80                       		dc.w  $A80		; 5
00014B7A 0B00                       		dc.w  $B00		; 6
00014B7C 0B80                       		dc.w  $B80		; 7
00014B7E 0C00                       		dc.w  $C00		; 8
00014B80                            Dash_Speeds_Super:
00014B80 0B00                       		dc.w  $B00	; 0
00014B82 0B80                       		dc.w  $B80	; 1
00014B84 0C00                       		dc.w  $C00	; 2
00014B86 0C80                       		dc.w  $C80	; 3
00014B88 0D00                       		dc.w  $D00	; 4
00014B8A 0D80                       		dc.w  $D80	; 5
00014B8C 0E00                       		dc.w  $E00	; 6
00014B8E 0E80                       		dc.w  $E80	; 7
00014B90 0F00                       		dc.w  $F00	; 8
00014B92                            ; ===========================================================================
