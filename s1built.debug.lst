0007911B                            @Str_PitchNotSet:
0007911B 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
00079172                            @Str_WaveInvalidHeader:
00079172 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
00079192                            @Str_WaveBadAudioFormat:
00079192 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported audio format. Only PCM is supported", 0
