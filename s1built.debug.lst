00014A20                            ; loc_1AB38: test_set_SS:
00014A20                            Sonic_CheckGoSuper:
00014A20 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014A24 6600                       	bne.s	return_1ABA4		; if yes, branch
00014A26 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
00014A2C 6600                       	bne.s	return_1ABA4		; if not, branch
00014A2E 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014A34 6500                       	bcs.s	return_1ABA4		; if not, branch
00014A36                            
00014A36 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014A3C 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
00014A42 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
00014A48 117C 0081 002A             	move.b	#$81,obj_control(a0)
00014A4E 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
00014A54 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
00014A5A 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014A60 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
00014A66 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014A6C 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
00014A72 303C 00C3                  	move.w	#$C3,d0         ; 
00014A76 4EB9 0000 1032             	jsr	(PlaySound).l	; Play special ring sound effect.
00014A7C 303C 0094                  	move.w	#$94,d0
00014A80 4EF9 0000 1038             	jmp	(PlaySound_Special).l	; Play the super theme
00014A86                            ; ---------------------------------------------------------------------------
00014A86                            return_1ABA4:
00014A86 4E75                       	rts
00014A88                            ; End of subroutine Sonic_CheckGoSuper
