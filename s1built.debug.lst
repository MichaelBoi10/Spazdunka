0001498C 0828 0001 0039             		btst	#1,$39(a0)
00014992 6600                       		bne.s	SCDPeelout_Launch
00014994 0C28 0007 001C             		cmpi.b	#7,$1C(a0) ;check to see if your looking up
0001499A 6600                       		bne.s	@return
0001499C 1038 F603                  		move.b	($FFFFF603).w,d0
000149A0 0200 0070                  		andi.b	#%01110000,d0
000149A4 6700 0000                  		beq.w	@return
000149A8 117C 0001 001C             		move.b	#1,$1C(a0)
000149AE 317C 0000 003A             		move.w	#0,$3A(a0)
000149B4 303C 00D2                  		move.w	#$D2,d0
000149B8 11FC 0002 D1DC                             move.b	#2,($FFFFD1DC).w
000149BE 4EB9 0000 1034             		jsr		(PlaySound_Special).l 	; Play peelout charge sound
000149C4                            	       ;sfx 	sfx_PeeloutCharge 		; These are if you use AMPS
000149C4 588F                       		addq.l	#4,sp
000149C6 08E8 0001 0039             		bset	#1,$39(a0)
000149CC                            		
000149CC 4268 0014                  		clr.w	$14(a0)
000149D0                             
000149D0 6100 FC5E                  		bsr.w	Sonic_LevelBound
000149D4 6100 0000                  		bsr.w	Sonic_AnglePos
000149D8                             
