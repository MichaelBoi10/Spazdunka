00081E3A                            ; ------------------------------------------------------------------------------
00081E3A                            ; Plays a given sample
00081E3A                            ; ------------------------------------------------------------------------------
00081E3A                            ; INPUT:
00081E3A                            ;		d0	.b		sample id (>$81)
00081E3A                            ;
00081E3A                            ; EXAMPLES:
00081E3A                            ;		move.b	#$81, d0
00081E3A                            ;		jsr		MegaPCM_PlaySample
00081E3A                            ;
00081E3A                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081E3A                            ;		jsr		MegaPCM_PlaySample
00081E3A                            ; ------------------------------------------------------------------------------
00081E3A                            
00081E3A                            MegaPCM_PlaySample:
00081E3A                            	MPCM_play	d0
00081E3A                          M 	mpcm_stopz80
00081E3A                          M 	pusho
00081E3A                          M 	opt	l-
00081E3A 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081E42                          M 	@wait_14:
00081E42 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081E4A 66F6                     M 	bne.s	@wait_14
00081E4C                          M 	popo
00081E4C 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081E52                          M 	mpcm_startz80
00081E52 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081E5A 4E75                       	rts
