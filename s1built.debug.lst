00014A5A 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)
00014A60 6500                       		bcs.s	SCDPeelout_ResetScr
00014A62 117C 001E 003A             		move.b	#$1E,$3A(a0)
00014A68 4EF9 0000 0000             		jmp 	SCDPeelout_ResetScr
00014A6E                            		
00014A6E                            SCDPeelout_Stop_Sound:
00014A6E 303C 00BC                  		move.w	#$BC,d0
00014A72 4EB9 0000 1034             		jsr		(PlaySound_Special).l
