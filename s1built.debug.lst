00014736 303C 00C3                  	move.w	#$C3,d0         ; 
0001473A 4EB9 0000 1032             	jsr	(PlaySound).l	; Play special ring sound effect.
00014740 303C 0094                  	move.w	#$94,d0
00014744 4EF9 0000 1038             	jmp	(PlaySound_Special).l	; Play the super theme
