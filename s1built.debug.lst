00077898                            ; ------------------------------------------------------------------------------
00077898                            ; Plays a given sample
00077898                            ; ------------------------------------------------------------------------------
00077898                            ; INPUT:
00077898                            ;		d0	.b		sample id (>$81)
00077898                            ;
00077898                            ; EXAMPLES:
00077898                            ;		move.b	#$81, d0
00077898                            ;		jsr		MegaPCM_PlaySample
00077898                            ;
00077898                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00077898                            ;		jsr		MegaPCM_PlaySample
00077898                            ; ------------------------------------------------------------------------------
00077898                            
00077898                            MegaPCM_PlaySample:
00077898                            	MPCM_play	d0
00077898                          M 	mpcm_stopz80
00077898                          M 	pusho
00077898                          M 	opt	l-
00077898 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
000778A0                          M 	@wait_5:
000778A0 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
000778A8 66F6                     M 	bne.s	@wait_5
000778AA                          M 	popo
000778AA 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
000778B0                          M 	mpcm_startz80
000778B0 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
000778B8 4E75                       	rts
000778BA                            
