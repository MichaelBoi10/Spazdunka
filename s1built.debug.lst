0000DE88 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DE8A 4A44                       		tst.w	d4			; check response value from SolidObject
0000DE8C 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DE8E 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DE92 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
