0000B05E 6600                       		bne.s	Obj2E_ChkSonic	; if not, go and check for the next monitor type (1-up icon)
0000B060 2248                       		move.l	a0,a1	; move a0 to a1, because Touch_ChkHurt wants the damaging object to be in a1
0000B062 2F08                       		move.l	a0,-(sp)	; push a0 on the stack, and decrement stack pointer
