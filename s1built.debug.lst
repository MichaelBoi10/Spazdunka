00014A7E 0C78 0060 F73E             		cmpi.w	#$60,($FFFFF73E).w
00014A84 6700                       		beq.s	@finish
00014A86 6400                       		bcc.s	@skip
00014A88 5878 F73E                  		addq.w	#4,($FFFFF73E).w
