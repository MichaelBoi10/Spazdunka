00079E1D                            @Str_PitchNotSet:
00079E1D 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
00079E74                            @Str_WaveInvalidHeader:
00079E74 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
00079E94                            @Str_WaveBadAudioFormat:
