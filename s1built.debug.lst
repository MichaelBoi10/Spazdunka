00077B78                            ; ------------------------------------------------------------------------------
00077B78                            @ErrorCodeToDescription:
00077B78                            	;		Raw error code								  String pointer
00077B78 0000 0000                  	dc.l	(MPCM_ST_TOO_MANY_SAMPLES<<24) 				| @Str_TooManySamples
00077B7C 0000 0000                  	dc.l	(MPCM_ST_UNKNOWN_SAMPLE_TYPE<<24)			| @Str_UnknownSampleType
00077B80 0000 0000                  	dc.l	(MPCM_ST_PITCH_NOT_SET<<24)					| @Str_PitchNotSet
00077B84 0000 0000                  	dc.l	(MPCM_ST_WAVE_INVALID_HEADER<<24)			| @Str_WaveInvalidHeader
00077B88 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_AUDIO_FORMAT<<24)			| @Str_WaveBadAudioFormat
00077B8C 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_MONO<<24)					| @Str_WaveNotMono
00077B90 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_8BIT<<24)					| @Str_WaveNot8bit
00077B94 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_SAMPLE_RATE<<24)			| @Str_WaveBadSampleRate
00077B98 0000 0000                  	dc.l	(MPCM_ST_WAVE_MISSING_DATA_CHUNK<<24)		| @Str_WaveMissingDataChunk
00077B9C 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_UNSUPPORTED_VERSION<<24)	| @Str_DpcmHqUnsupportedVersion
00077BA0 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_BAD_SAMPLE_RATE<<24)		| @Str_DpcmHqBadSampleRate
00077BA4 FF00                       	dc.b	$FF, 0		; end marker
00077BA6                            
00077BA6                            ; ------------------------------------------------------------------------------
00077BA6                            @Str_TooManySamples:
00077BA6 546F 6F20 6D61 6E79 2073+  	dc.b	"Too many samples in table", 0
00077BC0                            @Str_UnknownSampleType:
00077BC0 556E 6B6E 6F77 6E20 7361+  	dc.b	"Unknown sample type or missing end marker. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE", 0
00077C2D                            @Str_PitchNotSet:
00077C2D 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
00077C84                            @Str_WaveInvalidHeader:
00077C84 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
00077CA4                            @Str_WaveBadAudioFormat:
00077CA4 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported audio format. Only PCM is supported", 0
00077CE0                            @Str_WaveNotMono:
00077CE0 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be mono", 0
00077CFF                            @Str_WaveNot8bit:
00077CFF 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be 8-bit unsigned PCM", 0
00077D2C                            @Str_WaveBadSampleRate:
