000058A8                            EndingDemoLoad:				; XREF: Credits
000058A8 3038 FFF4                  		move.w	($FFFFFFF4).w,d0
000058AC 0240 000F                  		andi.w	#$F,d0
000058B0 D040                       		add.w	d0,d0
000058B2 303B 0000                  		move.w	EndDemo_Levels(pc,d0.w),d0 ; load level	array
000058B6 31C0 FE10                  		move.w	d0,($FFFFFE10).w ; set level from level	array
000058BA 5278 FFF4                  		addq.w	#1,($FFFFFFF4).w
000058BE 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	credits	finished?
000058C4 6400                       		bcc.s	EndDemo_Exit	; if yes, branch
000058C6 31FC 8001 FFF0             		move.w	#$8001,($FFFFFFF0).w ; force demo mode
000058CC 11FC 0008 F600             		move.b	#8,($FFFFF600).w ; set game mode to 08 (demo)
000058D2 11FC 0003 FE12             		move.b	#3,($FFFFFE12).w ; set lives to	3
000058D8 7000                       		moveq	#0,d0
000058DA 31C0 FE20                  		move.w	d0,($FFFFFE20).w ; clear rings
000058DE 21C0 FE22                  		move.l	d0,($FFFFFE22).w ; clear time
000058E2 21C0 FE26                  		move.l	d0,($FFFFFE26).w ; clear score
000058E6 11C0 FE30                  		move.b	d0,($FFFFFE30).w ; clear lamppost counter
000058EA 0C78 0004 FFF4             		cmpi.w	#4,($FFFFFFF4).w ; is SLZ demo running?
000058F0 6600                       		bne.s	EndDemo_Exit	; if not, branch
000058F2 43F9 0000 0000             		lea	(EndDemo_LampVar).l,a1 ; load lamppost variables
000058F8 45F8 FE30                  		lea	($FFFFFE30).w,a2
000058FC 303C 0008                  		move.w	#8,d0
