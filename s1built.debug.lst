0000DB2C 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DB2E 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DB30 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DB32                            		; otherwise, fall through to Spik_Hurt
