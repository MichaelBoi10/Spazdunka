00001146 6700                       		beq.s	Process_DMA_Done ; branch if we reached a stop token
00001148                            
00001148                            		; issue a set of VDP commands...
00001148 3A80                       		move.w	d0,(a5)		; transfer length
0000114A 3A99                       		move.w	(a1)+,(a5)	; transfer length
0000114C 3A99                       		move.w	(a1)+,(a5)	; source address
0000114E 3A99                       		move.w	(a1)+,(a5)	; source address
00001150 3A99                       		move.w	(a1)+,(a5)	; source address
00001152 3A99                       		move.w	(a1)+,(a5)	; destination
00001154 3A99                       		move.w	(a1)+,(a5)	; destination
00001156 B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
0000115A 66E8                       		bne.s	Process_DMA_Loop ; loop if we haven't reached the end of the buffer
