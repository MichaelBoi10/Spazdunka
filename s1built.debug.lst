00078D74 66F6                     M 	bne.s	@wait_8
00078D76                          M 	popo
00078D76 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00078D7E                          M 	mpcm_startz80
00078D7E 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00078D86 4E75                       	rts
