00015088                            ; ---------------------------------------------------------------------------
00015088                            ; Subroutine to	animate	Sonic's sprites
00015088                            ; ---------------------------------------------------------------------------
00015088                            
00015088                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00015088                            
00015088                            
00015088                            Sonic_Animate:				; XREF: Obj01_Control; et al
00015088 43F9 0000 0000             		lea	(SonicAniData).l,a1
0001508E 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015092 6700                       		beq.s	SAnim_NotSuper
00015094 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
0001509A                            
0001509A                            SAnim_NotSuper:		
0001509A 7000                       		moveq	#0,d0
0001509C 1028 001C                  		move.b	$1C(a0),d0
000150A0 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
000150A4 6700                       		beq.s	SAnim_Do	; if not, branch
000150A6 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000150AA 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000150B0 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000150B6                            
000150B6                            SAnim_Do:
000150B6 D040                       		add.w	d0,d0
000150B8 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000150BC 1011                       		move.b	(a1),d0
000150BE 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000150C0 1228 0022                  		move.b	$22(a0),d1
000150C4 0201 0001                  		andi.b	#1,d1
000150C8 0228 00FC 0001             		andi.b	#$FC,1(a0)
000150CE 8328 0001                  		or.b	d1,1(a0)
000150D2 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150D6 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000150D8 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000150DC                            
000150DC                            SAnim_Do2:
000150DC 7200                       		moveq	#0,d1
000150DE 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000150E2 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000150E6 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000150EA 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
000150EC                            
000150EC                            SAnim_Next:
000150EC 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000150F0 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000150F4                            
000150F4                            SAnim_Delay:
000150F4 4E75                       		rts	
000150F6                            ; ===========================================================================
000150F6                            
000150F6                            SAnim_End_FF:
000150F6 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000150F8 6600                       		bne.s	SAnim_End_FE	; if not, branch
000150FA 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015100 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015104 60E6                       		bra.s	SAnim_Next
00015106                            ; ===========================================================================
00015106                            
00015106                            SAnim_End_FE:
00015106 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00015108 6600                       		bne.s	SAnim_End_FD	; if not, branch
0001510A 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0001510E 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015112 9200                       		sub.b	d0,d1
00015114 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015118 60D2                       		bra.s	SAnim_Next
0001511A                            ; ===========================================================================
0001511A                            
0001511A                            SAnim_End_FD:
0001511A 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0001511C 6600                       		bne.s	SAnim_End	; if not, branch
0001511E 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015124                            
00015124                            SAnim_End:
00015124 4E75                       		rts	
00015126                            ; ===========================================================================
00015126                            
00015126                            SAnim_WalkRun:				; XREF: SAnim_Do
00015126 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
0001512A 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
0001512C 5200                       		addq.b	#1,d0		; is animation walking/running?
0001512E 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015132 7200                       		moveq	#0,d1
00015134 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015138 1428 0022                  		move.b	$22(a0),d2
0001513C 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015140 6600                       		bne.s	loc_13A70	; if yes, branch
00015142 4600                       		not.b	d0		; reverse angle
00015144                            
00015144                            loc_13A70:
00015144 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015148 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001514A 7203                       		moveq	#3,d1
0001514C                            
0001514C                            loc_13A78:
0001514C 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015152 B302                       		eor.b	d1,d2
00015154 8528 0001                  		or.b	d2,1(a0)
00015158 0828 0005 0022             		btst	#5,$22(a0)
0001515E 6600 0000                  		bne.w	SAnim_Push
00015162 E808                       		lsr.b	#4,d0		; divide angle by $10
00015164 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015168 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
0001516C 6A00                       		bpl.s	loc_13A9C
0001516E 4442                       		neg.w	d2
00015170                            
00015170                            loc_13A9C:
00015170 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015174 6700                       		beq.s	Loc_NotSuper
00015176 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
0001517C 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015180 6400                       		bhs.s	SuperRun	; if yes, branch
00015182 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
00015188 6000                       		bra.s	SuperWalk
0001518A                            
0001518A                            Loc_NotSuper:
0001518A 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00015190 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015194 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015196 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
0001519C 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000151A0 6400                       		bhs.s	loc_13AB4	; if yes, branch
000151A2 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000151A8                            
000151A8                            SuperWalk:
000151A8 1200                       		move.b	d0,d1
000151AA E209                       		lsr.b	#1,d1
000151AC D001                       		add.b	d1,d0
000151AE                            
000151AE                            loc_13AB4:
000151AE D000                       		add.b	d0,d0
000151B0                            
000151B0                            SuperRun:
000151B0 1600                       		move.b	d0,d3
000151B2 4442                       		neg.w	d2
000151B4 0642 0800                  		addi.w	#$800,d2
000151B8 6A00                       		bpl.s	loc_13AC2
000151BA 7400                       		moveq	#0,d2
000151BC                            
000151BC                            loc_13AC2:
000151BC E04A                       		lsr.w	#8,d2
000151BE 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151C2 6100 FF18                  		bsr.w	SAnim_Do2
000151C6 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000151CA 4E75                       		rts	
000151CC                            ; ===========================================================================
000151CC                            
000151CC                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000151CC 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000151CE 6600                       		bne.s	SAnim_Push	; if not, branch
000151D0 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000151D4 6A00                       		bpl.s	loc_13ADE
000151D6 4442                       		neg.w	d2
000151D8                            
000151D8                            loc_13ADE:
000151D8 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000151DE 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000151E2 6400                       		bcc.s	loc_13AF0	; if yes, branch
000151E4 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000151EA                            
000151EA                            loc_13AF0:
000151EA 4442                       		neg.w	d2
000151EC 0642 0400                  		addi.w	#$400,d2
000151F0 6A00                       		bpl.s	loc_13AFA
000151F2 7400                       		moveq	#0,d2
000151F4                            
000151F4                            loc_13AFA:
000151F4 E04A                       		lsr.w	#8,d2
000151F6 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151FA 1228 0022                  		move.b	$22(a0),d1
000151FE 0201 0001                  		andi.b	#1,d1
00015202 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015208 8328 0001                  		or.b	d1,1(a0)
0001520C 6000 FECE                  		bra.w	SAnim_Do2
00015210                            ; ===========================================================================
00015210                            
00015210                            SAnim_Push:				; XREF: SAnim_RollJump
00015210 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015214 6B00                       		bmi.s	loc_13B1E
00015216 4442                       		neg.w	d2
00015218                            
00015218                            loc_13B1E:
00015218 0642 0800                  		addi.w	#$800,d2
0001521C 6A00                       		bpl.s	loc_13B26
0001521E 7400                       		moveq	#0,d2
00015220                            
00015220                            loc_13B26:
00015220 EC4A                       		lsr.w	#6,d2
00015222 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015226 43F9 0000 0000             		lea	(SonAni_Push).l,a1
0001522C 1228 0022                  		move.b	$22(a0),d1
00015230 0201 0001                  		andi.b	#1,d1
00015234 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001523A 8328 0001                  		or.b	d1,1(a0)
0001523E 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015242 6700                       		beq.s	Loc_NotSuper2
00015244 43F9 0000 0000             		lea	(SupSonAni_Push).l,a1 ; use	running	animation
0001524A                            
0001524A                            Loc_NotSuper2:
0001524A 6000 FE90                  		bra.w	SAnim_Do2
0001524E                            ; End of function Sonic_Animate
