00001040                            PauseGame:				; XREF: Level_MainLoop; et al
00001040 4E71                       		nop	
00001042 4A38 FE12                  		tst.b	($FFFFFE12).w	; do you have any lives	left?
00001046 6700                       		beq.s	Unpause		; if not, branch
00001048 4A78 F63A                  		tst.w	($FFFFF63A).w	; is game already paused?
0000104C 6600                       		bne.s	loc_13BE	; if yes, branch
0000104E 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
00001054 6700                       		beq.s	Pause_DoNothing	; if not, branch
00001056                            
00001056                            loc_13BE:
00001056 31FC 0001 F63A             		move.w	#1,($FFFFF63A).w ; freeze time
0000105C 11FC 0001 F003             		move.b	#1,($FFFFF003).w ; pause music
