00014CBA 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
00014CC0 6500                       		bcs.s	loc2_1AC84		; ??? branch if carry
00014CC2 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
