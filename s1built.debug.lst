0001471E 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014724 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
0001472A 317C 0000 0032             	move.w	#0,invincibility_time(a0)
