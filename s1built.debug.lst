0000B3DE                            AnimateSprite:
0000B3DE 7000                       		moveq	#0,d0
0000B3E0 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B3E4 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B3E8 6700                       		beq.s	Anim_Run	; if not, branch
0000B3EA 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B3EE 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B3F4 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B3FA                            
0000B3FA                            Anim_Run:
0000B3FA 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B3FE 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B400 D040                       		add.w	d0,d0
0000B402 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B406 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B40A 7200                       		moveq	#0,d1
0000B40C 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B410 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B414 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B416                            
0000B416                            Anim_Next:
0000B416 1200                       		move.b	d0,d1
0000B418 0200 001F                  		andi.b	#$1F,d0
0000B41C 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B420 1028 0022                  		move.b	$22(a0),d0
0000B424 E719                       		rol.b	#3,d1
0000B426 B101                       		eor.b	d0,d1
0000B428 0201 0003                  		andi.b	#3,d1
0000B42C 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B432 8328 0001                  		or.b	d1,render_flags(a0)
0000B436 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B43A                            
0000B43A                            Anim_Wait:
0000B43A 4E75                       		rts	
0000B43C                            ; ===========================================================================
0000B43C                            
0000B43C                            Anim_End_FF:
0000B43C 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B43E 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B440 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B446 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B44A 60CA                       		bra.s	Anim_Next
0000B44C                            ; ===========================================================================
0000B44C                            
0000B44C                            Anim_End_FE:
0000B44C 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B44E 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B450 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B454 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B458 9200                       		sub.b	d0,d1
0000B45A 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B45E 60B6                       		bra.s	Anim_Next
0000B460                            ; ===========================================================================
0000B460                            
0000B460                            Anim_End_FD:
0000B460 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B462 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B464 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B46A                            
0000B46A                            Anim_End_FC:
0000B46A 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B46C 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B46E 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B472                            
0000B472                            Anim_End_FB:
0000B472 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B474 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B476 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B47C 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B480                            
0000B480                            Anim_End_FA:
0000B480 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B482 6600                       		bne.s	Anim_End	; if not, branch
0000B484 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B488                            
0000B488                            Anim_End:
0000B488 4E75                       		rts	
0000B48A                            ; End of function AnimateSprite
