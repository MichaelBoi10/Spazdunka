00014B96 317C 0000 003A             		move.w	#0,$3A(a0)
00014B9C 303C 00D2                  		move.w	#$D2,d0
00014BA0 11FC 0002 D1DC                             move.b	#2,($FFFFD1DC).w
00014BA6 4EB9 0000 1038             		jsr		(PlaySound_Special).l 	; Play peelout charge sound
00014BAC                            	       ;sfx 	sfx_PeeloutCharge 		; These are if you use AMPS
