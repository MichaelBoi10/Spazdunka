000146AE                            Sonic_CheckGoSuper:
000146AE 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
000146B2 6600                       	bne.s	return_1ABA4		; if yes, branch
000146B4 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
000146BA 6600                       	bne.s	return_1ABA4		; if not, branch
000146BC 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
000146C2 6500                       	bcs.s	return_1ABA4		; if not, branch
000146C4                            
000146C4 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
000146CA 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
