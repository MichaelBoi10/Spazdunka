00014CF6 5A68 000C                  		addq.w	#5,y_pos(a0)		; $C(a0) is Y coordinate
00014CFA 117C 0000 0039             		move.b	#0,$39(a0)		; clear Spin Dash flag
00014D00 7000                       		moveq	#0,d0
00014D02 1028 003A                  		move.b	$3A(a0),d0		; copy charge count
