00014604 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
0001460A 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
00014610 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014616 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
0001461C 303C 00C3                  	move.w	#$C3,d0         ; 
00014620 4EB9 0000 1032             	jsr	(PlaySound).l	; Play special ring sound effect.
00014626 303C 0094                  	move.w	#$94,d0
0001462A 4EF9 0000 1038             	jmp	(PlaySound_Special).l	; Play the super theme
00014630                            ; ---------------------------------------------------------------------------
