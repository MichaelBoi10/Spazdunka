00077A00                            ; ------------------------------------------------------------------------------
00077A00                            ; Plays a given sample
00077A00                            ; ------------------------------------------------------------------------------
00077A00                            ; INPUT:
00077A00                            ;		d0	.b		sample id (>$81)
00077A00                            ;
00077A00                            ; EXAMPLES:
00077A00                            ;		move.b	#$81, d0
00077A00                            ;		jsr		MegaPCM_PlaySample
00077A00                            ;
00077A00                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00077A00                            ;		jsr		MegaPCM_PlaySample
00077A00                            ; ------------------------------------------------------------------------------
00077A00                            
00077A00                            MegaPCM_PlaySample:
00077A00                            	MPCM_play	d0
00077A00                          M 	mpcm_stopz80
00077A00                          M 	pusho
00077A00                          M 	opt	l-
00077A00 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00077A08                          M 	@wait_11:
00077A08 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00077A10 66F6                     M 	bne.s	@wait_11
00077A12                          M 	popo
00077A12 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00077A18                          M 	mpcm_startz80
00077A18 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00077A20 4E75                       	rts
