00082496                            ; ------------------------------------------------------------------------------
00082496                            @Str_TooManySamples:
00082496 546F 6F20 6D61 6E79 2073+  	dc.b	"Too many samples in table", 0
000824B0                            @Str_UnknownSampleType:
000824B0 556E 6B6E 6F77 6E20 7361+  	dc.b	"Unknown sample type or missing end marker. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE", 0
0008251D                            @Str_PitchNotSet:
0008251D 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
00082574                            @Str_WaveInvalidHeader:
00082574 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
00082594                            @Str_WaveBadAudioFormat:
00082594 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported audio format. Only PCM is supported", 0
000825D0                            @Str_WaveNotMono:
000825D0 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be mono", 0
000825EF                            @Str_WaveNot8bit:
000825EF 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be 8-bit unsigned PCM", 0
0008261C                            @Str_WaveBadSampleRate:
0008261C 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported sample rate. Use <=\#TYPE_PCM_MAX_RATE\ Hz for TYPE_PCM or \#TYPE_PCM_TURBO_MAX_RATE\ Hz for TYPE_PCM_TURBO.", 0
0008267D                            @Str_WaveMissingDataChunk:
0008267D 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Failed to locate 'data' chunk", 0
000826A7                            @Str_DpcmHqUnsupportedVersion:
000826A7 4450 434D 2D48 5120 6572+  	dc.b	"DPCM-HQ error: Unsupported version specified in header", 0
000826DE                            @Str_DpcmHqBadSampleRate:
