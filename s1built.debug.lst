00078DB0                          M 	@wait_8:
00078DB0 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00078DB8 66F6                     M 	bne.s	@wait_8
00078DBA                          M 	popo
00078DBA 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00078DC2                          M 	mpcm_startz80
00078DC2 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00078DCA 4E75                       	rts
