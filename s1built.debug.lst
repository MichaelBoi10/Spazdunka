00005B9E 45F2 0000                  		lea	(a2,d0.w),a2
00005BA2 7000                       		moveq	#0,d0
00005BA4 1012                       		move.b	(a2),d0
00005BA6 6700                       		beq.s	loc_5862
00005BA8 6100 B702                  		bsr.w	LoadPLC		; load level patterns
