00015068 1600                       		move.b	d0,d3
0001506A 4442                       		neg.w	d2
0001506C 0642 0800                  		addi.w	#$800,d2
00015070 6A00                       		bpl.s	loc_13AC2
00015072 7400                       		moveq	#0,d2
00015074                            
