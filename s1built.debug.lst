0000DA1C 3028 0012                  		move.w	$12(a0),d0
0000DA20 48C0                       		ext.l	d0
0000DA22 E180                       		asl.l	#8,d0
0000DA24 9680                       		sub.l	d0,d3
0000DA26 2143 000C                  		move.l	d3,y_pos(a0)
0000DA2A 4EB9 0000 0000             		jsr	HurtSonic
