00014B80                            ;SCDPeelout:
00014B80 0828 0001 0039             		btst	#1,$39(a0)
00014B86 6600                       		bne.s	SCDPeelout_Launch
00014B88 0C28 0007 001C             		cmpi.b	#7,$1C(a0) ;check to see if your looking up
00014B8E 6600                       		bne.s	@return
00014B90 1038 F603                  		move.b	($FFFFF603).w,d0
00014B94 0200 0070                  		andi.b	#%01110000,d0
00014B98 6700 0000                  		beq.w	@return
00014B9C 117C 0001 001C             		move.b	#1,$1C(a0)
00014BA2 317C 0000 003A             		move.w	#0,$3A(a0)
00014BA8 303C 00D2                  		move.w	#$D2,d0
00014BAC 11FC 0002 D1DC                             move.b	#2,($FFFFD1DC).w
00014BB2 4EB9 0000 1038             		jsr		(PlaySound_Special).l 	; Play peelout charge sound
00014BB8                            	       ;sfx 	sfx_PeeloutCharge 		; These are if you use AMPS
00014BB8 588F                       		addq.l	#4,sp
00014BBA 08E8 0001 0039             		bset	#1,$39(a0)
00014BC0                            		
00014BC0 4268 0014                  		clr.w	$14(a0)
00014BC4                             
00014BC4 6100 FC6C                  		bsr.w	Sonic_LevelBound
00014BC8 6100 0000                  		bsr.w	Sonic_AnglePos
00014BCC                             
00014BCC                            	@return:
00014BCC 4E75                       		rts	
00014BCE                            ; ---------------------------------------------------------------------------
00014BCE                             
00014BCE                            SCDPeelout_Launch:
00014BCE 1038 F602                  		move.b	($FFFFF602).w,d0
00014BD2 0800 0000                  		btst	#0,d0
00014BD6 6600 0000                  		bne.w	SCDPeelout_Charge
00014BDA 08A8 0001 0039             		bclr	#1,$39(a0)	; stop Dashing
00014BE0 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)	; have we been charging long enough?
00014BE6 6600                       		bne.s	SCDPeelout_Stop_Sound
00014BE8 117C 0000 001C             		move.b	#0,$1C(a0)	; launches here (peelout sprites)
00014BEE 317C 0001 0010             		move.w	#1,$10(a0)	; force X speed to nonzero for camera lag's benefit
00014BF4 3028 0014                  		move.w	$14(a0),d0
00014BF8 0440 0800                  		subi.w	#$800,d0
00014BFC D040                       		add.w	d0,d0
00014BFE 0240 0800                  		andi.w	#$800,d0
00014C02 4440                       		neg.w	d0
00014C04 0640 0800                  		addi.w	#$800,d0
00014C08                            		;move.w	d0,(v_cameralag).w
00014C08 0828 0000 0022             		btst	#0,$22(a0)
00014C0E 6700                       		beq.s	@dontflip
00014C10 4468 0014                  		neg.w	$14(a0)
00014C14                             
00014C14                            @dontflip:
00014C14 08A8 0007 0022             		bclr	#7,$22(a0)
00014C1A 303C 00D3                  		move.w	#$D3,d0
00014C1E 4EB9 0000 1038             		jsr		(PlaySound_Special).l
00014C24                            		; sfx 	sfx_PeeloutRelease
00014C24 6000 0000                  		bra.w	SCDPeelout_ResetScr
00014C28                            ; ---------------------------------------------------------------------------
00014C28                             
00014C28                            SCDPeelout_Charge:				; If still charging the dash...
00014C28 3238 F760                  		move.w	($FFFFF760).w,d1	; get top peelout speed
00014C2C 3401                       		move.w	d1,d2
00014C2E D241                       		add.w	d1,d1
00014C30 4A38 FE2E                  		tst.b   ($FFFFFE2E).w 		; test for speed shoes
00014C34 6700                       		beq.s	@noshoes
00014C36 E242                       		asr.w	#1,d2
00014C38 9242                       		sub.w	d2,d1
00014C3A                            
00014C3A                            @noshoes:
00014C3A 0668 0064 0014             		addi.w	#$64,$14(a0)		; increment speed
00014C40 B268 0014                  		cmp.w	$14(a0),d1
00014C44 6E00                       		bgt.s	@inctimer
00014C46 3141 0014                  		move.w	d1,$14(a0)
00014C4A                            
00014C4A                            @inctimer:
00014C4A 5228 003A                  		addq.b	#1,$3A(a0)		; increment timer
00014C4E 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)
00014C54 6500                       		bcs.s	SCDPeelout_ResetScr
00014C56 117C 001E 003A             		move.b	#$1E,$3A(a0)
00014C5C 4EF9 0000 0000             		jmp 	SCDPeelout_ResetScr
00014C62                            		
00014C62                            SCDPeelout_Stop_Sound:
00014C62 303C 00BC                  		move.w	#$BC,d0
00014C66 4EB9 0000 1038             		jsr		(PlaySound_Special).l
00014C6C                            		; sfx 	sfx_PeeloutStop
00014C6C 4268 0014                  		clr.w	$14(a0)
00014C70                            
00014C70                            SCDPeelout_ResetScr:
00014C70 588F                       		addq.l	#4,sp			; increase stack ptr ; was 4
00014C72 0C78 0060 F73E             		cmpi.w	#$60,($FFFFF73E).w
00014C78 6700                       		beq.s	@finish
00014C7A 6400                       		bcc.s	@skip
00014C7C 5878 F73E                  		addq.w	#4,($FFFFF73E).w
00014C80                             
00014C80                            	@skip:
00014C80 5578 F73E                  		subq.w	#2,($FFFFF73E).w
00014C84                             
00014C84                            	@finish:
00014C84 6100 FBAC                  		bsr.w	Sonic_LevelBound
00014C88 6100 0000                  		bsr.w	Sonic_AnglePos
00014C8C 4E75                       		rts
