0000DE9C 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DE9E 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DEA2 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
