00077A40                            ; ------------------------------------------------------------------------------
00077A40                            ; Plays a given sample
00077A40                            ; ------------------------------------------------------------------------------
00077A40                            ; INPUT:
00077A40                            ;		d0	.b		sample id (>$81)
00077A40                            ;
00077A40                            ; EXAMPLES:
00077A40                            ;		move.b	#$81, d0
00077A40                            ;		jsr		MegaPCM_PlaySample
00077A40                            ;
00077A40                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00077A40                            ;		jsr		MegaPCM_PlaySample
00077A40                            ; ------------------------------------------------------------------------------
00077A40                            
00077A40                            MegaPCM_PlaySample:
00077A40                            	MPCM_play	d0
00077A40                          M 	mpcm_stopz80
00077A40                          M 	pusho
00077A40                          M 	opt	l-
00077A40 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00077A48                          M 	@wait_8:
00077A48 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00077A50 66F6                     M 	bne.s	@wait_8
00077A52                          M 	popo
00077A52 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00077A58                          M 	mpcm_startz80
00077A58 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00077A60 4E75                       	rts
00077A62                            
