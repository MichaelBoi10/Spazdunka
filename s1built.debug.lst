0000108A 6600                       		bne.s	Pause_SlowMo	; if yes, branch
0000108C 0838 0005 F605             		btst	#5,($FFFFF605).w ; is button C pressed?
00001092 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001094                            
00001094                            Pause_ChkStart:				; XREF: PauseGame
00001094 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
0000109A 67C6                       		beq.s	loc_13CA	; if not, branch
