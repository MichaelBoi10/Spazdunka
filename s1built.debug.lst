000145CA                            ; loc_1AB38: test_set_SS:
000145CA                            Sonic_CheckGoSuper:
000145CA 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
000145CE 6600                       	bne.s	return_1ABA4		; if yes, branch
000145D0 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
000145D6 6600                       	bne.s	return_1ABA4		; if not, branch
000145D8 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
000145DE 6500                       	bcs.s	return_1ABA4		; if not, branch
000145E0                            
000145E0 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
000145E6 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
000145EC 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
