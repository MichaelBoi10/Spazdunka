00014FF0 6A00                       		bpl.s	loc_13B26
00014FF2 7400                       		moveq	#0,d2
00014FF4                            
00014FF4                            loc_13B26:
00014FF4 EC4A                       		lsr.w	#6,d2
00014FF6 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00014FFA 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00015000 1228 0022                  		move.b	$22(a0),d1
00015004 0201 0001                  		andi.b	#1,d1
00015008 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001500E 8328 0001                  		or.b	d1,1(a0)
00015012 6000 FEBA                  		bra.w	SAnim_Do2
