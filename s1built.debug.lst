00014FBE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014FBE                            
00014FBE                            
00014FBE                            Sonic_Animate:				; XREF: Obj01_Control; et al
00014FBE 43F9 0000 0000             		lea	(SonicAniData).l,a1
00014FC4 7000                       		moveq	#0,d0
00014FC6 1028 001C                  		move.b	$1C(a0),d0
00014FCA B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00014FCE 6700                       		beq.s	SAnim_Do	; if not, branch
00014FD0 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
00014FD4 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00014FDA 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00014FE0                            
00014FE0                            SAnim_Do:
00014FE0 D040                       		add.w	d0,d0
00014FE2 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00014FE6 1011                       		move.b	(a1),d0
00014FE8 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00014FEA 1228 0022                  		move.b	$22(a0),d1
00014FEE 0201 0001                  		andi.b	#1,d1
00014FF2 0228 00FC 0001             		andi.b	#$FC,1(a0)
00014FF8 8328 0001                  		or.b	d1,1(a0)
00014FFC 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015000 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00015002 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00015006                            
00015006                            SAnim_Do2:
00015006 7200                       		moveq	#0,d1
00015008 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0001500C 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00015010 6B00                       		bmi.s	SAnim_End_FF	; if animation is complete, branch
00015012                            
00015012                            SAnim_Next:
00015012 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00015016 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
0001501A                            
0001501A                            SAnim_Delay:
0001501A 4E75                       		rts	
0001501C                            ; ===========================================================================
0001501C                            
0001501C                            SAnim_End_FF:
0001501C 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0001501E 6600                       		bne.s	SAnim_End_FE	; if not, branch
00015020 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015026 1029 0001                  		move.b	1(a1),d0	; read sprite number
0001502A 60E6                       		bra.s	SAnim_Next
0001502C                            ; ===========================================================================
0001502C                            
0001502C                            SAnim_End_FE:
0001502C 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0001502E 6600                       		bne.s	SAnim_End_FD	; if not, branch
00015030 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015034 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015038 9200                       		sub.b	d0,d1
0001503A 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0001503E 60D2                       		bra.s	SAnim_Next
00015040                            ; ===========================================================================
00015040                            
00015040                            SAnim_End_FD:
00015040 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015042 6600                       		bne.s	SAnim_End	; if not, branch
00015044 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
0001504A                            
0001504A                            SAnim_End:
0001504A 4E75                       		rts	
0001504C                            ; ===========================================================================
0001504C                            
0001504C                            SAnim_WalkRun:				; XREF: SAnim_Do
0001504C 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015050 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015052 5200                       		addq.b	#1,d0		; is animation walking/running?
00015054 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015058 7200                       		moveq	#0,d1
0001505A 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
0001505E 1428 0022                  		move.b	$22(a0),d2
00015062 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015066 6600                       		bne.s	loc_13A70	; if yes, branch
00015068 4600                       		not.b	d0		; reverse angle
0001506A                            
0001506A                            loc_13A70:
0001506A 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
0001506E 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015070 7203                       		moveq	#3,d1
00015072                            
00015072                            loc_13A78:
00015072 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015078 B302                       		eor.b	d1,d2
0001507A 8528 0001                  		or.b	d2,1(a0)
0001507E 0828 0005 0022             		btst	#5,$22(a0)
00015084 6600 0000                  		bne.w	SAnim_Push
00015088 E808                       		lsr.b	#4,d0		; divide angle by $10
0001508A 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
0001508E 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015092 6A00                       		bpl.s	loc_13A9C
00015094 4442                       		neg.w	d2
00015096                            
00015096                            loc_13A9C:
00015096 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
0001509C 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000150A0 6400                       		bcc.s	loc_13AB4	; if yes, branch
000150A2 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000150A8 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000150AC 6400                       		bcc.s	loc_13AB4	; if yes, branch
000150AE 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000150B4 1200                       		move.b	d0,d1
000150B6 E209                       		lsr.b	#1,d1
000150B8 D001                       		add.b	d1,d0
000150BA                            
000150BA                            loc_13AB4:
000150BA D000                       		add.b	d0,d0
000150BC 1600                       		move.b	d0,d3
000150BE 4442                       		neg.w	d2
000150C0 0642 0800                  		addi.w	#$800,d2
000150C4 6A00                       		bpl.s	loc_13AC2
000150C6 7400                       		moveq	#0,d2
000150C8                            
000150C8                            loc_13AC2:
000150C8 E04A                       		lsr.w	#8,d2
000150CA 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000150CE 6100 FF36                  		bsr.w	SAnim_Do2
000150D2 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000150D6 4E75                       		rts	
000150D8                            ; ===========================================================================
000150D8                            
000150D8                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000150D8 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000150DA 6600                       		bne.s	SAnim_Push	; if not, branch
000150DC 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000150E0 6A00                       		bpl.s	loc_13ADE
000150E2 4442                       		neg.w	d2
000150E4                            
000150E4                            loc_13ADE:
000150E4 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000150EA 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000150EE 6400                       		bcc.s	loc_13AF0	; if yes, branch
000150F0 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000150F6                            
000150F6                            loc_13AF0:
000150F6 4442                       		neg.w	d2
000150F8 0642 0400                  		addi.w	#$400,d2
000150FC 6A00                       		bpl.s	loc_13AFA
000150FE 7400                       		moveq	#0,d2
00015100                            
00015100                            loc_13AFA:
00015100 E04A                       		lsr.w	#8,d2
00015102 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015106 1228 0022                  		move.b	$22(a0),d1
0001510A 0201 0001                  		andi.b	#1,d1
0001510E 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015114 8328 0001                  		or.b	d1,1(a0)
00015118 6000 FEEC                  		bra.w	SAnim_Do2
0001511C                            ; ===========================================================================
0001511C                            
0001511C                            SAnim_Push:				; XREF: SAnim_RollJump
0001511C 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015120 6B00                       		bmi.s	loc_13B1E
00015122 4442                       		neg.w	d2
00015124                            
00015124                            loc_13B1E:
00015124 0642 0800                  		addi.w	#$800,d2
00015128 6A00                       		bpl.s	loc_13B26
0001512A 7400                       		moveq	#0,d2
0001512C                            
0001512C                            loc_13B26:
0001512C EC4A                       		lsr.w	#6,d2
0001512E 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015132 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00015138 1228 0022                  		move.b	$22(a0),d1
0001513C 0201 0001                  		andi.b	#1,d1
00015140 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015146 8328 0001                  		or.b	d1,1(a0)
0001514A 6000 FEBA                  		bra.w	SAnim_Do2
