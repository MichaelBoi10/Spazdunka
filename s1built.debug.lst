00015072 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
00015076 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
0001507C 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00015082                            
00015082                            SAnim_Do:
00015082 D040                       		add.w	d0,d0
00015084 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00015088 1011                       		move.b	(a1),d0
0001508A 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
0001508C 1228 0022                  		move.b	$22(a0),d1
00015090 0201 0001                  		andi.b	#1,d1
00015094 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001509A 8328 0001                  		or.b	d1,1(a0)
0001509E 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150A2 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000150A4 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000150A8                            
000150A8                            SAnim_Do2:
000150A8 7200                       		moveq	#0,d1
000150AA 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000150AE 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000150B2 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000150B6 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
000150B8                            
000150B8                            SAnim_Next:
000150B8 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000150BC 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000150C0                            
000150C0                            SAnim_Delay:
000150C0 4E75                       		rts	
000150C2                            ; ===========================================================================
000150C2                            
000150C2                            SAnim_End_FF:
000150C2 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000150C4 6600                       		bne.s	SAnim_End_FE	; if not, branch
000150C6 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
000150CC 1029 0001                  		move.b	1(a1),d0	; read sprite number
000150D0 60E6                       		bra.s	SAnim_Next
000150D2                            ; ===========================================================================
000150D2                            
000150D2                            SAnim_End_FE:
000150D2 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
000150D4 6600                       		bne.s	SAnim_End_FD	; if not, branch
000150D6 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
000150DA 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
000150DE 9200                       		sub.b	d0,d1
000150E0 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
000150E4 60D2                       		bra.s	SAnim_Next
000150E6                            ; ===========================================================================
000150E6                            
000150E6                            SAnim_End_FD:
000150E6 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
000150E8 6600                       		bne.s	SAnim_End	; if not, branch
000150EA 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
000150F0                            
000150F0                            SAnim_End:
000150F0 4E75                       		rts	
000150F2                            ; ===========================================================================
000150F2                            
000150F2                            SAnim_WalkRun:				; XREF: SAnim_Do
000150F2 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150F6 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
000150F8 5200                       		addq.b	#1,d0		; is animation walking/running?
000150FA 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
000150FE 7200                       		moveq	#0,d1
00015100 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015104 1428 0022                  		move.b	$22(a0),d2
00015108 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
0001510C 6600                       		bne.s	loc_13A70	; if yes, branch
0001510E 4600                       		not.b	d0		; reverse angle
00015110                            
00015110                            loc_13A70:
00015110 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015114 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015116 7203                       		moveq	#3,d1
00015118                            
00015118                            loc_13A78:
00015118 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001511E B302                       		eor.b	d1,d2
00015120 8528 0001                  		or.b	d2,1(a0)
00015124 0828 0005 0022             		btst	#5,$22(a0)
0001512A 6600 0000                  		bne.w	SAnim_Push
0001512E E808                       		lsr.b	#4,d0		; divide angle by $10
00015130 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015134 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015138 6A00                       		bpl.s	loc_13A9C
0001513A 4442                       		neg.w	d2
0001513C                            
0001513C                            loc_13A9C:
0001513C 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015140 6700                       		beq.s	Loc_NotSuper
00015142 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
00015148 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
0001514C 6400                       		bhs.s	SuperRun	; if yes, branch
0001514E 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
00015154 6000                       		bra.s	SuperWalk
00015156                            
00015156                            Loc_NotSuper:
00015156 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
