0001E092                            HudUpdate:
0001E092 4A78 FE08                  		tst.w	($FFFFFE08).w	; has the player entered debug mode?
0001E096 6600 0000                  		bne.w	HudDebug	; if yes, branch
0001E09A 4A38 FE1F                  		tst.b	($FFFFFE1F).w	; does the score need updating?
0001E09E 6700                       		beq.s	Hud_ChkRings	; if not, branch
0001E0A0 4238 FE1F                  		clr.b	($FFFFFE1F).w
0001E0A4 203C 5C80 0003             		move.l	#$5C800003,d0	; set VRAM address
0001E0AA 2238 FE26                  		move.l	($FFFFFE26).w,d1 ; load	score
0001E0AE 6100 0000                  		bsr.w	Hud_Score
0001E0B2                            
0001E0B2                            Hud_ChkRings:
0001E0B2 4A38 FE1D                  		tst.b	($FFFFFE1D).w	; does the ring	counter	need updating?
0001E0B6 6700                       		beq.s	Hud_ChkTime	; if not, branch
0001E0B8 6A00                       		bpl.s	loc_1C6E4
0001E0BA 6100 0000                  		bsr.w	Hud_LoadZero
