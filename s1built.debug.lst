00078D42                            ; ------------------------------------------------------------------------------
00078D42                            ; Plays a given sample
00078D42                            ; ------------------------------------------------------------------------------
00078D42                            ; INPUT:
00078D42                            ;		d0	.b		sample id (>$81)
00078D42                            ;
00078D42                            ; EXAMPLES:
00078D42                            ;		move.b	#$81, d0
00078D42                            ;		jsr		MegaPCM_PlaySample
00078D42                            ;
00078D42                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00078D42                            ;		jsr		MegaPCM_PlaySample
00078D42                            ; ------------------------------------------------------------------------------
00078D42                            
00078D42                            MegaPCM_PlaySample:
00078D42                            	MPCM_play	d0
00078D42                          M 	mpcm_stopz80
00078D42                          M 	pusho
00078D42                          M 	opt	l-
00078D42 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00078D4A                          M 	@wait_5:
00078D4A 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00078D52 66F6                     M 	bne.s	@wait_5
00078D54                          M 	popo
00078D54 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00078D5A                          M 	mpcm_startz80
00078D5A 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00078D62 4E75                       	rts
00078D64                            
