0000E394 2628 000C                  		move.l	$C(a0),d3
0000E398 3028 0010                  		move.w	$10(a0),d0	; load horizontal speed
0000E39C 48C0                       		ext.l	d0
0000E39E E180                       		asl.l	#8,d0		; multiply speed by $100
0000E3A0 D480                       		add.l	d0,d2		; add to x-axis	position
0000E3A2 3028 0012                  		move.w	$12(a0),d0	; load vertical	speed
0000E3A6 48C0                       		ext.l	d0
0000E3A8 E180                       		asl.l	#8,d0		; multiply by $100
0000E3AA D680                       		add.l	d0,d3		; add to y-axis	position
0000E3AC 2142 0008                  		move.l	d2,8(a0)	; update x-axis	position
0000E3B0 2143 000C                  		move.l	d3,y_pos(a0)	; update y-axis	position
0000E3B4 4E75                       		rts	
