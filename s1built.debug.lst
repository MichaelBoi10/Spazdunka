00014E1A                            locret_13914:
00014E1A 4E75                       		rts	
00014E1C                            
00014E1C                            ; ---------------------------------------------------------------------------
00014E1C                            ; Subroutine to	make Sonic run around loops (GHZ/SLZ)
00014E1C                            ; ---------------------------------------------------------------------------
00014E1C                            
00014E1C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014E1C                            
00014E1C                            
00014E1C                            Sonic_Loops:				; XREF: Obj01_Control
00014E1C 0C38 0003 FE10             		cmpi.b	#3,($FFFFFE10).w ; is level SLZ	?
00014E22 6700                       		beq.s	loc_13926	; if yes, branch
00014E24 4A38 FE10                  		tst.b	($FFFFFE10).w	; is level GHZ ?
00014E28 6600 0000                  		bne.w	locret_139C2	; if not, branch
00014E2C                            
00014E2C                            loc_13926:
00014E2C 3028 000C                  		move.w	$C(a0),d0
00014E30 E248                       		lsr.w	#1,d0
00014E32 0240 0380                  		andi.w	#$380,d0
00014E36 1228 0008                  		move.b	8(a0),d1
00014E3A 0241 007F                  		andi.w	#$7F,d1
00014E3E D041                       		add.w	d1,d0
00014E40 43F8 A400                  		lea	($FFFFA400).w,a1
00014E44 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
00014E48 B238 F7AE                  		cmp.b	($FFFFF7AE).w,d1
00014E4C 6700 F68E                  		beq.w	Obj01_ChkRoll
00014E50 B238 F7AF                  		cmp.b	($FFFFF7AF).w,d1
00014E54 6700 F686                  		beq.w	Obj01_ChkRoll
00014E58 B238 F7AC                  		cmp.b	($FFFFF7AC).w,d1
00014E5C 6700                       		beq.s	loc_13976
00014E5E B238 F7AD                  		cmp.b	($FFFFF7AD).w,d1
00014E62 6700                       		beq.s	loc_13966
00014E64 08A8 0006 0001             		bclr	#6,render_flags(a0)
00014E6A 4E75                       		rts	
00014E6C                            ; ===========================================================================
00014E6C                            
00014E6C                            loc_13966:
00014E6C 0828 0001 0022             		btst	#1,status(a0)
00014E72 6700                       		beq.s	loc_13976
00014E74 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
00014E7A 4E75                       		rts	
00014E7C                            ; ===========================================================================
00014E7C                            
00014E7C                            loc_13976:
00014E7C 3428 0008                  		move.w	8(a0),d2
00014E80 0C02 002C                  		cmpi.b	#$2C,d2
00014E84 6400                       		bcc.s	loc_13988
00014E86 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
00014E8C 4E75                       		rts	
00014E8E                            ; ===========================================================================
00014E8E                            
00014E8E                            loc_13988:
00014E8E 0C02 00E0                  		cmpi.b	#-$20,d2
00014E92 6500                       		bcs.s	loc_13996
00014E94 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
00014E9A 4E75                       		rts	
00014E9C                            ; ===========================================================================
00014E9C                            
00014E9C                            loc_13996:
00014E9C 0828 0006 0001             		btst	#6,render_flags(a0)
00014EA2 6600                       		bne.s	loc_139B2
00014EA4 1228 0026                  		move.b	$26(a0),d1
00014EA8 6700                       		beq.s	locret_139C2
00014EAA 0C01 0080                  		cmpi.b	#-$80,d1
00014EAE 6200                       		bhi.s	locret_139C2
00014EB0 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
00014EB6 4E75                       		rts	
00014EB8                            ; ===========================================================================
00014EB8                            
00014EB8                            loc_139B2:
00014EB8 1228 0026                  		move.b	$26(a0),d1
00014EBC 0C01 0080                  		cmpi.b	#-$80,d1
00014EC0 6300                       		bls.s	locret_139C2
00014EC2 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
00014EC8                            
00014EC8                            locret_139C2:
00014EC8 4E75                       		rts	
00014ECA                            ; End of function Sonic_Loops
