0000DC68 363C 0011                  		move.w	#$11,d3
0000DC6C 3828 0008                  		move.w	8(a0),d4
0000DC70 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DC74 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DC7A 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DC7C 4A44                       		tst.w	d4			; check response value from SolidObject
0000DC7E 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DC80 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DC84 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DC88 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DC8E 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DC90 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DC92 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DC94 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DC96                            		; otherwise, fall through to Spik_Hurt
