000149D8 4E75                       		rts	
000149DA                            ; ---------------------------------------------------------------------------
000149DA                             
000149DA                            SCDPeelout_Launch:
000149DA 1038 F602                  		move.b	($FFFFF602).w,d0
000149DE 0800 0000                  		btst	#0,d0
000149E2 6600 0000                  		bne.w	SCDPeelout_Charge
000149E6 08A8 0001 0039             		bclr	#1,$39(a0)	; stop Dashing
000149EC 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)	; have we been charging long enough?
000149F2 6600                       		bne.s	SCDPeelout_Stop_Sound
000149F4 117C 0000 001C             		move.b	#0,$1C(a0)	; launches here (peelout sprites)
000149FA 317C 0001 0010             		move.w	#1,$10(a0)	; force X speed to nonzero for camera lag's benefit
00014A00 3028 0014                  		move.w	$14(a0),d0
00014A04 0440 0800                  		subi.w	#$800,d0
00014A08 D040                       		add.w	d0,d0
00014A0A 0240 0800                  		andi.w	#$800,d0
00014A0E 4440                       		neg.w	d0
00014A10 0640 0800                  		addi.w	#$800,d0
00014A14                            		;move.w	d0,(v_cameralag).w
00014A14 0828 0000 0022             		btst	#0,$22(a0)
00014A1A 6700                       		beq.s	@dontflip
00014A1C 4468 0014                  		neg.w	$14(a0)
00014A20                             
00014A20                            @dontflip:
00014A20 08A8 0007 0022             		bclr	#7,$22(a0)
00014A26 303C 00D3                  		move.w	#$D3,d0
00014A2A 4EB9 0000 1034             		jsr		(PlaySound_Special).l
00014A30                            		; sfx 	sfx_PeeloutRelease
00014A30 6000 0000                  		bra.w	SCDPeelout_ResetScr
00014A34                            ; ---------------------------------------------------------------------------
00014A34                             
00014A34                            SCDPeelout_Charge:				; If still charging the dash...
00014A34 3238 F760                  		move.w	($FFFFF760).w,d1	; get top peelout speed
00014A38 3401                       		move.w	d1,d2
00014A3A D241                       		add.w	d1,d1
00014A3C 4A38 FE2E                  		tst.b   ($FFFFFE2E).w 		; test for speed shoes
00014A40 6700                       		beq.s	@noshoes
00014A42 E242                       		asr.w	#1,d2
00014A44 9242                       		sub.w	d2,d1
00014A46                            
00014A46                            @noshoes:
00014A46 0668 0064 0014             		addi.w	#$64,$14(a0)		; increment speed
00014A4C B268 0014                  		cmp.w	$14(a0),d1
00014A50 6E00                       		bgt.s	@inctimer
00014A52 3141 0014                  		move.w	d1,$14(a0)
00014A56                            
00014A56                            @inctimer:
