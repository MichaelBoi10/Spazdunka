00081FAA                            @ErrorCodeToDescription:
00081FAA                            	;		Raw error code								  String pointer
00081FAA 0000 0000                  	dc.l	(MPCM_ST_TOO_MANY_SAMPLES<<24) 				| @Str_TooManySamples
00081FAE 0000 0000                  	dc.l	(MPCM_ST_UNKNOWN_SAMPLE_TYPE<<24)			| @Str_UnknownSampleType
00081FB2 0000 0000                  	dc.l	(MPCM_ST_PITCH_NOT_SET<<24)					| @Str_PitchNotSet
00081FB6 0000 0000                  	dc.l	(MPCM_ST_WAVE_INVALID_HEADER<<24)			| @Str_WaveInvalidHeader
00081FBA 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_AUDIO_FORMAT<<24)			| @Str_WaveBadAudioFormat
00081FBE 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_MONO<<24)					| @Str_WaveNotMono
00081FC2 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_8BIT<<24)					| @Str_WaveNot8bit
00081FC6 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_SAMPLE_RATE<<24)			| @Str_WaveBadSampleRate
00081FCA 0000 0000                  	dc.l	(MPCM_ST_WAVE_MISSING_DATA_CHUNK<<24)		| @Str_WaveMissingDataChunk
00081FCE 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_UNSUPPORTED_VERSION<<24)	| @Str_DpcmHqUnsupportedVersion
00081FD2 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_BAD_SAMPLE_RATE<<24)		| @Str_DpcmHqBadSampleRate
00081FD6 FF00                       	dc.b	$FF, 0		; end marker
00081FD8                            
00081FD8                            ; ------------------------------------------------------------------------------
00081FD8                            @Str_TooManySamples:
00081FD8 546F 6F20 6D61 6E79 2073+  	dc.b	"Too many samples in table", 0
00081FF2                            @Str_UnknownSampleType:
00081FF2 556E 6B6E 6F77 6E20 7361+  	dc.b	"Unknown sample type or missing end marker. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE", 0
0008205F                            @Str_PitchNotSet:
0008205F 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
000820B6                            @Str_WaveInvalidHeader:
000820B6 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
000820D6                            @Str_WaveBadAudioFormat:
000820D6 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported audio format. Only PCM is supported", 0
00082112                            @Str_WaveNotMono:
00082112 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be mono", 0
00082131                            @Str_WaveNot8bit:
00082131 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be 8-bit unsigned PCM", 0
0008215E                            @Str_WaveBadSampleRate:
0008215E 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported sample rate. Use <=\#TYPE_PCM_MAX_RATE\ Hz for TYPE_PCM or \#TYPE_PCM_TURBO_MAX_RATE\ Hz for TYPE_PCM_TURBO.", 0
000821BF                            @Str_WaveMissingDataChunk:
000821BF 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Failed to locate 'data' chunk", 0
000821E9                            @Str_DpcmHqUnsupportedVersion:
000821E9 4450 434D 2D48 5120 6572+  	dc.b	"DPCM-HQ error: Unsupported version specified in header", 0
00082220                            @Str_DpcmHqBadSampleRate:
00082220 4450 434D 2D48 5120 6572+  	dc.b	"DPCM-HQ error: Unsupported sample rate. Use <=\#TYPE_DPCM_MAX_RATE\ Hz for TYPE_DPCM or \#TYPE_DPCM_TURBO_MAX_RATE\ Hz for TYPE_DPCM_TURBO.", 0
00082286                            @Str_UnknownError:
00082286 556B 6E6F 776E 2065 7272+  	dc.b	"Uknown error code", 0
