000DA56E                            ; O c�digo deve ficar como abaixo
000DA56E                            ;               ......................
000DA56E                            ; loc_3242:
000DA56E                            ;		tst.b	($FFFFFFE0).w
000DA56E                            ;		beq.w	PlayLevel	
000DA56E                            ;		btst	#6,($FFFFF604).w 
