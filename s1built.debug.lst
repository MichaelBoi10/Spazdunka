0001481E                            ; loc_1AB38: test_set_SS:
0001481E                            Sonic_CheckGoSuper:
0001481E 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014822 6600 0000                  	bne.w	Sonic_RevertToNormal		; if yes, branch
00014826 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
0001482C 6600                       	bne.s	return_1ABA4		; if not, branch
0001482E 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014834 6500                       	bcs.s	return_1ABA4		; if not, branch
00014836 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
0001483A 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
0001483E 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014844 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
0001484A 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
00014850 11FC 0001 F7C8             	move.b	#1,($FFFFF7C8).w ; lock	controls
00014856 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
0001485C 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
00014862 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014868 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
0001486E 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014874 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
0001487A 303C 00D4                  	move.w	#$D4,d0         ; 
0001487E 4EB9 0000 1034             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
00014884 303C 0087                  	move.w	#$87,d0
00014888 4EF9 0000 102E             	jmp	(PlaySound).l	; Play the super theme
0001488E                            ; ---------------------------------------------------------------------------
0001488E                            return_1ABA4:
0001488E 4E75                       	rts
00014890                            ; End of subroutine Sonic_CheckGoSuper
