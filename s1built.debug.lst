0001521A                            ; ---------------------------------------------------------------------------
0001521A                            ; Sonic	when the level is restarted
0001521A                            ; ---------------------------------------------------------------------------
0001521A                            
0001521A                            Obj01_ResetLevel:			; XREF: Obj01_Index
0001521A 4A68 003A                  		tst.w	$3A(a0)
0001521E 6700                       		beq.s	locret_13914
00015220 5368 003A                  		subq.w	#1,$3A(a0)	; subtract 1 from time delay
00015224 6600                       		bne.s	locret_13914
00015226 31FC 0001 FE02             		move.w	#1,($FFFFFE02).w ; restart the level
0001522C                            
0001522C                            locret_13914:
0001522C 4E75                       		rts	
0001522E                            
0001522E                            ; ---------------------------------------------------------------------------
0001522E                            ; Subroutine to	make Sonic run around loops (GHZ/SLZ)
0001522E                            ; ---------------------------------------------------------------------------
0001522E                            
0001522E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001522E                            
0001522E                            
0001522E                            Sonic_Loops:				; XREF: Obj01_Control
0001522E 0C38 0003 FE10             		cmpi.b	#3,($FFFFFE10).w ; is level SLZ	?
00015234 6700                       		beq.s	loc_13926	; if yes, branch
00015236 4A38 FE10                  		tst.b	($FFFFFE10).w	; is level GHZ ?
0001523A 6600 0000                  		bne.w	locret_139C2	; if not, branch
0001523E                            
0001523E                            loc_13926:
0001523E 3028 000C                  		move.w	$C(a0),d0
00015242 E248                       		lsr.w	#1,d0
00015244 0240 0380                  		andi.w	#$380,d0
00015248 1228 0008                  		move.b	8(a0),d1
0001524C 0241 007F                  		andi.w	#$7F,d1
00015250 D041                       		add.w	d1,d0
00015252 43F8 A400                  		lea	($FFFFA400).w,a1
00015256 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
0001525A B238 F7AE                  		cmp.b	($FFFFF7AE).w,d1
0001525E 6700 F68E                  		beq.w	Obj01_ChkRoll
00015262 B238 F7AF                  		cmp.b	($FFFFF7AF).w,d1
00015266 6700 F686                  		beq.w	Obj01_ChkRoll
0001526A B238 F7AC                  		cmp.b	($FFFFF7AC).w,d1
0001526E 6700                       		beq.s	loc_13976
00015270 B238 F7AD                  		cmp.b	($FFFFF7AD).w,d1
00015274 6700                       		beq.s	loc_13966
00015276 08A8 0006 0001             		bclr	#6,render_flags(a0)
0001527C 4E75                       		rts	
0001527E                            ; ===========================================================================
0001527E                            
0001527E                            loc_13966:
0001527E 0828 0001 0022             		btst	#1,status(a0)
00015284 6700                       		beq.s	loc_13976
00015286 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
0001528C 4E75                       		rts	
0001528E                            ; ===========================================================================
0001528E                            
0001528E                            loc_13976:
0001528E 3428 0008                  		move.w	8(a0),d2
00015292 0C02 002C                  		cmpi.b	#$2C,d2
00015296 6400                       		bcc.s	loc_13988
00015298 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
0001529E 4E75                       		rts	
000152A0                            ; ===========================================================================
000152A0                            
000152A0                            loc_13988:
000152A0 0C02 00E0                  		cmpi.b	#-$20,d2
000152A4 6500                       		bcs.s	loc_13996
000152A6 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
000152AC 4E75                       		rts	
000152AE                            ; ===========================================================================
000152AE                            
000152AE                            loc_13996:
000152AE 0828 0006 0001             		btst	#6,render_flags(a0)
000152B4 6600                       		bne.s	loc_139B2
000152B6 1228 0026                  		move.b	$26(a0),d1
000152BA 6700                       		beq.s	locret_139C2
000152BC 0C01 0080                  		cmpi.b	#-$80,d1
000152C0 6200                       		bhi.s	locret_139C2
000152C2 08E8 0006 0001             		bset	#6,render_flags(a0)	; send Sonic to	low plane
000152C8 4E75                       		rts	
000152CA                            ; ===========================================================================
000152CA                            
000152CA                            loc_139B2:
000152CA 1228 0026                  		move.b	$26(a0),d1
000152CE 0C01 0080                  		cmpi.b	#-$80,d1
000152D2 6300                       		bls.s	locret_139C2
000152D4 08A8 0006 0001             		bclr	#6,render_flags(a0)	; send Sonic to	high plane
000152DA                            
000152DA                            locret_139C2:
000152DA 4E75                       		rts	
000152DC                            ; End of function Sonic_Loops
