00014B04 4A78 FE20                  	tst.w	(Ring_count).w
00014B08 6700                       	beq.s	Sonic_RevertToNormal
00014B0A 0038 0001 FE1D             	ori.b	#1,(Update_HUD_rings).w
00014B10 0C78 0001 FE20             	cmpi.w	#1,(Ring_count).w
00014B16 6700                       	beq.s	@update
00014B18 0C78 000A FE20             	cmpi.w	#10,(Ring_count).w
00014B1E 6700                       	beq.s	@update
