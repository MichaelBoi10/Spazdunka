000800C6                            
000800C6                            
000800C6                            ; ------------------------------------------------------------------------------
000800C6                            ; Plays a given sample
000800C6                            ; ------------------------------------------------------------------------------
000800C6                            ; INPUT:
000800C6                            ;		d0	.b		sample id (>$81)
000800C6                            ;
000800C6                            ; EXAMPLES:
000800C6                            ;		move.b	#$81, d0
000800C6                            ;		jsr		MegaPCM_PlaySample
000800C6                            ;
000800C6                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
000800C6                            ;		jsr		MegaPCM_PlaySample
000800C6                            ; ------------------------------------------------------------------------------
000800C6                            
000800C6                            MegaPCM_PlaySample:
000800C6                            	MPCM_play	d0
000800C6                          M 	mpcm_stopz80
000800C6                          M 	pusho
000800C6                          M 	opt	l-
000800C6 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
000800CE                          M 	@wait_8:
000800CE 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
000800D6 66F6                     M 	bne.s	@wait_8
000800D8                          M 	popo
000800D8 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
000800DE                          M 	mpcm_startz80
000800DE 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
000800E6 4E75                       	rts
000800E8                            
000800E8                            ; ------------------------------------------------------------------------------
