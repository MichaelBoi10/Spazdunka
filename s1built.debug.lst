0000B3EA                            AnimateSprite:
0000B3EA 7000                       		moveq	#0,d0
0000B3EC 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B3F0 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B3F4 6700                       		beq.s	Anim_Run	; if not, branch
0000B3F6 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B3FA 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B400 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B406                            
0000B406                            Anim_Run:
0000B406 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B40A 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B40C D040                       		add.w	d0,d0
0000B40E D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B412 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B416 7200                       		moveq	#0,d1
0000B418 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B41C 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B420 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B422                            
0000B422                            Anim_Next:
0000B422 1200                       		move.b	d0,d1
0000B424 0200 001F                  		andi.b	#$1F,d0
0000B428 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B42C 1028 0022                  		move.b	$22(a0),d0
0000B430 E719                       		rol.b	#3,d1
0000B432 B101                       		eor.b	d0,d1
0000B434 0201 0003                  		andi.b	#3,d1
0000B438 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B43E 8328 0001                  		or.b	d1,render_flags(a0)
0000B442 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B446                            
0000B446                            Anim_Wait:
0000B446 4E75                       		rts	
0000B448                            ; ===========================================================================
0000B448                            
0000B448                            Anim_End_FF:
0000B448 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B44A 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B44C 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B452 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B456 60CA                       		bra.s	Anim_Next
0000B458                            ; ===========================================================================
0000B458                            
0000B458                            Anim_End_FE:
0000B458 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B45A 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B45C 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B460 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B464 9200                       		sub.b	d0,d1
0000B466 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B46A 60B6                       		bra.s	Anim_Next
0000B46C                            ; ===========================================================================
0000B46C                            
0000B46C                            Anim_End_FD:
0000B46C 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B46E 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B470 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B476                            
0000B476                            Anim_End_FC:
0000B476 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B478 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B47A 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B47E                            
0000B47E                            Anim_End_FB:
0000B47E 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B480 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B482 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B488 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B48C                            
0000B48C                            Anim_End_FA:
0000B48C 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B48E 6600                       		bne.s	Anim_End	; if not, branch
0000B490 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B494                            
0000B494                            Anim_End:
0000B494 4E75                       		rts	
0000B496                            ; End of function AnimateSprite
