000150BA 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000150BC 6600                       		bne.s	SAnim_Push	; if not, branch
000150BE 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000150C2 6A00                       		bpl.s	loc_13ADE
000150C4 4442                       		neg.w	d2
000150C6                            
