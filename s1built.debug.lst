0007927B                            @Str_WaveMissingDataChunk:
0007927B 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Failed to locate 'data' chunk", 0
000792A5                            @Str_DpcmHqUnsupportedVersion:
