00015146                            
00015146                            ; ---------------------------------------------------------------------------
00015146                            ; Subroutine to	stop Sonic falling after he's been hurt
00015146                            ; ---------------------------------------------------------------------------
00015146                            
00015146                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00015146                            
00015146                            
00015146                            Sonic_HurtStop:				; XREF: Obj01_Hurt
00015146 3038 F72E                  		move.w	($FFFFF72E).w,d0
0001514A 0640 00E0                  		addi.w	#$E0,d0
0001514E B068 000C                  		cmp.w	$C(a0),d0
00015152 6500 F752                  		bcs.w	JmpTo_KillSonic
00015156 6100 FD70                  		bsr.w	Sonic_Floor
0001515A 0828 0001 0022             		btst	#1,status(a0)
00015160 6600                       		bne.s	locret_13860
00015162 7000                       		moveq	#0,d0
00015164 3140 0012                  		move.w	d0,y_vel(a0)
00015168 3140 0010                  		move.w	d0,x_vel(a0)
0001516C 3140 0014                  		move.w	d0,$14(a0)
00015170 117C 0000 001C             		move.b	#0,anim(a0)
00015176 5528 0024                  		subq.b	#2,routine(a0)
0001517A 317C 0078 0030             		move.w	#$78,$30(a0)
00015180                            
00015180                            locret_13860:
00015180 4E75                       		rts	
00015182                            ; End of function Sonic_HurtStop
00015182                            
00015182                            ; ===========================================================================
00015182                            ; ---------------------------------------------------------------------------
00015182                            ; Sonic	when he	dies
00015182                            ; ---------------------------------------------------------------------------
00015182                            
00015182                            Obj01_Death:				; XREF: Obj01_Index
00015182 6100 0000                  		bsr.w	GameOver
00015186 4EBA 93DE                  		jsr	ObjectFall
0001518A 6100 EF3C                  		bsr.w	Sonic_RecordPos
0001518E 6100 0000                  		bsr.w	Sonic_Animate
00015192 6100 0000                  		bsr.w	LoadSonicDynPLC
00015196 4EFA 9420                  		jmp	DisplaySprite
0001519A                            
0001519A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001519A                            
0001519A                            
0001519A                            GameOver:				; XREF: Obj01_Death
0001519A 3038 F704                  		move.w	($FFFFF704).w,d0
0001519E 0640 0100                  		addi.w	#$100,d0
000151A2 B068 000C                  		cmp.w	$C(a0),d0
000151A6 6C00 0000                  		bge.w	locret_13900
000151AA 317C FFC8 0012             		move.w	#-$38,y_vel(a0)
000151B0 5428 0024                  		addq.b	#2,routine(a0)
000151B4 4238 FE1E                  		clr.b	($FFFFFE1E).w	; stop time counter
000151B8 5238 FE1C                  		addq.b	#1,($FFFFFE1C).w ; update lives	counter
000151BC 5338 FE12                  		subq.b	#1,($FFFFFE12).w ; subtract 1 from number of lives
000151C0 6600                       		bne.s	loc_138D4
000151C2 317C 0000 003A             		move.w	#0,$3A(a0)
000151C8 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load GAME object
000151CE 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
000151D4 11FC 0001 D0DA             		move.b	#1,($FFFFD0DA).w ; set OVER object to correct frame
000151DA 4238 FE1A                  		clr.b	($FFFFFE1A).w
000151DE                            
000151DE                            loc_138C2:
000151DE 11FC 0014 F600             		move.b	#$14,($FFFFF600).w ; set mode to $14 (continue screen)
000151E4 7003                       		moveq	#3,d0
000151E6 4EF9 0000 12AC             		jmp	(LoadPLC).l	; load game over patterns
000151EC                            ; ===========================================================================
000151EC                            
000151EC                            loc_138D4:
000151EC 317C 003C 003A             		move.w	#60,$3A(a0)	; set time delay to 1 second
000151F2 4A38 FE1A                  		tst.b	($FFFFFE1A).w	; is TIME OVER tag set?
000151F6 6700                       		beq.s	locret_13900	; if not, branch
000151F8 317C 0000 003A             		move.w	#0,$3A(a0)
000151FE 11FC 0039 D080             		move.b	#$39,($FFFFD080).w ; load TIME object
00015204 11FC 0039 D0C0             		move.b	#$39,($FFFFD0C0).w ; load OVER object
0001520A 11FC 0002 D09A             		move.b	#2,($FFFFD09A).w
00015210 11FC 0003 D0DA             		move.b	#3,($FFFFD0DA).w
00015216 60C6                       		bra.s	loc_138C2
00015218                            ; ===========================================================================
00015218                            
00015218                            locret_13900:
00015218 4E75                       		rts	
0001521A                            ; End of function GameOver
