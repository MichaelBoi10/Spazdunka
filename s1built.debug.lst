000800E8 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
000800F0                          M 	@wait_11:
000800F0 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
000800F8 66F6                     M 	bne.s	@wait_11
000800FA                          M 	popo
000800FA 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00080102                          M 	mpcm_startz80
00080102 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
0008010A 4E75                       	rts
