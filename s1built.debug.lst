001972DA                            ; O c�digo deve ficar como abaixo
001972DA                            ;               ......................
001972DA                            ; loc_3242:
001972DA                            ;		tst.b	($FFFFFFE0).w
001972DA                            ;		beq.w	PlayLevel	
001972DA                            ;		btst	#6,($FFFFF604).w 
001972DA                            ;		beq.w	PlayLevel	  		
001972DA                            ;		jmp     Level_Select_Menu ; <- Carrega o Menu do Sonic 2	
