000147D0                            ; Subroutine called at the peak of a jump that transforms Sonic into Super Sonic
000147D0                            ; if he has enough rings and emeralds
000147D0                            ; ---------------------------------------------------------------------------
000147D0                            
000147D0                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
