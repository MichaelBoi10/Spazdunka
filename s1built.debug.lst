000010DC                            ; ---------------------------------------------------------------------------
000010DC                            ; Subroutine to load VDP commands into the DMA transfer queue
000010DC                            ;
000010DC                            ; In case you wish to use this queue system outside of the spin dash, this is the
000010DC                            ; registers in which it expects data in:
000010DC                            ; d1.l: Address to data (In 68k address space)
000010DC                            ; d2.w: Destination in VRAM
000010DC                            ; d3.w: Length of data
000010DC                            ; ---------------------------------------------------------------------------
000010DC                            
000010DC                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000010DC                            
