000146E8 6600                       	bne.s	return_1ABA4		; if yes, branch
000146EA 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
000146F0 6600                       	bne.s	return_1ABA4		; if not, branch
000146F2 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
000146F8 6500                       	bcs.s	return_1ABA4		; if not, branch
000146FA                            
