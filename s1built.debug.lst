00014E86                            ; Subroutine to	animate	Sonic's sprites
00014E86                            ; ---------------------------------------------------------------------------
00014E86                            
00014E86                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014E86                            
00014E86                            
00014E86                            Sonic_Animate:				; XREF: Obj01_Control; et al
00014E86 43F9 0000 0000             		lea	(SonicAniData).l,a1
00014E8C 7000                       		moveq	#0,d0
00014E8E 1028 001C                  		move.b	$1C(a0),d0
00014E92 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00014E96 6700                       		beq.s	SAnim_Do	; if not, branch
00014E98 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
00014E9C 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00014EA2 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00014EA8                            
00014EA8                            SAnim_Do:
00014EA8 D040                       		add.w	d0,d0
00014EAA D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00014EAE 1011                       		move.b	(a1),d0
00014EB0 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00014EB2 1228 0022                  		move.b	$22(a0),d1
00014EB6 0201 0001                  		andi.b	#1,d1
00014EBA 0228 00FC 0001             		andi.b	#$FC,1(a0)
00014EC0 8328 0001                  		or.b	d1,1(a0)
00014EC4 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00014EC8 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00014ECA 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00014ECE                            
00014ECE                            SAnim_Do2:
00014ECE 7200                       		moveq	#0,d1
00014ED0 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
00014ED4 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00014ED8 6B00                       		bmi.s	SAnim_End_FF	; if animation is complete, branch
00014EDA                            
00014EDA                            SAnim_Next:
00014EDA 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00014EDE 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00014EE2                            
00014EE2                            SAnim_Delay:
00014EE2 4E75                       		rts	
00014EE4                            ; ===========================================================================
00014EE4                            
00014EE4                            SAnim_End_FF:
00014EE4 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00014EE6 6600                       		bne.s	SAnim_End_FE	; if not, branch
00014EE8 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00014EEE 1029 0001                  		move.b	1(a1),d0	; read sprite number
00014EF2 60E6                       		bra.s	SAnim_Next
00014EF4                            ; ===========================================================================
00014EF4                            
00014EF4                            SAnim_End_FE:
00014EF4 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00014EF6 6600                       		bne.s	SAnim_End_FD	; if not, branch
00014EF8 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00014EFC 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00014F00 9200                       		sub.b	d0,d1
00014F02 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00014F06 60D2                       		bra.s	SAnim_Next
00014F08                            ; ===========================================================================
00014F08                            
00014F08                            SAnim_End_FD:
00014F08 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00014F0A 6600                       		bne.s	SAnim_End	; if not, branch
00014F0C 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00014F12                            
00014F12                            SAnim_End:
00014F12 4E75                       		rts	
00014F14                            ; ===========================================================================
00014F14                            
00014F14                            SAnim_WalkRun:				; XREF: SAnim_Do
00014F14 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00014F18 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00014F1A 5200                       		addq.b	#1,d0		; is animation walking/running?
00014F1C 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00014F20 7200                       		moveq	#0,d1
00014F22 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00014F26 1428 0022                  		move.b	$22(a0),d2
00014F2A 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00014F2E 6600                       		bne.s	loc_13A70	; if yes, branch
00014F30 4600                       		not.b	d0		; reverse angle
00014F32                            
00014F32                            loc_13A70:
00014F32 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00014F36 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00014F38 7203                       		moveq	#3,d1
00014F3A                            
00014F3A                            loc_13A78:
00014F3A 0228 00FC 0001             		andi.b	#$FC,1(a0)
00014F40 B302                       		eor.b	d1,d2
00014F42 8528 0001                  		or.b	d2,1(a0)
00014F46 0828 0005 0022             		btst	#5,$22(a0)
00014F4C 6600 0000                  		bne.w	SAnim_Push
00014F50 E808                       		lsr.b	#4,d0		; divide angle by $10
00014F52 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00014F56 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00014F5A 6A00                       		bpl.s	loc_13A9C
00014F5C 4442                       		neg.w	d2
00014F5E                            
00014F5E                            loc_13A9C:
00014F5E 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00014F64 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00014F68 6400                       		bcc.s	loc_13AB4	; if yes, branch
00014F6A 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
00014F70 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00014F74 6400                       		bcc.s	loc_13AB4	; if yes, branch
00014F76 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00014F7C 1200                       		move.b	d0,d1
00014F7E E209                       		lsr.b	#1,d1
00014F80 D001                       		add.b	d1,d0
00014F82                            
00014F82                            loc_13AB4:
00014F82 D000                       		add.b	d0,d0
00014F84 1600                       		move.b	d0,d3
00014F86 4442                       		neg.w	d2
00014F88 0642 0800                  		addi.w	#$800,d2
00014F8C 6A00                       		bpl.s	loc_13AC2
00014F8E 7400                       		moveq	#0,d2
00014F90                            
00014F90                            loc_13AC2:
00014F90 E04A                       		lsr.w	#8,d2
00014F92 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00014F96 6100 FF36                  		bsr.w	SAnim_Do2
00014F9A D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
00014F9E 4E75                       		rts	
00014FA0                            ; ===========================================================================
00014FA0                            
00014FA0                            SAnim_RollJump:				; XREF: SAnim_WalkRun
00014FA0 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
00014FA2 6600                       		bne.s	SAnim_Push	; if not, branch
00014FA4 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00014FA8 6A00                       		bpl.s	loc_13ADE
00014FAA 4442                       		neg.w	d2
00014FAC                            
00014FAC                            loc_13ADE:
00014FAC 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
00014FB2 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00014FB6 6400                       		bcc.s	loc_13AF0	; if yes, branch
00014FB8 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
00014FBE                            
00014FBE                            loc_13AF0:
00014FBE 4442                       		neg.w	d2
00014FC0 0642 0400                  		addi.w	#$400,d2
00014FC4 6A00                       		bpl.s	loc_13AFA
00014FC6 7400                       		moveq	#0,d2
00014FC8                            
00014FC8                            loc_13AFA:
00014FC8 E04A                       		lsr.w	#8,d2
00014FCA 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00014FCE 1228 0022                  		move.b	$22(a0),d1
00014FD2 0201 0001                  		andi.b	#1,d1
00014FD6 0228 00FC 0001             		andi.b	#$FC,1(a0)
00014FDC 8328 0001                  		or.b	d1,1(a0)
00014FE0 6000 FEEC                  		bra.w	SAnim_Do2
00014FE4                            ; ===========================================================================
00014FE4                            
00014FE4                            SAnim_Push:				; XREF: SAnim_RollJump
00014FE4 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00014FE8 6B00                       		bmi.s	loc_13B1E
00014FEA 4442                       		neg.w	d2
00014FEC                            
00014FEC                            loc_13B1E:
