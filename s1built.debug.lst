00014A12 6600                       		bne.s	locret2_1AC8C		; if not, return
00014A14 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014A18 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
