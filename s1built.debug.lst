0000B068 4EB9 0000 0000             		jsr	Touch_ChkHurt	; run the Touch_ChkHurt routine
0000B06E 205F                       		move.l	(sp)+,a0	; pop the previous value of a0 from the stack, and increment stack pointer
0000B070 4E75                       		rts
