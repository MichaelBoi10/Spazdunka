00079A98 66F6                     M 	bne.s	@wait_14
00079A9A                          M 	popo
00079A9A 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00079AA0                          M 	mpcm_startz80
00079AA0 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00079AA8 4E75                       	rts
