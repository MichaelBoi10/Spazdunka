0000D978                            Obj36_Solid:				; XREF: Obj36_Index
0000D978 6100 0000                  		bsr.w	Obj36_Type0x	; make the object move
0000D97C 343C 0004                  		move.w	#4,d2
0000D980 0C28 0005 001A             		cmpi.b	#5,mapping_frame(a0)	; is object type $5x ?
0000D986 6700                       		beq.s	Obj36_SideWays	; if yes, branch
0000D988 0C28 0001 001A             		cmpi.b	#1,mapping_frame(a0)	; is object type $1x ?
0000D98E 6600                       		bne.s	Obj36_Upright	; if not, branch
0000D990 343C 0014                  		move.w	#$14,d2
0000D994                            
0000D994                            ; Spikes types $1x and $5x face	sideways
0000D994                            
0000D994                            Obj36_SideWays:				; XREF: Obj36_Solid
0000D994 323C 001B                  		move.w	#$1B,d1
0000D998 3602                       		move.w	d2,d3
0000D99A 5243                       		addq.w	#1,d3
0000D99C 3828 0008                  		move.w	8(a0),d4
0000D9A0 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000D9A4 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000D9A8 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000D9AC 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000D9B0 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000D9B6 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000D9B8 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000D9BA 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000D9BC 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000D9BE 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000D9C0                            ; ===========================================================================
0000D9C0                            
0000D9C0                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000D9C0                            
0000D9C0                            Obj36_Upright:				; XREF: Obj36_Solid
0000D9C0 7200                       		moveq	#0,d1
0000D9C2 1228 0019                  		move.b	$19(a0),d1
0000D9C6 0641 000B                  		addi.w	#$B,d1
0000D9CA 343C 0010                  		move.w	#$10,d2
0000D9CE 363C 0011                  		move.w	#$11,d3
0000D9D2 3828 0008                  		move.w	8(a0),d4
0000D9D6 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000D9DA 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000D9E0 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000D9E2 4A44                       		tst.w	d4			; check response value from SolidObject
0000D9E4 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000D9E6 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000D9EA 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000D9EE 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000D9F4 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000D9F6 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000D9F8 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000D9FA 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000D9FC                            		; otherwise, fall through to Spik_Hurt
0000D9FC                            
0000D9FC                            Obj36_Hurt:				; XREF: Obj36_SideWays; Obj36_Upright
0000D9FC 4A38 FE2D                  		tst.b	($FFFFFE2D).w	; is Sonic invincible?
0000DA00 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DA02 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DA06 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
0000DA08 2F08                       		move.l	a0,-(sp)
0000DA0A 2448                       		movea.l	a0,a2
0000DA0C 41F8 D000                  		lea	($FFFFD000).w,a0
0000DA10 0C28 0004 0024             		cmpi.b	#4,routine(a0)
