00001070 4A38 FFE1                  		tst.b	($FFFFFFE1).w	; is slow-motion cheat on?
00001074 6700                       		beq.s	Pause_ChkStart	; if not, branch
00001076 0838 0006 F605             		btst	#6,($FFFFF605).w ; is button A pressed?
0000107C 6700                       		beq.s	Pause_ChkBC	; if not, branch
0000107E 11FC 0004 F600             		move.b	#4,($FFFFF600).w ; set game mode to 4 (title screen)
00001084 4E71                       		nop	
00001086 6000                       		bra.s	loc_1404
