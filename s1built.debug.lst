0000DC9A 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DC9C 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DCA0 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
