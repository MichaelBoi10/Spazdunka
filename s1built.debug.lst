00077A36                            ; Mega PCM API Routines
00077A36                            ; ------------------------------------------------------------------------------
00077A36                            
00077A36                            
00077A36                            ; ------------------------------------------------------------------------------
00077A36                            ; Plays a given sample
00077A36                            ; ------------------------------------------------------------------------------
00077A36                            ; INPUT:
00077A36                            ;		d0	.b		sample id (>$81)
00077A36                            ;
00077A36                            ; EXAMPLES:
00077A36                            ;		move.b	#$81, d0
00077A36                            ;		jsr		MegaPCM_PlaySample
00077A36                            ;
00077A36                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00077A36                            ;		jsr		MegaPCM_PlaySample
00077A36                            ; ------------------------------------------------------------------------------
00077A36                            
00077A36                            MegaPCM_PlaySample:
00077A36                            	MPCM_play	d0
00077A36                          M 	mpcm_stopz80
00077A36                          M 	pusho
00077A36                          M 	opt	l-
00077A36 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00077A3E                          M 	@wait_8:
00077A3E 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00077A46 66F6                     M 	bne.s	@wait_8
00077A48                          M 	popo
00077A48 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00077A4E                          M 	mpcm_startz80
00077A4E 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00077A56 4E75                       	rts
00077A58                            
00077A58                            ; ------------------------------------------------------------------------------
00077A58                            ; Pauses current sample playback
00077A58                            ; ------------------------------------------------------------------------------
00077A58                            
00077A58                            MegaPCM_PausePlayback:
00077A58                            	MPCM_pause
00077A58                          M 	mpcm_stopz80
00077A58                          M 	pusho
00077A58                          M 	opt	l-
00077A58 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00077A60                          M 	@wait_11:
00077A60 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00077A68 66F6                     M 	bne.s	@wait_11
00077A6A                          M 	popo
00077A6A 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00077A72                          M 	mpcm_startz80
00077A72 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00077A7A 4E75                       	rts
