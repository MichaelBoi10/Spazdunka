0000DBB6                            ; ---------------------------------------------------------------------------
0000DBB6                            ; Object 36 - spikes
0000DBB6                            ; ---------------------------------------------------------------------------
0000DBB6                            
0000DBB6                            Obj36:					; XREF: Obj_Index
0000DBB6 7000                       		moveq	#0,d0
0000DBB8 1028 0024                  		move.b	$24(a0),d0
0000DBBC 323B 0000                  		move.w	Obj36_Index(pc,d0.w),d1
0000DBC0 4EFB 1000                  		jmp	Obj36_Index(pc,d1.w)
0000DBC4                            ; ===========================================================================
0000DBC4 0000                       Obj36_Index:	dc.w Obj36_Main-Obj36_Index
0000DBC6 0000                       		dc.w Obj36_Solid-Obj36_Index
0000DBC8                            
0000DBC8 0014                       Obj36_Var:	dc.b 0,	$14		; frame	number,	object width
0000DBCA 0110                       		dc.b 1,	$10
0000DBCC 0204                       		dc.b 2,	4
0000DBCE 031C                       		dc.b 3,	$1C
0000DBD0 0440                       		dc.b 4,	$40
0000DBD2 0510                       		dc.b 5,	$10
0000DBD4                            ; ===========================================================================
0000DBD4                            
0000DBD4                            Obj36_Main:				; XREF: Obj36_Index
0000DBD4 5428 0024                  		addq.b	#2,routine(a0)
0000DBD8 217C 0000 0000 0004        		move.l	#Map_obj36,mappings(a0)
0000DBE0 317C 051B 0002             		move.w	#$51B,art_tile(a0)
0000DBE6 0028 0004 0001             		ori.b	#4,render_flags(a0)
0000DBEC 117C 0004 0018             		move.b	#4,priority(a0)
0000DBF2 1028 0028                  		move.b	$28(a0),d0
0000DBF6 0228 000F 0028             		andi.b	#$F,subtype(a0)
0000DBFC 0240 00F0                  		andi.w	#$F0,d0
0000DC00 43F9 0000 DBC8             		lea	(Obj36_Var).l,a1
0000DC06 E648                       		lsr.w	#3,d0
0000DC08 D2C0                       		adda.w	d0,a1
0000DC0A 1159 001A                  		move.b	(a1)+,mapping_frame(a0)
0000DC0E 1159 0019                  		move.b	(a1)+,width_pixels(a0)
0000DC12 3168 0008 0030             		move.w	8(a0),$30(a0)
0000DC18 3168 000C 0032             		move.w	$C(a0),$32(a0)
0000DC1E                            
0000DC1E                            Obj36_Solid:				; XREF: Obj36_Index
0000DC1E 6100 0000                  		bsr.w	Obj36_Type0x	; make the object move
0000DC22 343C 0004                  		move.w	#4,d2
0000DC26 0C28 0005 001A             		cmpi.b	#5,mapping_frame(a0)	; is object type $5x ?
0000DC2C 6700                       		beq.s	Obj36_SideWays	; if yes, branch
0000DC2E 0C28 0001 001A             		cmpi.b	#1,mapping_frame(a0)	; is object type $1x ?
0000DC34 6600                       		bne.s	Obj36_Upright	; if not, branch
0000DC36 343C 0014                  		move.w	#$14,d2
0000DC3A                            
0000DC3A                            ; Spikes types $1x and $5x face	sideways
0000DC3A                            
0000DC3A                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DC3A 323C 001B                  		move.w	#$1B,d1
0000DC3E 3602                       		move.w	d2,d3
0000DC40 5243                       		addq.w	#1,d3
0000DC42 3828 0008                  		move.w	8(a0),d4
0000DC46 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DC4A 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DC4E 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DC52 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DC56 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DC5C 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DC5E 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DC60 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DC62 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DC64 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DC66                            ; ===========================================================================
0000DC66                            
0000DC66                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DC66                            
0000DC66                            Obj36_Upright:				; XREF: Obj36_Solid
0000DC66 7200                       		moveq	#0,d1
0000DC68 1228 0019                  		move.b	$19(a0),d1
0000DC6C 0641 000B                  		addi.w	#$B,d1
0000DC70 343C 0010                  		move.w	#$10,d2
0000DC74 363C 0011                  		move.w	#$11,d3
0000DC78 3828 0008                  		move.w	8(a0),d4
0000DC7C 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DC80 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DC86 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DC88 4A44                       		tst.w	d4			; check response value from SolidObject
