000150CC 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000150D0 6400                       		bcc.s	loc_13AF0	; if yes, branch
000150D2 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000150D8                            
000150D8                            loc_13AF0:
000150D8 4442                       		neg.w	d2
000150DA 0642 0400                  		addi.w	#$400,d2
000150DE 6A00                       		bpl.s	loc_13AFA
000150E0 7400                       		moveq	#0,d2
