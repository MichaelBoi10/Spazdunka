00077D95                            @Str_PitchNotSet:
00077D95 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
00077DEC                            @Str_WaveInvalidHeader:
