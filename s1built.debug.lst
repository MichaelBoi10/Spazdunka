000147EE                            ; loc_1AB38: test_set_SS:
000147EE                            Sonic_CheckGoSuper:
000147EE 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
000147F2 6600 0000                  	bne.w	return_1ABA4		; if yes, branch
000147F6 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
000147FC 6600                       	bne.s	return_1ABA4		; if not, branch
000147FE 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014804 6500                       	bcs.s	return_1ABA4		; if not, branch
00014806 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
0001480A 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
0001480E 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014814 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
0001481A 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
00014820 11FC 0001 F7C8             	move.b	#1,($FFFFF7C8).w ; lock	controls
00014826 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
0001482C 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
00014832 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014838 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
0001483E 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014844 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
0001484A 303C 00D4                  	move.w	#$D4,d0         ; 
0001484E 4EB9 0000 1034             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
00014854 303C 0087                  	move.w	#$87,d0
00014858 4EF9 0000 102E             	jmp	(PlaySound).l	; Play the super theme
0001485E                            ; ---------------------------------------------------------------------------
0001485E                            return_1ABA4:
0001485E 4E75                       	rts
