0000108E 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001090 0838 0005 F605             		btst	#5,($FFFFF605).w ; is button C pressed?
00001096 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001098                            
00001098                            Pause_ChkStart:				; XREF: PauseGame
00001098 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
0000109E 67C6                       		beq.s	loc_13CA	; if not, branch
