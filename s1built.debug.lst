00005872                            ; ---------------------------------------------------------------------------
00005872                            ; Ending sequence demo loading subroutine
00005872                            ; ---------------------------------------------------------------------------
00005872                            
00005872                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00005872                            
00005872                            
00005872                            EndingDemoLoad:				; XREF: Credits
00005872 3038 FFF4                  		move.w	($FFFFFFF4).w,d0
00005876 0240 000F                  		andi.w	#$F,d0
0000587A D040                       		add.w	d0,d0
0000587C 303B 0000                  		move.w	EndDemo_Levels(pc,d0.w),d0 ; load level	array
00005880 31C0 FE10                  		move.w	d0,($FFFFFE10).w ; set level from level	array
00005884 5278 FFF4                  		addq.w	#1,($FFFFFFF4).w
00005888 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	credits	finished?
0000588E 6400                       		bcc.s	EndDemo_Exit	; if yes, branch
00005890 31FC 8001 FFF0             		move.w	#$8001,($FFFFFFF0).w ; force demo mode
00005896 11FC 0008 F600             		move.b	#8,($FFFFF600).w ; set game mode to 08 (demo)
0000589C 11FC 0003 FE12             		move.b	#3,($FFFFFE12).w ; set lives to	3
000058A2 7000                       		moveq	#0,d0
000058A4 31C0 FE20                  		move.w	d0,($FFFFFE20).w ; clear rings
000058A8 21C0 FE22                  		move.l	d0,($FFFFFE22).w ; clear time
000058AC 21C0 FE26                  		move.l	d0,($FFFFFE26).w ; clear score
000058B0 11C0 FE30                  		move.b	d0,($FFFFFE30).w ; clear lamppost counter
000058B4 0C78 0004 FFF4             		cmpi.w	#4,($FFFFFFF4).w ; is SLZ demo running?
000058BA 6600                       		bne.s	EndDemo_Exit	; if not, branch
000058BC 43F9 0000 0000             		lea	(EndDemo_LampVar).l,a1 ; load lamppost variables
000058C2 45F8 FE30                  		lea	($FFFFFE30).w,a2
000058C6 303C 0008                  		move.w	#8,d0
000058CA                            
000058CA                            EndDemo_LampLoad:
000058CA 24D9                       		move.l	(a1)+,(a2)+
000058CC 51C8 FFFC                  		dbf	d0,EndDemo_LampLoad
000058D0                            
000058D0                            EndDemo_Exit:
000058D0 4E75                       		rts	
