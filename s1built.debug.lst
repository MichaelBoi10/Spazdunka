0018F192                            ; Menu do Sonic 2 No Sonic 1 reprogramado por Esrael L. G. Neto
0018F192                            ; [ In�cio ]
0018F192                            ;
0018F192                            ; O c�digo deste menu foi desenvolvido para funcionar com
0018F192                            ; o disassembly do Sonic 1 feito por -> drx (www.hacking-cult.org)
0018F192                            ; 
0018F192                            ; Se estiver usando um disassembly diferente modifique os jumps no final do 
0018F192                            ; c�digo para que aponte para as rotinas equivalentes.
0018F192                            ; 
0018F192                            ; Para pode utilizar este menu basta fazer a seguinte modifica��o no c�digo 
0018F192                            ; original:
0018F192                            ; Localize o label  -> loc_3242 adicione -> jmp     Level_Select_Menu
0018F192                            ; O c�digo deve ficar como abaixo
0018F192                            ;               ......................
0018F192                            ; loc_3242:
0018F192                            ;		tst.b	($FFFFFFE0).w
0018F192                            ;		beq.w	PlayLevel	
0018F192                            ;		btst	#6,($FFFFF604).w 
0018F192                            ;		beq.w	PlayLevel	  		
0018F192                            ;		jmp     Level_Select_Menu ; <- Carrega o Menu do Sonic 2	
0018F192                            ;		moveq	#2,d0		
0018F192                            ;		bsr.w	PalLoad		 
0018F192                            ;               ...............
0018F192                            ;
0018F192                            ; N�o esque�a de incluir este asm em seu c�digo com a diretiva include:
0018F192                            ;               include 's2_menu.asm'
