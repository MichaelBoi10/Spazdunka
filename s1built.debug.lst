00015160 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015162 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
00015168 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
0001516C 6400                       		bhs.s	loc_13AB4	; if yes, branch
0001516E 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
