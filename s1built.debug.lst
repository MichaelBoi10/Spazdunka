000010D8                            ; ---------------------------------------------------------------------------
000010D8                            ; Subroutine to load VDP commands into the DMA transfer queue
000010D8                            ;
000010D8                            ; In case you wish to use this queue system outside of the spin dash, this is the
000010D8                            ; registers in which it expects data in:
000010D8                            ; d1.l: Address to data (In 68k address space)
000010D8                            ; d2.w: Destination in VRAM
000010D8                            ; d3.w: Length of data
000010D8                            ; ---------------------------------------------------------------------------
000010D8                            
000010D8                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000010D8                            
000010D8                            
000010D8                            DMA_68KtoVRAM:
000010D8 2278 C8FC                  		movea.l	($FFFFC8FC).w,a1
000010DC B2FC C8FC                  		cmpa.w	#$C8FC,a1	; is the DMA queue full?
000010E0 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
000010E2                            
000010E2                            		; piece together some VDP commands and store them for later...
000010E2 303C 9300                  		move.w	#$9300,d0	; command to specify DMA transfer length & $00FF
000010E6 1003                       		move.b	d3,d0
000010E8 32C0                       		move.w	d0,(a1)+	; store command
000010EA                            
000010EA 303C 9400                  		move.w	#$9400,d0	; command to specify DMA transfer length & $FF00
000010EE E04B                       		lsr.w	#8,d3
000010F0 1003                       		move.b	d3,d0
000010F2 32C0                       		move.w	d0,(a1)+	; store command
000010F4                            
000010F4 303C 9500                  		move.w	#$9500,d0	; command to specify source address & $0001FE
000010F8 E289                       		lsr.l	#1,d1
000010FA 1001                       		move.b	d1,d0
000010FC 32C0                       		move.w	d0,(a1)+	; store command
000010FE                            
000010FE 303C 9600                  		move.w	#$9600,d0	; command to specify source address & $01FE00
00001102 E089                       		lsr.l	#8,d1
00001104 1001                       		move.b	d1,d0
00001106 32C0                       		move.w	d0,(a1)+	; store command
00001108                            
00001108 303C 9700                  		move.w	#$9700,d0	; command to specify source address & $FE0000
0000110C E089                       		lsr.l	#8,d1
0000110E 1001                       		move.b	d1,d0
00001110 32C0                       		move.w	d0,(a1)+	; store command
00001112                            
00001112 0282 0000 FFFF             		andi.l	#$FFFF,d2	; command to specify destination address and begin DMA
00001118 E58A                       		lsl.l	#2,d2
0000111A E44A                       		lsr.w	#2,d2
0000111C 4842                       		swap	d2
0000111E 0082 4000 0080             		ori.l	#$40000080,d2 ; set bits to specify VRAM transfer
00001124 22C2                       		move.l	d2,(a1)+	; store command
00001126                            
00001126 21C9 C8FC                  		move.l	a1,($FFFFC8FC).w ; set the next free slot address
0000112A B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
0000112E 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
