0000DC2E                            ; Spikes types $1x and $5x face	sideways
0000DC2E                            
0000DC2E                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DC2E 323C 001B                  		move.w	#$1B,d1
0000DC32 3602                       		move.w	d2,d3
0000DC34 5243                       		addq.w	#1,d3
0000DC36 3828 0008                  		move.w	8(a0),d4
0000DC3A 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DC3E 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DC42 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DC46 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DC4A 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DC50 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DC52 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DC54 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DC56 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DC58 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DC5A                            ; ===========================================================================
0000DC5A                            
0000DC5A                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
