0001482A                            ; ---------------------------------------------------------------------------
0001482A                            ; Subroutine called at the peak of a jump that transforms Sonic into Super Sonic
0001482A                            ; if he has enough rings and emeralds
0001482A                            ; ---------------------------------------------------------------------------
0001482A                            
0001482A                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0001482A                            
0001482A                            ; loc_1AB38: test_set_SS:
0001482A                            Sonic_CheckGoSuper:
0001482A 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
0001482E 6600 0000                  	bne.w	Sonic_RevertToNormal		; if yes, branch
00014832 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
00014838 6600                       	bne.s	return_1ABA4		; if not, branch
0001483A 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014840 6500                       	bcs.s	return_1ABA4		; if not, branch
00014842 4A38 FE1E                  	tst.b	(Update_HUD_timer).w	; has Sonic reached the end of the act?
00014846 6700 0000                  	beq.w	return_1ABA4		; if yes, branch
0001484A 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014850 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
00014856 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
0001485C 117C 0081 F7C8             	move.b	#$81,$FFFFF7C8(a0)
00014862 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
00014868 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
0001486E 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014874 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
0001487A 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014880 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
00014886 303C 00D4                  	move.w	#$D4,d0         ; 
0001488A 4EB9 0000 1034             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
00014890 303C 0087                  	move.w	#$87,d0
00014894 4EF9 0000 102E             	jmp	(PlaySound).l	; Play the super theme
0001489A                            ; ---------------------------------------------------------------------------
0001489A                            return_1ABA4:
0001489A 4E75                       	rts
0001489C                            ; End of subroutine Sonic_CheckGoSuper
0001489C                            
0001489C                            ; ---------------------------------------------------------------------------
0001489C                            ; Subroutine called when sonic hits the S Monitor
0001489C                            ; (it's basically the same routine as Sonic_CheckGoSuper)
0001489C                            ; (but the emerald count check is removed)
0001489C                            ; ---------------------------------------------------------------------------
0001489C                            
0001489C                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0001489C                            
0001489C                            Sonic_ChkSuper_SMonitor:
0001489C 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
000148A0 6600                       	bne.s	return2_1ABA4		; if yes, branch
000148A2                            
000148A2 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
000148A8 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
000148AE 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
000148B4 117C 0081 F7C8             	move.b	#$81,obj_control(a0)
000148BA 117C 0021 001C             	move.b	#$21,anim(a0)			; use transformation animation
000148C0 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
000148C6 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
000148CC 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
000148D2 317C 0000 0032             	move.w	#0,invincibility_time(a0)
000148D8 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
000148DE 303C 00D4                  	move.w	#$D4,d0         ; 
000148E2 4EB9 0000 1034             	jsr	(PlaySound_Special).l	; Play special ring sound effect.
000148E8 303C 0087                  	move.w	#$87,d0
000148EC 4EF9 0000 102E             	jmp	(PlaySound).l	; Play the super theme
000148F2                            
000148F2                            return2_1ABA4
000148F2 4E75                       	rts
000148F4                            ; End of subroutine Sonic_ChkSuper_SMonitor
000148F4                            
000148F4                            ; ---------------------------------------------------------------------------
000148F4                            ; Subroutine doing the extra logic for Super Sonic
000148F4                            ; ---------------------------------------------------------------------------
000148F4                            
000148F4                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000148F4                            
