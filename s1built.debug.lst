00005798                            
00005798                            Credits:				; XREF: GameModeArray
00005798 6100 BB70                  		bsr.w	ClearPLC
0000579C 6100 C56C                  		bsr.w	Pal_FadeFrom
000057A0 4DF9 00C0 0004             		lea	($C00004).l,a6
000057A6 3CBC 8004                  		move.w	#$8004,(a6)
000057AA 3CBC 8230                  		move.w	#$8230,(a6)
000057AE 3CBC 8407                  		move.w	#$8407,(a6)
000057B2 3CBC 9001                  		move.w	#$9001,(a6)
000057B6 3CBC 9200                  		move.w	#$9200,(a6)
000057BA 3CBC 8B03                  		move.w	#$8B03,(a6)
000057BE 3CBC 8720                  		move.w	#$8720,(a6)
000057C2 4238 F64E                  		clr.b	($FFFFF64E).w
000057C6 6100 B7DC                  		bsr.w	ClearScreen
000057CA 43F8 D000                  		lea	($FFFFD000).w,a1
000057CE 7000                       		moveq	#0,d0
000057D0 323C 07FF                  		move.w	#$7FF,d1
000057D4                            
