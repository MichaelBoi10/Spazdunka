000778CA 66F6                     M 	bne.s	@wait_8
000778CC                          M 	popo
000778CC 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
000778D4                          M 	mpcm_startz80
000778D4 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
000778DC 4E75                       	rts
