00014B40 11FC 0000 FE19             	move.b	#0,(Super_Sonic_flag).w
00014B46 117C 0001 001D             	move.b	#1,next_anim(a0)	; Change animation back to normal ?
00014B4C 317C 0001 0032             	move.w	#1,invincibility_time(a0)	; Remove invincibility
00014B52 31FC 0630 F760             	move.w	#$630,(Sonic_top_speed).w
