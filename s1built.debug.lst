0000E368 2628 000C                  		move.l	$C(a0),d3
0000E36C 3028 0010                  		move.w	$10(a0),d0
0000E370 48C0                       		ext.l	d0
0000E372 E180                       		asl.l	#8,d0
0000E374 D480                       		add.l	d0,d2
0000E376 3028 0012                  		move.w	$12(a0),d0
0000E37A 0668 0038 0012             		addi.w	#$38,y_vel(a0)	; increase vertical speed
0000E380 48C0                       		ext.l	d0
0000E382 E180                       		asl.l	#8,d0
0000E384 D680                       		add.l	d0,d3
0000E386 2142 0008                  		move.l	d2,8(a0)
0000E38A 2143 000C                  		move.l	d3,y_pos(a0)
0000E38E 4E75                       		rts	
