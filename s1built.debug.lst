00005CD2                            Cred_WaitLoop:
00005CD2 11FC 0004 F62A             		move.b	#4,($FFFFF62A).w
00005CD8 6100 CD90                  		bsr.w	DelayProgram
00005CDC 6100 B636                  		bsr.w	RunPLC_RAM
00005CE0 4A78 F614                  		tst.w	($FFFFF614).w	; have 2 seconds elapsed?
00005CE4 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005CE6 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005CEA 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005CEC 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
00005CF2 6700 0000                  		beq.w	TryAgainEnd	; if yes, branch
00005CF6 4E75                       		rts	
