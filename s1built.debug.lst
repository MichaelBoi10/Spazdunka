00082468                            @ErrorCodeToDescription:
00082468                            	;		Raw error code								  String pointer
00082468 0000 0000                  	dc.l	(MPCM_ST_TOO_MANY_SAMPLES<<24) 				| @Str_TooManySamples
0008246C 0000 0000                  	dc.l	(MPCM_ST_UNKNOWN_SAMPLE_TYPE<<24)			| @Str_UnknownSampleType
00082470 0000 0000                  	dc.l	(MPCM_ST_PITCH_NOT_SET<<24)					| @Str_PitchNotSet
00082474 0000 0000                  	dc.l	(MPCM_ST_WAVE_INVALID_HEADER<<24)			| @Str_WaveInvalidHeader
00082478 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_AUDIO_FORMAT<<24)			| @Str_WaveBadAudioFormat
0008247C 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_MONO<<24)					| @Str_WaveNotMono
00082480 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_8BIT<<24)					| @Str_WaveNot8bit
00082484 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_SAMPLE_RATE<<24)			| @Str_WaveBadSampleRate
00082488 0000 0000                  	dc.l	(MPCM_ST_WAVE_MISSING_DATA_CHUNK<<24)		| @Str_WaveMissingDataChunk
0008248C 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_UNSUPPORTED_VERSION<<24)	| @Str_DpcmHqUnsupportedVersion
00082490 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_BAD_SAMPLE_RATE<<24)		| @Str_DpcmHqBadSampleRate
00082494 FF00                       	dc.b	$FF, 0		; end marker
