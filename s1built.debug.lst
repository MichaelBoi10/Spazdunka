000150D8 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150DC 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000150DE 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000150E2                            
000150E2                            SAnim_Do2:
000150E2 7200                       		moveq	#0,d1
000150E4 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000150E8 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000150EC 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000150F0 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
000150F2                            
000150F2                            SAnim_Next:
000150F2 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000150F6 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000150FA                            
000150FA                            SAnim_Delay:
000150FA 4E75                       		rts	
000150FC                            ; ===========================================================================
000150FC                            
000150FC                            SAnim_End_FF:
000150FC 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000150FE 6600                       		bne.s	SAnim_End_FE	; if not, branch
00015100 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015106 1029 0001                  		move.b	1(a1),d0	; read sprite number
0001510A 60E6                       		bra.s	SAnim_Next
0001510C                            ; ===========================================================================
0001510C                            
0001510C                            SAnim_End_FE:
0001510C 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0001510E 6600                       		bne.s	SAnim_End_FD	; if not, branch
00015110 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015114 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015118 9200                       		sub.b	d0,d1
0001511A 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0001511E 60D2                       		bra.s	SAnim_Next
00015120                            ; ===========================================================================
00015120                            
00015120                            SAnim_End_FD:
00015120 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015122 6600                       		bne.s	SAnim_End	; if not, branch
00015124 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
0001512A                            
0001512A                            SAnim_End:
0001512A 4E75                       		rts	
0001512C                            ; ===========================================================================
0001512C                            
0001512C                            SAnim_WalkRun:				; XREF: SAnim_Do
0001512C 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015130 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015132 5200                       		addq.b	#1,d0		; is animation walking/running?
00015134 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015138 7200                       		moveq	#0,d1
0001513A 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
0001513E 1428 0022                  		move.b	$22(a0),d2
00015142 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015146 6600                       		bne.s	loc_13A70	; if yes, branch
00015148 4600                       		not.b	d0		; reverse angle
0001514A                            
0001514A                            loc_13A70:
0001514A 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
0001514E 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015150 7203                       		moveq	#3,d1
00015152                            
00015152                            loc_13A78:
00015152 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015158 B302                       		eor.b	d1,d2
0001515A 8528 0001                  		or.b	d2,1(a0)
0001515E 0828 0005 0022             		btst	#5,$22(a0)
00015164 6600 0000                  		bne.w	SAnim_Push
00015168 E808                       		lsr.b	#4,d0		; divide angle by $10
0001516A 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
0001516E 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015172 6A00                       		bpl.s	loc_13A9C
00015174 4442                       		neg.w	d2
00015176                            
00015176                            loc_13A9C:
00015176 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
0001517A 6700                       		beq.s	Loc_NotSuper
0001517C 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
00015182 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015186 6400                       		bhs.s	SuperRun	; if yes, branch
00015188 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
0001518E 6000                       		bra.s	SuperWalk
00015190                            
00015190                            Loc_NotSuper:
00015190 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00015196 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
0001519A 6400                       		bhs.s	loc_13AB4	; if yes, branch
0001519C 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000151A2 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000151A6 6400                       		bhs.s	loc_13AB4	; if yes, branch
000151A8 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000151AE                            
000151AE                            SuperWalk:
000151AE 1200                       		move.b	d0,d1
000151B0 E209                       		lsr.b	#1,d1
000151B2 D001                       		add.b	d1,d0
000151B4                            
000151B4                            loc_13AB4:
000151B4 D000                       		add.b	d0,d0
000151B6                            
000151B6                            SuperRun:
000151B6 1600                       		move.b	d0,d3
000151B8 4442                       		neg.w	d2
000151BA 0642 0800                  		addi.w	#$800,d2
000151BE 6A00                       		bpl.s	loc_13AC2
000151C0 7400                       		moveq	#0,d2
000151C2                            
000151C2                            loc_13AC2:
000151C2 E04A                       		lsr.w	#8,d2
000151C4 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151C8 6100 FF18                  		bsr.w	SAnim_Do2
000151CC D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000151D0 4E75                       		rts	
000151D2                            ; ===========================================================================
000151D2                            
000151D2                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000151D2 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000151D4 6600                       		bne.s	SAnim_Push	; if not, branch
000151D6 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000151DA 6A00                       		bpl.s	loc_13ADE
000151DC 4442                       		neg.w	d2
000151DE                            
000151DE                            loc_13ADE:
000151DE 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000151E4 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000151E8 6400                       		bcc.s	loc_13AF0	; if yes, branch
000151EA 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000151F0                            
000151F0                            loc_13AF0:
000151F0 4442                       		neg.w	d2
000151F2 0642 0400                  		addi.w	#$400,d2
000151F6 6A00                       		bpl.s	loc_13AFA
000151F8 7400                       		moveq	#0,d2
000151FA                            
000151FA                            loc_13AFA:
000151FA E04A                       		lsr.w	#8,d2
000151FC 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015200 1228 0022                  		move.b	$22(a0),d1
00015204 0201 0001                  		andi.b	#1,d1
00015208 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001520E 8328 0001                  		or.b	d1,1(a0)
00015212 6000 FECE                  		bra.w	SAnim_Do2
00015216                            ; ===========================================================================
