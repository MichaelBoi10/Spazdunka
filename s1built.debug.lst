00014C82                            Sonic_SpinDash:
00014C82 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
00014C86 6600                       		bne.s	loc2_1AC8E		; if set, branch
00014C88 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
00014C8E 6600                       		bne.s	locret2_1AC8C		; if not, return
00014C90 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014C94 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
00014C98 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
00014C9C 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
00014CA2 303C 00D1                  		move.w	#$D1,d0			; spin sound ($E0 in s2)
00014CA6 4EB9 0000 1038             		jsr	(PlaySound_Special).l	; play spin sound
00014CAC 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014CAE 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
