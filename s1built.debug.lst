000152EC 6700                       		beq.s	SAnim_Do	; if not, branch
000152EE 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000152F2 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000152F8 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000152FE                            
000152FE                            SAnim_Do:
000152FE D040                       		add.w	d0,d0
00015300 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00015304 1011                       		move.b	(a1),d0
00015306 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00015308 1228 0022                  		move.b	$22(a0),d1
0001530C 0201 0001                  		andi.b	#1,d1
00015310 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015316 8328 0001                  		or.b	d1,1(a0)
0001531A 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
0001531E 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00015320 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00015324                            
00015324                            SAnim_Do2:
00015324 7200                       		moveq	#0,d1
00015326 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0001532A 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0001532E 6B00                       		bmi.s	SAnim_End_FF	; if animation is complete, branch
00015330                            
00015330                            SAnim_Next:
00015330 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00015334 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00015338                            
00015338                            SAnim_Delay:
00015338 4E75                       		rts	
0001533A                            ; ===========================================================================
0001533A                            
0001533A                            SAnim_End_FF:
0001533A 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0001533C 6600                       		bne.s	SAnim_End_FE	; if not, branch
0001533E 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015344 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015348 60E6                       		bra.s	SAnim_Next
0001534A                            ; ===========================================================================
0001534A                            
0001534A                            SAnim_End_FE:
0001534A 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0001534C 6600                       		bne.s	SAnim_End_FD	; if not, branch
0001534E 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015352 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015356 9200                       		sub.b	d0,d1
00015358 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0001535C 60D2                       		bra.s	SAnim_Next
0001535E                            ; ===========================================================================
