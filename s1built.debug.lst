0000DEA8 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DEAA 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DEAE 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
