00014C8E                            ; ---------------------------------------------------------------------------
00014C8E                            ; Subroutine to make Sonic perform a spindash
00014C8E                            ; ---------------------------------------------------------------------------
00014C8E                             
00014C8E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014C8E                             
00014C8E                             
00014C8E                            Sonic_SpinDash:
00014C8E 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
00014C92 6600                       		bne.s	loc2_1AC8E		; if set, branch
00014C94 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
00014C9A 6600                       		bne.s	locret2_1AC8C		; if not, return
00014C9C 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014CA0 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
00014CA4 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
00014CA8 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
00014CAE 303C 00D1                  		move.w	#$D1,d0			; spin sound ($E0 in s2)
00014CB2 4EB9 0000 1038             		jsr	(PlaySound_Special).l	; play spin sound
00014CB8 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014CBA 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
00014CC0 317C 0000 003A             		move.w	#0,$3A(a0)		; set charge count to 0
00014CC6 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
00014CCC 6500                       		bcs.s	loc2_1AC84		; ??? branch if carry
00014CCE 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014CD4                            						; the smoke/dust object
00014CD4                            loc2_1AC84:
00014CD4 6100 FB5C                  		bsr.w	Sonic_LevelBound
00014CD8 6100 0000                  		bsr.w	Sonic_AnglePos
00014CDC                            
00014CDC                            locret2_1AC8C:
00014CDC 4E75                       		rts	
00014CDE                            ; ---------------------------------------------------------------------------
00014CDE                            
00014CDE                            loc2_1AC8E:
00014CDE 117C 0009 001C             		move.b	#9,anim(a0)
00014CE4 1038 F602                  		move.b	($FFFFF602).w,d0	; read controller
00014CE8 0800 0001                  		btst	#1,d0			; check down button
00014CEC 6600 0000                  		bne.w	loc2_1AD30		; if set, branch
00014CF0 117C 000E 0016             		move.b	#$E,y_radius(a0)		; $16(a0) is height/2
00014CF6 117C 0007 0017             		move.b	#7,x_radius(a0)		; $17(a0) is width/2
00014CFC 117C 0002 001C             		move.b	#2,anim(a0)		; set animation to roll
00014D02 5A68 000C                  		addq.w	#5,y_pos(a0)		; $C(a0) is Y coordinate
00014D06 117C 0000 0039             		move.b	#0,$39(a0)		; clear Spin Dash flag
00014D0C 7000                       		moveq	#0,d0
00014D0E 1028 003A                  		move.b	$3A(a0),d0		; copy charge count
00014D12 D040                       		add.w	d0,d0			; double it
00014D14 317B 0000 0014             		move.w	Dash_Speeds(pc,d0.w),$14(a0) ; get normal speed
00014D1A 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00014D1E 6700                       		beq.s	loc2_1AC8F
00014D20 317B 0000 0014             		move.w	Dash_Speeds_Super(pc,d0.w),inertia(a0)
00014D26                            
00014D26                            loc2_1AC8F:
00014D26 3028 0014                  		move.w	$14(a0),d0		; get inertia
00014D2A 0440 0800                  		subi.w	#$800,d0		; subtract $800
00014D2E D040                       		add.w	d0,d0			; double it
00014D30 0240 1F00                  		andi.w	#$1F00,d0		; mask it against $1F00
00014D34 4440                       		neg.w	d0			; negate it
00014D36 0640 2000                  		addi.w	#$2000,d0		; add $2000
00014D3A 31C0 C904                  		move.w	d0,($FFFFC904).w	; move to $C904
00014D3E 0828 0000 0022             		btst	#0,status(a0)		; is sonic facing right?
00014D44 6700                       		beq.s	loc2_1ACF4		; if not, branch
00014D46 4468 0014                  		neg.w	$14(a0)			; negate inertia
00014D4A                            
00014D4A                            loc2_1ACF4:
00014D4A 08E8 0002 0022             		bset	#2,status(a0)		; set unused (in s1) flag
00014D50 11FC 0000 D1DC             		move.b	#0,($FFFFD1DC).w	; clear Spin Dash dust animation.
00014D56 303C 00BC                  		move.w	#$BC,d0			; spin release sound
00014D5A 4EB9 0000 1038             		jsr	(PlaySound_Special).l	; play it!
00014D60 6000                       		bra.s	loc2_1AD78
00014D62                            ; ===========================================================================
00014D62                            Dash_Speeds:
00014D62 0800                       		dc.w  $800		; 0
00014D64 0880                       		dc.w  $880		; 1
00014D66 0900                       		dc.w  $900		; 2
00014D68 0980                       		dc.w  $980		; 3
00014D6A 0A00                       		dc.w  $A00		; 4
00014D6C 0A80                       		dc.w  $A80		; 5
00014D6E 0B00                       		dc.w  $B00		; 6
00014D70 0B80                       		dc.w  $B80		; 7
00014D72 0C00                       		dc.w  $C00		; 8
00014D74                            Dash_Speeds_Super:
00014D74 0B00                       		dc.w  $B00	; 0
00014D76 0B80                       		dc.w  $B80	; 1
00014D78 0C00                       		dc.w  $C00	; 2
00014D7A 0C80                       		dc.w  $C80	; 3
00014D7C 0D00                       		dc.w  $D00	; 4
00014D7E 0D80                       		dc.w  $D80	; 5
00014D80 0E00                       		dc.w  $E00	; 6
00014D82 0E80                       		dc.w  $E80	; 7
00014D84 0F00                       		dc.w  $F00	; 8
00014D86                            ; ===========================================================================
00014D86                            
00014D86                            loc2_1AD30:				; If still charging the dash...
00014D86 4A68 003A                  		tst.w	$3A(a0)		; check charge count
00014D8A 6700                       		beq.s	loc2_1AD48	; if zero, branch
00014D8C 3028 003A                  		move.w	$3A(a0),d0	; otherwise put it in d0
00014D90 EA48                       		lsr.w	#5,d0		; shift right 5 (divide it by 32)
00014D92 9168 003A                  		sub.w	d0,$3A(a0)	; subtract from charge count
00014D96 6400                       		bcc.s	loc2_1AD48	; ??? branch if carry clear
00014D98 317C 0000 003A             		move.w	#0,$3A(a0)	; set charge count to 0
00014D9E                            
00014D9E                            loc2_1AD48:
00014D9E 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014DA2 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C?
00014DA6 6700 0000                  		beq.w	loc2_1AD78		; if not, branch
00014DAA 317C 0900 001C             		move.w	#$900,anim(a0)		; reset spdsh animation
00014DB0 303C 00D1                  		move.w	#$D1,d0			; was $E0 in sonic 2
00014DB4 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014DBA 4EB9 0000 1038             		jsr	(PlaySound_Special).l	; play charge sound
00014DC0 0668 0200 003A             		addi.w	#$200,$3A(a0)		; increase charge count
00014DC6 0C68 0800 003A             		cmpi.w	#$800,$3A(a0)		; check if it's maxed
00014DCC 6500                       		bcs.s	loc2_1AD78		; if not, then branch
00014DCE 317C 0800 003A             		move.w	#$800,$3A(a0)		; reset it to max
00014DD4                            
