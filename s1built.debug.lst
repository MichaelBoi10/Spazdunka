00001140                            Process_DMA_Loop:			; XREF: Process_DMA
00001140 3019                       		move.w	(a1)+,d0	; has a stop token been encountered?
00001142 6700                       		beq.s	Process_DMA_Done ; branch if we reached a stop token
00001144                            
00001144                            		; issue a set of VDP commands...
00001144 3A80                       		move.w	d0,(a5)		; transfer length
00001146 3A99                       		move.w	(a1)+,(a5)	; transfer length
00001148 3A99                       		move.w	(a1)+,(a5)	; source address
0000114A 3A99                       		move.w	(a1)+,(a5)	; source address
0000114C 3A99                       		move.w	(a1)+,(a5)	; source address
0000114E 3A99                       		move.w	(a1)+,(a5)	; destination
00001150 3A99                       		move.w	(a1)+,(a5)	; destination
00001152 B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
00001156 66E8                       		bne.s	Process_DMA_Loop ; loop if we haven't reached the end of the buffer
