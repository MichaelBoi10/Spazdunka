0000DE72 343C 0010                  		move.w	#$10,d2
0000DE76 363C 0011                  		move.w	#$11,d3
0000DE7A 3828 0008                  		move.w	8(a0),d4
0000DE7E 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DE82 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DE88 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DE8A 4A44                       		tst.w	d4			; check response value from SolidObject
0000DE8C 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DE8E 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DE92 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DE96 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DE9C 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DE9E 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DEA0 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DEA2 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DEA4                            		; otherwise, fall through to Spik_Hurt
