00078EBE                            
00078EBE                            ; ------------------------------------------------------------------------------
00078EBE                            ; DEBUGGER: Displays details for `MegaPCM_LoadSampleTable` error code
00078EBE                            ; ------------------------------------------------------------------------------
00078EBE                            ; INPUT:
00078EBE                            ;		d0	.w	Error code returned by `MegaPCM_LoadSampleTable`
00078EBE                            ;		a0		Pointer to faulty sample
00078EBE                            ; ------------------------------------------------------------------------------
00078EBE                            
00078EBE                            MPCM_Debugger_LoadSampleTableException:
00078EBE                            
00078EBE                            	; Print raw error code
00078EBE                            	Console.Write "%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078EBE 40E7                     M 	move.w	sr,-(sp)
00078EC0                          M 	_console.write	<"%<pal1>Error code: %<pal0>%<.b d0>%<endl>">,<>
00078EC0                          M 	__fstring_generateargumentscode	"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078EC0 =00000001                M 	__pos:	= instr("%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'%<')
00078EC0 =00000000                M 	__stack:=	0
00078EC0 =00000000                M 	__sp:	= 0
00078EC0                          M 	pusho
00078EC0                          M 	opt	ae-
00078EC0                          M 	while	(__pos)
00078EC0 =00000007                M 	__endpos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'>')
00078EC0 =0000000D                M 	__midpos:	= instr(__pos+5,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",' ')
00078EC0 =00000007                M 	__midpos:	= __endpos
00078EC0                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078EC0                          M 	__type:	substr __pos+1+1,__pos+1+1+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078EC0 =00000014                M 	__pos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'%<')
00078EC0 =0000001A                M 	__endpos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'>')
