00014958 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
0001495E 6600                       		bne.s	locret2_1AC8C		; if not, return
00014960 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
