00078D86                            
00078D86                            
00078D86                            ; ------------------------------------------------------------------------------
00078D86                            ; Plays a given sample
00078D86                            ; ------------------------------------------------------------------------------
00078D86                            ; INPUT:
00078D86                            ;		d0	.b		sample id (>$81)
00078D86                            ;
00078D86                            ; EXAMPLES:
00078D86                            ;		move.b	#$81, d0
00078D86                            ;		jsr		MegaPCM_PlaySample
00078D86                            ;
00078D86                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00078D86                            ;		jsr		MegaPCM_PlaySample
00078D86                            ; ------------------------------------------------------------------------------
00078D86                            
00078D86                            MegaPCM_PlaySample:
00078D86                            	MPCM_play	d0
00078D86                          M 	mpcm_stopz80
00078D86                          M 	pusho
00078D86                          M 	opt	l-
00078D86 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00078D8E                          M 	@wait_5:
00078D8E 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00078D96 66F6                     M 	bne.s	@wait_5
00078D98                          M 	popo
00078D98 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00078D9E                          M 	mpcm_startz80
00078D9E 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00078DA6 4E75                       	rts
00078DA8                            
