00078E7A                            
00078E7A                            ; ------------------------------------------------------------------------------
00078E7A                            ; DEBUGGER: Displays details for `MegaPCM_LoadSampleTable` error code
00078E7A                            ; ------------------------------------------------------------------------------
00078E7A                            ; INPUT:
00078E7A                            ;		d0	.w	Error code returned by `MegaPCM_LoadSampleTable`
00078E7A                            ;		a0		Pointer to faulty sample
00078E7A                            ; ------------------------------------------------------------------------------
00078E7A                            
00078E7A                            MPCM_Debugger_LoadSampleTableException:
00078E7A                            
00078E7A                            	; Print raw error code
00078E7A                            	Console.Write "%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078E7A 40E7                     M 	move.w	sr,-(sp)
00078E7C                          M 	_console.write	<"%<pal1>Error code: %<pal0>%<.b d0>%<endl>">,<>
00078E7C                          M 	__fstring_generateargumentscode	"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078E7C =00000001                M 	__pos:	= instr("%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'%<')
00078E7C =00000000                M 	__stack:=	0
00078E7C =00000000                M 	__sp:	= 0
00078E7C                          M 	pusho
00078E7C                          M 	opt	ae-
00078E7C                          M 	while	(__pos)
00078E7C =00000007                M 	__endpos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'>')
00078E7C =0000000D                M 	__midpos:	= instr(__pos+5,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",' ')
00078E7C =00000007                M 	__midpos:	= __endpos
00078E7C                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078E7C                          M 	__type:	substr __pos+1+1,__pos+1+1+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078E7C =00000014                M 	__pos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'%<')
00078E7C =0000001A                M 	__endpos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'>')
00078E7C =0000001F                M 	__midpos:	= instr(__pos+5,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",' ')
00078E7C =0000001A                M 	__midpos:	= __endpos
00078E7C                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078E7C                          M 	__type:	substr __pos+1+1,__pos+1+1+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078E7C =0000001B                M 	__pos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'%<')
00078E7C =00000022                M 	__endpos:	= instr(__pos+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",'>')
00078E7C =00000000                M 	__midpos:	= instr(__pos+5,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>",' ')
00078E7C =00000022                M 	__midpos:	= __endpos
00078E7C                          M 	__substr:	substr __pos+1+1,__endpos-1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078E7C                          M 	__type:	substr __pos+1+1,__pos+1+1+1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
00078E7C                          M 	__operand:	substr __pos+1+1,__midpos-1,"%<pal1>Error code: %<pal0>%<.b d0>%<endl>"
