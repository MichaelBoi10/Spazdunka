000010DC                            ; ---------------------------------------------------------------------------
000010DC                            ; Subroutine to load VDP commands into the DMA transfer queue
000010DC                            ;
000010DC                            ; In case you wish to use this queue system outside of the spin dash, this is the
000010DC                            ; registers in which it expects data in:
000010DC                            ; d1.l: Address to data (In 68k address space)
000010DC                            ; d2.w: Destination in VRAM
000010DC                            ; d3.w: Length of data
000010DC                            ; ---------------------------------------------------------------------------
000010DC                            
000010DC                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000010DC                            
000010DC                            
000010DC                            DMA_68KtoVRAM:
000010DC 2278 C8FC                  		movea.l	($FFFFC8FC).w,a1
000010E0 B2FC C8FC                  		cmpa.w	#$C8FC,a1	; is the DMA queue full?
000010E4 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
000010E6                            
000010E6                            		; piece together some VDP commands and store them for later...
000010E6 303C 9300                  		move.w	#$9300,d0	; command to specify DMA transfer length & $00FF
000010EA 1003                       		move.b	d3,d0
000010EC 32C0                       		move.w	d0,(a1)+	; store command
000010EE                            
000010EE 303C 9400                  		move.w	#$9400,d0	; command to specify DMA transfer length & $FF00
000010F2 E04B                       		lsr.w	#8,d3
000010F4 1003                       		move.b	d3,d0
000010F6 32C0                       		move.w	d0,(a1)+	; store command
000010F8                            
000010F8 303C 9500                  		move.w	#$9500,d0	; command to specify source address & $0001FE
000010FC E289                       		lsr.l	#1,d1
000010FE 1001                       		move.b	d1,d0
00001100 32C0                       		move.w	d0,(a1)+	; store command
00001102                            
00001102 303C 9600                  		move.w	#$9600,d0	; command to specify source address & $01FE00
00001106 E089                       		lsr.l	#8,d1
00001108 1001                       		move.b	d1,d0
0000110A 32C0                       		move.w	d0,(a1)+	; store command
0000110C                            
0000110C 303C 9700                  		move.w	#$9700,d0	; command to specify source address & $FE0000
00001110 E089                       		lsr.l	#8,d1
00001112 1001                       		move.b	d1,d0
00001114 32C0                       		move.w	d0,(a1)+	; store command
00001116                            
00001116 0282 0000 FFFF             		andi.l	#$FFFF,d2	; command to specify destination address and begin DMA
0000111C E58A                       		lsl.l	#2,d2
0000111E E44A                       		lsr.w	#2,d2
00001120 4842                       		swap	d2
00001122 0082 4000 0080             		ori.l	#$40000080,d2 ; set bits to specify VRAM transfer
00001128 22C2                       		move.l	d2,(a1)+	; store command
0000112A                            
0000112A 21C9 C8FC                  		move.l	a1,($FFFFC8FC).w ; set the next free slot address
0000112E B2FC C8FC                  		cmpa.w	#$C8FC,a1	; has the end of the queue been reached?
00001132 6700                       		beq.s	DMA_68KtoVRAM_Done ; return if there's no more room in the buffer
