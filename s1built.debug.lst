00001044                            PauseGame:				; XREF: Level_MainLoop; et al
00001044 4E71                       		nop	
00001046 4A38 FE12                  		tst.b	($FFFFFE12).w	; do you have any lives	left?
0000104A 6700                       		beq.s	Unpause		; if not, branch
0000104C 4A78 F63A                  		tst.w	($FFFFF63A).w	; is game already paused?
00001050 6600                       		bne.s	loc_13BE	; if yes, branch
00001052 0838 0007 F605             		btst	#7,($FFFFF605).w ; is Start button pressed?
00001058 6700                       		beq.s	Pause_DoNothing	; if not, branch
0000105A                            
0000105A                            loc_13BE:
0000105A 31FC 0001 F63A             		move.w	#1,($FFFFF63A).w ; freeze time
00001060 11FC 0001 F003             		move.b	#1,($FFFFF003).w ; pause music
00001066                            
00001066                            loc_13CA:
