00014FB4 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
00014FB8 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00014FBC 6B00                       		bmi.s	SAnim_End_FF	; if animation is complete, branch
00014FBE                            
00014FBE                            SAnim_Next:
00014FBE 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00014FC2 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00014FC6                            
00014FC6                            SAnim_Delay:
00014FC6 4E75                       		rts	
00014FC8                            ; ===========================================================================
00014FC8                            
00014FC8                            SAnim_End_FF:
00014FC8 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00014FCA 6600                       		bne.s	SAnim_End_FE	; if not, branch
00014FCC 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00014FD2 1029 0001                  		move.b	1(a1),d0	; read sprite number
00014FD6 60E6                       		bra.s	SAnim_Next
00014FD8                            ; ===========================================================================
00014FD8                            
00014FD8                            SAnim_End_FE:
00014FD8 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00014FDA 6600                       		bne.s	SAnim_End_FD	; if not, branch
00014FDC 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00014FE0 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00014FE4 9200                       		sub.b	d0,d1
00014FE6 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00014FEA 60D2                       		bra.s	SAnim_Next
00014FEC                            ; ===========================================================================
00014FEC                            
00014FEC                            SAnim_End_FD:
00014FEC 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00014FEE 6600                       		bne.s	SAnim_End	; if not, branch
00014FF0 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00014FF6                            
00014FF6                            SAnim_End:
00014FF6 4E75                       		rts	
00014FF8                            ; ===========================================================================
00014FF8                            
00014FF8                            SAnim_WalkRun:				; XREF: SAnim_Do
00014FF8 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00014FFC 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00014FFE 5200                       		addq.b	#1,d0		; is animation walking/running?
00015000 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015004 7200                       		moveq	#0,d1
00015006 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
0001500A 1428 0022                  		move.b	$22(a0),d2
0001500E 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015012 6600                       		bne.s	loc_13A70	; if yes, branch
00015014 4600                       		not.b	d0		; reverse angle
00015016                            
00015016                            loc_13A70:
00015016 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
0001501A 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001501C 7203                       		moveq	#3,d1
0001501E                            
0001501E                            loc_13A78:
0001501E 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015024 B302                       		eor.b	d1,d2
00015026 8528 0001                  		or.b	d2,1(a0)
0001502A 0828 0005 0022             		btst	#5,$22(a0)
00015030 6600 0000                  		bne.w	SAnim_Push
00015034 E808                       		lsr.b	#4,d0		; divide angle by $10
00015036 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
0001503A 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
0001503E 6A00                       		bpl.s	loc_13A9C
00015040 4442                       		neg.w	d2
00015042                            
