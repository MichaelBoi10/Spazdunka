00077A6A                          M 	@wait_11:
00077A6A 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00077A72 66F6                     M 	bne.s	@wait_11
00077A74                          M 	popo
00077A74 13FC 0002 00A0 0001      M 	move.b	#z_mpcm_command_pause,mpcm_z80_ram+z_mpcm_commandinput
00077A7C                          M 	mpcm_startz80
00077A7C 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00077A84 4E75                       	rts
