0000B0DA                            Ani_obj0F:
0000B0DA                            	include "_anim\obj0F.asm"
0000B0DA                            ; ---------------------------------------------------------------------------
0000B0DA                            ; Animation script - "TM" and "PRESS START BUTTON" on the title screen
0000B0DA                            ; ---------------------------------------------------------------------------
0000B0DA 0000                       		dc.w byte_A714-Ani_obj0F
0000B0DC 1F00 01FF                  byte_A714:	dc.b $1F, 0, 1,	$FF
0000B0E0                            		even
0000B0E0                            
0000B0E0                            ; ---------------------------------------------------------------------------
0000B0E0                            ; Subroutine to	animate	a sprite using an animation script
0000B0E0                            ; ---------------------------------------------------------------------------
0000B0E0                            
0000B0E0                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B0E0                            
0000B0E0                            
0000B0E0                            AnimateSprite:
0000B0E0 7000                       		moveq	#0,d0
0000B0E2 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B0E6 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B0EA 6700                       		beq.s	Anim_Run	; if not, branch
0000B0EC 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B0F0 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B0F6 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B0FC                            
0000B0FC                            Anim_Run:
0000B0FC 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B100 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B102 D040                       		add.w	d0,d0
0000B104 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B108 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B10C 7200                       		moveq	#0,d1
0000B10E 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B112 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B116 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B118                            
0000B118                            Anim_Next:
0000B118 1200                       		move.b	d0,d1
0000B11A 0200 001F                  		andi.b	#$1F,d0
0000B11E 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B122 1028 0022                  		move.b	$22(a0),d0
0000B126 E719                       		rol.b	#3,d1
0000B128 B101                       		eor.b	d0,d1
0000B12A 0201 0003                  		andi.b	#3,d1
0000B12E 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B134 8328 0001                  		or.b	d1,render_flags(a0)
0000B138 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
0000B13C                            
0000B13C                            Anim_Wait:
0000B13C 4E75                       		rts	
0000B13E                            ; ===========================================================================
0000B13E                            
0000B13E                            Anim_End_FF:
0000B13E 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000B140 6600                       		bne.s	Anim_End_FE	; if not, branch
0000B142 117C 0000 001B             		move.b	#0,anim_frame(a0)	; restart the animation
0000B148 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000B14C 60CA                       		bra.s	Anim_Next
0000B14E                            ; ===========================================================================
0000B14E                            
0000B14E                            Anim_End_FE:
0000B14E 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000B150 6600                       		bne.s	Anim_End_FD	; if not, branch
0000B152 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000B156 9128 001B                  		sub.b	d0,anim_frame(a0)	; jump back d0 bytes in	the script
0000B15A 9200                       		sub.b	d0,d1
0000B15C 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000B160 60B6                       		bra.s	Anim_Next
0000B162                            ; ===========================================================================
0000B162                            
0000B162                            Anim_End_FD:
0000B162 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000B164 6600                       		bne.s	Anim_End_FC	; if not, branch
0000B166 1171 1002 001C             		move.b	2(a1,d1.w),anim(a0) ; read next byte, run that animation
0000B16C                            
0000B16C                            Anim_End_FC:
0000B16C 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000B16E 6600                       		bne.s	Anim_End_FB	; if not, branch
0000B170 5428 0024                  		addq.b	#2,routine(a0)	; jump to next routine
0000B174                            
0000B174                            Anim_End_FB:
0000B174 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000B176 6600                       		bne.s	Anim_End_FA	; if not, branch
0000B178 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B17E 4228 0025                  		clr.b	$25(a0)		; reset	2nd routine counter
0000B182                            
0000B182                            Anim_End_FA:
0000B182 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000B184 6600                       		bne.s	Anim_End	; if not, branch
0000B186 5428 0025                  		addq.b	#2,routine_secondary(a0)	; jump to next routine
0000B18A                            
0000B18A                            Anim_End:
0000B18A 4E75                       		rts	
0000B18C                            ; End of function AnimateSprite
