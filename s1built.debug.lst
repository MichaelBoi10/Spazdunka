000154A4 0000                       		dc.w SonAni_Run-SonicAniData
000154A6 0000                       		dc.w SonAni_Roll-SonicAniData
000154A8 0000                       		dc.w SonAni_Roll2-SonicAniData
000154AA 0000                       		dc.w SonAni_Push-SonicAniData
000154AC 0000                       		dc.w SonAni_Wait-SonicAniData
