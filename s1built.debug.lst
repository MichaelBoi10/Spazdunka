00005B10 4DF9 00C0 0004             		lea	($C00004).l,a6
00005B16 3CBC 8004                  		move.w	#$8004,(a6)
00005B1A 3CBC 8230                  		move.w	#$8230,(a6)
00005B1E 3CBC 8407                  		move.w	#$8407,(a6)
