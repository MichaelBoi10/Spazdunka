00005BAC 6100 C0B6                  		bsr.w	Pal_FadeTo
00005BB0                            
00005BB0                            Cred_WaitLoop:
00005BB0 11FC 0004 F62A             		move.b	#4,($FFFFF62A).w
00005BB6 6100 CDE0                  		bsr.w	DelayProgram
00005BBA 6100 B75C                  		bsr.w	RunPLC_RAM
00005BBE 4A78 F614                  		tst.w	($FFFFF614).w	; have 2 seconds elapsed?
00005BC2 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005BC4 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005BC8 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005BCA 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
00005BD0 6700 0000                  		beq.w	TryAgainEnd	; if yes, branch
00005BD4 4E75                       		rts	
