0000B3DE                            ; Subroutine to	animate	a sprite using an animation script
0000B3DE                            ; ---------------------------------------------------------------------------
0000B3DE                            
0000B3DE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
