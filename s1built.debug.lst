0000B078                            ; ---------------------------------------------------------------------------
0000B078                            ; Subroutine to	animate	a sprite using an animation script
0000B078                            ; ---------------------------------------------------------------------------
0000B078                            
0000B078                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000B078                            
0000B078                            
0000B078                            AnimateSprite:
0000B078 7000                       		moveq	#0,d0
0000B07A 1028 001C                  		move.b	$1C(a0),d0	; move animation number	to d0
0000B07E B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
0000B082 6700                       		beq.s	Anim_Run	; if not, branch
0000B084 1140 001D                  		move.b	d0,next_anim(a0)	; set to "no restart"
0000B088 117C 0000 001B             		move.b	#0,anim_frame(a0)	; reset	animation
0000B08E 117C 0000 001E             		move.b	#0,anim_frame_duration(a0)	; reset	frame duration
0000B094                            
0000B094                            Anim_Run:
0000B094 5328 001E                  		subq.b	#1,anim_frame_duration(a0)	; subtract 1 from frame	duration
0000B098 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000B09A D040                       		add.w	d0,d0
0000B09C D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000B0A0 1151 001E                  		move.b	(a1),anim_frame_duration(a0)	; load frame duration
0000B0A4 7200                       		moveq	#0,d1
0000B0A6 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0000B0AA 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000B0AE 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000B0B0                            
0000B0B0                            Anim_Next:
0000B0B0 1200                       		move.b	d0,d1
0000B0B2 0200 001F                  		andi.b	#$1F,d0
0000B0B6 1140 001A                  		move.b	d0,mapping_frame(a0)	; load sprite number
0000B0BA 1028 0022                  		move.b	$22(a0),d0
0000B0BE E719                       		rol.b	#3,d1
0000B0C0 B101                       		eor.b	d0,d1
0000B0C2 0201 0003                  		andi.b	#3,d1
0000B0C6 0228 00FC 0001             		andi.b	#$FC,render_flags(a0)
0000B0CC 8328 0001                  		or.b	d1,render_flags(a0)
0000B0D0 5228 001B                  		addq.b	#1,anim_frame(a0)	; next frame number
