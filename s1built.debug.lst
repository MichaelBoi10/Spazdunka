00014BCA 6600 0000                  		bne.w	SCDPeelout_Charge
00014BCE 08A8 0001 0039             		bclr	#1,$39(a0)	; stop Dashing
00014BD4 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)	; have we been charging long enough?
00014BDA 6600                       		bne.s	SCDPeelout_Stop_Sound
00014BDC 117C 0000 001C             		move.b	#0,$1C(a0)	; launches here (peelout sprites)
00014BE2 317C 0001 0010             		move.w	#1,$10(a0)	; force X speed to nonzero for camera lag's benefit
00014BE8 3028 0014                  		move.w	$14(a0),d0
00014BEC 0440 0800                  		subi.w	#$800,d0
00014BF0 D040                       		add.w	d0,d0
00014BF2 0240 0800                  		andi.w	#$800,d0
00014BF6 4440                       		neg.w	d0
00014BF8 0640 0800                  		addi.w	#$800,d0
00014BFC                            		;move.w	d0,(v_cameralag).w
00014BFC 0828 0000 0022             		btst	#0,$22(a0)
00014C02 6700                       		beq.s	@dontflip
00014C04 4468 0014                  		neg.w	$14(a0)
00014C08                             
