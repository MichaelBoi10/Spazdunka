00081E32                            ; ------------------------------------------------------------------------------
00081E32                            ; Plays a given sample
00081E32                            ; ------------------------------------------------------------------------------
00081E32                            ; INPUT:
00081E32                            ;		d0	.b		sample id (>$81)
00081E32                            ;
00081E32                            ; EXAMPLES:
00081E32                            ;		move.b	#$81, d0
00081E32                            ;		jsr		MegaPCM_PlaySample
00081E32                            ;
00081E32                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081E32                            ;		jsr		MegaPCM_PlaySample
