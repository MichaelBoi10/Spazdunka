0001504C 6400                       		bcc.s	loc_13AB4	; if yes, branch
0001504E 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
00015054 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00015058 6400                       		bcc.s	loc_13AB4	; if yes, branch
0001505A 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00015060 1200                       		move.b	d0,d1
00015062 E209                       		lsr.b	#1,d1
00015064 D001                       		add.b	d1,d0
