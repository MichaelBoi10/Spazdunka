00014C22 D241                       		add.w	d1,d1
00014C24 4A38 FE2E                  		tst.b   ($FFFFFE2E).w 		; test for speed shoes
00014C28 6700                       		beq.s	@noshoes
00014C2A E242                       		asr.w	#1,d2
00014C2C 9242                       		sub.w	d2,d1
00014C2E                            
