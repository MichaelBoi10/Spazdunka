00014FA0                            
00014FA0                            Sonic_Animate:				; XREF: Obj01_Control; et al
00014FA0 43F9 0000 0000             		lea	(SonicAniData).l,a1
00014FA6 7000                       		moveq	#0,d0
00014FA8 1028 001C                  		move.b	$1C(a0),d0
00014FAC B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00014FB0 6700                       		beq.s	SAnim_Do	; if not, branch
00014FB2 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
00014FB6 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00014FBC 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00014FC2                            
00014FC2                            SAnim_Do:
00014FC2 D040                       		add.w	d0,d0
00014FC4 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00014FC8 1011                       		move.b	(a1),d0
00014FCA 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00014FCC 1228 0022                  		move.b	$22(a0),d1
00014FD0 0201 0001                  		andi.b	#1,d1
00014FD4 0228 00FC 0001             		andi.b	#$FC,1(a0)
00014FDA 8328 0001                  		or.b	d1,1(a0)
00014FDE 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00014FE2 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00014FE4 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00014FE8                            
00014FE8                            SAnim_Do2:
00014FE8 7200                       		moveq	#0,d1
00014FEA 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
00014FEE 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00014FF2 6B00                       		bmi.s	SAnim_End_FF	; if animation is complete, branch
00014FF4                            
00014FF4                            SAnim_Next:
00014FF4 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00014FF8 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00014FFC                            
00014FFC                            SAnim_Delay:
00014FFC 4E75                       		rts	
00014FFE                            ; ===========================================================================
00014FFE                            
00014FFE                            SAnim_End_FF:
00014FFE 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00015000 6600                       		bne.s	SAnim_End_FE	; if not, branch
00015002 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015008 1029 0001                  		move.b	1(a1),d0	; read sprite number
0001500C 60E6                       		bra.s	SAnim_Next
0001500E                            ; ===========================================================================
0001500E                            
0001500E                            SAnim_End_FE:
0001500E 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00015010 6600                       		bne.s	SAnim_End_FD	; if not, branch
00015012 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015016 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
0001501A 9200                       		sub.b	d0,d1
0001501C 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015020 60D2                       		bra.s	SAnim_Next
00015022                            ; ===========================================================================
00015022                            
00015022                            SAnim_End_FD:
00015022 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015024 6600                       		bne.s	SAnim_End	; if not, branch
00015026 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
0001502C                            
0001502C                            SAnim_End:
0001502C 4E75                       		rts	
0001502E                            ; ===========================================================================
0001502E                            
0001502E                            SAnim_WalkRun:				; XREF: SAnim_Do
0001502E 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015032 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015034 5200                       		addq.b	#1,d0		; is animation walking/running?
00015036 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
0001503A 7200                       		moveq	#0,d1
0001503C 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015040 1428 0022                  		move.b	$22(a0),d2
00015044 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015048 6600                       		bne.s	loc_13A70	; if yes, branch
0001504A 4600                       		not.b	d0		; reverse angle
0001504C                            
0001504C                            loc_13A70:
0001504C 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015050 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015052 7203                       		moveq	#3,d1
00015054                            
00015054                            loc_13A78:
00015054 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001505A B302                       		eor.b	d1,d2
0001505C 8528 0001                  		or.b	d2,1(a0)
00015060 0828 0005 0022             		btst	#5,$22(a0)
00015066 6600 0000                  		bne.w	SAnim_Push
0001506A E808                       		lsr.b	#4,d0		; divide angle by $10
0001506C 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015070 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015074 6A00                       		bpl.s	loc_13A9C
00015076 4442                       		neg.w	d2
00015078                            
00015078                            loc_13A9C:
00015078 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
0001507E 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015082 6400                       		bcc.s	loc_13AB4	; if yes, branch
00015084 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
0001508A 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
0001508E 6400                       		bcc.s	loc_13AB4	; if yes, branch
00015090 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00015096 1200                       		move.b	d0,d1
00015098 E209                       		lsr.b	#1,d1
0001509A D001                       		add.b	d1,d0
0001509C                            
0001509C                            loc_13AB4:
0001509C D000                       		add.b	d0,d0
0001509E 1600                       		move.b	d0,d3
000150A0 4442                       		neg.w	d2
000150A2 0642 0800                  		addi.w	#$800,d2
000150A6 6A00                       		bpl.s	loc_13AC2
000150A8 7400                       		moveq	#0,d2
000150AA                            
000150AA                            loc_13AC2:
000150AA E04A                       		lsr.w	#8,d2
000150AC 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000150B0 6100 FF36                  		bsr.w	SAnim_Do2
000150B4 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000150B8 4E75                       		rts	
000150BA                            ; ===========================================================================
000150BA                            
