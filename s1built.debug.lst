000057E4 41F9 0000 0000             		lea	(Nem_CreditText).l,a0 ;	load credits alphabet patterns
000057EA 6100 B980                  		bsr.w	NemDec
000057EE 43F8 FB80                  		lea	($FFFFFB80).w,a1
000057F2 7000                       		moveq	#0,d0
000057F4 323C 001F                  		move.w	#$1F,d1
000057F8                            
000057F8                            Cred_ClrPallet:
000057F8 22C0                       		move.l	d0,(a1)+
000057FA 51C9 FFFC                  		dbf	d1,Cred_ClrPallet ; fill pallet	with black ($0000)
000057FE                            
000057FE 7003                       		moveq	#3,d0
00005800 6100 C7B2                  		bsr.w	PalLoad1	; load Sonic's pallet
00005804 11FC 008A D080             		move.b	#$8A,($FFFFD080).w ; load credits object
0000580A 11FC 0000 FFD0             		move.b	#0,($FFFFFFD0).w
00005810 4EB9 0000 0000             		jsr	ObjectsLoad
00005816 4EB9 0000 0000             		jsr	BuildSprites
0000581C 6100 0000                  		bsr.w	EndingDemoLoad
00005820 7000                       		moveq	#0,d0
00005822 1038 FE10                  		move.b	($FFFFFE10).w,d0
00005826 E948                       		lsl.w	#4,d0
00005828 45F9 0000 0000             		lea	(MainLoadBlocks).l,a2 ;	load block mappings etc
0000582E 45F2 0000                  		lea	(a2,d0.w),a2
00005832 7000                       		moveq	#0,d0
00005834 1012                       		move.b	(a2),d0
00005836 6700                       		beq.s	loc_5862
00005838 6100 BA72                  		bsr.w	LoadPLC		; load level patterns
0000583C                            
0000583C                            loc_5862:
0000583C 7001                       		moveq	#1,d0
0000583E 6100 BA6C                  		bsr.w	LoadPLC		; load standard	level patterns
00005842 31FC 0078 F614             		move.w	#120,($FFFFF614).w ; display a credit for 2 seconds
00005848 6100 C41A                  		bsr.w	Pal_FadeTo
0000584C                            
0000584C                            Cred_WaitLoop:
0000584C 11FC 0004 F62A             		move.b	#4,($FFFFF62A).w
00005852 6100 D0FC                  		bsr.w	DelayProgram
00005856 6100 BAC0                  		bsr.w	RunPLC_RAM
0000585A 4A78 F614                  		tst.w	($FFFFF614).w	; have 2 seconds elapsed?
0000585E 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005860 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005864 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005866 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
0000586C 6700 0000                  		beq.w	TryAgainEnd	; if yes, branch
00005870 4E75                       		rts	
