00014834                            ; ---------------------------------------------------------------------------
00014834                            ; Subroutine called at the peak of a jump that transforms Sonic into Super Sonic
00014834                            ; if he has enough rings and emeralds
00014834                            ; ---------------------------------------------------------------------------
00014834                            
00014834                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00014834                            
00014834                            ; loc_1AB38: test_set_SS:
00014834                            Sonic_CheckGoSuper:
00014834 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014838 6600                       	bne.s	return_1ABA4		; if yes, branch
0001483A 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
00014840 6600                       	bne.s	return_1ABA4		; if not, branch
00014842 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014848 6500                       	bcs.s	return_1ABA4		; if not, branch
0001484A                            
0001484A 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
00014850 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
00014856 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
0001485C 117C 0081 002A             	move.b	#$81,obj_control(a0)
00014862 117C 001F 001C             	move.b	#$1F,anim(a0)			; use transformation animation
00014868 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
0001486E 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
00014874 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
0001487A 317C 0000 0032             	move.w	#0,invincibility_time(a0)
00014880 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
00014886 303C 00C3                  	move.w	#$C3,d0         ; 
0001488A 4EB9 0000 102E             	jsr	(PlaySound).l	; Play special ring sound effect.
00014890 303C 0094                  	move.w	#$94,d0
00014894 4EF9 0000 1034             	jmp	(PlaySound_Special).l	; Play the super theme
0001489A                            ; ---------------------------------------------------------------------------
0001489A                            return_1ABA4:
0001489A 4E75                       	rts
0001489C                            ; End of subroutine Sonic_CheckGoSuper
