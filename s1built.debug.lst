00077D68                            @Str_UnknownSampleType:
00077D68 556E 6B6E 6F77 6E20 7361+  	dc.b	"Unknown sample type or missing end marker. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE", 0
00077DD5                            @Str_PitchNotSet:
00077DD5 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
00077E2C                            @Str_WaveInvalidHeader:
00077E2C 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
00077E4C                            @Str_WaveBadAudioFormat:
00077E4C 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported audio format. Only PCM is supported", 0
00077E88                            @Str_WaveNotMono:
00077E88 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be mono", 0
00077EA7                            @Str_WaveNot8bit:
00077EA7 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be 8-bit unsigned PCM", 0
00077ED4                            @Str_WaveBadSampleRate:
00077ED4 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported sample rate. Use <=\#TYPE_PCM_MAX_RATE\ Hz for TYPE_PCM or \#TYPE_PCM_TURBO_MAX_RATE\ Hz for TYPE_PCM_TURBO.", 0
00077F35                            @Str_WaveMissingDataChunk:
00077F35 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Failed to locate 'data' chunk", 0
