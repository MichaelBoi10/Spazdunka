00014AA2                             
00014AA2                            Sonic_SpinDash:
00014AA2 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
00014AA6 6600                       		bne.s	loc2_1AC8E		; if set, branch
00014AA8 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
00014AAE 6600                       		bne.s	locret2_1AC8C		; if not, return
00014AB0 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
00014AB4 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
00014AB8 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
00014ABC 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
00014AC2 303C 00D1                  		move.w	#$D1,d0			; spin sound ($E0 in s2)
00014AC6 4EB9 0000 1034             		jsr	(PlaySound_Special).l	; play spin sound
00014ACC 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014ACE 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
00014AD4 317C 0000 003A             		move.w	#0,$3A(a0)		; set charge count to 0
00014ADA 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
00014AE0 6500                       		bcs.s	loc2_1AC84		; ??? branch if carry
00014AE2 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014AE8                            						; the smoke/dust object
00014AE8                            loc2_1AC84:
