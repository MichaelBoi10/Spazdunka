00198E90 =00000001                M 	__pos:	= instr("%<pal1>Camera (FG): %<pal0>%<.w $FFFFF700>-%<.w $FFFFF704>",'%<')
00198E90 =00000000                M 	__stack:=	0
00198E90 =00000000                M 	__sp:	= 0
