00077B52                            @Str_TooManySamples:
00077B52 546F 6F20 6D61 6E79 2073+  	dc.b	"Too many samples in table", 0
00077B6C                            @Str_UnknownSampleType:
00077B6C 556E 6B6E 6F77 6E20 7361+  	dc.b	"Unknown sample type or missing end marker. Please use one of: TYPE_PCM, TYPE_DPCM, TYPE_PCM_TURBO, TYPE_NONE", 0
00077BD9                            @Str_PitchNotSet:
00077BD9 5361 6D70 6C65 2072 6174+  	dc.b	"Sample rate can't be auto-detected (only works for .WAV files). Please set it manually", 0
00077C30                            @Str_WaveInvalidHeader:
00077C30 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Invalid WAVE header", 0
00077C50                            @Str_WaveBadAudioFormat:
00077C50 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported audio format. Only PCM is supported", 0
00077C8C                            @Str_WaveNotMono:
00077C8C 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be mono", 0
00077CAB                            @Str_WaveNot8bit:
00077CAB 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Audio must be 8-bit unsigned PCM", 0
00077CD8                            @Str_WaveBadSampleRate:
00077CD8 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Unsupported sample rate. Use <=\#TYPE_PCM_MAX_RATE\ Hz for TYPE_PCM or \#TYPE_PCM_TURBO_MAX_RATE\ Hz for TYPE_PCM_TURBO.", 0
00077D39                            @Str_WaveMissingDataChunk:
00077D39 5741 5645 2065 7272 6F72+  	dc.b	"WAVE error: Failed to locate 'data' chunk", 0
00077D63                            @Str_DpcmHqUnsupportedVersion:
