00081CCA                            ; ------------------------------------------------------------------------------
00081CCA                            ; Plays a given sample
00081CCA                            ; ------------------------------------------------------------------------------
00081CCA                            ; INPUT:
00081CCA                            ;		d0	.b		sample id (>$81)
00081CCA                            ;
00081CCA                            ; EXAMPLES:
00081CCA                            ;		move.b	#$81, d0
00081CCA                            ;		jsr		MegaPCM_PlaySample
00081CCA                            ;
00081CCA                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00081CCA                            ;		jsr		MegaPCM_PlaySample
00081CCA                            ; ------------------------------------------------------------------------------
00081CCA                            
00081CCA                            MegaPCM_PlaySample:
00081CCA                            	MPCM_play	d0
00081CCA                          M 	mpcm_stopz80
00081CCA                          M 	pusho
00081CCA                          M 	opt	l-
00081CCA 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081CD2                          M 	@wait_14:
00081CD2 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081CDA 66F6                     M 	bne.s	@wait_14
00081CDC                          M 	popo
00081CDC 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081CE2                          M 	mpcm_startz80
00081CE2 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081CEA 4E75                       	rts
