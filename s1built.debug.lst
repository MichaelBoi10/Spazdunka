00015084                            Sonic_Animate:				; XREF: Obj01_Control; et al
00015084 43F9 0000 0000             		lea	(SonicAniData).l,a1
0001508A 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
0001508E 6700                       		beq.s	SAnim_NotSuper
00015090 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
00015096                            
00015096                            SAnim_NotSuper:		
00015096 7000                       		moveq	#0,d0
00015098 1028 001C                  		move.b	$1C(a0),d0
0001509C B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
000150A0 6700                       		beq.s	SAnim_Do	; if not, branch
000150A2 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000150A6 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000150AC 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000150B2                            
000150B2                            SAnim_Do:
000150B2 D040                       		add.w	d0,d0
000150B4 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000150B8 1011                       		move.b	(a1),d0
000150BA 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000150BC 1228 0022                  		move.b	$22(a0),d1
000150C0 0201 0001                  		andi.b	#1,d1
000150C4 0228 00FC 0001             		andi.b	#$FC,1(a0)
000150CA 8328 0001                  		or.b	d1,1(a0)
000150CE 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
000150D2 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
000150D4 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
000150D8                            
000150D8                            SAnim_Do2:
000150D8 7200                       		moveq	#0,d1
000150DA 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
000150DE 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000150E2 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
000150E6 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
000150E8                            
000150E8                            SAnim_Next:
000150E8 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
000150EC 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
000150F0                            
000150F0                            SAnim_Delay:
000150F0 4E75                       		rts	
000150F2                            ; ===========================================================================
000150F2                            
000150F2                            SAnim_End_FF:
000150F2 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000150F4 6600                       		bne.s	SAnim_End_FE	; if not, branch
000150F6 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
000150FC 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015100 60E6                       		bra.s	SAnim_Next
00015102                            ; ===========================================================================
00015102                            
00015102                            SAnim_End_FE:
00015102 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00015104 6600                       		bne.s	SAnim_End_FD	; if not, branch
00015106 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0001510A 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
0001510E 9200                       		sub.b	d0,d1
00015110 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015114 60D2                       		bra.s	SAnim_Next
00015116                            ; ===========================================================================
00015116                            
00015116                            SAnim_End_FD:
00015116 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015118 6600                       		bne.s	SAnim_End	; if not, branch
0001511A 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015120                            
00015120                            SAnim_End:
00015120 4E75                       		rts	
00015122                            ; ===========================================================================
00015122                            
00015122                            SAnim_WalkRun:				; XREF: SAnim_Do
00015122 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015126 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015128 5200                       		addq.b	#1,d0		; is animation walking/running?
0001512A 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
0001512E 7200                       		moveq	#0,d1
00015130 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015134 1428 0022                  		move.b	$22(a0),d2
00015138 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
0001513C 6600                       		bne.s	loc_13A70	; if yes, branch
0001513E 4600                       		not.b	d0		; reverse angle
00015140                            
00015140                            loc_13A70:
00015140 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015144 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015146 7203                       		moveq	#3,d1
00015148                            
00015148                            loc_13A78:
00015148 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001514E B302                       		eor.b	d1,d2
00015150 8528 0001                  		or.b	d2,1(a0)
00015154 0828 0005 0022             		btst	#5,$22(a0)
0001515A 6600 0000                  		bne.w	SAnim_Push
0001515E E808                       		lsr.b	#4,d0		; divide angle by $10
00015160 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00015164 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015168 6A00                       		bpl.s	loc_13A9C
0001516A 4442                       		neg.w	d2
0001516C                            
0001516C                            loc_13A9C:
0001516C 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015170 6700                       		beq.s	Loc_NotSuper
00015172 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
00015178 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
0001517C 6400                       		bhs.s	SuperRun	; if yes, branch
0001517E 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
00015184 6000                       		bra.s	SuperWalk
00015186                            
00015186                            Loc_NotSuper:
00015186 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
0001518C 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00015190 6400                       		bhs.s	loc_13AB4	; if yes, branch
00015192 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
00015198 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
0001519C 6400                       		bhs.s	loc_13AB4	; if yes, branch
0001519E 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000151A4                            
000151A4                            SuperWalk:
000151A4 1200                       		move.b	d0,d1
000151A6 E209                       		lsr.b	#1,d1
000151A8 D001                       		add.b	d1,d0
000151AA                            
000151AA                            loc_13AB4:
000151AA D000                       		add.b	d0,d0
000151AC                            
000151AC                            SuperRun:
000151AC 1600                       		move.b	d0,d3
000151AE 4442                       		neg.w	d2
000151B0 0642 0800                  		addi.w	#$800,d2
000151B4 6A00                       		bpl.s	loc_13AC2
000151B6 7400                       		moveq	#0,d2
000151B8                            
000151B8                            loc_13AC2:
000151B8 E04A                       		lsr.w	#8,d2
000151BA 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151BE 6100 FF18                  		bsr.w	SAnim_Do2
000151C2 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000151C6 4E75                       		rts	
000151C8                            ; ===========================================================================
000151C8                            
000151C8                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000151C8 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000151CA 6600                       		bne.s	SAnim_Push	; if not, branch
000151CC 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000151D0 6A00                       		bpl.s	loc_13ADE
000151D2 4442                       		neg.w	d2
000151D4                            
000151D4                            loc_13ADE:
000151D4 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000151DA 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
000151DE 6400                       		bcc.s	loc_13AF0	; if yes, branch
000151E0 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
000151E6                            
000151E6                            loc_13AF0:
000151E6 4442                       		neg.w	d2
000151E8 0642 0400                  		addi.w	#$400,d2
000151EC 6A00                       		bpl.s	loc_13AFA
000151EE 7400                       		moveq	#0,d2
000151F0                            
000151F0                            loc_13AFA:
000151F0 E04A                       		lsr.w	#8,d2
000151F2 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000151F6 1228 0022                  		move.b	$22(a0),d1
000151FA 0201 0001                  		andi.b	#1,d1
000151FE 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015204 8328 0001                  		or.b	d1,1(a0)
00015208 6000 FECE                  		bra.w	SAnim_Do2
0001520C                            ; ===========================================================================
0001520C                            
0001520C                            SAnim_Push:				; XREF: SAnim_RollJump
0001520C 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015210 6B00                       		bmi.s	loc_13B1E
00015212 4442                       		neg.w	d2
00015214                            
00015214                            loc_13B1E:
00015214 0642 0800                  		addi.w	#$800,d2
00015218 6A00                       		bpl.s	loc_13B26
0001521A 7400                       		moveq	#0,d2
0001521C                            
0001521C                            loc_13B26:
0001521C EC4A                       		lsr.w	#6,d2
0001521E 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015222 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00015228 1228 0022                  		move.b	$22(a0),d1
0001522C 0201 0001                  		andi.b	#1,d1
00015230 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015236 8328 0001                  		or.b	d1,1(a0)
0001523A 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
0001523E 6700                       		beq.s	Loc_NotSuper2
00015240 43F9 0000 0000             		lea	(SupSonAni_Push).l,a1 ; use	running	animation
00015246                            
00015246                            Loc_NotSuper2:
00015246 6000 FE90                  		bra.w	SAnim_Do2
0001524A                            ; End of function Sonic_Animate
