0001460E                            ; Subroutine called at the peak of a jump that transforms Sonic into Super Sonic
0001460E                            ; if he has enough rings and emeralds
0001460E                            ; ---------------------------------------------------------------------------
0001460E                            
0001460E                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0001460E                            
0001460E                            ; loc_1AB38: test_set_SS:
0001460E                            Sonic_CheckGoSuper:
0001460E 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; is Sonic already Super?
00014612 6600                       	bne.s	return_1ABA4		; if yes, branch
00014614 0C38 0006 FE57             	cmpi.b	#6,(Emerald_count).w	; does Sonic have exactly 6 emeralds?
0001461A 6600                       	bne.s	return_1ABA4		; if not, branch
0001461C 0C78 0032 FE20             	cmpi.w	#50,(Ring_count).w	; does Sonic have at least 50 rings?
00014622 6500                       	bcs.s	return_1ABA4		; if not, branch
00014624                            
00014624 11FC 0001 F65F             	move.b	#1,(Super_Sonic_palette).w
0001462A 11FC 000F F65E             	move.b	#$F,(Palette_frame_count).w
00014630 11FC 0001 FE19             	move.b	#1,(Super_Sonic_flag).w
00014636 117C 0081 002A             	move.b	#$81,obj_control(a0)
0001463C 117C 001F 001C             	move.b	#$1F,anim(a0)			; use transformation animation
00014642 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
00014648 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
0001464E 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
00014654 317C 0000 0032             	move.w	#0,invincibility_time(a0)
0001465A 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
00014660 303C 00C3                  	move.w	#$C3,d0         ; 
00014664 4EB9 0000 1032             	jsr	(PlaySound).l	; Play special ring sound effect.
0001466A 303C 0094                  	move.w	#$94,d0
0001466E 4EF9 0000 1038             	jmp	(PlaySound_Special).l	; Play the super theme
00014674                            ; ---------------------------------------------------------------------------
