0000DE3C                            Obj36_SideWays:				; XREF: Obj36_Solid
0000DE3C 323C 001B                  		move.w	#$1B,d1
0000DE40 3602                       		move.w	d2,d3
0000DE42 5243                       		addq.w	#1,d3
0000DE44 3828 0008                  		move.w	8(a0),d4
0000DE48 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DE4C 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000DE50 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000DE54 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000DE58 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000DE5E 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000DE60 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DE62 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DE64 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DE66 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DE68                            ; ===========================================================================
0000DE68                            
0000DE68                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DE68                            
0000DE68                            Obj36_Upright:				; XREF: Obj36_Solid
0000DE68 7200                       		moveq	#0,d1
0000DE6A 1228 0019                  		move.b	$19(a0),d1
