00015360 6600                       		bne.s	SAnim_End	; if not, branch
00015362 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015368                            
00015368                            SAnim_End:
00015368 4E75                       		rts	
