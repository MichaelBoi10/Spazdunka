0000DB6C 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DB6E 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DB72 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
