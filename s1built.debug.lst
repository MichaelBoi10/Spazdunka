00077D24 0000 0000                  	dc.l	(MPCM_ST_UNKNOWN_SAMPLE_TYPE<<24)			| @Str_UnknownSampleType
00077D28 0000 0000                  	dc.l	(MPCM_ST_PITCH_NOT_SET<<24)					| @Str_PitchNotSet
00077D2C 0000 0000                  	dc.l	(MPCM_ST_WAVE_INVALID_HEADER<<24)			| @Str_WaveInvalidHeader
00077D30 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_AUDIO_FORMAT<<24)			| @Str_WaveBadAudioFormat
00077D34 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_MONO<<24)					| @Str_WaveNotMono
00077D38 0000 0000                  	dc.l	(MPCM_ST_WAVE_NOT_8BIT<<24)					| @Str_WaveNot8bit
00077D3C 0000 0000                  	dc.l	(MPCM_ST_WAVE_BAD_SAMPLE_RATE<<24)			| @Str_WaveBadSampleRate
00077D40 0000 0000                  	dc.l	(MPCM_ST_WAVE_MISSING_DATA_CHUNK<<24)		| @Str_WaveMissingDataChunk
00077D44 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_UNSUPPORTED_VERSION<<24)	| @Str_DpcmHqUnsupportedVersion
00077D48 0000 0000                  	dc.l	(MPCM_ST_DPCM_HQ_BAD_SAMPLE_RATE<<24)		| @Str_DpcmHqBadSampleRate
