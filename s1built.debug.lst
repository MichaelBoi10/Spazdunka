0000D9BA                            Obj36_Solid:				; XREF: Obj36_Index
0000D9BA 6100 0000                  		bsr.w	Obj36_Type0x	; make the object move
0000D9BE 343C 0004                  		move.w	#4,d2
0000D9C2 0C28 0005 001A             		cmpi.b	#5,mapping_frame(a0)	; is object type $5x ?
0000D9C8 6700                       		beq.s	Obj36_SideWays	; if yes, branch
0000D9CA 0C28 0001 001A             		cmpi.b	#1,mapping_frame(a0)	; is object type $1x ?
0000D9D0 6600                       		bne.s	Obj36_Upright	; if not, branch
0000D9D2 343C 0014                  		move.w	#$14,d2
0000D9D6                            
0000D9D6                            ; Spikes types $1x and $5x face	sideways
0000D9D6                            
0000D9D6                            Obj36_SideWays:				; XREF: Obj36_Solid
0000D9D6 323C 001B                  		move.w	#$1B,d1
0000D9DA 3602                       		move.w	d2,d3
0000D9DC 5243                       		addq.w	#1,d3
0000D9DE 3828 0008                  		move.w	8(a0),d4
0000D9E2 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000D9E6 6F00 0000                  		ble.w	Obj36_Display		; branch if not touched at all (0) or top/bottom touched (-1)
0000D9EA 3038 D008                  		move.w	($FFFFD000+$08).w,d0	; load Sonic's X position into d0
0000D9EE 9068 0008                  		sub.w	$08(a0),d0		; subtract spikes' X position
0000D9F2 0828 0000 0022             		btst	#0,$22(a0)		; are spikes facing left? (X-flip flag clear)
0000D9F8 6700                       		beq.s	Obj36_ChkHurt		; if yes, branch
0000D9FA 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000D9FC 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000D9FE 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DA00 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
0000DA02                            ; ===========================================================================
0000DA02                            
0000DA02                            ; Spikes types $0x, $2x, $3x and $4x face up or	down
0000DA02                            
0000DA02                            Obj36_Upright:				; XREF: Obj36_Solid
0000DA02 7200                       		moveq	#0,d1
0000DA04 1228 0019                  		move.b	$19(a0),d1
0000DA08 0641 000B                  		addi.w	#$B,d1
0000DA0C 343C 0010                  		move.w	#$10,d2
0000DA10 363C 0011                  		move.w	#$11,d3
0000DA14 3828 0008                  		move.w	8(a0),d4
0000DA18 6100 0000                  		bsr.w	SolidObject		; check if Sonic touched the spikes
0000DA1C 0828 0003 0022             		btst	#3,$22(a0)		; does Sonic stand on the spikes? (landing on it after taking damage)
0000DA22 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DA24 4A44                       		tst.w	d4			; check response value from SolidObject
0000DA26 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DA28 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DA2C 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
0000DA30 0828 0001 0022             		btst	#1,$22(a0)		; are spikes facing up? (Y-flip flag clear)
0000DA36 6700                       		beq.s	Obj36_chkHurt2		; if yes, branch
0000DA38 4440                       		neg.w	d0			; invert difference to check opposite end for upside-down spikes
0000DA3A 4A40                       Obj36_chkHurt2:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DA3C 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DA3E                            		; otherwise, fall through to Spik_Hurt
0000DA3E                            
0000DA3E                            Obj36_Hurt:				; XREF: Obj36_SideWays; Obj36_Upright
0000DA3E 4A38 FE2D                  		tst.b	($FFFFFE2D).w	; is Sonic invincible?
0000DA42 6600                       		bne.s	Obj36_Display	; if yes, branch
0000DA44 4A78 D030                  		tst.w	($FFFFD030).w	; +++ is Sonic invulnerable?
0000DA48 6600                       		bne.s	Obj36_Display	; +++ if yes, branch
0000DA4A 2F08                       		move.l	a0,-(sp)
0000DA4C 2448                       		movea.l	a0,a2
0000DA4E 41F8 D000                  		lea	($FFFFD000).w,a0
0000DA52 0C28 0004 0024             		cmpi.b	#4,routine(a0)
0000DA58 6400                       		bcc.s	loc_CF20
0000DA5A 2628 000C                  		move.l	$C(a0),d3
0000DA5E 3028 0012                  		move.w	$12(a0),d0
0000DA62 48C0                       		ext.l	d0
0000DA64 E180                       		asl.l	#8,d0
0000DA66 9680                       		sub.l	d0,d3
0000DA68 2143 000C                  		move.l	d3,y_pos(a0)
0000DA6C 4EB9 0000 0000             		jsr	HurtSonic
