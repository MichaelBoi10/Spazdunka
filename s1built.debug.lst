000148F4                            Sonic_Super:
000148F4 4A38 FE19                  	tst.b	(Super_Sonic_flag).w	; Ignore all this code if not Super Sonic
000148F8 6700 0000                  	beq.w	return_1AC3C
000148FC 4A38 FE1E                  	tst.b	(Update_HUD_timer).w
00014900 6700                       	beq.s	Sonic_RevertToNormal ; ?
00014902 5378 F670                  	subq.w	#1,(Super_Sonic_frame_count).w
00014906 6A00 0000                  	bpl.w	return_1AC3C
0001490A 31FC 003C F670             	move.w	#60,(Super_Sonic_frame_count).w	; Reset frame counter to 60
00014910 4A78 FE20                  	tst.w	(Ring_count).w
00014914 6700                       	beq.s	Sonic_RevertToNormal
00014916 0038 0001 FE1D             	ori.b	#1,(Update_HUD_rings).w
0001491C 0C78 0001 FE20             	cmpi.w	#1,(Ring_count).w
00014922 6700                       	beq.s	@update
00014924 0C78 000A FE20             	cmpi.w	#10,(Ring_count).w
0001492A 6700                       	beq.s	@update
0001492C 0C78 0064 FE20             	cmpi.w	#100,(Ring_count).w
00014932 6600                       	bne.s	@update2
00014934                            @update
00014934 0038 0080 FE1D             	ori.b	#$80,(Update_HUD_rings).w
0001493A                            @update2
0001493A 5378 FE20                  	subq.w	#1,(Ring_count).w
0001493E 6600                       	bne.s	return_1AC3C
00014940                            ; loc_1ABF2:
00014940                            Sonic_RevertToNormal:
00014940 11FC 0002 F65F             	move.b	#2,(Super_Sonic_palette).w	; Remove rotating palette
00014946 31FC 0028 F65C             	move.w	#$28,($FFFFF65C).w	; Unknown
0001494C 11FC 0000 FE19             	move.b	#0,(Super_Sonic_flag).w
00014952 117C 0001 001D             	move.b	#1,next_anim(a0)	; Change animation back to normal ?
00014958 317C 0001 0032             	move.w	#1,invincibility_time(a0)	; Remove invincibility
0001495E 31FC 0630 F760             	move.w	#$630,(Sonic_top_speed).w
00014964 31FC 000C F762             	move.w	#$C,(Sonic_acceleration).w
0001496A 31FC 0080 F764             	move.w	#$80,(Sonic_deceleration).w
00014970 0828 0006 0022             	btst	#6,status(a0)	; Check if underwater, return if not
00014976 6700                       	beq.s	return_1AC3C
00014978 31FC 0300 F760             	move.w	#$300,(Sonic_top_speed).w
0001497E 31FC 0006 F762             	move.w	#6,(Sonic_acceleration).w
00014984 31FC 0040 F764             	move.w	#$40,(Sonic_deceleration).w
0001498A                            
