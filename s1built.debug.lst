000147F6 6F00                       		ble.s	locret_134C2
000147F8 1038 F602                  		move.b	($FFFFF602).w,d0
000147FC 0200 0070                  		andi.b	#$70,d0		; is A,	B or C pressed?
00014800 6600                       		bne.s	locret_134C2	; if yes, branch
00014802 3141 0012                  		move.w	d1,y_vel(a0)
