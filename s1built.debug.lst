000152DC                            ; ---------------------------------------------------------------------------
000152DC                            ; Subroutine to	animate	Sonic's sprites
000152DC                            ; ---------------------------------------------------------------------------
000152DC                            
000152DC                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000152DC                            
000152DC                            
000152DC                            Sonic_Animate:				; XREF: Obj01_Control; et al
000152DC 43F9 0000 0000             		lea	(SonicAniData).l,a1
000152E2 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
000152E6 6700                       		beq.s	SAnim_NotSuper
000152E8 43F9 0000 0000             		lea	(SuperSonicAniData).l,a1
000152EE                            
000152EE                            SAnim_NotSuper:		
000152EE 7000                       		moveq	#0,d0
000152F0 1028 001C                  		move.b	$1C(a0),d0
000152F4 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
000152F8 6700                       		beq.s	SAnim_Do	; if not, branch
000152FA 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000152FE 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00015304 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
0001530A                            
0001530A                            SAnim_Do:
0001530A D040                       		add.w	d0,d0
0001530C D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00015310 1011                       		move.b	(a1),d0
00015312 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00015314 1228 0022                  		move.b	$22(a0),d1
00015318 0201 0001                  		andi.b	#1,d1
0001531C 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015322 8328 0001                  		or.b	d1,1(a0)
00015326 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
0001532A 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
0001532C 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00015330                            
00015330                            SAnim_Do2:
00015330 7200                       		moveq	#0,d1
00015332 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
00015336 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0001533A 0C00 00FD                  		cmpi.b	#$FD,d0		; MJ: is it a flag from FD to FF?
0001533E 6400                       		bhs.s	SAnim_End_FF			; MJ: if so, branch to flag routines
00015340                            
00015340                            SAnim_Next:
00015340 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00015344 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00015348                            
00015348                            SAnim_Delay:
00015348 4E75                       		rts	
0001534A                            ; ===========================================================================
0001534A                            
0001534A                            SAnim_End_FF:
0001534A 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0001534C 6600                       		bne.s	SAnim_End_FE	; if not, branch
0001534E 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015354 1029 0001                  		move.b	1(a1),d0	; read sprite number
00015358 60E6                       		bra.s	SAnim_Next
0001535A                            ; ===========================================================================
0001535A                            
0001535A                            SAnim_End_FE:
0001535A 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0001535C 6600                       		bne.s	SAnim_End_FD	; if not, branch
0001535E 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015362 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00015366 9200                       		sub.b	d0,d1
00015368 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0001536C 60D2                       		bra.s	SAnim_Next
0001536E                            ; ===========================================================================
0001536E                            
0001536E                            SAnim_End_FD:
0001536E 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015370 6600                       		bne.s	SAnim_End	; if not, branch
00015372 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00015378                            
00015378                            SAnim_End:
00015378 4E75                       		rts	
0001537A                            ; ===========================================================================
0001537A                            
0001537A                            SAnim_WalkRun:				; XREF: SAnim_Do
0001537A 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
0001537E 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015380 5200                       		addq.b	#1,d0		; is animation walking/running?
00015382 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00015386 7200                       		moveq	#0,d1
00015388 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
0001538C 1428 0022                  		move.b	$22(a0),d2
00015390 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015394 6600                       		bne.s	loc_13A70	; if yes, branch
00015396 4600                       		not.b	d0		; reverse angle
00015398                            
00015398                            loc_13A70:
00015398 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
0001539C 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
0001539E 7203                       		moveq	#3,d1
000153A0                            
000153A0                            loc_13A78:
000153A0 0228 00FC 0001             		andi.b	#$FC,1(a0)
000153A6 B302                       		eor.b	d1,d2
000153A8 8528 0001                  		or.b	d2,1(a0)
000153AC 0828 0005 0022             		btst	#5,$22(a0)
000153B2 6600 0000                  		bne.w	SAnim_Push
000153B6 E808                       		lsr.b	#4,d0		; divide angle by $10
000153B8 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
000153BC 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000153C0 6A00                       		bpl.s	loc_13A9C
000153C2 4442                       		neg.w	d2
000153C4                            
000153C4                            loc_13A9C:
000153C4 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
000153C8 6700                       		beq.s	Loc_NotSuper
000153CA 43F9 0000 0000             		lea	(SupSonAni_Run).l,a1 ; use	running	animation
000153D0 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000153D4 6400                       		bhs.s	SuperRun	; if yes, branch
000153D6 43F9 0000 0000             		lea	(SupSonAni_Walk).l,a1 ; use walking animation
000153DC 6000                       		bra.s	SuperWalk
000153DE                            
000153DE                            Loc_NotSuper:
000153DE 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
000153E4 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000153E8 6400                       		bhs.s	loc_13AB4	; if yes, branch
000153EA 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000153F0 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000153F4 6400                       		bhs.s	loc_13AB4	; if yes, branch
000153F6 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000153FC                            
000153FC                            SuperWalk:
000153FC 1200                       		move.b	d0,d1
000153FE E209                       		lsr.b	#1,d1
00015400 D001                       		add.b	d1,d0
00015402                            
00015402                            loc_13AB4:
00015402 D000                       		add.b	d0,d0
00015404                            
00015404                            SuperRun:
00015404 1600                       		move.b	d0,d3
00015406 4442                       		neg.w	d2
00015408 0642 0800                  		addi.w	#$800,d2
0001540C 6A00                       		bpl.s	loc_13AC2
0001540E 7400                       		moveq	#0,d2
00015410                            
00015410                            loc_13AC2:
00015410 E04A                       		lsr.w	#8,d2
00015412 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015416 6100 FF18                  		bsr.w	SAnim_Do2
0001541A D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
0001541E 4E75                       		rts	
00015420                            ; ===========================================================================
00015420                            
00015420                            SAnim_RollJump:				; XREF: SAnim_WalkRun
00015420 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
00015422 6600                       		bne.s	SAnim_Push	; if not, branch
00015424 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015428 6A00                       		bpl.s	loc_13ADE
0001542A 4442                       		neg.w	d2
0001542C                            
0001542C                            loc_13ADE:
0001542C 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
00015432 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00015436 6400                       		bcc.s	loc_13AF0	; if yes, branch
00015438 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
0001543E                            
0001543E                            loc_13AF0:
0001543E 4442                       		neg.w	d2
00015440 0642 0400                  		addi.w	#$400,d2
00015444 6A00                       		bpl.s	loc_13AFA
00015446 7400                       		moveq	#0,d2
00015448                            
00015448                            loc_13AFA:
00015448 E04A                       		lsr.w	#8,d2
0001544A 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001544E 1228 0022                  		move.b	$22(a0),d1
00015452 0201 0001                  		andi.b	#1,d1
00015456 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001545C 8328 0001                  		or.b	d1,1(a0)
00015460 6000 FECE                  		bra.w	SAnim_Do2
00015464                            ; ===========================================================================
00015464                            
00015464                            SAnim_Push:				; XREF: SAnim_RollJump
00015464 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00015468 6B00                       		bmi.s	loc_13B1E
0001546A 4442                       		neg.w	d2
0001546C                            
0001546C                            loc_13B1E:
0001546C 0642 0800                  		addi.w	#$800,d2
00015470 6A00                       		bpl.s	loc_13B26
00015472 7400                       		moveq	#0,d2
00015474                            
00015474                            loc_13B26:
00015474 EC4A                       		lsr.w	#6,d2
00015476 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001547A 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00015480 1228 0022                  		move.b	$22(a0),d1
00015484 0201 0001                  		andi.b	#1,d1
00015488 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001548E 8328 0001                  		or.b	d1,1(a0)
00015492 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
00015496 6700                       		beq.s	Loc_NotSuper2
00015498 43F9 0000 0000             		lea	(SupSonAni_Push).l,a1 ; use	running	animation
0001549E                            
0001549E                            Loc_NotSuper2:
0001549E 6000 FE90                  		bra.w	SAnim_Do2
000154A2                            ; End of function Sonic_Animate
