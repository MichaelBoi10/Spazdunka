00014ECA                            ; ---------------------------------------------------------------------------
00014ECA                            ; Subroutine to	animate	Sonic's sprites
00014ECA                            ; ---------------------------------------------------------------------------
00014ECA                            
00014ECA                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014ECA                            
00014ECA                            
00014ECA                            Sonic_Animate:				; XREF: Obj01_Control; et al
00014ECA 43F9 0000 0000             		lea	(SonicAniData).l,a1
00014ED0 7000                       		moveq	#0,d0
00014ED2 1028 001C                  		move.b	$1C(a0),d0
00014ED6 B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
00014EDA 6700                       		beq.s	SAnim_Do	; if not, branch
00014EDC 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
00014EE0 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
00014EE6 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
00014EEC                            
00014EEC                            SAnim_Do:
00014EEC D040                       		add.w	d0,d0
00014EEE D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00014EF2 1011                       		move.b	(a1),d0
00014EF4 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
00014EF6 1228 0022                  		move.b	$22(a0),d1
00014EFA 0201 0001                  		andi.b	#1,d1
00014EFE 0228 00FC 0001             		andi.b	#$FC,1(a0)
00014F04 8328 0001                  		or.b	d1,1(a0)
00014F08 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00014F0C 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00014F0E 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00014F12                            
00014F12                            SAnim_Do2:
00014F12 7200                       		moveq	#0,d1
00014F14 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
00014F18 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00014F1C 6B00                       		bmi.s	SAnim_End_FF	; if animation is complete, branch
00014F1E                            
00014F1E                            SAnim_Next:
00014F1E 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00014F22 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
00014F26                            
00014F26                            SAnim_Delay:
00014F26 4E75                       		rts	
00014F28                            ; ===========================================================================
00014F28                            
00014F28                            SAnim_End_FF:
00014F28 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00014F2A 6600                       		bne.s	SAnim_End_FE	; if not, branch
00014F2C 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00014F32 1029 0001                  		move.b	1(a1),d0	; read sprite number
00014F36 60E6                       		bra.s	SAnim_Next
00014F38                            ; ===========================================================================
00014F38                            
00014F38                            SAnim_End_FE:
00014F38 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00014F3A 6600                       		bne.s	SAnim_End_FD	; if not, branch
00014F3C 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00014F40 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
00014F44 9200                       		sub.b	d0,d1
00014F46 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00014F4A 60D2                       		bra.s	SAnim_Next
00014F4C                            ; ===========================================================================
00014F4C                            
00014F4C                            SAnim_End_FD:
00014F4C 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00014F4E 6600                       		bne.s	SAnim_End	; if not, branch
00014F50 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
00014F56                            
00014F56                            SAnim_End:
00014F56 4E75                       		rts	
00014F58                            ; ===========================================================================
00014F58                            
00014F58                            SAnim_WalkRun:				; XREF: SAnim_Do
00014F58 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00014F5C 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00014F5E 5200                       		addq.b	#1,d0		; is animation walking/running?
00014F60 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
00014F64 7200                       		moveq	#0,d1
00014F66 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00014F6A 1428 0022                  		move.b	$22(a0),d2
00014F6E 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00014F72 6600                       		bne.s	loc_13A70	; if yes, branch
00014F74 4600                       		not.b	d0		; reverse angle
00014F76                            
00014F76                            loc_13A70:
00014F76 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00014F7A 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00014F7C 7203                       		moveq	#3,d1
00014F7E                            
00014F7E                            loc_13A78:
00014F7E 0228 00FC 0001             		andi.b	#$FC,1(a0)
00014F84 B302                       		eor.b	d1,d2
00014F86 8528 0001                  		or.b	d2,1(a0)
00014F8A 0828 0005 0022             		btst	#5,$22(a0)
00014F90 6600 0000                  		bne.w	SAnim_Push
00014F94 E808                       		lsr.b	#4,d0		; divide angle by $10
00014F96 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00014F9A 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00014F9E 6A00                       		bpl.s	loc_13A9C
00014FA0 4442                       		neg.w	d2
00014FA2                            
00014FA2                            loc_13A9C:
00014FA2 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
00014FA8 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
00014FAC 6400                       		bcc.s	loc_13AB4	; if yes, branch
00014FAE 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
00014FB4 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00014FB8 6400                       		bcc.s	loc_13AB4	; if yes, branch
00014FBA 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00014FC0 1200                       		move.b	d0,d1
00014FC2 E209                       		lsr.b	#1,d1
00014FC4 D001                       		add.b	d1,d0
00014FC6                            
00014FC6                            loc_13AB4:
00014FC6 D000                       		add.b	d0,d0
00014FC8 1600                       		move.b	d0,d3
00014FCA 4442                       		neg.w	d2
00014FCC 0642 0800                  		addi.w	#$800,d2
00014FD0 6A00                       		bpl.s	loc_13AC2
00014FD2 7400                       		moveq	#0,d2
00014FD4                            
00014FD4                            loc_13AC2:
00014FD4 E04A                       		lsr.w	#8,d2
00014FD6 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00014FDA 6100 FF36                  		bsr.w	SAnim_Do2
00014FDE D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
00014FE2 4E75                       		rts	
00014FE4                            ; ===========================================================================
00014FE4                            
00014FE4                            SAnim_RollJump:				; XREF: SAnim_WalkRun
00014FE4 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
00014FE6 6600                       		bne.s	SAnim_Push	; if not, branch
00014FE8 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
00014FEC 6A00                       		bpl.s	loc_13ADE
00014FEE 4442                       		neg.w	d2
00014FF0                            
00014FF0                            loc_13ADE:
00014FF0 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
00014FF6 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00014FFA 6400                       		bcc.s	loc_13AF0	; if yes, branch
00014FFC 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
00015002                            
00015002                            loc_13AF0:
00015002 4442                       		neg.w	d2
00015004 0642 0400                  		addi.w	#$400,d2
00015008 6A00                       		bpl.s	loc_13AFA
0001500A 7400                       		moveq	#0,d2
0001500C                            
0001500C                            loc_13AFA:
0001500C E04A                       		lsr.w	#8,d2
0001500E 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015012 1228 0022                  		move.b	$22(a0),d1
00015016 0201 0001                  		andi.b	#1,d1
0001501A 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015020 8328 0001                  		or.b	d1,1(a0)
00015024 6000 FEEC                  		bra.w	SAnim_Do2
00015028                            ; ===========================================================================
00015028                            
00015028                            SAnim_Push:				; XREF: SAnim_RollJump
00015028 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
0001502C 6B00                       		bmi.s	loc_13B1E
0001502E 4442                       		neg.w	d2
00015030                            
00015030                            loc_13B1E:
00015030 0642 0800                  		addi.w	#$800,d2
00015034 6A00                       		bpl.s	loc_13B26
00015036 7400                       		moveq	#0,d2
00015038                            
00015038                            loc_13B26:
00015038 EC4A                       		lsr.w	#6,d2
0001503A 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001503E 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00015044 1228 0022                  		move.b	$22(a0),d1
00015048 0201 0001                  		andi.b	#1,d1
0001504C 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015052 8328 0001                  		or.b	d1,1(a0)
00015056 6000 FEBA                  		bra.w	SAnim_Do2
0001505A                            ; End of function Sonic_Animate
