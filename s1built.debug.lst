0000DB16 6600                       		bne.s	Obj36_chkAnyway		; if yes, check for collision anyway
0000DB18 4A44                       		tst.w	d4			; check response value from SolidObject
0000DB1A 6C00                       		bge.s	Obj36_Display		; branch if not touched at all (0) or touched from the sides (+1)
0000DB1C 3038 D00C                  Obj36_chkAnyway:	move.w	($FFFFD000+$0C).w,d0	; load Sonic's Y position into d0
0000DB20 9068 000C                  		sub.w	$0C(a0),d0		; subtract spikes' Y position
