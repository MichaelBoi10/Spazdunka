00081E32                            MegaPCM_PlaySample:
00081E32                            	MPCM_play	d0
00081E32                          M 	mpcm_stopz80
00081E32                          M 	pusho
00081E32                          M 	opt	l-
00081E32 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
00081E3A                          M 	@wait_14:
00081E3A 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00081E42 66F6                     M 	bne.s	@wait_14
00081E44                          M 	popo
00081E44 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
00081E4A                          M 	mpcm_startz80
00081E4A 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00081E52 4E75                       	rts
