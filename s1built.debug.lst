0001472A                            Sonic_Peelout:
0001472A                            		include "_peelout/peelout.asm"
0001472A                            ; ---------------------------------------------------------------------------
0001472A                            ; Subroutine to make Sonic perform a peelout
0001472A                            ; ---------------------------------------------------------------------------
0001472A                            ; If you use this makes sure to search for ;Peelout in Sonic1.asm
0001472A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001472A                            
0001472A                            ;SCDPeelout:
0001472A 0828 0001 0039             		btst	#1,$39(a0)
00014730 6600                       		bne.s	SCDPeelout_Launch
00014732 0C28 0007 001C             		cmpi.b	#7,$1C(a0) ;check to see if your looking up
00014738 6600                       		bne.s	@return
0001473A 1038 F603                  		move.b	($FFFFF603).w,d0
0001473E 0200 0070                  		andi.b	#%01110000,d0
00014742 6700 0000                  		beq.w	@return
00014746 117C 0001 001C             		move.b	#1,$1C(a0)
0001474C 317C 0000 003A             		move.w	#0,$3A(a0)
00014752 303C 00D2                  		move.w	#$D2,d0
00014756 11FC 0002 D1DC                             move.b	#2,($FFFFD1DC).w
0001475C 4EB9 0000 1038             		jsr		(PlaySound_Special).l 	; Play peelout charge sound
00014762                            	       ;sfx 	sfx_PeeloutCharge 		; These are if you use AMPS
00014762 588F                       		addq.l	#4,sp
00014764 08E8 0001 0039             		bset	#1,$39(a0)
0001476A                            		
0001476A 4268 0014                  		clr.w	$14(a0)
0001476E                             
0001476E 6100 FC6C                  		bsr.w	Sonic_LevelBound
00014772 6100 0000                  		bsr.w	Sonic_AnglePos
00014776                             
00014776                            	@return:
00014776 4E75                       		rts	
00014778                            ; ---------------------------------------------------------------------------
00014778                             
00014778                            SCDPeelout_Launch:
00014778 1038 F602                  		move.b	($FFFFF602).w,d0
0001477C 0800 0000                  		btst	#0,d0
00014780 6600 0000                  		bne.w	SCDPeelout_Charge
00014784 08A8 0001 0039             		bclr	#1,$39(a0)	; stop Dashing
0001478A 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)	; have we been charging long enough?
00014790 6600                       		bne.s	SCDPeelout_Stop_Sound
00014792 117C 0000 001C             		move.b	#0,$1C(a0)	; launches here (peelout sprites)
00014798 317C 0001 0010             		move.w	#1,$10(a0)	; force X speed to nonzero for camera lag's benefit
0001479E 3028 0014                  		move.w	$14(a0),d0
000147A2 0440 0800                  		subi.w	#$800,d0
000147A6 D040                       		add.w	d0,d0
000147A8 0240 0800                  		andi.w	#$800,d0
000147AC 4440                       		neg.w	d0
000147AE 0640 0800                  		addi.w	#$800,d0
000147B2                            		;move.w	d0,(v_cameralag).w
000147B2 0828 0000 0022             		btst	#0,$22(a0)
000147B8 6700                       		beq.s	@dontflip
000147BA 4468 0014                  		neg.w	$14(a0)
000147BE                             
000147BE                            @dontflip:
000147BE 08A8 0007 0022             		bclr	#7,$22(a0)
000147C4 303C 00D3                  		move.w	#$D3,d0
000147C8 4EB9 0000 1038             		jsr		(PlaySound_Special).l
000147CE                            		; sfx 	sfx_PeeloutRelease
000147CE 6000 0000                  		bra.w	SCDPeelout_ResetScr
000147D2                            ; ---------------------------------------------------------------------------
000147D2                             
000147D2                            SCDPeelout_Charge:				; If still charging the dash...
000147D2 3238 F760                  		move.w	($FFFFF760).w,d1	; get top peelout speed
000147D6 3401                       		move.w	d1,d2
000147D8 D241                       		add.w	d1,d1
000147DA 4A38 FE2E                  		tst.b   ($FFFFFE2E).w 		; test for speed shoes
000147DE 6700                       		beq.s	@noshoes
000147E0 E242                       		asr.w	#1,d2
000147E2 9242                       		sub.w	d2,d1
000147E4                            
000147E4                            @noshoes:
000147E4 0668 0064 0014             		addi.w	#$64,$14(a0)		; increment speed
000147EA B268 0014                  		cmp.w	$14(a0),d1
000147EE 6E00                       		bgt.s	@inctimer
000147F0 3141 0014                  		move.w	d1,$14(a0)
000147F4                            
000147F4                            @inctimer:
000147F4 5228 003A                  		addq.b	#1,$3A(a0)		; increment timer
000147F8 0C28 001E 003A             		cmpi.b	#$1E,$3A(a0)
000147FE 6500                       		bcs.s	SCDPeelout_ResetScr
00014800 117C 001E 003A             		move.b	#$1E,$3A(a0)
00014806 4EF9 0000 0000             		jmp 	SCDPeelout_ResetScr
0001480C                            		
0001480C                            SCDPeelout_Stop_Sound:
0001480C 303C 00BC                  		move.w	#$BC,d0
00014810 4EB9 0000 1038             		jsr		(PlaySound_Special).l
00014816                            		; sfx 	sfx_PeeloutStop
00014816 4268 0014                  		clr.w	$14(a0)
0001481A                            
0001481A                            SCDPeelout_ResetScr:
0001481A 588F                       		addq.l	#4,sp			; increase stack ptr ; was 4
0001481C 0C78 0060 F73E             		cmpi.w	#$60,($FFFFF73E).w
00014822 6700                       		beq.s	@finish
00014824 6400                       		bcc.s	@skip
00014826 5878 F73E                  		addq.w	#4,($FFFFF73E).w
0001482A                             
0001482A                            	@skip:
0001482A 5578 F73E                  		subq.w	#2,($FFFFF73E).w
0001482E                             
0001482E                            	@finish:
0001482E 6100 FBAC                  		bsr.w	Sonic_LevelBound
00014832 6100 0000                  		bsr.w	Sonic_AnglePos
00014836 4E75                       		rts
00014838                            		
00014838                            ; ---------------------------------------------------------------------------
00014838                            ; Subroutine to make Sonic perform a spindash
00014838                            ; ---------------------------------------------------------------------------
00014838                             
00014838                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014838                             
00014838                             
00014838                            Sonic_SpinDash:
00014838 4A28 0039                  		tst.b	$39(a0)			; already Spin Dashing?
0001483C 6600                       		bne.s	loc2_1AC8E		; if set, branch
0001483E 0C28 0008 001C             		cmpi.b	#8,anim(a0)		; is anim duck
00014844 6600                       		bne.s	locret2_1AC8C		; if not, return
00014846 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
0001484A 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C ?
0001484E 6700 0000                  		beq.w	locret2_1AC8C		; if not, return
00014852 117C 0009 001C             		move.b	#9,anim(a0)		; set Spin Dash anim
00014858 303C 00D1                  		move.w	#$D1,d0			; spin sound ($E0 in s2)
0001485C 4EB9 0000 1038             		jsr	(PlaySound_Special).l	; play spin sound
00014862 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014864 117C 0001 0039             		move.b	#1,$39(a0)		; set Spin Dash flag
0001486A 317C 0000 003A             		move.w	#0,$3A(a0)		; set charge count to 0
00014870 0C78 000C FE14             		cmpi.w	#$C,($FFFFFE14).w	; check air remaining
00014876 6500                       		bcs.s	loc2_1AC84		; ??? branch if carry
00014878 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
0001487E                            						; the smoke/dust object
0001487E                            loc2_1AC84:
0001487E 6100 FB5C                  		bsr.w	Sonic_LevelBound
00014882 6100 0000                  		bsr.w	Sonic_AnglePos
00014886                            
00014886                            locret2_1AC8C:
00014886 4E75                       		rts	
00014888                            ; ---------------------------------------------------------------------------
00014888                            
00014888                            loc2_1AC8E:
00014888 117C 0009 001C             		move.b	#9,anim(a0)
0001488E 1038 F602                  		move.b	($FFFFF602).w,d0	; read controller
00014892 0800 0001                  		btst	#1,d0			; check down button
00014896 6600 0000                  		bne.w	loc2_1AD30		; if set, branch
0001489A 117C 000E 0016             		move.b	#$E,y_radius(a0)		; $16(a0) is height/2
000148A0 117C 0007 0017             		move.b	#7,x_radius(a0)		; $17(a0) is width/2
000148A6 117C 0002 001C             		move.b	#2,anim(a0)		; set animation to roll
000148AC 5A68 000C                  		addq.w	#5,y_pos(a0)		; $C(a0) is Y coordinate
000148B0 117C 0000 0039             		move.b	#0,$39(a0)		; clear Spin Dash flag
000148B6 7000                       		moveq	#0,d0
000148B8 1028 003A                  		move.b	$3A(a0),d0		; copy charge count
000148BC D040                       		add.w	d0,d0			; double it
000148BE 317B 0000 0014             		move.w	Dash_Speeds(pc,d0.w),$14(a0) ; get normal speed
000148C4 4A38 FE19                  		tst.b	(Super_Sonic_flag).w
000148C8 6700                       		beq.s	loc2_1AC8F
000148CA 317B 0000 0014             		move.w	Dash_Speeds_Super(pc,d0.w),inertia(a0)
000148D0                            
000148D0                            loc2_1AC8F:
000148D0 3028 0014                  		move.w	$14(a0),d0		; get inertia
000148D4 0440 0800                  		subi.w	#$800,d0		; subtract $800
000148D8 D040                       		add.w	d0,d0			; double it
000148DA 0240 1F00                  		andi.w	#$1F00,d0		; mask it against $1F00
000148DE 4440                       		neg.w	d0			; negate it
000148E0 0640 2000                  		addi.w	#$2000,d0		; add $2000
000148E4 31C0 C904                  		move.w	d0,($FFFFC904).w	; move to $C904
000148E8 0828 0000 0022             		btst	#0,status(a0)		; is sonic facing right?
000148EE 6700                       		beq.s	loc2_1ACF4		; if not, branch
000148F0 4468 0014                  		neg.w	$14(a0)			; negate inertia
000148F4                            
000148F4                            loc2_1ACF4:
000148F4 08E8 0002 0022             		bset	#2,status(a0)		; set unused (in s1) flag
000148FA 11FC 0000 D1DC             		move.b	#0,($FFFFD1DC).w	; clear Spin Dash dust animation.
00014900 303C 00BC                  		move.w	#$BC,d0			; spin release sound
00014904 4EB9 0000 1038             		jsr	(PlaySound_Special).l	; play it!
0001490A 6000                       		bra.s	loc2_1AD78
0001490C                            ; ===========================================================================
0001490C                            Dash_Speeds:
0001490C 0800                       		dc.w  $800		; 0
0001490E 0880                       		dc.w  $880		; 1
00014910 0900                       		dc.w  $900		; 2
00014912 0980                       		dc.w  $980		; 3
00014914 0A00                       		dc.w  $A00		; 4
00014916 0A80                       		dc.w  $A80		; 5
00014918 0B00                       		dc.w  $B00		; 6
0001491A 0B80                       		dc.w  $B80		; 7
0001491C 0C00                       		dc.w  $C00		; 8
0001491E                            Dash_Speeds_Super:
0001491E 0B00                       		dc.w  $B00	; 0
00014920 0B80                       		dc.w  $B80	; 1
00014922 0C00                       		dc.w  $C00	; 2
00014924 0C80                       		dc.w  $C80	; 3
00014926 0D00                       		dc.w  $D00	; 4
00014928 0D80                       		dc.w  $D80	; 5
0001492A 0E00                       		dc.w  $E00	; 6
0001492C 0E80                       		dc.w  $E80	; 7
0001492E 0F00                       		dc.w  $F00	; 8
00014930                            ; ===========================================================================
00014930                            
00014930                            loc2_1AD30:				; If still charging the dash...
00014930 4A68 003A                  		tst.w	$3A(a0)		; check charge count
00014934 6700                       		beq.s	loc2_1AD48	; if zero, branch
00014936 3028 003A                  		move.w	$3A(a0),d0	; otherwise put it in d0
0001493A EA48                       		lsr.w	#5,d0		; shift right 5 (divide it by 32)
0001493C 9168 003A                  		sub.w	d0,$3A(a0)	; subtract from charge count
00014940 6400                       		bcc.s	loc2_1AD48	; ??? branch if carry clear
00014942 317C 0000 003A             		move.w	#0,$3A(a0)	; set charge count to 0
00014948                            
00014948                            loc2_1AD48:
00014948 1038 F603                  		move.b	($FFFFF603).w,d0	; read controller
0001494C 0200 0070                  		andi.b	#$70,d0			; pressing A/B/C?
00014950 6700 0000                  		beq.w	loc2_1AD78		; if not, branch
00014954 317C 0900 001C             		move.w	#$900,anim(a0)		; reset spdsh animation
0001495A 303C 00D1                  		move.w	#$D1,d0			; was $E0 in sonic 2
0001495E 11FC 0002 D1DC             		move.b	#2,($FFFFD1DC).w	; Set the Spin Dash dust animation to $2.
00014964 4EB9 0000 1038             		jsr	(PlaySound_Special).l	; play charge sound
0001496A 0668 0200 003A             		addi.w	#$200,$3A(a0)		; increase charge count
00014970 0C68 0800 003A             		cmpi.w	#$800,$3A(a0)		; check if it's maxed
00014976 6500                       		bcs.s	loc2_1AD78		; if not, then branch
00014978 317C 0800 003A             		move.w	#$800,$3A(a0)		; reset it to max
0001497E                            
0001497E                            loc2_1AD78:
0001497E 588F                       		addq.l	#4,sp			; Add 4 bytes to the stack return address to skip Sonic_Jump on next rts to Obj01_MdNormal, preventing conflicts with button presses.
00014980 0C78 0060 EED8             		cmpi.w	#$60,($FFFFEED8).w	; $EED8 only ever seems
00014986 6700                       		beq.s	loc2_1AD8C		; to be used in Spin Dash
00014988 6400                       		bcc.s	loc2_1AD88
0001498A 5878 EED8                  		addq.w	#4,($FFFFEED8).w
0001498E                            
0001498E                            loc2_1AD88:
0001498E 5578 EED8                  		subq.w	#2,($FFFFEED8).w
