00079A88                            ; ------------------------------------------------------------------------------
00079A88                            ; Plays a given sample
00079A88                            ; ------------------------------------------------------------------------------
00079A88                            ; INPUT:
00079A88                            ;		d0	.b		sample id (>$81)
00079A88                            ;
00079A88                            ; EXAMPLES:
00079A88                            ;		move.b	#$81, d0
00079A88                            ;		jsr		MegaPCM_PlaySample
00079A88                            ;
00079A88                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00079A88                            ;		jsr		MegaPCM_PlaySample
00079A88                            ; ------------------------------------------------------------------------------
00079A88                            
00079A88                            MegaPCM_PlaySample:
00079A88                            	MPCM_play	d0
00079A88                          M 	mpcm_stopz80
00079A88                          M 	pusho
00079A88                          M 	opt	l-
00079A88 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
