0000AD28 41F8 D000                  		lea	($FFFFD000).w,a0	; put Sonic's ram address in a0, because Touch_ChkHurt wants the damaged object to be in a0
0000AD2C 4EB9 0000 0000             		jsr	Touch_ChkHurt	; run the Touch_ChkHurt routine
0000AD32 205F                       		move.l	(sp)+,a0	; pop the previous value of a0 from the stack, and increment stack pointer
0000AD34 4E75                       		rts
