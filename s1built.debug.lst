0018E1F8                            ; O c�digo deve ficar como abaixo
0018E1F8                            ;               ......................
0018E1F8                            ; loc_3242:
0018E1F8                            ;		tst.b	($FFFFFFE0).w
0018E1F8                            ;		beq.w	PlayLevel	
0018E1F8                            ;		btst	#6,($FFFFF604).w 
