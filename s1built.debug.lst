000152D0                            
000152D0                            Sonic_Animate:				; XREF: Obj01_Control; et al
000152D0 43F9 0000 0000             		lea	(SonicAniData).l,a1
000152D6 7000                       		moveq	#0,d0
000152D8 1028 001C                  		move.b	$1C(a0),d0
000152DC B028 001D                  		cmp.b	$1D(a0),d0	; is animation set to restart?
000152E0 6700                       		beq.s	SAnim_Do	; if not, branch
000152E2 1140 001D                  		move.b	d0,$1D(a0)	; set to "no restart"
000152E6 117C 0000 001B             		move.b	#0,$1B(a0)	; reset	animation
000152EC 117C 0000 001E             		move.b	#0,$1E(a0)	; reset	frame duration
000152F2                            
000152F2                            SAnim_Do:
000152F2 D040                       		add.w	d0,d0
000152F4 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000152F8 1011                       		move.b	(a1),d0
000152FA 6B00                       		bmi.s	SAnim_WalkRun	; if animation is walk/run/roll/jump, branch
000152FC 1228 0022                  		move.b	$22(a0),d1
00015300 0201 0001                  		andi.b	#1,d1
00015304 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001530A 8328 0001                  		or.b	d1,1(a0)
0001530E 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015312 6A00                       		bpl.s	SAnim_Delay	; if time remains, branch
00015314 1140 001E                  		move.b	d0,$1E(a0)	; load frame duration
00015318                            
00015318                            SAnim_Do2:
00015318 7200                       		moveq	#0,d1
0001531A 1228 001B                  		move.b	$1B(a0),d1	; load current frame number
0001531E 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00015322 6B00                       		bmi.s	SAnim_End_FF	; if animation is complete, branch
00015324                            
00015324                            SAnim_Next:
00015324 1140 001A                  		move.b	d0,$1A(a0)	; load sprite number
00015328 5228 001B                  		addq.b	#1,$1B(a0)	; next frame number
0001532C                            
0001532C                            SAnim_Delay:
0001532C 4E75                       		rts	
0001532E                            ; ===========================================================================
0001532E                            
0001532E                            SAnim_End_FF:
0001532E 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00015330 6600                       		bne.s	SAnim_End_FE	; if not, branch
00015332 117C 0000 001B             		move.b	#0,$1B(a0)	; restart the animation
00015338 1029 0001                  		move.b	1(a1),d0	; read sprite number
0001533C 60E6                       		bra.s	SAnim_Next
0001533E                            ; ===========================================================================
0001533E                            
0001533E                            SAnim_End_FE:
0001533E 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00015340 6600                       		bne.s	SAnim_End_FD	; if not, branch
00015342 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00015346 9128 001B                  		sub.b	d0,$1B(a0)	; jump back d0 bytes in	the script
0001534A 9200                       		sub.b	d0,d1
0001534C 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00015350 60D2                       		bra.s	SAnim_Next
00015352                            ; ===========================================================================
00015352                            
00015352                            SAnim_End_FD:
00015352 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00015354 6600                       		bne.s	SAnim_End	; if not, branch
00015356 1171 1002 001C             		move.b	2(a1,d1.w),$1C(a0) ; read next byte, run that animation
0001535C                            
0001535C                            SAnim_End:
0001535C 4E75                       		rts	
0001535E                            ; ===========================================================================
0001535E                            
0001535E                            SAnim_WalkRun:				; XREF: SAnim_Do
0001535E 5328 001E                  		subq.b	#1,$1E(a0)	; subtract 1 from frame	duration
00015362 6AC8                       		bpl.s	SAnim_Delay	; if time remains, branch
00015364 5200                       		addq.b	#1,d0		; is animation walking/running?
00015366 6600 0000                  		bne.w	SAnim_RollJump	; if not, branch
0001536A 7200                       		moveq	#0,d1
0001536C 1028 0026                  		move.b	$26(a0),d0	; get Sonic's angle
00015370 1428 0022                  		move.b	$22(a0),d2
00015374 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00015378 6600                       		bne.s	loc_13A70	; if yes, branch
0001537A 4600                       		not.b	d0		; reverse angle
0001537C                            
0001537C                            loc_13A70:
0001537C 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00015380 6A00                       		bpl.s	loc_13A78	; if angle is $0-$7F, branch
00015382 7203                       		moveq	#3,d1
00015384                            
00015384                            loc_13A78:
00015384 0228 00FC 0001             		andi.b	#$FC,1(a0)
0001538A B302                       		eor.b	d1,d2
0001538C 8528 0001                  		or.b	d2,1(a0)
00015390 0828 0005 0022             		btst	#5,$22(a0)
00015396 6600 0000                  		bne.w	SAnim_Push
0001539A E808                       		lsr.b	#4,d0		; divide angle by $10
0001539C 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
000153A0 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000153A4 6A00                       		bpl.s	loc_13A9C
000153A6 4442                       		neg.w	d2
000153A8                            
000153A8                            loc_13A9C:
000153A8 43F9 0000 0000             		lea	(SonAni_Peelout).l,a1 ; use	running	animation
000153AE 0C42 0800                  		cmpi.w	#$800,d2	; is Sonic at running speed?
000153B2 6400                       		bcc.s	loc_13AB4	; if yes, branch
000153B4 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
000153BA 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
000153BE 6400                       		bcc.s	loc_13AB4	; if yes, branch
000153C0 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
000153C6 1200                       		move.b	d0,d1
000153C8 E209                       		lsr.b	#1,d1
000153CA D001                       		add.b	d1,d0
000153CC                            
000153CC                            loc_13AB4:
000153CC D000                       		add.b	d0,d0
000153CE 1600                       		move.b	d0,d3
000153D0 4442                       		neg.w	d2
000153D2 0642 0800                  		addi.w	#$800,d2
000153D6 6A00                       		bpl.s	loc_13AC2
000153D8 7400                       		moveq	#0,d2
000153DA                            
000153DA                            loc_13AC2:
000153DA E04A                       		lsr.w	#8,d2
000153DC 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
000153E0 6100 FF36                  		bsr.w	SAnim_Do2
000153E4 D728 001A                  		add.b	d3,$1A(a0)	; modify frame number
000153E8 4E75                       		rts	
000153EA                            ; ===========================================================================
000153EA                            
000153EA                            SAnim_RollJump:				; XREF: SAnim_WalkRun
000153EA 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
000153EC 6600                       		bne.s	SAnim_Push	; if not, branch
000153EE 3428 0014                  		move.w	$14(a0),d2	; get Sonic's speed
000153F2 6A00                       		bpl.s	loc_13ADE
000153F4 4442                       		neg.w	d2
000153F6                            
000153F6                            loc_13ADE:
000153F6 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
000153FC 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00015400 6400                       		bcc.s	loc_13AF0	; if yes, branch
00015402 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
00015408                            
00015408                            loc_13AF0:
00015408 4442                       		neg.w	d2
0001540A 0642 0400                  		addi.w	#$400,d2
0001540E 6A00                       		bpl.s	loc_13AFA
00015410 7400                       		moveq	#0,d2
00015412                            
00015412                            loc_13AFA:
00015412 E04A                       		lsr.w	#8,d2
00015414 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
00015418 1228 0022                  		move.b	$22(a0),d1
0001541C 0201 0001                  		andi.b	#1,d1
00015420 0228 00FC 0001             		andi.b	#$FC,1(a0)
00015426 8328 0001                  		or.b	d1,1(a0)
0001542A 6000 FEEC                  		bra.w	SAnim_Do2
0001542E                            ; ===========================================================================
0001542E                            
