00077844                            ; ------------------------------------------------------------------------------
00077844                            ; Plays a given sample
00077844                            ; ------------------------------------------------------------------------------
00077844                            ; INPUT:
00077844                            ;		d0	.b		sample id (>$81)
00077844                            ;
00077844                            ; EXAMPLES:
00077844                            ;		move.b	#$81, d0
00077844                            ;		jsr		MegaPCM_PlaySample
00077844                            ;
00077844                            ;		move.b	#mysample.id, d0	; if sample has a label in sample table
00077844                            ;		jsr		MegaPCM_PlaySample
00077844                            ; ------------------------------------------------------------------------------
00077844                            
00077844                            MegaPCM_PlaySample:
00077844                            	MPCM_play	d0
00077844                          M 	mpcm_stopz80
00077844                          M 	pusho
00077844                          M 	opt	l-
00077844 33FC 0100 00A1 1100      M 	move.w	#$100,mpcm_z80_busreq
0007784C                          M 	@wait_5:
0007784C 0839 0000 00A1 1100      M 	btst	#0,mpcm_z80_busreq
00077854 66F6                     M 	bne.s	@wait_5
00077856                          M 	popo
00077856 13C0 00A0 0001           M 	move.b	d0,mpcm_z80_ram+z_mpcm_commandinput
0007785C                          M 	mpcm_startz80
0007785C 33FC 0000 00A1 1100      M 	move.w	#0,mpcm_z80_busreq
00077864 4E75                       	rts
00077866                            
