0000DE60 4440                       		neg.w	d0			; invert difference to check opposite end for right spikes
0000DE62 4A40                       Obj36_ChkHurt:	tst.w	d0			; is Sonic touching the "pointy" end of the spikes?
0000DE64 6E00                       		bgt.s	Obj36_Display		; if not, make spike harmless (backside touched)
0000DE66 6000                       		bra.s	Obj36_Hurt		; otherwise, trigger damage
