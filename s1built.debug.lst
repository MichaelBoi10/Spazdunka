0001521A 6B00                       		bmi.s	loc_13B1E
0001521C 4442                       		neg.w	d2
0001521E                            
0001521E                            loc_13B1E:
0001521E 0642 0800                  		addi.w	#$800,d2
00015222 6A00                       		bpl.s	loc_13B26
00015224 7400                       		moveq	#0,d2
00015226                            
00015226                            loc_13B26:
00015226 EC4A                       		lsr.w	#6,d2
00015228 1142 001E                  		move.b	d2,$1E(a0)	; modify frame duration
0001522C 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00015232 1228 0022                  		move.b	$22(a0),d1
00015236 0201 0001                  		andi.b	#1,d1
0001523A 0228 00FC 0001             		andi.b	#$FC,1(a0)
