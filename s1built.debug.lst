000146DC 117C 001F 001C             	move.b	#$1F,anim(a0)			; use transformation animation
000146E2 31FC 0A00 F760             	move.w	#$A00,(Sonic_top_speed).w
000146E8 31FC 0030 F762             	move.w	#$30,(Sonic_acceleration).w
000146EE 31FC 0100 F764             	move.w	#$100,(Sonic_deceleration).w
000146F4 317C 0000 0032             	move.w	#0,invincibility_time(a0)
000146FA 11FC 0001 FE2D             	move.b #1,($FFFFFE2D).w ; make Sonic invincible
00014700 303C 00C3                  	move.w	#$C3,d0         ; 
00014704 4EB9 0000 1032             	jsr	(PlaySound).l	; Play special ring sound effect.
0001470A 303C 0094                  	move.w	#$94,d0
0001470E 4EF9 0000 1038             	jmp	(PlaySound_Special).l	; Play the super theme
00014714                            ; ---------------------------------------------------------------------------
