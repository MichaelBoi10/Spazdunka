00005BBC                            
00005BBC                            Cred_WaitLoop:
00005BBC 11FC 0004 F62A             		move.b	#4,($FFFFF62A).w
00005BC2 6100 CDD4                  		bsr.w	DelayProgram
00005BC6 6100 B750                  		bsr.w	RunPLC_RAM
00005BCA 4A78 F614                  		tst.w	($FFFFF614).w	; have 2 seconds elapsed?
00005BCE 66EC                       		bne.s	Cred_WaitLoop	; if not, branch
00005BD0 4AB8 F680                  		tst.l	($FFFFF680).w	; have level gfx finished decompressing?
00005BD4 66E6                       		bne.s	Cred_WaitLoop	; if not, branch
00005BD6 0C78 0009 FFF4             		cmpi.w	#9,($FFFFFFF4).w ; have	the credits finished?
00005BDC 6700 0000                  		beq.w	TryAgainEnd	; if yes, branch
00005BE0 4E75                       		rts	
